workbench-prefs-patterns_SRC := $(shell echo . | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(AROSDIR)/Prefs/Presets/Patterns/Misc
else
setup :: $(AROSDIR)/Prefs/Presets/Patterns/Misc
endif

GLOB_MKDIRS += $(AROSDIR)/Prefs/Presets/Patterns/Misc


.PHONY : workbench-prefs-patterns

#MM
workbench-prefs-patterns : | $(AROSDIR)/Prefs/Presets/Patterns/Misc 
	$(foreach file, $(FILES), $(shell $(CP) $(addprefix $(if $(filter /%,$(workbench-prefs-patterns_SRC)),$(workbench-prefs-patterns_SRC),$(SRCDIR)/$(CURDIR)/$(workbench-prefs-patterns_SRC))/, $(file)) $(addprefix $(AROSDIR)/Prefs/Presets/Patterns/Misc/, $(file))))


