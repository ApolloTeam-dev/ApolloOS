# Makefile for Mason's workbench icons

include $(SRCDIR)/config/aros.cfg

ICONS     := Sashimi
ICONDIR   := $(AROSDIR)/Developer/Debug

#MM- iconset-Mason-wbench-icons-aros : iconset-Mason-wbench-icons-aros-debug


BD_OBJS := $(addprefix  $(ICONDIR)/, $(addsuffix .info,$(ICONS)))

#MM
iconset-Mason-wbench-icons-aros-debug : $(BD_OBJS)

ifeq (,)

$(ICONDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(ICONDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(ICONDIR)
else
$(BD_OBJS) :: $(ICONDIR)
endif

GLOB_MKDIRS += $(ICONDIR)


iconset-Mason-wbench-icons-aros-debug-clean : FILES := $(BD_OBJS)
#MM
iconset-Mason-wbench-icons-aros-debug-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-Mason-wbench-icons-aros-debug iconset-Mason-wbench-icons-aros-debug-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
