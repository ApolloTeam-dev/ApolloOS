include $(SRCDIR)/config/aros.cfg

ICONS := CDROM_Amiga Harddisk_Amiga Harddisk_Linux Harddisk_MacOS Harddisk_Windows

#MM- themes-GorillaSmall-icons-clean : themes-GorillaSmall-icons-disks-clean
#MM- themes-GorillaSmall-icons : themes-GorillaSmall-icons-disks

BD_OBJS := $(addprefix  $(AROS_CONTRIB)/Icons/Gorilla/Disks/, $(addsuffix .info,$(ICONS)))

#MM
themes-GorillaSmall-icons-disks : $(BD_OBJS)

ifeq (,)

$(AROS_CONTRIB)/Icons/Gorilla/Disks/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_CONTRIB)/Icons/Gorilla/Disks/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_CONTRIB)/Icons/Gorilla/Disks
else
$(BD_OBJS) :: $(AROS_CONTRIB)/Icons/Gorilla/Disks
endif

GLOB_MKDIRS += $(AROS_CONTRIB)/Icons/Gorilla/Disks


themes-GorillaSmall-icons-disks-clean : FILES := $(BD_OBJS)
#MM
themes-GorillaSmall-icons-disks-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: themes-GorillaSmall-icons-disks themes-GorillaSmall-icons-disks-clean


