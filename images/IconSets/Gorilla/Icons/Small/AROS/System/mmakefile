BD_OBJS := $(addprefix  $(AROS_SYSTEM)/, $(addsuffix .info,$(BASEICONS)))

#MM
iconset-GorillaSmall-wbench-icons-aros-system : $(BD_OBJS)

ifeq (,)

$(AROS_SYSTEM)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_SYSTEM)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_SYSTEM)
else
$(BD_OBJS) :: $(AROS_SYSTEM)
endif

GLOB_MKDIRS += $(AROS_SYSTEM)


iconset-GorillaSmall-wbench-icons-aros-system-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-aros-system-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-aros-system iconset-GorillaSmall-wbench-icons-aros-system-clean



