include $(SRCDIR)/config/aros.cfg

BASEICONS := Calculator HDToolBox InstallAROS Editor Commodities \
         ShowConfig KeyShow InitPrinter PrintFiles GraphicDump
ADDITIONALICONS := WiMP ScreenGrabber SysExplorer BoingIconBar

#MM- iconset-GorillaSmall-wbench-icons-aros-clean : iconset-GorillaSmall-wbench-icons-aros-tools-clean
#MM- iconset-GorillaSmall-additional-icons-aros-clean : iconset-GorillaSmall-additional-icons-aros-tools-clean
#MM- iconset-GorillaSmall-wbench-icons-aros : iconset-GorillaSmall-wbench-icons-aros-tools
#MM- iconset-GorillaSmall-additional-icons-aros : iconset-GorillaSmall-additional-icons-aros-tools


BD_OBJS := $(addprefix  $(AROS_TOOLS)/, $(addsuffix .info,$(BASEICONS)))

#MM
iconset-GorillaSmall-wbench-icons-aros-tools : $(BD_OBJS)

ifeq (,)

$(AROS_TOOLS)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_TOOLS)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_TOOLS)
else
$(BD_OBJS) :: $(AROS_TOOLS)
endif

GLOB_MKDIRS += $(AROS_TOOLS)


iconset-GorillaSmall-wbench-icons-aros-tools-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-aros-tools-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-aros-tools iconset-GorillaSmall-wbench-icons-aros-tools-clean



