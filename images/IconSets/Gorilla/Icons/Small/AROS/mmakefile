BD_OBJS := $(addprefix  $(AROSDIR)/, $(addsuffix .info,$(BASEICONS)))

#MM
iconset-GorillaSmall-wbench-icons-aros : $(BD_OBJS)

ifeq (,)

$(AROSDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROSDIR)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROSDIR)
else
$(BD_OBJS) :: $(AROSDIR)
endif

GLOB_MKDIRS += $(AROSDIR)


iconset-GorillaSmall-wbench-icons-aros-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-aros-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-aros iconset-GorillaSmall-wbench-icons-aros-clean



