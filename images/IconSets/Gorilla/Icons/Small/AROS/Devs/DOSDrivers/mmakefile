include $(SRCDIR)/config/aros.cfg

STORAGEICONS := ICD0 ICD1 IDF0 IDF1 ISO0 PC0
DEVSICONS    := PAR PIPE PRT SER SER0 SER1

#MM- iconset-GorillaSmall-wbench-icons-aros-clean : iconset-GorillaSmall-wbench-icons-devs-dosdrivers-clean iconset-GorillaSmall-wbench-icons-storage-dosdrivers-clean
#MM- iconset-GorillaSmall-wbench-icons-aros : iconset-GorillaSmall-wbench-icons-devs-dosdrivers iconset-GorillaSmall-wbench-icons-storage-dosdrivers


BD_OBJS := $(addprefix  $(AROS_DEVS)/DOSDrivers/, $(addsuffix .info,$(DEVSICONS)))

#MM
iconset-GorillaSmall-wbench-icons-devs-dosdrivers : $(BD_OBJS)

ifeq (,)

$(AROS_DEVS)/DOSDrivers/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_DEVS)/DOSDrivers/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_DEVS)/DOSDrivers
else
$(BD_OBJS) :: $(AROS_DEVS)/DOSDrivers
endif

GLOB_MKDIRS += $(AROS_DEVS)/DOSDrivers


iconset-GorillaSmall-wbench-icons-devs-dosdrivers-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-devs-dosdrivers-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-devs-dosdrivers iconset-GorillaSmall-wbench-icons-devs-dosdrivers-clean



