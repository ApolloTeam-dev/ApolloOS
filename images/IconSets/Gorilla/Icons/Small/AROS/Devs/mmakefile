include $(SRCDIR)/config/aros.cfg

STORAGEICONS := DataTypes DOSDrivers Drivers Keymaps Monitors Printers
DEVSICONS := $(STORAGEICONS) Midi

#MM- iconset-GorillaSmall-wbench-icons-aros-clean : iconset-GorillaSmall-wbench-icons-aros-devs-clean iconset-GorillaSmall-wbench-icons-aros-storage-clean
#MM- iconset-GorillaSmall-wbench-icons-aros : iconset-GorillaSmall-wbench-icons-aros-devs iconset-GorillaSmall-wbench-icons-aros-storage


BD_OBJS := $(addprefix  $(AROS_DEVS)/, $(addsuffix .info,$(DEVSICONS)))

#MM
iconset-GorillaSmall-wbench-icons-aros-devs : $(BD_OBJS)

ifeq (,)

$(AROS_DEVS)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_DEVS)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_DEVS)
else
$(BD_OBJS) :: $(AROS_DEVS)
endif

GLOB_MKDIRS += $(AROS_DEVS)


iconset-GorillaSmall-wbench-icons-aros-devs-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-aros-devs-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-aros-devs iconset-GorillaSmall-wbench-icons-aros-devs-clean



