include $(SRCDIR)/config/aros.cfg

STORAGEICONS := Wrapper
DEVSICONS    := ATI IntelGMA NVidia VMWare SAGA

#MM- iconset-GorillaSmall-wbench-icons-aros-clean : iconset-GorillaSmall-wbench-icons-devs-monitors-clean iconset-GorillaSmall-wbench-icons-storage-monitors-clean
#MM- iconset-GorillaSmall-wbench-icons-aros : iconset-GorillaSmall-wbench-icons-devs-monitors iconset-GorillaSmall-wbench-icons-storage-monitors


BD_OBJS := $(addprefix  $(AROS_DEVS)/Monitors/, $(addsuffix .info,$(DEVSICONS)))

#MM
iconset-GorillaSmall-wbench-icons-devs-monitors : $(BD_OBJS)

ifeq (Wrapper.png,)

$(AROS_DEVS)/Monitors/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_DEVS)/Monitors/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/Wrapper.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_DEVS)/Monitors
else
$(BD_OBJS) :: $(AROS_DEVS)/Monitors
endif

GLOB_MKDIRS += $(AROS_DEVS)/Monitors


iconset-GorillaSmall-wbench-icons-devs-monitors-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-devs-monitors-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-devs-monitors iconset-GorillaSmall-wbench-icons-devs-monitors-clean



