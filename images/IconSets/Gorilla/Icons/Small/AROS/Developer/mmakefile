BD_OBJS := $(addprefix  $(AROS_DEVELOPER)/, $(addsuffix .info,$(BASEICONS)))

#MM
iconset-GorillaSmall-wbench-icons-aros-developer : $(BD_OBJS)

ifeq (,)

$(AROS_DEVELOPER)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_DEVELOPER)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_DEVELOPER)
else
$(BD_OBJS) :: $(AROS_DEVELOPER)
endif

GLOB_MKDIRS += $(AROS_DEVELOPER)


iconset-GorillaSmall-wbench-icons-aros-developer-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-aros-developer-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-aros-developer iconset-GorillaSmall-wbench-icons-aros-developer-clean



