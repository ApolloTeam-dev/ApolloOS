BD_OBJS := $(addprefix  $(AROS_LOCALE)/, $(addsuffix .info,$(ICONS)))

#MM
iconset-GorillaSmall-wbench-icons-aros-locale : $(BD_OBJS)

ifeq (,)

$(AROS_LOCALE)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_LOCALE)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_LOCALE)
else
$(BD_OBJS) :: $(AROS_LOCALE)
endif

GLOB_MKDIRS += $(AROS_LOCALE)


iconset-GorillaSmall-wbench-icons-aros-locale-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-aros-locale-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-aros-locale iconset-GorillaSmall-wbench-icons-aros-locale-clean


