include $(SRCDIR)/config/aros.cfg

ICONS := Patterns Themes

#MM- iconset-GorillaSmall-wbench-icons-aros-clean : iconset-GorillaSmall-wbench-icons-aros-prefs-presets-clean
#MM- iconset-GorillaSmall-wbench-icons-aros : iconset-GorillaSmall-wbench-icons-aros-prefs-presets

BD_OBJS := $(addprefix  $(AROS_PREFS)/Presets/, $(addsuffix .info,$(ICONS)))

#MM
iconset-GorillaSmall-wbench-icons-aros-prefs-presets : $(BD_OBJS)

ifeq (,)

$(AROS_PREFS)/Presets/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_PREFS)/Presets/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_PREFS)/Presets
else
$(BD_OBJS) :: $(AROS_PREFS)/Presets
endif

GLOB_MKDIRS += $(AROS_PREFS)/Presets


iconset-GorillaSmall-wbench-icons-aros-prefs-presets-clean : FILES := $(BD_OBJS)
#MM
iconset-GorillaSmall-wbench-icons-aros-prefs-presets-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-GorillaSmall-wbench-icons-aros-prefs-presets iconset-GorillaSmall-wbench-icons-aros-prefs-presets-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
