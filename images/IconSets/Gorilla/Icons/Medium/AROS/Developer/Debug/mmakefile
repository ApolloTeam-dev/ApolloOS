BD_OBJS := $(addprefix  $(AROS_DEBUG)/, $(addsuffix .info,$(BASEICONS)))

#MM
iconset-Gorilla-wbench-icons-aros-debug : $(BD_OBJS)

ifeq (,)

$(AROS_DEBUG)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/%.png
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

else

$(AROS_DEBUG)/%.info : $(SRCDIR)/$(CURDIR)/%.info.src $(SRCDIR)/$(CURDIR)/
	$(Q)$(ECHO) "Creating   $(subst $(TARGETDIR)/,,$@)..."
	$(Q)$(ILBMTOICON) $+ $@

endif


ifneq ($(BD_OBJS),)
$(BD_OBJS) : | $(AROS_DEBUG)
else
$(BD_OBJS) :: $(AROS_DEBUG)
endif

GLOB_MKDIRS += $(AROS_DEBUG)


iconset-Gorilla-wbench-icons-aros-debug-clean : FILES := $(BD_OBJS)
#MM
iconset-Gorilla-wbench-icons-aros-debug-clean ::
	$(Q)$(RM) $(FILES)

.PHONY: iconset-Gorilla-wbench-icons-aros-debug iconset-Gorilla-wbench-icons-aros-debug-clean



