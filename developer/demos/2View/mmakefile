  $(demos_MOBJC_TARGETS) $(demos_MOBJC_DTARGETS) : demos_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(demos_OBJCFLAGS))
  $(demos_MOBJC_TARGETS) $(demos_MOBJC_DTARGETS) : demos_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(demos_OBJCDFLAGS))
  $(demos_MOBJC_TARGETS) $(demos_MOBJC_DTARGETS) : demos_IQUOTE:=$(KERNEL_IQUOTE)
  $(demos_MOBJC_TARGETS) $(demos_MOBJC_DTARGETS) : demos_IQUOTE_END:=$(KERNEL_IQUOTE_END)
