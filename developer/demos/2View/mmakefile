# Adjust compiler flags to suit C++
demos_MCXX_CPPFLAGS := $(demos_CPPFLAGS)
demos_CXXFLAGS := $(demos_CXXFLAGS)
ifeq ($(demos_DXXFLAGS),)
  demos_DXXFLAGS := $(demos_CXXFLAGS)
else
  demos_DXXFLAGS := $(demos_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  demos_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  demos_STRIP ?= $(HOST_STRIP)
  demos_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  demos_CXXCMD:=$(HOST_CXX)
  demos_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(demos_MCXX_CPPFLAGS) $(demos_MCXX_EXTRA_CPPFLAGS))
  demos_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(demos_CXXFLAGS))
  demos_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(demos_DXXFLAGS))
  demos_CXXIQUOTE:=$(HOST_IQUOTE)
  demos_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  demos_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  demos_STRIP ?= $(TARGET_STRIP)
  demos_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  demos_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  demos_MCXX_CPPFLAGS := $(strip $(demos_MCXX_CPPFLAGS) $(demos_MCXX_EXTRA_CPPFLAGS))
  demos_CXXFLAGS := $(strip $(demos_CXXFLAGS) $(SAFETY_CFLAGS))
  demos_DXXFLAGS := $(demos_DXXFLAGS)
  demos_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  demos_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
