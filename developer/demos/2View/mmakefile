demos_CXXABSBASENAMES := $(foreach demos_CXXBASE,$(demos_CXX_NARCHFILES),$(if $(filter /%,$(demos_CXXBASE)),$(demos_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(demos_CXXBASE))))

ifneq ($(demos_CXXABSBASENAMES),)

demos_CXXBASENAMES := $(basename $(demos_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
demos_MCXX_FILES  := $(strip $(foreach demos_CXXBASE,$(demos_CXXABSBASENAMES), $(firstword $(wildcard $(foreach demos_EXT, $(AROS_CXXEXTS),$(addsuffix .$(demos_EXT),$(demos_CXXBASE)))))))

ifeq (,)
demos_MCXX_SRCWILDCARD := %
else
demos_MCXX_SRCWILDCARD := /%
endif

ifeq ($(demos_OBJDIR),)
  demos_CXXTARGETS := $(notdir $(demos_CXXBASENAMES:=.o))
  demos_CXXDTARGETS := $(notdir $(demos_CXXBASENAMES:=.d))
  demos_MCXX_WILDCARD := %
else
  demos_CXXTARGETS := $(addprefix $(demos_OBJDIR)/,$(notdir $(demos_CXXBASENAMES:=.o)))
  demos_CXXDTARGETS := $(addprefix $(demos_OBJDIR)/,$(notdir $(demos_CXXBASENAMES:=.d)))
