	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(demos_OBJCDFLAGS) $(demos_MOBJC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@

