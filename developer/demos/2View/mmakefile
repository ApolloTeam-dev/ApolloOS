demos_OBJS := $(addsuffix .o,$(addprefix $(demos_OBJDIR)/,$(notdir $(TMP_FILES))))
demos_DEPS := $(addsuffix .d,$(addprefix $(demos_OBJDIR)/,$(notdir $(TMP_FILES))))

demos_CPPFLAGS :=  $(CPPFLAGS)
ifneq (,)
demos_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (target,target)
demos_CFLAGS            := $(CFLAGS)
endif
ifeq (target,host)
demos_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
demos_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
demos_CFLAGS            := 
