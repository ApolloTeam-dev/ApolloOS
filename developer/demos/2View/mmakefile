  # Be sure that all .m files are generated
  $(demos_MOBJC_TARGETS) $(demos_MOBJC_DTARGETS) : | $(addsuffix .m,$(demos_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  demos_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  demos_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(demos_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  demos_MOBJC_DIRS := $(foreach dir, $(demos_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(demos_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(demos_MOBJC_DIRS),)
    demos_MOBJC_DIRS := $(shell echo $(demos_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(demos_MOBJC_DIRS)
  endif
