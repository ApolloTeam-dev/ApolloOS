$(demos_MOBJC_TARGETS) : CPPFLAGS := $(demos_MOBJC_CPPFLAGS)
$(demos_MOBJC_TARGETS) : CFLAGS := $(demos_OBJCFLAGS)
$(demos_MOBJC_TARGETS) : $(demos_MOBJC_WILDCARD).o : $(demos_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(demos_IQUOTE) $(dir $<) $(demos_IQUOTE) $(SRCDIR)/$(CURDIR) $(demos_IQUOTE) . $(demos_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(demos_IQUOTE) $(dir $<) $(demos_IQUOTE) $(SRCDIR)/$(CURDIR) $(demos_IQUOTE) . $(demos_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(demos_IQUOTE) $(dir $<) $(demos_IQUOTE) $(SRCDIR)/$(CURDIR) $(demos_IQUOTE) . $(demos_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
