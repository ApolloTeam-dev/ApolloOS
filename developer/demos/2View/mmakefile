  demos_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(demos_MCXX_CPPFLAGS) $(demos_MCXX_EXTRA_CPPFLAGS))
  demos_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(demos_CXXFLAGS))
  demos_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(demos_DXXFLAGS))
  demos_CXXIQUOTE:=$(KERNEL_IQUOTE)
  demos_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(demos_CXXCMD) $(demos_CXXIQUOTE) $(dir $(2)) $(demos_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(demos_CXXIQUOTE) . $(demos_CXXIQUOTE_END) $(strip $(demos_CXXFLAGS) $(demos_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(demos_CXXCMD) $(demos_CXXIQUOTE) $(dir $(2)) $(demos_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(demos_CXXIQUOTE) . $(demos_CXXIQUOTE_END) $(strip $(demos_CXXFLAGS) $(demos_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(demos_CXXCMD) $(demos_CXXIQUOTE) $(dir $(2)) $(demos_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(demos_CXXIQUOTE) . $(demos_CXXIQUOTE_END) $(strip $(demos_CXXFLAGS) $(demos_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(demos_CXXCMD)" $(MKDEPEND) $(strip $(demos_DXXFLAGS) $(demos_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(demos_OBJDIR),)
  $(foreach demos_CXXFILE,$(demos_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(demos_CXXFILE))),$(demos_CXXFILE))))
else
  $(foreach demos_CXXFILE,$(demos_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(demos_OBJDIR)/,$(notdir $(basename $(demos_CXXFILE)))),$(demos_CXXFILE))))
endif

endif


ifneq ($(demos_OBJC_NARCHFILES),)

