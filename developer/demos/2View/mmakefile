$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : CMD:=$(HOST_CC)
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_MC_CPPFLAGS:=$(strip $(HOST_MC_CPPFLAGS) $(demos_MC_CPPFLAGS) $(demos_MC_EXTRA_CPPFLAGS))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_CFLAGS:=$(strip $(HOST_CFLAGS) $(demos_CFLAGS))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_DFLAGS:=$(strip $(HOST_CFLAGS) $(demos_DFLAGS))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_IQUOTE:=$(HOST_IQUOTE)
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
demos_LINK ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
demos_STRIP ?= $(ECHO) >/dev/null
demos_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(demos_MC_CPPFLAGS) $(demos_MC_EXTRA_CPPFLAGS))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(demos_CFLAGS))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(demos_DFLAGS))
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_IQUOTE:=$(KERNEL_IQUOTE)
$(demos_MC_TARGETS) $(demos_MC_DTARGETS) : demos_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(demos_MC_TARGETS) : CPPFLAGS := $(demos_MC_CPPFLAGS)
$(demos_MC_TARGETS) : CFLAGS := $(demos_CFLAGS)
$(demos_MC_TARGETS) : $(demos_MC_TGTWILDCARD).o : $(demos_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(demos_IQUOTE) $(dir $<) $(demos_IQUOTE) $(SRCDIR)/$(CURDIR) $(demos_IQUOTE) . $(demos_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(demos_IQUOTE) $(dir $<) $(demos_IQUOTE) $(SRCDIR)/$(CURDIR) $(demos_IQUOTE) . $(demos_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(demos_IQUOTE) $(dir $<) $(demos_IQUOTE) $(SRCDIR)/$(CURDIR) $(demos_IQUOTE) . $(demos_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(demos_MC_DTARGETS) : $(demos_MC_TGTWILDCARD).d : $(demos_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(demos_DFLAGS) $(demos_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@

ifeq ($(demos_OBJDIR),)
demos-MA_TARGETS := $(addsuffix .o,$(demos_ASMFILES))
demos-MA_WILDCARD := %
else
demos-MA_TARGETS := $(addsuffix .o,$(addprefix $(demos_OBJDIR)/,$(notdir $(demos_ASMFILES))))
demos-MA_WILDCARD := $(demos_OBJDIR)/%

# Be sure that all .s files are generated
$(demos-MA_TARGETS) : | $(addsuffix .s,$(demos_ASMFILES))

# Be sure that all .c files are found
demos-MA_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
demos-MA_BASEDIRS := $(shell echo $(sort $(dir $(demos_ASMFILES))) | sed 's/\(.\):\//\/\1\//g')
demos-MA_DIRS := $(foreach dir, $(demos-MA_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(demos-MA_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(demos-MA_DIRS),)
    demos-MA_DIRS := $(shell echo $(demos-MA_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.s $(demos-MA_DIRS)
endif

endif

demos-MA_ASSEMBLER ?= $(demos_ASSEMBLER)

$(demos-MA_TARGETS) : demos-MA_CMD:= $(demos-MA_ASSEMBLER)

$(demos-MA_TARGETS) : CPPFLAGS := $(demos_CPPFLAGS)
$(demos-MA_TARGETS) : AFLAGS := $(demos_AFLAGS)
$(demos-MA_TARGETS) : $(demos-MA_WILDCARD).o : %.s
	$(Q)$(ECHO) "Assembling $(notdir $<)..."
	$(Q)$(IF) $(demos-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(notdir $<): $(demos-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@" >> $(GENDIR)/errors ; \
			$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Assemble failed: $(demos-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi


demos-link_EXTRA_LDFLAGS := 
demos-link_EXTRA_LIBS :=
ifeq (no,yes)
    demos-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    demos-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    demos-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files this program depends on.
# In LDFLAGS remove white space between -L and directory
demos-link_DIRS := $(subst -L ,-L,$(strip $(demos_LDFLAGS)))
# Filter out only the libdirs and remove -L
demos-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(demos-link_DIRS)))
# Add trailing /
demos-link_DIRS := $(subst //,/,$(addsuffix /,$(demos-link_DIRS)))
# Add normal linklib path
demos-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
demos-link_LIBS := $(addprefix lib,$(addsuffix .a,$(demos_LIBS) $(demos-link_EXTRA_LIBS)))
ifeq (yes,yes)
    demos-link_LIBS += startup.o
endif
ifeq (no,yes)
    demos-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
demos-link_DEPLIBS := $(foreach lib,$(demos-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(demos-link_DIRS)))) \
)

$(demos_TARGETDIR)/$(demos_PROGNAME) : OBJDIR := $(demos_OBJDIR)
$(demos_TARGETDIR)/$(demos_PROGNAME) : OBJS := $(demos_OBJS) $(demos_ARCHOBJS) $(USER_OBJS)
$(demos_TARGETDIR)/$(demos_PROGNAME) : LDFLAGS := $(strip $(demos_LDFLAGS) $(demos-link_EXTRA_LDFLAGS))
$(demos_TARGETDIR)/$(demos_PROGNAME) : LIBS := $(addprefix -l,$(demos_LIBS) $(demos-link_EXTRA_LIBS) )
$(demos_TARGETDIR)/$(demos_PROGNAME) : $(demos_OBJS) $(demos_ARCHOBJS) $(USER_OBJS) $(demos-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(demos_LINK) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(demos_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(demos_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(demos_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(demos_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(demos_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(demos_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(demos_DEPS),)
  ifneq (demos demos-quick,)
    ifneq ($(findstring $(TARGET),demos demos-quick),)
      -include $(demos_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(demos_DEPS)
    endif
  endif
endif


ifneq ($(demos_OBJS) $(demos_DEPS) $(demos_TARGETDIR)/$(demos_PROGNAME),)
$(demos_OBJS) $(demos_DEPS) $(demos_TARGETDIR)/$(demos_PROGNAME) : | $(demos_OBJDIR) $(demos_TARGETDIR)
else
$(demos_OBJS) $(demos_DEPS) $(demos_TARGETDIR)/$(demos_PROGNAME) :: $(demos_OBJDIR) $(demos_TARGETDIR)
endif

GLOB_MKDIRS += $(demos_OBJDIR) $(demos_TARGETDIR)


demos-clean : FILES := $(demos_OBJS) $(demos_TARGETDIR)/$(demos_PROGNAME) $(demos_DEPS)
#MM
demos-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget demos"
	$(Q)$(RM) $(FILES)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

