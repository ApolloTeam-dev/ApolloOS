  $(demos_MOBJC_TARGETS) $(demos_MOBJC_DTARGETS) : demos_MOBJC_CPPFLAGS:=$(strip $(demos_MOBJC_CPPFLAGS) $(demos_MOBJC_EXTRA_CPPFLAGS))
  $(demos_MOBJC_TARGETS) $(demos_MOBJC_DTARGETS) : demos_OBJCFLAGS:=$(strip $(demos_OBJCFLAGS) $(SAFETY_CFLAGS))
