demos_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(demos_CFLAGS))
demos_CXXFLAGS := $(strip $(LTO_BINARY_CFLAGS) $(demos_CXXFLAGS))
endif
endif
demos_AFLAGS    := $(AFLAGS)
ifneq (,)
    demos_DFLAGS     := 
else
    demos_DFLAGS     := $(demos_CFLAGS)
endif
ifneq (,)
    demos_DXXFLAGS     := 
else
    demos_DXXFLAGS     := $(demos_CXXFLAGS)
endif
ifeq (target,target)
demos_LDFLAGS           := $(demos_LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
