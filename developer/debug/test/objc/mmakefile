include $(SRCDIR)/config/aros.cfg

EXEDIR := $(AROS_TESTS)/objc

# gcc 4.6.2 can't build arm Objective C support without
# a compiler error.
#MM- test : test-$(OBJC_TARGET)-$(CPU)
