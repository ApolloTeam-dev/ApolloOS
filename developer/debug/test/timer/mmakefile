#
#   Makefile for AROS timer.device tests

include $(SRCDIR)/config/aros.cfg

FILES := \
    getsystime

EXEDIR := $(AROS_TESTS)/timer

#MM test-timer : includes linklibs

#MM- test : test-timer
#MM- test-quick : test-timer-quick


.PHONY : test-timer

test-timer_OBJDIR    := $(GENDIR)/$(CURDIR)
test-timer_TARGETDIR := $(EXEDIR)
test-timer_LIBS := 

test-timer_FILES     := $(FILES)
test-timer_OBJS      := $(addsuffix .o,$(addprefix $(test-timer_OBJDIR)/,$(test-timer_FILES)))
test-timer_DEPS      := $(addsuffix .d,$(addprefix $(test-timer_OBJDIR)/,$(test-timer_FILES)))
test-timer_EXES      := $(addprefix $(test-timer_TARGETDIR)/,$(test-timer_FILES))

test-timer_CPPFLAGS := $(CPPFLAGS)
ifneq (,)
    test-timer_CPPFLAGS += -I
endif
test-timer_CFLAGS    := $(CFLAGS)
test-timer_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
test-timer_COVERAGE := yes
test-timer_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
test-timer_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
test-timer_CFLAGS    := $(strip $(test-timer_COVERAGEFLAGS) $(test-timer_CFLAGS))
test-timer_LIBS += $(test-timer_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
test-timer_FUNCINSTR := yes
test-timer_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
test-timer_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
test-timer_CFLAGS    := $(strip $(test-timer_INSTRFUNCFLAGS) $(test-timer_CFLAGS))
test-timer_LIBS += $(test-timer_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
test-timer_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(test-timer_CFLAGS))
endif
endif
ifneq (,)
    test-timer_DFLAGS := 
else
    test-timer_DFLAGS := $(test-timer_CFLAGS)
endif
ifeq (target,target)
test-timer_LDFLAGS           := $(LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
test-timer_LDFLAGS           := $(LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
test-timer_LDFLAGS           := $(LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
    test-timer_LDFLAGS += -L
endif

#MM
test-timer-quick : test-timer

#MM test-timer : includes-generate-deps core-linklibs
test-timer : $(test-timer_EXES)

ifneq ($(filter $(TARGET),test-timer test-timer-quick),)

ifeq (,)
test-timer_MC_SRCWILDCARD := %
else
test-timer_MC_SRCWILDCARD := /%
endif

ifeq ($(test-timer_OBJDIR),)
test-timer_MC_TARGETS := $(addsuffix .o,$(test-timer_FILES))
test-timer_MC_DTARGETS := $(addsuffix .d,$(test-timer_FILES))
test-timer_MC_TGTWILDCARD := %
else
ifeq (no,no)
    test-timer_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-timer_OBJDIR)/,$(notdir $(test-timer_FILES))))
    test-timer_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-timer_OBJDIR)/,$(notdir $(test-timer_FILES))))
else
ifeq (,)
    test-timer_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-timer_OBJDIR)/,$(test-timer_FILES)))
    test-timer_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-timer_OBJDIR)/,$(test-timer_FILES)))
else
    test-timer_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-timer_OBJDIR)/,$(patsubst /%,%,$(test-timer_FILES))))
    test-timer_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-timer_OBJDIR)/,$(patsubst /%,%,$(test-timer_FILES))))
endif
endif
test-timer_MC_TGTWILDCARD := $(test-timer_OBJDIR)/%

# Be sure that all .c files are generated
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : | $(addsuffix .c,$(test-timer_FILES))

# Be sure that all .c files are found
test-timer_MC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
test-timer_MC_BASEDIRS := $(shell echo $(sort $(dir $(test-timer_FILES))) | sed 's/\(.\):\//\/\1\//g')
test-timer_MC_DIRS := $(foreach dir, $(test-timer_MC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(test-timer_MC_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(test-timer_MC_DIRS),)
    test-timer_MC_DIRS := $(shell echo $(test-timer_MC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.c $(test-timer_MC_DIRS)
endif

endif

test-timer_MC_CPPFLAGS := $(test-timer_CPPFLAGS)
test-timer_CFLAGS := $(test-timer_CFLAGS)
ifeq ($(test-timer_DFLAGS),)
  test-timer_DFLAGS := $(test-timer_CFLAGS)
else
  test-timer_DFLAGS := $(test-timer_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
test-timer_LINK ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
test-timer_STRIP ?= $(TARGET_STRIP)
test-timer_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : CMD:=$(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_MC_CPPFLAGS:=$(strip $(test-timer_MC_CPPFLAGS) $(test-timer_MC_EXTRA_CPPFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_CFLAGS:=$(strip $(test-timer_CFLAGS) $(SAFETY_CFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_DFLAGS:=$(test-timer_DFLAGS)
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_IQUOTE:=$(CFLAGS_IQUOTE)
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
test-timer_LINK ?= $(strip $(HOST_CC) $(HOST_LDFLAGS))
test-timer_STRIP ?= $(HOST_STRIP)
test-timer_ASSEMBLER ?= $(strip $HOST_CC) $(HOST_SYSROOT))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : CMD:=$(HOST_CC)
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_MC_CPPFLAGS:=$(strip $(HOST_MC_CPPFLAGS) $(test-timer_MC_CPPFLAGS) $(test-timer_MC_EXTRA_CPPFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_CFLAGS:=$(strip $(HOST_CFLAGS) $(test-timer_CFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_DFLAGS:=$(strip $(HOST_CFLAGS) $(test-timer_DFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_IQUOTE:=$(HOST_IQUOTE)
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
test-timer_LINK ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
test-timer_STRIP ?= $(ECHO) >/dev/null
test-timer_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(test-timer_MC_CPPFLAGS) $(test-timer_MC_EXTRA_CPPFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-timer_CFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-timer_DFLAGS))
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_IQUOTE:=$(KERNEL_IQUOTE)
$(test-timer_MC_TARGETS) $(test-timer_MC_DTARGETS) : test-timer_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(test-timer_MC_TARGETS) : CPPFLAGS := $(test-timer_MC_CPPFLAGS)
$(test-timer_MC_TARGETS) : CFLAGS := $(test-timer_CFLAGS)
$(test-timer_MC_TARGETS) : $(test-timer_MC_TGTWILDCARD).o : $(test-timer_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(test-timer_IQUOTE) $(dir $<) $(test-timer_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-timer_IQUOTE) . $(test-timer_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-timer_IQUOTE) $(dir $<) $(test-timer_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-timer_IQUOTE) . $(test-timer_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(test-timer_IQUOTE) $(dir $<) $(test-timer_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-timer_IQUOTE) . $(test-timer_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(test-timer_MC_DTARGETS) : $(test-timer_MC_TGTWILDCARD).d : $(test-timer_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-timer_DFLAGS) $(test-timer_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@


test-timer-link_EXTRA_LDFLAGS := 
test-timer-link_EXTRA_LIBS :=
ifeq (no,yes)
    test-timer-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    test-timer-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    test-timer-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
test-timer-link_DIRS := $(subst -L ,-L,$(strip $(test-timer_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-timer-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-timer-link_DIRS)))
# Add trailing /
test-timer-link_DIRS := $(subst //,/,$(addsuffix /,$(test-timer-link_DIRS)))
# Add normal linklib path
test-timer-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-timer-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-timer_LIBS) $(test-timer-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
test-timer-link_DEPLIBS := $(foreach lib,$(test-timer-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-timer-link_DIRS)))) \
)
test-timer-link_PROGS := $(addprefix $(test-timer_TARGETDIR)/,$(test-timer_FILES))

$(test-timer-link_PROGS) : OBJDIR := $(test-timer_OBJDIR)
$(test-timer-link_PROGS) : LDFLAGS := $(strip $(test-timer_LDFLAGS) $(test-timer-link_EXTRA_LDFLAGS))
$(test-timer-link_PROGS) : LIBS := $(addprefix -l,$(test-timer_LIBS) $(test-timer-link_EXTRA_LIBS) )
$(test-timer-link_PROGS) : $(test-timer_TARGETDIR)/% : $(test-timer_OBJDIR)/%.o $(test-timer-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-timer_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-timer_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-timer_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-timer_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-timer_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-timer_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-timer_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(test-timer_DEPS),)
  ifneq (test-timer test-timer-quick,)
    ifneq ($(findstring $(TARGET),test-timer test-timer-quick),)
      -include $(test-timer_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(test-timer_DEPS)
    endif
  endif
endif


ifneq ($(test-timer_DEPS) $(test-timer_OBJS) $(addprefix $(test-timer_TARGETDIR)/,$(test-timer_FILES)),)
$(test-timer_DEPS) $(test-timer_OBJS) $(addprefix $(test-timer_TARGETDIR)/,$(test-timer_FILES)) : | $(test-timer_TARGETDIR) $(test-timer_OBJDIR)
else
$(test-timer_DEPS) $(test-timer_OBJS) $(addprefix $(test-timer_TARGETDIR)/,$(test-timer_FILES)) :: $(test-timer_TARGETDIR) $(test-timer_OBJDIR)
endif

GLOB_MKDIRS += $(test-timer_TARGETDIR) $(test-timer_OBJDIR)


test-timer-clean : FILES := $(test-timer_OBJS) $(test-timer_EXES) $(test-timer_DEPS)
#MM
test-timer-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget test-timer"
	$(Q)$(RM) $(FILES)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
