else
$(test-dos_DEPS) $(test-dos_OBJS) $(addprefix $(test-dos_TARGETDIR)/,$(test-dos_FILES)) :: $(test-dos_TARGETDIR) $(test-dos_OBJDIR)
endif

GLOB_MKDIRS += $(test-dos_TARGETDIR) $(test-dos_OBJDIR)


test-dos-clean : FILES := $(test-dos_OBJS) $(test-dos_EXES) $(test-dos_DEPS)
#MM
test-dos-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget test-dos"
	$(Q)$(RM) $(FILES)



