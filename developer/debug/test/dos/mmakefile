	$(Q)$(IF) $(CMD) $(test-dos-pure_IQUOTE) $(dir $<) $(test-dos-pure_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-dos-pure_IQUOTE) . $(test-dos-pure_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-dos-pure_IQUOTE) $(dir $<) $(test-dos-pure_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-dos-pure_IQUOTE) . $(test-dos-pure_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
