	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-dos-pure_DFLAGS) $(test-dos-pure_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@


test-dos-pure-link_EXTRA_LDFLAGS := 
test-dos-pure-link_EXTRA_LIBS :=
ifeq (no,yes)
    test-dos-pure-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (no,no)
    test-dos-pure-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    test-dos-pure-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
test-dos-pure-link_DIRS := $(subst -L ,-L,$(strip $(test-dos-pure_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-dos-pure-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-dos-pure-link_DIRS)))
# Add trailing /
test-dos-pure-link_DIRS := $(subst //,/,$(addsuffix /,$(test-dos-pure-link_DIRS)))
# Add normal linklib path
test-dos-pure-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-dos-pure-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-dos-pure_LIBS) $(test-dos-pure-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
test-dos-pure-link_DEPLIBS := $(foreach lib,$(test-dos-pure-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-dos-pure-link_DIRS)))) \
)
test-dos-pure-link_PROGS := $(addprefix $(test-dos-pure_TARGETDIR)/,$(test-dos-pure_FILES))

$(test-dos-pure-link_PROGS) : OBJDIR := $(test-dos-pure_OBJDIR)
$(test-dos-pure-link_PROGS) : LDFLAGS := $(strip $(test-dos-pure_LDFLAGS) $(test-dos-pure-link_EXTRA_LDFLAGS))
$(test-dos-pure-link_PROGS) : LIBS := $(addprefix -l,$(test-dos-pure_LIBS) $(test-dos-pure-link_EXTRA_LIBS) )
$(test-dos-pure-link_PROGS) : $(test-dos-pure_TARGETDIR)/% : $(test-dos-pure_OBJDIR)/%.o $(test-dos-pure-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-dos-pure_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-dos-pure_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-dos-pure_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-dos-pure_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-dos-pure_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-dos-pure_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-dos-pure_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

