test-lowlevel-link_DIRS := $(subst //,/,$(addsuffix /,$(test-lowlevel-link_DIRS)))
# Add normal linklib path
test-lowlevel-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-lowlevel-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-lowlevel_LIBS) $(test-lowlevel-link_EXTRA_LIBS)))
ifeq (yes,yes)
    test-lowlevel-link_LIBS += startup.o
endif
ifeq (no,yes)
    test-lowlevel-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
test-lowlevel-link_DEPLIBS := $(foreach lib,$(test-lowlevel-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-lowlevel-link_DIRS)))) \
)

