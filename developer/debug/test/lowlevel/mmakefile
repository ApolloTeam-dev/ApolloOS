$(test-lowlevel_TARGETDIR)/$(test-lowlevel_PROGNAME) : $(test-lowlevel_OBJS) $(test-lowlevel_ARCHOBJS) $(USER_OBJS) $(test-lowlevel-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
