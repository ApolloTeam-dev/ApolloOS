define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(test-lowlevel_CXXCMD) $(test-lowlevel_CXXIQUOTE) $(dir $(2)) $(test-lowlevel_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-lowlevel_CXXIQUOTE) . $(test-lowlevel_CXXIQUOTE_END) $(strip $(test-lowlevel_CXXFLAGS) $(test-lowlevel_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(test-lowlevel_CXXCMD) $(test-lowlevel_CXXIQUOTE) $(dir $(2)) $(test-lowlevel_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-lowlevel_CXXIQUOTE) . $(test-lowlevel_CXXIQUOTE_END) $(strip $(test-lowlevel_CXXFLAGS) $(test-lowlevel_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(test-lowlevel_CXXCMD) $(test-lowlevel_CXXIQUOTE) $(dir $(2)) $(test-lowlevel_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-lowlevel_CXXIQUOTE) . $(test-lowlevel_CXXIQUOTE_END) $(strip $(test-lowlevel_CXXFLAGS) $(test-lowlevel_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(test-lowlevel_CXXCMD)" $(MKDEPEND) $(strip $(test-lowlevel_DXXFLAGS) $(test-lowlevel_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(test-lowlevel_OBJDIR),)
