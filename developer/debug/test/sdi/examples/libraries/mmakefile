	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-sdi-libraries-test_DFLAGS) $(test-sdi-libraries-test_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@


test-sdi-libraries-test-link_EXTRA_LDFLAGS := 
test-sdi-libraries-test-link_EXTRA_LIBS :=
ifeq (no,yes)
    test-sdi-libraries-test-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    test-sdi-libraries-test-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    test-sdi-libraries-test-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
test-sdi-libraries-test-link_DIRS := $(subst -L ,-L,$(strip $(test-sdi-libraries-test_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-sdi-libraries-test-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-sdi-libraries-test-link_DIRS)))
# Add trailing /
test-sdi-libraries-test-link_DIRS := $(subst //,/,$(addsuffix /,$(test-sdi-libraries-test-link_DIRS)))
# Add normal linklib path
test-sdi-libraries-test-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-sdi-libraries-test-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-sdi-libraries-test_LIBS) $(test-sdi-libraries-test-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
test-sdi-libraries-test-link_DEPLIBS := $(foreach lib,$(test-sdi-libraries-test-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-sdi-libraries-test-link_DIRS)))) \
)
test-sdi-libraries-test-link_PROGS := $(addprefix $(test-sdi-libraries-test_TARGETDIR)/,$(test-sdi-libraries-test_FILES))

$(test-sdi-libraries-test-link_PROGS) : OBJDIR := $(test-sdi-libraries-test_OBJDIR)
$(test-sdi-libraries-test-link_PROGS) : LDFLAGS := $(strip $(test-sdi-libraries-test_LDFLAGS) $(test-sdi-libraries-test-link_EXTRA_LDFLAGS))
$(test-sdi-libraries-test-link_PROGS) : LIBS := $(addprefix -l,$(test-sdi-libraries-test_LIBS) $(test-sdi-libraries-test-link_EXTRA_LIBS) )
$(test-sdi-libraries-test-link_PROGS) : $(test-sdi-libraries-test_TARGETDIR)/% : $(test-sdi-libraries-test_OBJDIR)/%.o $(test-sdi-libraries-test-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-sdi-libraries-test_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-sdi-libraries-test_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-sdi-libraries-test_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-sdi-libraries-test_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-sdi-libraries-test_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-sdi-libraries-test_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-sdi-libraries-test_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

