	$(Q)$(IF) $(CMD) $(test-sdi-libraries-library_IQUOTE) $(dir $<) $(test-sdi-libraries-library_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-sdi-libraries-library_IQUOTE) . $(test-sdi-libraries-library_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-sdi-libraries-library_IQUOTE) $(dir $<) $(test-sdi-libraries-library_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-sdi-libraries-library_IQUOTE) . $(test-sdi-libraries-library_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
