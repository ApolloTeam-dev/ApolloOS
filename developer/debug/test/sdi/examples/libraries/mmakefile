else
  $(foreach test-sdi-libraries-library_CXXFILE,$(test-sdi-libraries-library_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(OBJDIR)/,$(notdir $(basename $(test-sdi-libraries-library_CXXFILE)))),$(test-sdi-libraries-library_CXXFILE))))
