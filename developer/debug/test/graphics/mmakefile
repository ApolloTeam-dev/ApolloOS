include $(SRCDIR)/config/aros.cfg

FILES := \
    allocbitmap \
    areatest2 \
    blttemplatealpha \
    CGXTest \
    copper \
    getcybermapattr \
    gfx \
    gfxinfo \
    gfxtest \
    obtainpentest \
    readpixelarray \
    scalepixelarray \
    showvisregion \
    showvisshape \
    textbug \
    truecolorpens \
    weightamatch \
    writepixelarray \
    writepixelarrayalpha

EXEDIR := $(AROS_TESTS)/graphics

#MM- test : test-graphics
#MM- test-quick : test-graphics-quick

#MM test-graphics : includes linklibs


.PHONY : test-graphics

test-graphics_OBJDIR    := $(GENDIR)/$(CURDIR)
test-graphics_TARGETDIR := $(EXEDIR)
test-graphics_LIBS := 

test-graphics_FILES     := $(FILES)
test-graphics_OBJS      := $(addsuffix .o,$(addprefix $(test-graphics_OBJDIR)/,$(test-graphics_FILES)))
test-graphics_DEPS      := $(addsuffix .d,$(addprefix $(test-graphics_OBJDIR)/,$(test-graphics_FILES)))
test-graphics_EXES      := $(addprefix $(test-graphics_TARGETDIR)/,$(test-graphics_FILES))

test-graphics_CPPFLAGS := $(CPPFLAGS)
ifneq (,)
    test-graphics_CPPFLAGS += -I
endif
test-graphics_CFLAGS    := $(CFLAGS)
test-graphics_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
test-graphics_COVERAGE := yes
test-graphics_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
test-graphics_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
test-graphics_CFLAGS    := $(strip $(test-graphics_COVERAGEFLAGS) $(test-graphics_CFLAGS))
test-graphics_LIBS += $(test-graphics_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
test-graphics_FUNCINSTR := yes
test-graphics_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
test-graphics_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
test-graphics_CFLAGS    := $(strip $(test-graphics_INSTRFUNCFLAGS) $(test-graphics_CFLAGS))
test-graphics_LIBS += $(test-graphics_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
test-graphics_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(test-graphics_CFLAGS))
endif
endif
ifneq (,)
    test-graphics_DFLAGS := 
else
    test-graphics_DFLAGS := $(test-graphics_CFLAGS)
endif
ifeq (target,target)
test-graphics_LDFLAGS           := $(LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
test-graphics_LDFLAGS           := $(LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
test-graphics_LDFLAGS           := $(LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
    test-graphics_LDFLAGS += -L
endif

#MM
test-graphics-quick : test-graphics

#MM test-graphics : includes-generate-deps core-linklibs
test-graphics : $(test-graphics_EXES)

ifneq ($(filter $(TARGET),test-graphics test-graphics-quick),)

ifeq (,)
test-graphics_MC_SRCWILDCARD := %
else
test-graphics_MC_SRCWILDCARD := /%
endif

ifeq ($(test-graphics_OBJDIR),)
test-graphics_MC_TARGETS := $(addsuffix .o,$(test-graphics_FILES))
test-graphics_MC_DTARGETS := $(addsuffix .d,$(test-graphics_FILES))
test-graphics_MC_TGTWILDCARD := %
else
ifeq (no,no)
    test-graphics_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-graphics_OBJDIR)/,$(notdir $(test-graphics_FILES))))
    test-graphics_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-graphics_OBJDIR)/,$(notdir $(test-graphics_FILES))))
else
ifeq (,)
    test-graphics_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-graphics_OBJDIR)/,$(test-graphics_FILES)))
    test-graphics_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-graphics_OBJDIR)/,$(test-graphics_FILES)))
else
    test-graphics_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-graphics_OBJDIR)/,$(patsubst /%,%,$(test-graphics_FILES))))
    test-graphics_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-graphics_OBJDIR)/,$(patsubst /%,%,$(test-graphics_FILES))))
endif
endif
test-graphics_MC_TGTWILDCARD := $(test-graphics_OBJDIR)/%

# Be sure that all .c files are generated
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : | $(addsuffix .c,$(test-graphics_FILES))

# Be sure that all .c files are found
test-graphics_MC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
test-graphics_MC_BASEDIRS := $(shell echo $(sort $(dir $(test-graphics_FILES))) | sed 's/\(.\):\//\/\1\//g')
test-graphics_MC_DIRS := $(foreach dir, $(test-graphics_MC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(test-graphics_MC_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(test-graphics_MC_DIRS),)
    test-graphics_MC_DIRS := $(shell echo $(test-graphics_MC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.c $(test-graphics_MC_DIRS)
endif

endif

test-graphics_MC_CPPFLAGS := $(test-graphics_CPPFLAGS)
test-graphics_CFLAGS := $(test-graphics_CFLAGS)
ifeq ($(test-graphics_DFLAGS),)
  test-graphics_DFLAGS := $(test-graphics_CFLAGS)
else
  test-graphics_DFLAGS := $(test-graphics_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
test-graphics_LINK ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
test-graphics_STRIP ?= $(TARGET_STRIP)
test-graphics_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : CMD:=$(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_MC_CPPFLAGS:=$(strip $(test-graphics_MC_CPPFLAGS) $(test-graphics_MC_EXTRA_CPPFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_CFLAGS:=$(strip $(test-graphics_CFLAGS) $(SAFETY_CFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_DFLAGS:=$(test-graphics_DFLAGS)
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_IQUOTE:=$(CFLAGS_IQUOTE)
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
test-graphics_LINK ?= $(strip $(HOST_CC) $(HOST_LDFLAGS))
test-graphics_STRIP ?= $(HOST_STRIP)
test-graphics_ASSEMBLER ?= $(strip $HOST_CC) $(HOST_SYSROOT))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : CMD:=$(HOST_CC)
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_MC_CPPFLAGS:=$(strip $(HOST_MC_CPPFLAGS) $(test-graphics_MC_CPPFLAGS) $(test-graphics_MC_EXTRA_CPPFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_CFLAGS:=$(strip $(HOST_CFLAGS) $(test-graphics_CFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_DFLAGS:=$(strip $(HOST_CFLAGS) $(test-graphics_DFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_IQUOTE:=$(HOST_IQUOTE)
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
test-graphics_LINK ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
test-graphics_STRIP ?= $(ECHO) >/dev/null
test-graphics_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(test-graphics_MC_CPPFLAGS) $(test-graphics_MC_EXTRA_CPPFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-graphics_CFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-graphics_DFLAGS))
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_IQUOTE:=$(KERNEL_IQUOTE)
$(test-graphics_MC_TARGETS) $(test-graphics_MC_DTARGETS) : test-graphics_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(test-graphics_MC_TARGETS) : CPPFLAGS := $(test-graphics_MC_CPPFLAGS)
$(test-graphics_MC_TARGETS) : CFLAGS := $(test-graphics_CFLAGS)
$(test-graphics_MC_TARGETS) : $(test-graphics_MC_TGTWILDCARD).o : $(test-graphics_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(test-graphics_IQUOTE) $(dir $<) $(test-graphics_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-graphics_IQUOTE) . $(test-graphics_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-graphics_IQUOTE) $(dir $<) $(test-graphics_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-graphics_IQUOTE) . $(test-graphics_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(test-graphics_IQUOTE) $(dir $<) $(test-graphics_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-graphics_IQUOTE) . $(test-graphics_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(test-graphics_MC_DTARGETS) : $(test-graphics_MC_TGTWILDCARD).d : $(test-graphics_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-graphics_DFLAGS) $(test-graphics_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@


test-graphics-link_EXTRA_LDFLAGS := 
test-graphics-link_EXTRA_LIBS :=
ifeq (no,yes)
    test-graphics-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    test-graphics-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    test-graphics-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
test-graphics-link_DIRS := $(subst -L ,-L,$(strip $(test-graphics_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-graphics-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-graphics-link_DIRS)))
# Add trailing /
test-graphics-link_DIRS := $(subst //,/,$(addsuffix /,$(test-graphics-link_DIRS)))
# Add normal linklib path
test-graphics-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-graphics-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-graphics_LIBS) $(test-graphics-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
test-graphics-link_DEPLIBS := $(foreach lib,$(test-graphics-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-graphics-link_DIRS)))) \
)
test-graphics-link_PROGS := $(addprefix $(test-graphics_TARGETDIR)/,$(test-graphics_FILES))

$(test-graphics-link_PROGS) : OBJDIR := $(test-graphics_OBJDIR)
$(test-graphics-link_PROGS) : LDFLAGS := $(strip $(test-graphics_LDFLAGS) $(test-graphics-link_EXTRA_LDFLAGS))
$(test-graphics-link_PROGS) : LIBS := $(addprefix -l,$(test-graphics_LIBS) $(test-graphics-link_EXTRA_LIBS) )
$(test-graphics-link_PROGS) : $(test-graphics_TARGETDIR)/% : $(test-graphics_OBJDIR)/%.o $(test-graphics-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-graphics_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-graphics_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-graphics_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-graphics_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-graphics_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-graphics_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-graphics_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(test-graphics_DEPS),)
  ifneq (test-graphics test-graphics-quick,)
    ifneq ($(findstring $(TARGET),test-graphics test-graphics-quick),)
      -include $(test-graphics_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(test-graphics_DEPS)
    endif
  endif
endif


ifneq ($(test-graphics_DEPS) $(test-graphics_OBJS) $(addprefix $(test-graphics_TARGETDIR)/,$(test-graphics_FILES)),)
$(test-graphics_DEPS) $(test-graphics_OBJS) $(addprefix $(test-graphics_TARGETDIR)/,$(test-graphics_FILES)) : | $(test-graphics_TARGETDIR) $(test-graphics_OBJDIR)
else
$(test-graphics_DEPS) $(test-graphics_OBJS) $(addprefix $(test-graphics_TARGETDIR)/,$(test-graphics_FILES)) :: $(test-graphics_TARGETDIR) $(test-graphics_OBJDIR)
endif

GLOB_MKDIRS += $(test-graphics_TARGETDIR) $(test-graphics_OBJDIR)


test-graphics-clean : FILES := $(test-graphics_OBJS) $(test-graphics_EXES) $(test-graphics_DEPS)
#MM
test-graphics-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget test-graphics"
	$(Q)$(RM) $(FILES)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
