  $(test-freetype-lib-graph_MOBJC_TARGETS) $(test-freetype-lib-graph_MOBJC_DTARGETS) : test-freetype-lib-graph_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(test-freetype-lib-graph_MOBJC_CPPFLAGS) $(test-freetype-lib-graph_MOBJC_EXTRA_CPPFLAGS))
