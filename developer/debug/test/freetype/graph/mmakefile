define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(test-freetype-lib-graph_CXXCMD) $(test-freetype-lib-graph_CXXIQUOTE) $(dir $(2)) $(test-freetype-lib-graph_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-freetype-lib-graph_CXXIQUOTE) . $(test-freetype-lib-graph_CXXIQUOTE_END) $(strip $(test-freetype-lib-graph_CXXFLAGS) $(test-freetype-lib-graph_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(test-freetype-lib-graph_CXXCMD) $(test-freetype-lib-graph_CXXIQUOTE) $(dir $(2)) $(test-freetype-lib-graph_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-freetype-lib-graph_CXXIQUOTE) . $(test-freetype-lib-graph_CXXIQUOTE_END) $(strip $(test-freetype-lib-graph_CXXFLAGS) $(test-freetype-lib-graph_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(test-freetype-lib-graph_CXXCMD) $(test-freetype-lib-graph_CXXIQUOTE) $(dir $(2)) $(test-freetype-lib-graph_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-freetype-lib-graph_CXXIQUOTE) . $(test-freetype-lib-graph_CXXIQUOTE_END) $(strip $(test-freetype-lib-graph_CXXFLAGS) $(test-freetype-lib-graph_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(test-freetype-lib-graph_CXXCMD)" $(MKDEPEND) $(strip $(test-freetype-lib-graph_DXXFLAGS) $(test-freetype-lib-graph_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(test-freetype-lib-graph_OBJDIR),)
  $(foreach test-freetype-lib-graph_CXXFILE,$(test-freetype-lib-graph_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(test-freetype-lib-graph_CXXFILE))),$(test-freetype-lib-graph_CXXFILE))))
else
  $(foreach test-freetype-lib-graph_CXXFILE,$(test-freetype-lib-graph_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(test-freetype-lib-graph_OBJDIR)/,$(notdir $(basename $(test-freetype-lib-graph_CXXFILE)))),$(test-freetype-lib-graph_CXXFILE))))
