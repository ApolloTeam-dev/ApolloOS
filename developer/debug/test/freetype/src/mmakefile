  test-freetype-ftstring_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(test-freetype-ftstring_DXXFLAGS))
  test-freetype-ftstring_CXXIQUOTE:=$(KERNEL_IQUOTE)
  test-freetype-ftstring_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(test-freetype-ftstring_CXXCMD) $(test-freetype-ftstring_CXXIQUOTE) $(dir $(2)) $(test-freetype-ftstring_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-freetype-ftstring_CXXIQUOTE) . $(test-freetype-ftstring_CXXIQUOTE_END) $(strip $(test-freetype-ftstring_CXXFLAGS) $(test-freetype-ftstring_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(test-freetype-ftstring_CXXCMD) $(test-freetype-ftstring_CXXIQUOTE) $(dir $(2)) $(test-freetype-ftstring_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-freetype-ftstring_CXXIQUOTE) . $(test-freetype-ftstring_CXXIQUOTE_END) $(strip $(test-freetype-ftstring_CXXFLAGS) $(test-freetype-ftstring_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(test-freetype-ftstring_CXXCMD) $(test-freetype-ftstring_CXXIQUOTE) $(dir $(2)) $(test-freetype-ftstring_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-freetype-ftstring_CXXIQUOTE) . $(test-freetype-ftstring_CXXIQUOTE_END) $(strip $(test-freetype-ftstring_CXXFLAGS) $(test-freetype-ftstring_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(test-freetype-ftstring_CXXCMD)" $(MKDEPEND) $(strip $(test-freetype-ftstring_DXXFLAGS) $(test-freetype-ftstring_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(test-freetype-ftstring_OBJDIR),)
  $(foreach test-freetype-ftstring_CXXFILE,$(test-freetype-ftstring_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(test-freetype-ftstring_CXXFILE))),$(test-freetype-ftstring_CXXFILE))))
else
  $(foreach test-freetype-ftstring_CXXFILE,$(test-freetype-ftstring_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(test-freetype-ftstring_OBJDIR)/,$(notdir $(basename $(test-freetype-ftstring_CXXFILE)))),$(test-freetype-ftstring_CXXFILE))))
endif

endif


