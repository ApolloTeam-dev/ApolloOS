endif

ifeq ($(test-freetype-ftstring_OBJDIR),)
  test-freetype-ftstring_CXXTARGETS := $(notdir $(test-freetype-ftstring_CXXBASENAMES:=.o))
  test-freetype-ftstring_CXXDTARGETS := $(notdir $(test-freetype-ftstring_CXXBASENAMES:=.d))
  test-freetype-ftstring_MCXX_WILDCARD := %
else
  test-freetype-ftstring_CXXTARGETS := $(addprefix $(test-freetype-ftstring_OBJDIR)/,$(notdir $(test-freetype-ftstring_CXXBASENAMES:=.o)))
  test-freetype-ftstring_CXXDTARGETS := $(addprefix $(test-freetype-ftstring_OBJDIR)/,$(notdir $(test-freetype-ftstring_CXXBASENAMES:=.d)))
