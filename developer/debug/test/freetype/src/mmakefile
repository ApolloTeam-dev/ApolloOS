  test-freetype-ftstring_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(test-freetype-ftstring_MCXX_CPPFLAGS) $(test-freetype-ftstring_MCXX_EXTRA_CPPFLAGS))
