# Identify the "real" c++ files from the passed in basenames
test-freetype-ftstring_MCXX_FILES  := $(strip $(foreach test-freetype-ftstring_CXXBASE,$(test-freetype-ftstring_CXXABSBASENAMES), $(firstword $(wildcard $(foreach test-freetype-ftstring_EXT, $(AROS_CXXEXTS),$(addsuffix .$(test-freetype-ftstring_EXT),$(test-freetype-ftstring_CXXBASE)))))))

ifeq (,)
