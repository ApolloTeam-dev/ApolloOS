ifeq (target,target)
test-boot_LINK ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
test-boot_STRIP ?= $(TARGET_STRIP)
test-boot_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : CMD:=$(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_MC_CPPFLAGS:=$(strip $(test-boot_MC_CPPFLAGS) $(test-boot_MC_EXTRA_CPPFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_CFLAGS:=$(strip $(test-boot_CFLAGS) $(SAFETY_CFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_DFLAGS:=$(test-boot_DFLAGS)
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_IQUOTE:=$(CFLAGS_IQUOTE)
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
test-boot_LINK ?= $(strip $(HOST_CC) $(HOST_LDFLAGS))
test-boot_STRIP ?= $(HOST_STRIP)
test-boot_ASSEMBLER ?= $(strip $HOST_CC) $(HOST_SYSROOT))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : CMD:=$(HOST_CC)
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_MC_CPPFLAGS:=$(strip $(HOST_MC_CPPFLAGS) $(test-boot_MC_CPPFLAGS) $(test-boot_MC_EXTRA_CPPFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_CFLAGS:=$(strip $(HOST_CFLAGS) $(test-boot_CFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_DFLAGS:=$(strip $(HOST_CFLAGS) $(test-boot_DFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_IQUOTE:=$(HOST_IQUOTE)
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
test-boot_LINK ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
test-boot_STRIP ?= $(ECHO) >/dev/null
test-boot_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(test-boot_MC_CPPFLAGS) $(test-boot_MC_EXTRA_CPPFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-boot_CFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-boot_DFLAGS))
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_IQUOTE:=$(KERNEL_IQUOTE)
$(test-boot_MC_TARGETS) $(test-boot_MC_DTARGETS) : test-boot_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(test-boot_MC_TARGETS) : CPPFLAGS := $(test-boot_MC_CPPFLAGS)
$(test-boot_MC_TARGETS) : CFLAGS := $(test-boot_CFLAGS)
$(test-boot_MC_TARGETS) : $(test-boot_MC_TGTWILDCARD).o : $(test-boot_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(test-boot_IQUOTE) $(dir $<) $(test-boot_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_IQUOTE) . $(test-boot_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-boot_IQUOTE) $(dir $<) $(test-boot_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_IQUOTE) . $(test-boot_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(test-boot_IQUOTE) $(dir $<) $(test-boot_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_IQUOTE) . $(test-boot_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(test-boot_MC_DTARGETS) : $(test-boot_MC_TGTWILDCARD).d : $(test-boot_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-boot_DFLAGS) $(test-boot_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@

ifeq ($(test-boot_OBJDIR),)
test-boot-MA_TARGETS := $(addsuffix .o,$(test-boot_ASMFILES))
test-boot-MA_WILDCARD := %
else
test-boot-MA_TARGETS := $(addsuffix .o,$(addprefix $(test-boot_OBJDIR)/,$(notdir $(test-boot_ASMFILES))))
test-boot-MA_WILDCARD := $(test-boot_OBJDIR)/%

# Be sure that all .s files are generated
$(test-boot-MA_TARGETS) : | $(addsuffix .s,$(test-boot_ASMFILES))

# Be sure that all .c files are found
test-boot-MA_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
test-boot-MA_BASEDIRS := $(shell echo $(sort $(dir $(test-boot_ASMFILES))) | sed 's/\(.\):\//\/\1\//g')
test-boot-MA_DIRS := $(foreach dir, $(test-boot-MA_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(test-boot-MA_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(test-boot-MA_DIRS),)
    test-boot-MA_DIRS := $(shell echo $(test-boot-MA_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.s $(test-boot-MA_DIRS)
endif

endif

test-boot-MA_ASSEMBLER ?= $(test-boot_ASSEMBLER)

$(test-boot-MA_TARGETS) : test-boot-MA_CMD:= $(test-boot-MA_ASSEMBLER)

$(test-boot-MA_TARGETS) : CPPFLAGS := $(test-boot_CPPFLAGS)
$(test-boot-MA_TARGETS) : AFLAGS := $(test-boot_AFLAGS)
$(test-boot-MA_TARGETS) : $(test-boot-MA_WILDCARD).o : %.s
	$(Q)$(ECHO) "Assembling $(notdir $<)..."
	$(Q)$(IF) $(test-boot-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(notdir $<): $(test-boot-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@" >> $(GENDIR)/errors ; \
			$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Assemble failed: $(test-boot-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi


test-boot-link_EXTRA_LDFLAGS := 
test-boot-link_EXTRA_LIBS :=
ifeq (no,yes)
    test-boot-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (no,no)
    test-boot-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    test-boot-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files this program depends on.
# In LDFLAGS remove white space between -L and directory
test-boot-link_DIRS := $(subst -L ,-L,$(strip $(test-boot_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-boot-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-boot-link_DIRS)))
# Add trailing /
test-boot-link_DIRS := $(subst //,/,$(addsuffix /,$(test-boot-link_DIRS)))
# Add normal linklib path
test-boot-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-boot-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-boot_LIBS) $(test-boot-link_EXTRA_LIBS)))
ifeq (no,yes)
    test-boot-link_LIBS += startup.o
endif
ifeq (no,yes)
    test-boot-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
test-boot-link_DEPLIBS := $(foreach lib,$(test-boot-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-boot-link_DIRS)))) \
)

$(test-boot_TARGETDIR)/$(test-boot_PROGNAME) : OBJDIR := $(test-boot_OBJDIR)
$(test-boot_TARGETDIR)/$(test-boot_PROGNAME) : OBJS := $(test-boot_OBJS) $(test-boot_ARCHOBJS) $(USER_OBJS)
$(test-boot_TARGETDIR)/$(test-boot_PROGNAME) : LDFLAGS := $(strip $(test-boot_LDFLAGS) $(test-boot-link_EXTRA_LDFLAGS))
$(test-boot_TARGETDIR)/$(test-boot_PROGNAME) : LIBS := $(addprefix -l,$(test-boot_LIBS) $(test-boot-link_EXTRA_LIBS) )
$(test-boot_TARGETDIR)/$(test-boot_PROGNAME) : $(test-boot_OBJS) $(test-boot_ARCHOBJS) $(USER_OBJS) $(test-boot-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-boot_LINK) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-boot_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-boot_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-boot_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-boot_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-boot_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-boot_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(test-boot_DEPS),)
  ifneq (test-boot test-boot-quick,)
    ifneq ($(findstring $(TARGET),test-boot test-boot-quick),)
      -include $(test-boot_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(test-boot_DEPS)
    endif
  endif
endif


ifneq ($(test-boot_OBJS) $(test-boot_DEPS) $(test-boot_TARGETDIR)/$(test-boot_PROGNAME),)
$(test-boot_OBJS) $(test-boot_DEPS) $(test-boot_TARGETDIR)/$(test-boot_PROGNAME) : | $(test-boot_OBJDIR) $(test-boot_TARGETDIR)
else
$(test-boot_OBJS) $(test-boot_DEPS) $(test-boot_TARGETDIR)/$(test-boot_PROGNAME) :: $(test-boot_OBJDIR) $(test-boot_TARGETDIR)
endif

GLOB_MKDIRS += $(test-boot_OBJDIR) $(test-boot_TARGETDIR)


test-boot-clean : FILES := $(test-boot_OBJS) $(test-boot_TARGETDIR)/$(test-boot_PROGNAME) $(test-boot_DEPS)
