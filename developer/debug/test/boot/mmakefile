include $(SRCDIR)/config/aros.cfg

FILES  := testboot
EXEDIR := $(AROS_TESTS)/boot

USER_CFLAGS  := -isystem $(SRCDIR)/arch/all-native/bootconsole/include
USER_LDFLAGS := -L $(GENDIR)/lib

#MM test-boot : linklibs-bootconsole


.PHONY : test-boot

test-boot_PROGNAME  := testboot
test-boot_OBJDIR    := $(GENDIR)/$(CURDIR)
test-boot_TARGETDIR := $(EXEDIR)
test-boot_LINKER    := 
test-boot_LIBS := bootconsole
# If not supplied, linker is equal to compiler
ifeq ($(test-boot_LINKER),)
    test-boot_LINKER := target
endif

ifneq ("$(strip $(FILES)   )","")
    test-boot_FILES     := $(FILES)
    test-boot_OBJCFILES := 
    test-boot_ASMFILES  := 
    test-boot_CXXFILES := 
else
    test-boot_FILES     := $(test-boot_PROGNAME)
    test-boot_OBJCFILES :=
    test-boot_ASMFILES  :=
    test-boot_CXXFILES :=
endif

test-boot_ARCHOBJS   := $(wildcard $(test-boot_OBJDIR)/arch/*.o)
test-boot_ARCHFILES  := $(basename $(notdir $(test-boot_ARCHOBJS)))
test-boot_C_NARCHFILES := $(filter-out $(test-boot_ARCHFILES),$(test-boot_FILES))
test-boot_CXX_NARCHFILES := $(filter-out $(test-boot_ARCHFILES),$(test-boot_CXXFILES))
test-boot_OBJC_NARCHFILES := $(filter-out $(test-boot_ARCHFILES),$(test-boot_OBJCFILES))

TMP_FILES := $(test-boot_C_NARCHFILES) $(test-boot_CXX_NARCHFILES) $(test-boot_ASMFILES) $(test-boot_OBJC_NARCHFILES)
test-boot_OBJS := $(addsuffix .o,$(addprefix $(test-boot_OBJDIR)/,$(notdir $(TMP_FILES))))
test-boot_DEPS := $(addsuffix .d,$(addprefix $(test-boot_OBJDIR)/,$(notdir $(TMP_FILES))))

test-boot_CPPFLAGS :=  $(CPPFLAGS)
ifneq (,)
test-boot_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (target,target)
test-boot_CFLAGS            := $(CFLAGS)
endif
ifeq (target,host)
test-boot_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
test-boot_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
test-boot_CFLAGS            := 
endif

ifeq ("","")
ifeq (target,target)
test-boot_CXXFLAGS            := $(CXXFLAGS)
endif
ifeq (target,host)
test-boot_CXXFLAGS            := $(HOST_CXXFLAGS)
endif
ifeq (target,kernel)
test-boot_CXXFLAGS            := $(strip $(KERNEL_ISA_CXXFLAGS) $(KERNEL_CXXFLAGS))
endif
else
test-boot_CXXFLAGS          := 
endif

ifeq ("","")
ifeq (target,target)
test-boot_LDFLAGS            := $(LDFLAGS)
endif
ifeq (target,host)
test-boot_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (target,kernel)
test-boot_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
test-boot_LDFLAGS          := 
endif

test-boot_COVERAGE := no
ifeq (target,target)
ifeq (no,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
test-boot_COVERAGE := yes
test-boot_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
test-boot_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
test-boot_CFLAGS    := $(strip $(test-boot_COVERAGEFLAGS) $(test-boot_CFLAGS))
test-boot_CXXFLAGS := $(strip $(test-boot_COVERAGEFLAGS) $(test-boot_CXXFLAGS))
test-boot_LIBS += $(test-boot_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
test-boot_FUNCINSTR := yes
test-boot_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
test-boot_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
test-boot_CFLAGS    := $(strip $(test-boot_INSTRFUNCFLAGS) $(test-boot_CFLAGS))
test-boot_CXXFLAGS := $(strip $(test-boot_INSTRFUNCFLAGS) $(test-boot_CXXFLAGS))
test-boot_LIBS += $(test-boot_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
test-boot_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(test-boot_CFLAGS))
test-boot_CXXFLAGS := $(strip $(LTO_BINARY_CFLAGS) $(test-boot_CXXFLAGS))
endif
endif
test-boot_AFLAGS    := $(AFLAGS)
ifneq (,)
    test-boot_DFLAGS     := 
else
    test-boot_DFLAGS     := $(test-boot_CFLAGS)
endif
ifneq (,)
    test-boot_DXXFLAGS     := 
else
    test-boot_DXXFLAGS     := $(test-boot_CXXFLAGS)
endif
ifeq (target,target)
test-boot_LDFLAGS           := $(test-boot_LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
test-boot_LDFLAGS           := $(test-boot_LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
test-boot_LDFLAGS           := $(test-boot_LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
test-boot_LDFLAGS   += -L
endif

#MM
test-boot-quick : test-boot

#MM test-boot : includes-generate-deps core-linklibs
test-boot : $(test-boot_TARGETDIR)/$(test-boot_PROGNAME)

ifneq ($(filter $(TARGET),test-boot test-boot-quick test-boot-gz-quick),)

test-boot_CXXABSBASENAMES := $(foreach test-boot_CXXBASE,$(test-boot_CXX_NARCHFILES),$(if $(filter /%,$(test-boot_CXXBASE)),$(test-boot_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(test-boot_CXXBASE))))

ifneq ($(test-boot_CXXABSBASENAMES),)

test-boot_CXXBASENAMES := $(basename $(test-boot_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
test-boot_MCXX_FILES  := $(strip $(foreach test-boot_CXXBASE,$(test-boot_CXXABSBASENAMES), $(firstword $(wildcard $(foreach test-boot_EXT, $(AROS_CXXEXTS),$(addsuffix .$(test-boot_EXT),$(test-boot_CXXBASE)))))))

ifeq (,)
test-boot_MCXX_SRCWILDCARD := %
else
test-boot_MCXX_SRCWILDCARD := /%
endif

ifeq ($(test-boot_OBJDIR),)
  test-boot_CXXTARGETS := $(notdir $(test-boot_CXXBASENAMES:=.o))
  test-boot_CXXDTARGETS := $(notdir $(test-boot_CXXBASENAMES:=.d))
  test-boot_MCXX_WILDCARD := %
else
  test-boot_CXXTARGETS := $(addprefix $(test-boot_OBJDIR)/,$(notdir $(test-boot_CXXBASENAMES:=.o)))
  test-boot_CXXDTARGETS := $(addprefix $(test-boot_OBJDIR)/,$(notdir $(test-boot_CXXBASENAMES:=.d)))
  test-boot_MCXX_WILDCARD := $(test-boot_OBJDIR)/%

  # Be sure that all source files are generated
  $(test-boot_CXXTARGETS) $(test-boot_CXXDTARGETS) : | $(test-boot_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
test-boot_MCXX_CPPFLAGS := $(test-boot_CPPFLAGS)
test-boot_CXXFLAGS := $(test-boot_CXXFLAGS)
ifeq ($(test-boot_DXXFLAGS),)
  test-boot_DXXFLAGS := $(test-boot_CXXFLAGS)
else
  test-boot_DXXFLAGS := $(test-boot_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  test-boot_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  test-boot_STRIP ?= $(HOST_STRIP)
  test-boot_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  test-boot_CXXCMD:=$(HOST_CXX)
  test-boot_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(test-boot_MCXX_CPPFLAGS) $(test-boot_MCXX_EXTRA_CPPFLAGS))
  test-boot_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(test-boot_CXXFLAGS))
  test-boot_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(test-boot_DXXFLAGS))
  test-boot_CXXIQUOTE:=$(HOST_IQUOTE)
  test-boot_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  test-boot_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  test-boot_STRIP ?= $(TARGET_STRIP)
  test-boot_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  test-boot_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  test-boot_MCXX_CPPFLAGS := $(strip $(test-boot_MCXX_CPPFLAGS) $(test-boot_MCXX_EXTRA_CPPFLAGS))
  test-boot_CXXFLAGS := $(strip $(test-boot_CXXFLAGS) $(SAFETY_CFLAGS))
  test-boot_DXXFLAGS := $(test-boot_DXXFLAGS)
  test-boot_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  test-boot_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  test-boot_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  test-boot_STRIP ?= $(ECHO) >/dev/null
  test-boot_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  test-boot_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  test-boot_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(test-boot_MCXX_CPPFLAGS) $(test-boot_MCXX_EXTRA_CPPFLAGS))
  test-boot_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(test-boot_CXXFLAGS))
  test-boot_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(test-boot_DXXFLAGS))
  test-boot_CXXIQUOTE:=$(KERNEL_IQUOTE)
  test-boot_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(test-boot_CXXCMD) $(test-boot_CXXIQUOTE) $(dir $(2)) $(test-boot_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_CXXIQUOTE) . $(test-boot_CXXIQUOTE_END) $(strip $(test-boot_CXXFLAGS) $(test-boot_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(test-boot_CXXCMD) $(test-boot_CXXIQUOTE) $(dir $(2)) $(test-boot_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_CXXIQUOTE) . $(test-boot_CXXIQUOTE_END) $(strip $(test-boot_CXXFLAGS) $(test-boot_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(test-boot_CXXCMD) $(test-boot_CXXIQUOTE) $(dir $(2)) $(test-boot_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_CXXIQUOTE) . $(test-boot_CXXIQUOTE_END) $(strip $(test-boot_CXXFLAGS) $(test-boot_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(test-boot_CXXCMD)" $(MKDEPEND) $(strip $(test-boot_DXXFLAGS) $(test-boot_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(test-boot_OBJDIR),)
  $(foreach test-boot_CXXFILE,$(test-boot_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(test-boot_CXXFILE))),$(test-boot_CXXFILE))))
else
  $(foreach test-boot_CXXFILE,$(test-boot_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(test-boot_OBJDIR)/,$(notdir $(basename $(test-boot_CXXFILE)))),$(test-boot_CXXFILE))))
endif

endif


ifneq ($(test-boot_OBJC_NARCHFILES),)

ifeq (,)
test-boot_MOBJC_SRCWILDCARD := %
else
test-boot_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(test-boot_OBJDIR),)
  test-boot_MOBJC_TARGETS := $(addsuffix .o,$(test-boot_OBJC_NARCHFILES))
  test-boot_MOBJC_DTARGETS := $(addsuffix .d,$(test-boot_OBJC_NARCHFILES))
  test-boot_MOBJC_WILDCARD := %
else
  test-boot_MOBJC_TARGETS := $(addsuffix .o,$(addprefix $(test-boot_OBJDIR)/,$(test-boot_OBJC_NARCHFILES)))
  test-boot_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(test-boot_OBJDIR)/,$(test-boot_OBJC_NARCHFILES)))
  test-boot_MOBJC_WILDCARD := $(test-boot_OBJDIR)/%

  # Be sure that all .m files are generated
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : | $(addsuffix .m,$(test-boot_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  test-boot_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  test-boot_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(test-boot_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  test-boot_MOBJC_DIRS := $(foreach dir, $(test-boot_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(test-boot_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(test-boot_MOBJC_DIRS),)
    test-boot_MOBJC_DIRS := $(shell echo $(test-boot_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(test-boot_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  test-boot_CC := $(TARGET_CC)
else
  test-boot_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
