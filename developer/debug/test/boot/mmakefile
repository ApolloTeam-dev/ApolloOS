ifeq (,)
    test-boot_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-boot_OBJDIR)/,$(test-boot_C_NARCHFILES)))
    test-boot_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-boot_OBJDIR)/,$(test-boot_C_NARCHFILES)))
