ifeq ($(test-boot_DFLAGS),)
  test-boot_OBJCDFLAGS := $(test-boot_CFLAGS)
else
  test-boot_OBJCDFLAGS := $(test-boot_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  test-boot_LINK ?= $(strip $(test-boot_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  test-boot_STRIP ?= $(TARGET_STRIP)
  test-boot_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : CMD:=$(strip $(test-boot_CC) $(TARGET_SYSROOT))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_MOBJC_CPPFLAGS:=$(strip $(test-boot_MOBJC_CPPFLAGS) $(test-boot_MOBJC_EXTRA_CPPFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_OBJCFLAGS:=$(strip $(test-boot_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_OBJCDFLAGS:=$(test-boot_OBJCDFLAGS)
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_IQUOTE:=$(CFLAGS_IQUOTE)
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  test-boot_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  test-boot_STRIP ?= $(HOST_STRIP)
  test-boot_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(test-boot_MOBJC_CPPFLAGS) $(test-boot_MOBJC_EXTRA_CPPFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(test-boot_OBJCFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(test-boot_OBJCDFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_IQUOTE:=$(HOST_IQUOTE)
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  test-boot_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  test-boot_STRIP ?= $(ECHO) >/dev/null
  test-boot_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(test-boot_MOBJC_CPPFLAGS) $(test-boot_MOBJC_EXTRA_CPPFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-boot_OBJCFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-boot_OBJCDFLAGS))
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_IQUOTE:=$(KERNEL_IQUOTE)
  $(test-boot_MOBJC_TARGETS) $(test-boot_MOBJC_DTARGETS) : test-boot_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(test-boot_MOBJC_TARGETS) : CPPFLAGS := $(test-boot_MOBJC_CPPFLAGS)
$(test-boot_MOBJC_TARGETS) : CFLAGS := $(test-boot_OBJCFLAGS)
$(test-boot_MOBJC_TARGETS) : $(test-boot_MOBJC_WILDCARD).o : $(test-boot_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(test-boot_IQUOTE) $(dir $<) $(test-boot_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_IQUOTE) . $(test-boot_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-boot_IQUOTE) $(dir $<) $(test-boot_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_IQUOTE) . $(test-boot_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(test-boot_IQUOTE) $(dir $<) $(test-boot_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-boot_IQUOTE) . $(test-boot_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(test-boot_MOBJC_DTARGETS) : $(test-boot_MOBJC_WILDCARD).d : $(test-boot_MOBJC_SRCWILDCARD).m
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-boot_OBJCDFLAGS) $(test-boot_MOBJC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@

