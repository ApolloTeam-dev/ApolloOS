define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(test-library-peropenertest_CXXCMD) $(test-library-peropenertest_CXXIQUOTE) $(dir $(2)) $(test-library-peropenertest_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-library-peropenertest_CXXIQUOTE) . $(test-library-peropenertest_CXXIQUOTE_END) $(strip $(test-library-peropenertest_CXXFLAGS) $(test-library-peropenertest_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(test-library-peropenertest_CXXCMD) $(test-library-peropenertest_CXXIQUOTE) $(dir $(2)) $(test-library-peropenertest_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-library-peropenertest_CXXIQUOTE) . $(test-library-peropenertest_CXXIQUOTE_END) $(strip $(test-library-peropenertest_CXXFLAGS) $(test-library-peropenertest_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(test-library-peropenertest_CXXCMD) $(test-library-peropenertest_CXXIQUOTE) $(dir $(2)) $(test-library-peropenertest_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-library-peropenertest_CXXIQUOTE) . $(test-library-peropenertest_CXXIQUOTE_END) $(strip $(test-library-peropenertest_CXXFLAGS) $(test-library-peropenertest_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(test-library-peropenertest_CXXCMD)" $(MKDEPEND) $(strip $(test-library-peropenertest_DXXFLAGS) $(test-library-peropenertest_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(test-library-peropenertest_OBJDIR),)
  $(foreach test-library-peropenertest_CXXFILE,$(test-library-peropenertest_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(test-library-peropenertest_CXXFILE))),$(test-library-peropenertest_CXXFILE))))
else
