$(test-exec-private_MC_TARGETS) : $(test-exec-private_MC_TGTWILDCARD).o : $(test-exec-private_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(test-exec-private_IQUOTE) $(dir $<) $(test-exec-private_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-exec-private_IQUOTE) . $(test-exec-private_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-exec-private_IQUOTE) $(dir $<) $(test-exec-private_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-exec-private_IQUOTE) . $(test-exec-private_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(test-exec-private_IQUOTE) $(dir $<) $(test-exec-private_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-exec-private_IQUOTE) . $(test-exec-private_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(test-exec-private_MC_DTARGETS) : $(test-exec-private_MC_TGTWILDCARD).d : $(test-exec-private_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-exec-private_DFLAGS) $(test-exec-private_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@


test-exec-private-link_EXTRA_LDFLAGS := 
test-exec-private-link_EXTRA_LIBS :=
ifeq (no,yes)
    test-exec-private-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    test-exec-private-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    test-exec-private-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
test-exec-private-link_DIRS := $(subst -L ,-L,$(strip $(test-exec-private_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-exec-private-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-exec-private-link_DIRS)))
# Add trailing /
test-exec-private-link_DIRS := $(subst //,/,$(addsuffix /,$(test-exec-private-link_DIRS)))
# Add normal linklib path
test-exec-private-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-exec-private-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-exec-private_LIBS) $(test-exec-private-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
test-exec-private-link_DEPLIBS := $(foreach lib,$(test-exec-private-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-exec-private-link_DIRS)))) \
)
test-exec-private-link_PROGS := $(addprefix $(test-exec-private_TARGETDIR)/,$(test-exec-private_FILES))

$(test-exec-private-link_PROGS) : OBJDIR := $(test-exec-private_OBJDIR)
$(test-exec-private-link_PROGS) : LDFLAGS := $(strip $(test-exec-private_LDFLAGS) $(test-exec-private-link_EXTRA_LDFLAGS))
$(test-exec-private-link_PROGS) : LIBS := $(addprefix -l,$(test-exec-private_LIBS) $(test-exec-private-link_EXTRA_LIBS) )
$(test-exec-private-link_PROGS) : $(test-exec-private_TARGETDIR)/% : $(test-exec-private_OBJDIR)/%.o $(test-exec-private-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-exec-private_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-exec-private_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-exec-private_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-exec-private_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-exec-private_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-exec-private_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-exec-private_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

