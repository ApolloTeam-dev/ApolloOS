test-crt-posixc-general_LIBS := 

test-crt-posixc-general_FILES     := $(POSIXCTESTFILES)
test-crt-posixc-general_OBJS      := $(addsuffix .o,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(test-crt-posixc-general_FILES)))
test-crt-posixc-general_DEPS      := $(addsuffix .d,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(test-crt-posixc-general_FILES)))
