test-crt-posixc-general_MC_TGTWILDCARD := %
else
ifeq (no,no)
    test-crt-posixc-general_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(notdir $(test-crt-posixc-general_FILES))))
    test-crt-posixc-general_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(notdir $(test-crt-posixc-general_FILES))))
else
ifeq (,)
    test-crt-posixc-general_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(test-crt-posixc-general_FILES)))
    test-crt-posixc-general_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(test-crt-posixc-general_FILES)))
else
    test-crt-posixc-general_MC_TARGETS := $(addsuffix .o,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(patsubst /%,%,$(test-crt-posixc-general_FILES))))
    test-crt-posixc-general_MC_DTARGETS := $(addsuffix .d,$(addprefix $(test-crt-posixc-general_OBJDIR)/,$(patsubst /%,%,$(test-crt-posixc-general_FILES))))
