    test-crt-posixc-general_CPPFLAGS += -I
endif
test-crt-posixc-general_CFLAGS    := $(CFLAGS)
test-crt-posixc-general_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
test-crt-posixc-general_COVERAGE := yes
test-crt-posixc-general_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
test-crt-posixc-general_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
