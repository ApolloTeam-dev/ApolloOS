endif
ifeq (no,yes)
    test-crt-posixc-nix-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
test-crt-posixc-nix-link_DIRS := $(subst -L ,-L,$(strip $(test-crt-posixc-nix_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-crt-posixc-nix-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-crt-posixc-nix-link_DIRS)))
# Add trailing /
test-crt-posixc-nix-link_DIRS := $(subst //,/,$(addsuffix /,$(test-crt-posixc-nix-link_DIRS)))
# Add normal linklib path
test-crt-posixc-nix-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-crt-posixc-nix-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-crt-posixc-nix_LIBS) $(test-crt-posixc-nix-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
test-crt-posixc-nix-link_DEPLIBS := $(foreach lib,$(test-crt-posixc-nix-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-crt-posixc-nix-link_DIRS)))) \
)
test-crt-posixc-nix-link_PROGS := $(addprefix $(test-crt-posixc-nix_TARGETDIR)/,$(test-crt-posixc-nix_FILES))

$(test-crt-posixc-nix-link_PROGS) : OBJDIR := $(test-crt-posixc-nix_OBJDIR)
$(test-crt-posixc-nix-link_PROGS) : LDFLAGS := $(strip $(test-crt-posixc-nix_LDFLAGS) $(test-crt-posixc-nix-link_EXTRA_LDFLAGS))
$(test-crt-posixc-nix-link_PROGS) : LIBS := $(addprefix -l,$(test-crt-posixc-nix_LIBS) $(test-crt-posixc-nix-link_EXTRA_LIBS) )
$(test-crt-posixc-nix-link_PROGS) : $(test-crt-posixc-nix_TARGETDIR)/% : $(test-crt-posixc-nix_OBJDIR)/%.o $(test-crt-posixc-nix-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-crt-posixc-nix_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-crt-posixc-nix_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-crt-posixc-nix_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-crt-posixc-nix_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-crt-posixc-nix_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-crt-posixc-nix_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-crt-posixc-nix_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

