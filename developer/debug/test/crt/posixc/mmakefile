endif
test-crt-posixc-general_MC_TGTWILDCARD := $(test-crt-posixc-general_OBJDIR)/%

# Be sure that all .c files are generated
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : | $(addsuffix .c,$(test-crt-posixc-general_FILES))

# Be sure that all .c files are found
test-crt-posixc-general_MC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
test-crt-posixc-general_MC_BASEDIRS := $(shell echo $(sort $(dir $(test-crt-posixc-general_FILES))) | sed 's/\(.\):\//\/\1\//g')
test-crt-posixc-general_MC_DIRS := $(foreach dir, $(test-crt-posixc-general_MC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(test-crt-posixc-general_MC_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(test-crt-posixc-general_MC_DIRS),)
    test-crt-posixc-general_MC_DIRS := $(shell echo $(test-crt-posixc-general_MC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.c $(test-crt-posixc-general_MC_DIRS)
endif

endif

test-crt-posixc-general_MC_CPPFLAGS := $(test-crt-posixc-general_CPPFLAGS)
test-crt-posixc-general_CFLAGS := $(test-crt-posixc-general_CFLAGS)
ifeq ($(test-crt-posixc-general_DFLAGS),)
  test-crt-posixc-general_DFLAGS := $(test-crt-posixc-general_CFLAGS)
else
  test-crt-posixc-general_DFLAGS := $(test-crt-posixc-general_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
test-crt-posixc-general_LINK ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
test-crt-posixc-general_STRIP ?= $(TARGET_STRIP)
test-crt-posixc-general_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : CMD:=$(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_MC_CPPFLAGS:=$(strip $(test-crt-posixc-general_MC_CPPFLAGS) $(test-crt-posixc-general_MC_EXTRA_CPPFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_CFLAGS:=$(strip $(test-crt-posixc-general_CFLAGS) $(SAFETY_CFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_DFLAGS:=$(test-crt-posixc-general_DFLAGS)
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_IQUOTE:=$(CFLAGS_IQUOTE)
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
test-crt-posixc-general_LINK ?= $(strip $(HOST_CC) $(HOST_LDFLAGS))
test-crt-posixc-general_STRIP ?= $(HOST_STRIP)
test-crt-posixc-general_ASSEMBLER ?= $(strip $HOST_CC) $(HOST_SYSROOT))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : CMD:=$(HOST_CC)
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_MC_CPPFLAGS:=$(strip $(HOST_MC_CPPFLAGS) $(test-crt-posixc-general_MC_CPPFLAGS) $(test-crt-posixc-general_MC_EXTRA_CPPFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_CFLAGS:=$(strip $(HOST_CFLAGS) $(test-crt-posixc-general_CFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_DFLAGS:=$(strip $(HOST_CFLAGS) $(test-crt-posixc-general_DFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_IQUOTE:=$(HOST_IQUOTE)
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
test-crt-posixc-general_LINK ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
test-crt-posixc-general_STRIP ?= $(ECHO) >/dev/null
test-crt-posixc-general_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(test-crt-posixc-general_MC_CPPFLAGS) $(test-crt-posixc-general_MC_EXTRA_CPPFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-crt-posixc-general_CFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(test-crt-posixc-general_DFLAGS))
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_IQUOTE:=$(KERNEL_IQUOTE)
$(test-crt-posixc-general_MC_TARGETS) $(test-crt-posixc-general_MC_DTARGETS) : test-crt-posixc-general_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(test-crt-posixc-general_MC_TARGETS) : CPPFLAGS := $(test-crt-posixc-general_MC_CPPFLAGS)
$(test-crt-posixc-general_MC_TARGETS) : CFLAGS := $(test-crt-posixc-general_CFLAGS)
$(test-crt-posixc-general_MC_TARGETS) : $(test-crt-posixc-general_MC_TGTWILDCARD).o : $(test-crt-posixc-general_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(test-crt-posixc-general_IQUOTE) $(dir $<) $(test-crt-posixc-general_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-crt-posixc-general_IQUOTE) . $(test-crt-posixc-general_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(test-crt-posixc-general_IQUOTE) $(dir $<) $(test-crt-posixc-general_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-crt-posixc-general_IQUOTE) . $(test-crt-posixc-general_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(test-crt-posixc-general_IQUOTE) $(dir $<) $(test-crt-posixc-general_IQUOTE) $(SRCDIR)/$(CURDIR) $(test-crt-posixc-general_IQUOTE) . $(test-crt-posixc-general_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(test-crt-posixc-general_MC_DTARGETS) : $(test-crt-posixc-general_MC_TGTWILDCARD).d : $(test-crt-posixc-general_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(test-crt-posixc-general_DFLAGS) $(test-crt-posixc-general_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@


test-crt-posixc-general-link_EXTRA_LDFLAGS := 
test-crt-posixc-general-link_EXTRA_LIBS :=
ifeq (no,yes)
    test-crt-posixc-general-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    test-crt-posixc-general-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    test-crt-posixc-general-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
test-crt-posixc-general-link_DIRS := $(subst -L ,-L,$(strip $(test-crt-posixc-general_LDFLAGS)))
# Filter out only the libdirs and remove -L
test-crt-posixc-general-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(test-crt-posixc-general-link_DIRS)))
# Add trailing /
test-crt-posixc-general-link_DIRS := $(subst //,/,$(addsuffix /,$(test-crt-posixc-general-link_DIRS)))
# Add normal linklib path
test-crt-posixc-general-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
test-crt-posixc-general-link_LIBS := $(addprefix lib,$(addsuffix .a,$(test-crt-posixc-general_LIBS) $(test-crt-posixc-general-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
test-crt-posixc-general-link_DEPLIBS := $(foreach lib,$(test-crt-posixc-general-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(test-crt-posixc-general-link_DIRS)))) \
)
test-crt-posixc-general-link_PROGS := $(addprefix $(test-crt-posixc-general_TARGETDIR)/,$(test-crt-posixc-general_FILES))

$(test-crt-posixc-general-link_PROGS) : OBJDIR := $(test-crt-posixc-general_OBJDIR)
$(test-crt-posixc-general-link_PROGS) : LDFLAGS := $(strip $(test-crt-posixc-general_LDFLAGS) $(test-crt-posixc-general-link_EXTRA_LDFLAGS))
$(test-crt-posixc-general-link_PROGS) : LIBS := $(addprefix -l,$(test-crt-posixc-general_LIBS) $(test-crt-posixc-general-link_EXTRA_LIBS) )
$(test-crt-posixc-general-link_PROGS) : $(test-crt-posixc-general_TARGETDIR)/% : $(test-crt-posixc-general_OBJDIR)/%.o $(test-crt-posixc-general-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-crt-posixc-general_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-crt-posixc-general_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-crt-posixc-general_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-crt-posixc-general_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-crt-posixc-general_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-crt-posixc-general_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-crt-posixc-general_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(test-crt-posixc-general_DEPS),)
  ifneq (test-crt-posixc-general test-crt-posixc-general-quick,)
    ifneq ($(findstring $(TARGET),test-crt-posixc-general test-crt-posixc-general-quick),)
      -include $(test-crt-posixc-general_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(test-crt-posixc-general_DEPS)
    endif
  endif
endif


ifneq ($(test-crt-posixc-general_DEPS) $(test-crt-posixc-general_OBJS) $(addprefix $(test-crt-posixc-general_TARGETDIR)/,$(test-crt-posixc-general_FILES)),)
$(test-crt-posixc-general_DEPS) $(test-crt-posixc-general_OBJS) $(addprefix $(test-crt-posixc-general_TARGETDIR)/,$(test-crt-posixc-general_FILES)) : | $(test-crt-posixc-general_TARGETDIR) $(test-crt-posixc-general_OBJDIR)
else
$(test-crt-posixc-general_DEPS) $(test-crt-posixc-general_OBJS) $(addprefix $(test-crt-posixc-general_TARGETDIR)/,$(test-crt-posixc-general_FILES)) :: $(test-crt-posixc-general_TARGETDIR) $(test-crt-posixc-general_OBJDIR)
endif

GLOB_MKDIRS += $(test-crt-posixc-general_TARGETDIR) $(test-crt-posixc-general_OBJDIR)


test-crt-posixc-general-clean : FILES := $(test-crt-posixc-general_OBJS) $(test-crt-posixc-general_EXES) $(test-crt-posixc-general_DEPS)
