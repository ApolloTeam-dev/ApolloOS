define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(test-smp-smp-smallpt_CXXCMD) $(test-smp-smp-smallpt_CXXIQUOTE) $(dir $(2)) $(test-smp-smp-smallpt_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-smp-smp-smallpt_CXXIQUOTE) . $(test-smp-smp-smallpt_CXXIQUOTE_END) $(strip $(test-smp-smp-smallpt_CXXFLAGS) $(test-smp-smp-smallpt_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(test-smp-smp-smallpt_CXXCMD) $(test-smp-smp-smallpt_CXXIQUOTE) $(dir $(2)) $(test-smp-smp-smallpt_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-smp-smp-smallpt_CXXIQUOTE) . $(test-smp-smp-smallpt_CXXIQUOTE_END) $(strip $(test-smp-smp-smallpt_CXXFLAGS) $(test-smp-smp-smallpt_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(test-smp-smp-smallpt_CXXCMD) $(test-smp-smp-smallpt_CXXIQUOTE) $(dir $(2)) $(test-smp-smp-smallpt_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(test-smp-smp-smallpt_CXXIQUOTE) . $(test-smp-smp-smallpt_CXXIQUOTE_END) $(strip $(test-smp-smp-smallpt_CXXFLAGS) $(test-smp-smp-smallpt_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(test-smp-smp-smallpt_CXXCMD)" $(MKDEPEND) $(strip $(test-smp-smp-smallpt_DXXFLAGS) $(test-smp-smp-smallpt_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(test-smp-smp-smallpt_OBJDIR),)
  $(foreach test-smp-smp-smallpt_CXXFILE,$(test-smp-smp-smallpt_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(test-smp-smp-smallpt_CXXFILE))),$(test-smp-smp-smallpt_CXXFILE))))
else
  $(foreach test-smp-smp-smallpt_CXXFILE,$(test-smp-smp-smallpt_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(test-smp-smp-smallpt_OBJDIR)/,$(notdir $(basename $(test-smp-smp-smallpt_CXXFILE)))),$(test-smp-smp-smallpt_CXXFILE))))
