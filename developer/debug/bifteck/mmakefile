#MM
debug-tools-bifteck-quick : debug-tools-bifteck

#MM debug-tools-bifteck : includes-generate-deps core-linklibs
debug-tools-bifteck : $(debug-tools-bifteck_TARGETDIR)/$(debug-tools-bifteck_PROGNAME)

ifneq ($(filter $(TARGET),debug-tools-bifteck debug-tools-bifteck-quick debug-tools-bifteck-gz-quick),)

debug-tools-bifteck_CXXABSBASENAMES := $(foreach debug-tools-bifteck_CXXBASE,$(debug-tools-bifteck_CXX_NARCHFILES),$(if $(filter /%,$(debug-tools-bifteck_CXXBASE)),$(debug-tools-bifteck_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(debug-tools-bifteck_CXXBASE))))

ifneq ($(debug-tools-bifteck_CXXABSBASENAMES),)

debug-tools-bifteck_CXXBASENAMES := $(basename $(debug-tools-bifteck_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
debug-tools-bifteck_MCXX_FILES  := $(strip $(foreach debug-tools-bifteck_CXXBASE,$(debug-tools-bifteck_CXXABSBASENAMES), $(firstword $(wildcard $(foreach debug-tools-bifteck_EXT, $(AROS_CXXEXTS),$(addsuffix .$(debug-tools-bifteck_EXT),$(debug-tools-bifteck_CXXBASE)))))))

ifeq (,)
debug-tools-bifteck_MCXX_SRCWILDCARD := %
else
debug-tools-bifteck_MCXX_SRCWILDCARD := /%
endif

ifeq ($(debug-tools-bifteck_OBJDIR),)
  debug-tools-bifteck_CXXTARGETS := $(notdir $(debug-tools-bifteck_CXXBASENAMES:=.o))
  debug-tools-bifteck_CXXDTARGETS := $(notdir $(debug-tools-bifteck_CXXBASENAMES:=.d))
  debug-tools-bifteck_MCXX_WILDCARD := %
else
  debug-tools-bifteck_CXXTARGETS := $(addprefix $(debug-tools-bifteck_OBJDIR)/,$(notdir $(debug-tools-bifteck_CXXBASENAMES:=.o)))
  debug-tools-bifteck_CXXDTARGETS := $(addprefix $(debug-tools-bifteck_OBJDIR)/,$(notdir $(debug-tools-bifteck_CXXBASENAMES:=.d)))
  debug-tools-bifteck_MCXX_WILDCARD := $(debug-tools-bifteck_OBJDIR)/%

  # Be sure that all source files are generated
  $(debug-tools-bifteck_CXXTARGETS) $(debug-tools-bifteck_CXXDTARGETS) : | $(debug-tools-bifteck_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
debug-tools-bifteck_MCXX_CPPFLAGS := $(debug-tools-bifteck_CPPFLAGS)
debug-tools-bifteck_CXXFLAGS := $(debug-tools-bifteck_CXXFLAGS)
ifeq ($(debug-tools-bifteck_DXXFLAGS),)
  debug-tools-bifteck_DXXFLAGS := $(debug-tools-bifteck_CXXFLAGS)
else
  debug-tools-bifteck_DXXFLAGS := $(debug-tools-bifteck_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  debug-tools-bifteck_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  debug-tools-bifteck_STRIP ?= $(HOST_STRIP)
  debug-tools-bifteck_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  debug-tools-bifteck_CXXCMD:=$(HOST_CXX)
  debug-tools-bifteck_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(debug-tools-bifteck_MCXX_CPPFLAGS) $(debug-tools-bifteck_MCXX_EXTRA_CPPFLAGS))
  debug-tools-bifteck_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(debug-tools-bifteck_CXXFLAGS))
  debug-tools-bifteck_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(debug-tools-bifteck_DXXFLAGS))
  debug-tools-bifteck_CXXIQUOTE:=$(HOST_IQUOTE)
  debug-tools-bifteck_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  debug-tools-bifteck_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  debug-tools-bifteck_STRIP ?= $(TARGET_STRIP)
  debug-tools-bifteck_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  debug-tools-bifteck_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  debug-tools-bifteck_MCXX_CPPFLAGS := $(strip $(debug-tools-bifteck_MCXX_CPPFLAGS) $(debug-tools-bifteck_MCXX_EXTRA_CPPFLAGS))
  debug-tools-bifteck_CXXFLAGS := $(strip $(debug-tools-bifteck_CXXFLAGS) $(SAFETY_CFLAGS))
  debug-tools-bifteck_DXXFLAGS := $(debug-tools-bifteck_DXXFLAGS)
  debug-tools-bifteck_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  debug-tools-bifteck_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  debug-tools-bifteck_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  debug-tools-bifteck_STRIP ?= $(ECHO) >/dev/null
  debug-tools-bifteck_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  debug-tools-bifteck_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  debug-tools-bifteck_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(debug-tools-bifteck_MCXX_CPPFLAGS) $(debug-tools-bifteck_MCXX_EXTRA_CPPFLAGS))
  debug-tools-bifteck_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(debug-tools-bifteck_CXXFLAGS))
  debug-tools-bifteck_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(debug-tools-bifteck_DXXFLAGS))
  debug-tools-bifteck_CXXIQUOTE:=$(KERNEL_IQUOTE)
  debug-tools-bifteck_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(debug-tools-bifteck_CXXCMD) $(debug-tools-bifteck_CXXIQUOTE) $(dir $(2)) $(debug-tools-bifteck_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(debug-tools-bifteck_CXXIQUOTE) . $(debug-tools-bifteck_CXXIQUOTE_END) $(strip $(debug-tools-bifteck_CXXFLAGS) $(debug-tools-bifteck_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(debug-tools-bifteck_CXXCMD) $(debug-tools-bifteck_CXXIQUOTE) $(dir $(2)) $(debug-tools-bifteck_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(debug-tools-bifteck_CXXIQUOTE) . $(debug-tools-bifteck_CXXIQUOTE_END) $(strip $(debug-tools-bifteck_CXXFLAGS) $(debug-tools-bifteck_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(debug-tools-bifteck_CXXCMD) $(debug-tools-bifteck_CXXIQUOTE) $(dir $(2)) $(debug-tools-bifteck_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(debug-tools-bifteck_CXXIQUOTE) . $(debug-tools-bifteck_CXXIQUOTE_END) $(strip $(debug-tools-bifteck_CXXFLAGS) $(debug-tools-bifteck_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(debug-tools-bifteck_CXXCMD)" $(MKDEPEND) $(strip $(debug-tools-bifteck_DXXFLAGS) $(debug-tools-bifteck_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(debug-tools-bifteck_OBJDIR),)
  $(foreach debug-tools-bifteck_CXXFILE,$(debug-tools-bifteck_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(debug-tools-bifteck_CXXFILE))),$(debug-tools-bifteck_CXXFILE))))
else
  $(foreach debug-tools-bifteck_CXXFILE,$(debug-tools-bifteck_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(debug-tools-bifteck_OBJDIR)/,$(notdir $(basename $(debug-tools-bifteck_CXXFILE)))),$(debug-tools-bifteck_CXXFILE))))
endif

endif


ifneq ($(debug-tools-bifteck_OBJC_NARCHFILES),)

ifeq (,)
debug-tools-bifteck_MOBJC_SRCWILDCARD := %
else
debug-tools-bifteck_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(debug-tools-bifteck_OBJDIR),)
  debug-tools-bifteck_MOBJC_TARGETS := $(addsuffix .o,$(debug-tools-bifteck_OBJC_NARCHFILES))
  debug-tools-bifteck_MOBJC_DTARGETS := $(addsuffix .d,$(debug-tools-bifteck_OBJC_NARCHFILES))
  debug-tools-bifteck_MOBJC_WILDCARD := %
else
  debug-tools-bifteck_MOBJC_TARGETS := $(addsuffix .o,$(addprefix $(debug-tools-bifteck_OBJDIR)/,$(debug-tools-bifteck_OBJC_NARCHFILES)))
  debug-tools-bifteck_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(debug-tools-bifteck_OBJDIR)/,$(debug-tools-bifteck_OBJC_NARCHFILES)))
  debug-tools-bifteck_MOBJC_WILDCARD := $(debug-tools-bifteck_OBJDIR)/%

  # Be sure that all .m files are generated
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : | $(addsuffix .m,$(debug-tools-bifteck_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  debug-tools-bifteck_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  debug-tools-bifteck_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(debug-tools-bifteck_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  debug-tools-bifteck_MOBJC_DIRS := $(foreach dir, $(debug-tools-bifteck_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(debug-tools-bifteck_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(debug-tools-bifteck_MOBJC_DIRS),)
    debug-tools-bifteck_MOBJC_DIRS := $(shell echo $(debug-tools-bifteck_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(debug-tools-bifteck_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  debug-tools-bifteck_CC := $(TARGET_CC)
else
  debug-tools-bifteck_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
debug-tools-bifteck_MOBJC_CPPFLAGS := $(debug-tools-bifteck_CPPFLAGS)
debug-tools-bifteck_OBJCFLAGS := $(debug-tools-bifteck_CFLAGS)
debug-tools-bifteck_OBJCFLAGS := $(debug-tools-bifteck_OBJCFLAGS) -isystem $(AROS_DEVELOPER)/include
debug-tools-bifteck_OBJCFLAGS := $(subst -Wno-pointer-sign,, $(subst -Werror-implicit-function-declaration,, $(debug-tools-bifteck_OBJCFLAGS)))
ifeq ($(debug-tools-bifteck_DFLAGS),)
  debug-tools-bifteck_OBJCDFLAGS := $(debug-tools-bifteck_CFLAGS)
else
  debug-tools-bifteck_OBJCDFLAGS := $(debug-tools-bifteck_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  debug-tools-bifteck_LINK ?= $(strip $(debug-tools-bifteck_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  debug-tools-bifteck_STRIP ?= $(TARGET_STRIP)
  debug-tools-bifteck_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : CMD:=$(strip $(debug-tools-bifteck_CC) $(TARGET_SYSROOT))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_MOBJC_CPPFLAGS:=$(strip $(debug-tools-bifteck_MOBJC_CPPFLAGS) $(debug-tools-bifteck_MOBJC_EXTRA_CPPFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_OBJCFLAGS:=$(strip $(debug-tools-bifteck_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_OBJCDFLAGS:=$(debug-tools-bifteck_OBJCDFLAGS)
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_IQUOTE:=$(CFLAGS_IQUOTE)
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  debug-tools-bifteck_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  debug-tools-bifteck_STRIP ?= $(HOST_STRIP)
  debug-tools-bifteck_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(debug-tools-bifteck_MOBJC_CPPFLAGS) $(debug-tools-bifteck_MOBJC_EXTRA_CPPFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(debug-tools-bifteck_OBJCFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(debug-tools-bifteck_OBJCDFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_IQUOTE:=$(HOST_IQUOTE)
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  debug-tools-bifteck_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  debug-tools-bifteck_STRIP ?= $(ECHO) >/dev/null
  debug-tools-bifteck_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(debug-tools-bifteck_MOBJC_CPPFLAGS) $(debug-tools-bifteck_MOBJC_EXTRA_CPPFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(debug-tools-bifteck_OBJCFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(debug-tools-bifteck_OBJCDFLAGS))
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_IQUOTE:=$(KERNEL_IQUOTE)
  $(debug-tools-bifteck_MOBJC_TARGETS) $(debug-tools-bifteck_MOBJC_DTARGETS) : debug-tools-bifteck_IQUOTE_END:=$(KERNEL_IQUOTE_END)
