debug-tools-bifteck_OBJDIR    := $(GENDIR)/$(CURDIR)
debug-tools-bifteck_TARGETDIR := $(AROS_DEBUG)
debug-tools-bifteck_LINKER    := 
debug-tools-bifteck_LIBS := 
