$(debug-tools-bifteck_MOBJC_TARGETS) : CPPFLAGS := $(debug-tools-bifteck_MOBJC_CPPFLAGS)
$(debug-tools-bifteck_MOBJC_TARGETS) : CFLAGS := $(debug-tools-bifteck_OBJCFLAGS)
