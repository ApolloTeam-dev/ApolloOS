ifeq ($(findstring host,host kernel target),)
  $(error unknown compiler host)
endif
ifeq (host,target)
  tools-mkkeymap_LINK ?= $(strip $(tools-mkkeymap_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  tools-mkkeymap_STRIP ?= $(TARGET_STRIP)
  tools-mkkeymap_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : CMD:=$(strip $(tools-mkkeymap_CC) $(TARGET_SYSROOT))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_MOBJC_CPPFLAGS:=$(strip $(tools-mkkeymap_MOBJC_CPPFLAGS) $(tools-mkkeymap_MOBJC_EXTRA_CPPFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_OBJCFLAGS:=$(strip $(tools-mkkeymap_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_OBJCDFLAGS:=$(tools-mkkeymap_OBJCDFLAGS)
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_IQUOTE:=$(CFLAGS_IQUOTE)
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (host,host)
  tools-mkkeymap_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  tools-mkkeymap_STRIP ?= $(HOST_STRIP)
  tools-mkkeymap_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(tools-mkkeymap_MOBJC_CPPFLAGS) $(tools-mkkeymap_MOBJC_EXTRA_CPPFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(tools-mkkeymap_OBJCFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(tools-mkkeymap_OBJCDFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_IQUOTE:=$(HOST_IQUOTE)
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (host,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  tools-mkkeymap_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  tools-mkkeymap_STRIP ?= $(ECHO) >/dev/null
  tools-mkkeymap_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(tools-mkkeymap_MOBJC_CPPFLAGS) $(tools-mkkeymap_MOBJC_EXTRA_CPPFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(tools-mkkeymap_OBJCFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(tools-mkkeymap_OBJCDFLAGS))
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_IQUOTE:=$(KERNEL_IQUOTE)
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : tools-mkkeymap_IQUOTE_END:=$(KERNEL_IQUOTE_END)
