$(tools-mkkeymap_MOBJC_TARGETS) : CPPFLAGS := $(tools-mkkeymap_MOBJC_CPPFLAGS)
$(tools-mkkeymap_MOBJC_TARGETS) : CFLAGS := $(tools-mkkeymap_OBJCFLAGS)
$(tools-mkkeymap_MOBJC_TARGETS) : $(tools-mkkeymap_MOBJC_WILDCARD).o : $(tools-mkkeymap_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(tools-mkkeymap_IQUOTE) $(dir $<) $(tools-mkkeymap_IQUOTE) $(SRCDIR)/$(CURDIR) $(tools-mkkeymap_IQUOTE) . $(tools-mkkeymap_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(tools-mkkeymap_IQUOTE) $(dir $<) $(tools-mkkeymap_IQUOTE) $(SRCDIR)/$(CURDIR) $(tools-mkkeymap_IQUOTE) . $(tools-mkkeymap_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(tools-mkkeymap_IQUOTE) $(dir $<) $(tools-mkkeymap_IQUOTE) $(SRCDIR)/$(CURDIR) $(tools-mkkeymap_IQUOTE) . $(tools-mkkeymap_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

