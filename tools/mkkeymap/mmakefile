  tools-mkkeymap_MOBJC_WILDCARD := $(tools-mkkeymap_OBJDIR)/%

  # Be sure that all .m files are generated
  $(tools-mkkeymap_MOBJC_TARGETS) $(tools-mkkeymap_MOBJC_DTARGETS) : | $(addsuffix .m,$(tools-mkkeymap_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  tools-mkkeymap_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  tools-mkkeymap_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(tools-mkkeymap_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  tools-mkkeymap_MOBJC_DIRS := $(foreach dir, $(tools-mkkeymap_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(tools-mkkeymap_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(tools-mkkeymap_MOBJC_DIRS),)
    tools-mkkeymap_MOBJC_DIRS := $(shell echo $(tools-mkkeymap_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(tools-mkkeymap_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  tools-mkkeymap_CC := $(TARGET_CC)
else
  tools-mkkeymap_CC := $(TARGET_OBJC)
