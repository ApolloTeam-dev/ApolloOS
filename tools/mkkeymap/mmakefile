# Adjust compiler flags to suit ObjC
tools-mkkeymap_MOBJC_CPPFLAGS := $(tools-mkkeymap_CPPFLAGS)
tools-mkkeymap_OBJCFLAGS := $(tools-mkkeymap_CFLAGS)
