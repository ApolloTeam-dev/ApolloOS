include $(SRCDIR)/config/aros.cfg

## Host build

#MM- tools-mkkeymap: includes

USER_INCLUDES := -I$(GENINCDIR)
EXEDIR := $(dir $(MKKEYMAP))
FILES := mkkeymap config parsedescriptor writekeymap


.PHONY : tools-mkkeymap

tools-mkkeymap_PROGNAME  := $(notdir $(MKKEYMAP))
tools-mkkeymap_OBJDIR    := $(GENDIR)/$(CURDIR)
tools-mkkeymap_TARGETDIR := $(EXEDIR)
tools-mkkeymap_LINKER    := 
tools-mkkeymap_LIBS := 
# If not supplied, linker is equal to compiler
ifeq ($(tools-mkkeymap_LINKER),)
    tools-mkkeymap_LINKER := host
endif

ifneq ("$(strip $(FILES)   )","")
    tools-mkkeymap_FILES     := $(FILES)
    tools-mkkeymap_OBJCFILES := 
    tools-mkkeymap_ASMFILES  := 
    tools-mkkeymap_CXXFILES := 
else
    tools-mkkeymap_FILES     := $(tools-mkkeymap_PROGNAME)
    tools-mkkeymap_OBJCFILES :=
    tools-mkkeymap_ASMFILES  :=
    tools-mkkeymap_CXXFILES :=
endif

tools-mkkeymap_ARCHOBJS   := $(wildcard $(tools-mkkeymap_OBJDIR)/arch/*.o)
tools-mkkeymap_ARCHFILES  := $(basename $(notdir $(tools-mkkeymap_ARCHOBJS)))
tools-mkkeymap_C_NARCHFILES := $(filter-out $(tools-mkkeymap_ARCHFILES),$(tools-mkkeymap_FILES))
tools-mkkeymap_CXX_NARCHFILES := $(filter-out $(tools-mkkeymap_ARCHFILES),$(tools-mkkeymap_CXXFILES))
tools-mkkeymap_OBJC_NARCHFILES := $(filter-out $(tools-mkkeymap_ARCHFILES),$(tools-mkkeymap_OBJCFILES))

TMP_FILES := $(tools-mkkeymap_C_NARCHFILES) $(tools-mkkeymap_CXX_NARCHFILES) $(tools-mkkeymap_ASMFILES) $(tools-mkkeymap_OBJC_NARCHFILES)
tools-mkkeymap_OBJS := $(addsuffix .o,$(addprefix $(tools-mkkeymap_OBJDIR)/,$(notdir $(TMP_FILES))))
tools-mkkeymap_DEPS := $(addsuffix .d,$(addprefix $(tools-mkkeymap_OBJDIR)/,$(notdir $(TMP_FILES))))

tools-mkkeymap_CPPFLAGS :=  $(CPPFLAGS)
ifneq (,)
tools-mkkeymap_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (host,target)
tools-mkkeymap_CFLAGS            := $(CFLAGS)
endif
ifeq (host,host)
tools-mkkeymap_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (host,kernel)
tools-mkkeymap_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
tools-mkkeymap_CFLAGS            := 
endif

ifeq ("","")
ifeq (host,target)
tools-mkkeymap_CXXFLAGS            := $(CXXFLAGS)
endif
ifeq (host,host)
tools-mkkeymap_CXXFLAGS            := $(HOST_CXXFLAGS)
endif
ifeq (host,kernel)
tools-mkkeymap_CXXFLAGS            := $(strip $(KERNEL_ISA_CXXFLAGS) $(KERNEL_CXXFLAGS))
endif
else
tools-mkkeymap_CXXFLAGS          := 
endif

ifeq ("","")
ifeq (host,target)
tools-mkkeymap_LDFLAGS            := $(LDFLAGS)
endif
ifeq (host,host)
tools-mkkeymap_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (host,kernel)
tools-mkkeymap_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
tools-mkkeymap_LDFLAGS          := 
endif

tools-mkkeymap_COVERAGE := no
ifeq (host,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
tools-mkkeymap_COVERAGE := yes
tools-mkkeymap_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
tools-mkkeymap_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
tools-mkkeymap_CFLAGS    := $(strip $(tools-mkkeymap_COVERAGEFLAGS) $(tools-mkkeymap_CFLAGS))
tools-mkkeymap_CXXFLAGS := $(strip $(tools-mkkeymap_COVERAGEFLAGS) $(tools-mkkeymap_CXXFLAGS))
tools-mkkeymap_LIBS += $(tools-mkkeymap_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
tools-mkkeymap_FUNCINSTR := yes
tools-mkkeymap_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
tools-mkkeymap_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
tools-mkkeymap_CFLAGS    := $(strip $(tools-mkkeymap_INSTRFUNCFLAGS) $(tools-mkkeymap_CFLAGS))
tools-mkkeymap_CXXFLAGS := $(strip $(tools-mkkeymap_INSTRFUNCFLAGS) $(tools-mkkeymap_CXXFLAGS))
tools-mkkeymap_LIBS += $(tools-mkkeymap_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
tools-mkkeymap_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(tools-mkkeymap_CFLAGS))
tools-mkkeymap_CXXFLAGS := $(strip $(LTO_BINARY_CFLAGS) $(tools-mkkeymap_CXXFLAGS))
endif
endif
tools-mkkeymap_AFLAGS    := $(AFLAGS)
ifneq (,)
    tools-mkkeymap_DFLAGS     := 
else
    tools-mkkeymap_DFLAGS     := $(tools-mkkeymap_CFLAGS)
endif
ifneq (,)
    tools-mkkeymap_DXXFLAGS     := 
else
    tools-mkkeymap_DXXFLAGS     := $(tools-mkkeymap_CXXFLAGS)
endif
ifeq (host,target)
tools-mkkeymap_LDFLAGS           := $(tools-mkkeymap_LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (host,host)
tools-mkkeymap_LDFLAGS           := $(tools-mkkeymap_LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (host,kernel)
tools-mkkeymap_LDFLAGS           := $(tools-mkkeymap_LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
tools-mkkeymap_LDFLAGS   += -L
endif

#MM
tools-mkkeymap-quick : tools-mkkeymap

#MM tools-mkkeymap : includes-generate-deps core-linklibs
tools-mkkeymap : $(tools-mkkeymap_TARGETDIR)/$(tools-mkkeymap_PROGNAME)

ifneq ($(filter $(TARGET),tools-mkkeymap tools-mkkeymap-quick tools-mkkeymap-gz-quick),)

tools-mkkeymap_CXXABSBASENAMES := $(foreach tools-mkkeymap_CXXBASE,$(tools-mkkeymap_CXX_NARCHFILES),$(if $(filter /%,$(tools-mkkeymap_CXXBASE)),$(tools-mkkeymap_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(tools-mkkeymap_CXXBASE))))

ifneq ($(tools-mkkeymap_CXXABSBASENAMES),)

tools-mkkeymap_CXXBASENAMES := $(basename $(tools-mkkeymap_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
tools-mkkeymap_MCXX_FILES  := $(strip $(foreach tools-mkkeymap_CXXBASE,$(tools-mkkeymap_CXXABSBASENAMES), $(firstword $(wildcard $(foreach tools-mkkeymap_EXT, $(AROS_CXXEXTS),$(addsuffix .$(tools-mkkeymap_EXT),$(tools-mkkeymap_CXXBASE)))))))

ifeq (,)
tools-mkkeymap_MCXX_SRCWILDCARD := %
else
tools-mkkeymap_MCXX_SRCWILDCARD := /%
endif

ifeq ($(tools-mkkeymap_OBJDIR),)
  tools-mkkeymap_CXXTARGETS := $(notdir $(tools-mkkeymap_CXXBASENAMES:=.o))
  tools-mkkeymap_CXXDTARGETS := $(notdir $(tools-mkkeymap_CXXBASENAMES:=.d))
  tools-mkkeymap_MCXX_WILDCARD := %
else
  tools-mkkeymap_CXXTARGETS := $(addprefix $(tools-mkkeymap_OBJDIR)/,$(notdir $(tools-mkkeymap_CXXBASENAMES:=.o)))
  tools-mkkeymap_CXXDTARGETS := $(addprefix $(tools-mkkeymap_OBJDIR)/,$(notdir $(tools-mkkeymap_CXXBASENAMES:=.d)))
  tools-mkkeymap_MCXX_WILDCARD := $(tools-mkkeymap_OBJDIR)/%

  # Be sure that all source files are generated
  $(tools-mkkeymap_CXXTARGETS) $(tools-mkkeymap_CXXDTARGETS) : | $(tools-mkkeymap_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
tools-mkkeymap_MCXX_CPPFLAGS := $(tools-mkkeymap_CPPFLAGS)
tools-mkkeymap_CXXFLAGS := $(tools-mkkeymap_CXXFLAGS)
ifeq ($(tools-mkkeymap_DXXFLAGS),)
  tools-mkkeymap_DXXFLAGS := $(tools-mkkeymap_CXXFLAGS)
else
  tools-mkkeymap_DXXFLAGS := $(tools-mkkeymap_DXXFLAGS)
endif

ifeq ($(findstring host,host kernel target),)
  $(error unknown compiler host)
endif
ifeq (host,host)
  tools-mkkeymap_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  tools-mkkeymap_STRIP ?= $(HOST_STRIP)
  tools-mkkeymap_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  tools-mkkeymap_CXXCMD:=$(HOST_CXX)
  tools-mkkeymap_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(tools-mkkeymap_MCXX_CPPFLAGS) $(tools-mkkeymap_MCXX_EXTRA_CPPFLAGS))
  tools-mkkeymap_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(tools-mkkeymap_CXXFLAGS))
  tools-mkkeymap_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(tools-mkkeymap_DXXFLAGS))
  tools-mkkeymap_CXXIQUOTE:=$(HOST_IQUOTE)
  tools-mkkeymap_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (host,target)
  tools-mkkeymap_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  tools-mkkeymap_STRIP ?= $(TARGET_STRIP)
  tools-mkkeymap_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  tools-mkkeymap_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  tools-mkkeymap_MCXX_CPPFLAGS := $(strip $(tools-mkkeymap_MCXX_CPPFLAGS) $(tools-mkkeymap_MCXX_EXTRA_CPPFLAGS))
  tools-mkkeymap_CXXFLAGS := $(strip $(tools-mkkeymap_CXXFLAGS) $(SAFETY_CFLAGS))
  tools-mkkeymap_DXXFLAGS := $(tools-mkkeymap_DXXFLAGS)
  tools-mkkeymap_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  tools-mkkeymap_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (host,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  tools-mkkeymap_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  tools-mkkeymap_STRIP ?= $(ECHO) >/dev/null
  tools-mkkeymap_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  tools-mkkeymap_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  tools-mkkeymap_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(tools-mkkeymap_MCXX_CPPFLAGS) $(tools-mkkeymap_MCXX_EXTRA_CPPFLAGS))
  tools-mkkeymap_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(tools-mkkeymap_CXXFLAGS))
  tools-mkkeymap_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(tools-mkkeymap_DXXFLAGS))
  tools-mkkeymap_CXXIQUOTE:=$(KERNEL_IQUOTE)
  tools-mkkeymap_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(tools-mkkeymap_CXXCMD) $(tools-mkkeymap_CXXIQUOTE) $(dir $(2)) $(tools-mkkeymap_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-mkkeymap_CXXIQUOTE) . $(tools-mkkeymap_CXXIQUOTE_END) $(strip $(tools-mkkeymap_CXXFLAGS) $(tools-mkkeymap_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(tools-mkkeymap_CXXCMD) $(tools-mkkeymap_CXXIQUOTE) $(dir $(2)) $(tools-mkkeymap_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-mkkeymap_CXXIQUOTE) . $(tools-mkkeymap_CXXIQUOTE_END) $(strip $(tools-mkkeymap_CXXFLAGS) $(tools-mkkeymap_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(tools-mkkeymap_CXXCMD) $(tools-mkkeymap_CXXIQUOTE) $(dir $(2)) $(tools-mkkeymap_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-mkkeymap_CXXIQUOTE) . $(tools-mkkeymap_CXXIQUOTE_END) $(strip $(tools-mkkeymap_CXXFLAGS) $(tools-mkkeymap_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(tools-mkkeymap_CXXCMD)" $(MKDEPEND) $(strip $(tools-mkkeymap_DXXFLAGS) $(tools-mkkeymap_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(tools-mkkeymap_OBJDIR),)
  $(foreach tools-mkkeymap_CXXFILE,$(tools-mkkeymap_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(tools-mkkeymap_CXXFILE))),$(tools-mkkeymap_CXXFILE))))
else
  $(foreach tools-mkkeymap_CXXFILE,$(tools-mkkeymap_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(tools-mkkeymap_OBJDIR)/,$(notdir $(basename $(tools-mkkeymap_CXXFILE)))),$(tools-mkkeymap_CXXFILE))))
endif

endif


ifneq ($(tools-mkkeymap_OBJC_NARCHFILES),)

ifeq (,)
tools-mkkeymap_MOBJC_SRCWILDCARD := %
else
tools-mkkeymap_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(tools-mkkeymap_OBJDIR),)
  tools-mkkeymap_MOBJC_TARGETS := $(addsuffix .o,$(tools-mkkeymap_OBJC_NARCHFILES))
