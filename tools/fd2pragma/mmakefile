  tools-fd2pragma_CXXIQUOTE:=$(KERNEL_IQUOTE)
  tools-fd2pragma_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(tools-fd2pragma_CXXCMD) $(tools-fd2pragma_CXXIQUOTE) $(dir $(2)) $(tools-fd2pragma_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-fd2pragma_CXXIQUOTE) . $(tools-fd2pragma_CXXIQUOTE_END) $(strip $(tools-fd2pragma_CXXFLAGS) $(tools-fd2pragma_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(tools-fd2pragma_CXXCMD) $(tools-fd2pragma_CXXIQUOTE) $(dir $(2)) $(tools-fd2pragma_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-fd2pragma_CXXIQUOTE) . $(tools-fd2pragma_CXXIQUOTE_END) $(strip $(tools-fd2pragma_CXXFLAGS) $(tools-fd2pragma_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(tools-fd2pragma_CXXCMD) $(tools-fd2pragma_CXXIQUOTE) $(dir $(2)) $(tools-fd2pragma_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-fd2pragma_CXXIQUOTE) . $(tools-fd2pragma_CXXIQUOTE_END) $(strip $(tools-fd2pragma_CXXFLAGS) $(tools-fd2pragma_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(tools-fd2pragma_CXXCMD)" $(MKDEPEND) $(strip $(tools-fd2pragma_DXXFLAGS) $(tools-fd2pragma_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(tools-fd2pragma_OBJDIR),)
  $(foreach tools-fd2pragma_CXXFILE,$(tools-fd2pragma_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(tools-fd2pragma_CXXFILE))),$(tools-fd2pragma_CXXFILE))))
else
  $(foreach tools-fd2pragma_CXXFILE,$(tools-fd2pragma_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(tools-fd2pragma_OBJDIR)/,$(notdir $(basename $(tools-fd2pragma_CXXFILE)))),$(tools-fd2pragma_CXXFILE))))
