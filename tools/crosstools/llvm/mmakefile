                                -DCMAKE_BUILD_TYPE=Release \
                                -DCMAKE_LINKER="$(strip $(HOST_LD))" \
                                -DCMAKE_EXE_LINKER_FLAGS="$(strip $(BD_LDFLAGS))"
    ifeq (no,yes)
        crosstools-llvm-cmake_opts  += -DCMAKE_CXX_LINK_EXECUTABLE="<CMAKE_LINKER> <FLAGS> <CMAKE_CXX_LINK_FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>"
    endif
    ifneq ($(CC_PREFIX),)
        crosstools-llvm-cmake_opts      += -DCMAKE_C_COMPILER="$(strip $(subst $(CC_PREFIX),,$(HOST_DEF_CC)))"
    else
        crosstools-llvm-cmake_opts      += -DCMAKE_C_COMPILER="$(strip $(HOST_DEF_CC))"
    endif
    ifeq (yes,yes)
        crosstools-llvm-cmake_opts  += -DCMAKE_C_FLAGS="$(strip $(BD_CFLAGS))"
    endif
    ifeq (yes,yes)
        crosstools-llvm-cmake_opts  += -DCMAKE_CPP_FLAGS="$(strip $(BD_CPPFLAGS))"
    endif
    ifneq ($(CC_PREFIX),)
        crosstools-llvm-cmake_opts      += -DCMAKE_CXX_COMPILER="$(strip $(subst $(CC_PREFIX),,$(HOST_CXX)))"
    else
        crosstools-llvm-cmake_opts      += -DCMAKE_CXX_COMPILER="$(strip $(HOST_CXX))"
    endif
    ifeq (yes,yes)
        crosstools-llvm-cmake_opts  += -DCMAKE_CXX_FLAGS="$(strip $(BD_CXXFLAGS))"
    endif
    ifeq (llvm,)
        crosstools-llvm-pkgdir      := $(HOSTGENDIR)/$(CURDIR)
    else
        crosstools-llvm-pkgdir      := $(HOSTGENDIR)/$(CURDIR)/llvm
    endif
else
    BD_LDFLAGS               := $(strip $(LDFLAGS) )
    BD_CFLAGS                := $(strip $(CFLAGS) )
    BD_CXXFLAGS              := $(strip $(CXXFLAGS) )
    BD_CPPFLAGS              := $(strip $(CPPFLAGS) )
    crosstools-llvm-cmake_opts      := -DCMAKE_TOOLCHAIN_FILE=$(GENDIR)/config/conf.cmake -DCMAKE_INSTALL_PREFIX=$(crosstools-llvm-prefix)
    ifeq (yes,yes)
        crosstools-llvm-cmake_opts  += -DCMAKE_C_FLAGS="$(strip $(BD_CFLAGS))"
    endif
    ifeq (yes,yes)
        crosstools-llvm-cmake_opts  += -DCMAKE_CPP_FLAGS="$(strip $(BD_CPPFLAGS))"
    endif
    ifeq (yes,yes)
        crosstools-llvm-cmake_opts      += -DCMAKE_CXX_FLAGS="$(strip $(BD_CXXFLAGS))"
    endif
    crosstools-llvm-cmake_opts  += -DCMAKE_EXE_LINKER_FLAGS="$(strip $(BD_LDFLAGS))"
    ifeq (llvm,)
        crosstools-llvm-pkgdir      := $(GENDIR)/$(CURDIR)
    else
        crosstools-llvm-pkgdir      := $(GENDIR)/$(CURDIR)/llvm
    endif
endif
ifneq (,)
    ifeq (llvm,)
        crosstools-llvm-pkgdir      := /$(CURDIR)
    else
        crosstools-llvm-pkgdir      := /$(CURDIR)/llvm
    endif
endif

crosstools-llvm-cmakeflag           := $(crosstools-llvm-pkgdir)/.cmake
crosstools-llvm-installflag         := $(crosstools-llvm-pkgdir)/.installed

.PHONY : crosstools-llvm crosstools-llvm-clean crosstools-llvm-build_and_install-quick

#MM- crosstools-llvm: setup includes core-linklibs crosstools-llvm-quick

#MM- crosstools-llvm-quick : crosstools-llvm-cmake crosstools-llvm-build_and_install-quick

#MM
crosstools-llvm-build_and_install-quick :  $(crosstools-llvm-installflag)

$(crosstools-llvm-installflag) : $(crosstools-llvm-cmakeflag)
	$(IF) ! $(MAKE) -q -C $(crosstools-llvm-pkgdir); then \
	    $(RM)  $(crosstools-llvm-installflag) && \
	    $(MAKE) -C $(crosstools-llvm-pkgdir) $(LLVM_CMAKETARGET) && \
	    cd $(crosstools-llvm-pkgdir) && \
	    cmake  -P cmake_install.cmake && \
	    $(TOUCH) $@ -r $^; \
	fi

crosstools-llvm-touchfileflag ?= $(crosstools-llvm-pkgdir)/.files-touched
ifneq ($(crosstools-llvm-touchfileflag),)
$(crosstools-llvm-touchfileflag):
	$(Q)$(FOR) dir in $(crosstools-llvm-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	find $(HOSTDIR)/Ports/host/llvm/$(LLVM_ARCHBASE) -exec $(TOUCH) -c -r $(HOSTDIR)/Ports/host/llvm/$(LLVM_ARCHBASE)/CMakeLists.txt '{}' \; && \
	$(TOUCH) $@
endif

#MM
crosstools-llvm-cmake : crosstools-llvm-adddirs $(crosstools-llvm-cmakeflag) 

$(crosstools-llvm-cmakeflag) : TMP_SRCDIR := $(shell echo $(HOSTDIR)/Ports/host/llvm/$(LLVM_ARCHBASE) | sed 's/^\(.\):\//\/\1\//')
$(crosstools-llvm-cmakeflag) : $(crosstools-llvm-touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(RM) $@
	$(Q)$(FOR) dir in $(crosstools-llvm-pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	cd $(crosstools-llvm-pkgdir) && \
	$(RM) -Rf CMakeCache.txt CMakeFiles \; && \
	cmake $(crosstools-llvm-cmake_opts) $(LLVM_CMAKEOPTIONS) $(TMP_SRCDIR) && \
	$(TOUCH) $@

#MM
crosstools-llvm-clean : crosstools-llvm-uninstall
	$(Q)$(RM) $(crosstools-llvm-pkgdir)

# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
