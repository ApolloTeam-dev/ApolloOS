$(tools-flexcat-bin_MOBJC_TARGETS) : CPPFLAGS := $(tools-flexcat-bin_MOBJC_CPPFLAGS)
$(tools-flexcat-bin_MOBJC_TARGETS) : CFLAGS := $(tools-flexcat-bin_OBJCFLAGS)
$(tools-flexcat-bin_MOBJC_TARGETS) : $(tools-flexcat-bin_MOBJC_WILDCARD).o : $(tools-flexcat-bin_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(tools-flexcat-bin_IQUOTE) $(dir $<) $(tools-flexcat-bin_IQUOTE) $(SRCDIR)/$(CURDIR) $(tools-flexcat-bin_IQUOTE) . $(tools-flexcat-bin_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(tools-flexcat-bin_IQUOTE) $(dir $<) $(tools-flexcat-bin_IQUOTE) $(SRCDIR)/$(CURDIR) $(tools-flexcat-bin_IQUOTE) . $(tools-flexcat-bin_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
