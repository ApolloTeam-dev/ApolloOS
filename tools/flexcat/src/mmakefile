ifeq (target,host)
  tools-flexcat-bin_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  tools-flexcat-bin_STRIP ?= $(HOST_STRIP)
  tools-flexcat-bin_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(tools-flexcat-bin_MOBJC_CPPFLAGS) $(tools-flexcat-bin_MOBJC_EXTRA_CPPFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(tools-flexcat-bin_OBJCFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(tools-flexcat-bin_OBJCDFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_IQUOTE:=$(HOST_IQUOTE)
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  tools-flexcat-bin_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  tools-flexcat-bin_STRIP ?= $(ECHO) >/dev/null
  tools-flexcat-bin_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(tools-flexcat-bin_MOBJC_CPPFLAGS) $(tools-flexcat-bin_MOBJC_EXTRA_CPPFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(tools-flexcat-bin_OBJCFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(tools-flexcat-bin_OBJCDFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_IQUOTE:=$(KERNEL_IQUOTE)
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_IQUOTE_END:=$(KERNEL_IQUOTE_END)
