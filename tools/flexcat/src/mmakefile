include $(SRCDIR)/config/aros.cfg

#MM- tools-flexcat : tools-flexcat-bin tools-flexcat-sd tools-flexcat-locale
#MM tools-flexcat-bin : includes linklibs

FILES := \
    main \
    createcat \
    createcatsrc \
    createct \
    globals \
    readprefs \
    scancd \
    scanct \
    scanpo \
    showfuncs \
    swapfuncs \
    translators \
    utils \
    locale \
    getft \
    asprintf \
    vasprintf \
    vastubs \
    openlibs

EXEDIR := $(AROS_CONTRIB)/$(AROS_DIR_DEVELOPER)/FlexCat
NOWARN_FLAGS := $(NOWARN_FORMAT)
USER_CFLAGS := $(NOWARN_FLAGS) -DNO_INLINE_STDARG -D__BSD_VISIBLE=1 -DAMIGA


.PHONY : tools-flexcat-bin

tools-flexcat-bin_PROGNAME  := flexcat
tools-flexcat-bin_OBJDIR    := $(GENDIR)/$(CURDIR)
tools-flexcat-bin_TARGETDIR := $(EXEDIR)
tools-flexcat-bin_LINKER    := 
tools-flexcat-bin_LIBS := 
# If not supplied, linker is equal to compiler
ifeq ($(tools-flexcat-bin_LINKER),)
    tools-flexcat-bin_LINKER := target
endif

ifneq ("$(strip $(FILES)   )","")
    tools-flexcat-bin_FILES     := $(FILES)
    tools-flexcat-bin_OBJCFILES := 
    tools-flexcat-bin_ASMFILES  := 
    tools-flexcat-bin_CXXFILES := 
else
    tools-flexcat-bin_FILES     := $(tools-flexcat-bin_PROGNAME)
    tools-flexcat-bin_OBJCFILES :=
    tools-flexcat-bin_ASMFILES  :=
    tools-flexcat-bin_CXXFILES :=
endif

tools-flexcat-bin_ARCHOBJS   := $(wildcard $(tools-flexcat-bin_OBJDIR)/arch/*.o)
tools-flexcat-bin_ARCHFILES  := $(basename $(notdir $(tools-flexcat-bin_ARCHOBJS)))
tools-flexcat-bin_C_NARCHFILES := $(filter-out $(tools-flexcat-bin_ARCHFILES),$(tools-flexcat-bin_FILES))
tools-flexcat-bin_CXX_NARCHFILES := $(filter-out $(tools-flexcat-bin_ARCHFILES),$(tools-flexcat-bin_CXXFILES))
tools-flexcat-bin_OBJC_NARCHFILES := $(filter-out $(tools-flexcat-bin_ARCHFILES),$(tools-flexcat-bin_OBJCFILES))

TMP_FILES := $(tools-flexcat-bin_C_NARCHFILES) $(tools-flexcat-bin_CXX_NARCHFILES) $(tools-flexcat-bin_ASMFILES) $(tools-flexcat-bin_OBJC_NARCHFILES)
tools-flexcat-bin_OBJS := $(addsuffix .o,$(addprefix $(tools-flexcat-bin_OBJDIR)/,$(notdir $(TMP_FILES))))
tools-flexcat-bin_DEPS := $(addsuffix .d,$(addprefix $(tools-flexcat-bin_OBJDIR)/,$(notdir $(TMP_FILES))))

tools-flexcat-bin_CPPFLAGS :=  $(CPPFLAGS)
ifneq (,)
tools-flexcat-bin_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (target,target)
tools-flexcat-bin_CFLAGS            := $(CFLAGS)
endif
ifeq (target,host)
tools-flexcat-bin_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
tools-flexcat-bin_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
tools-flexcat-bin_CFLAGS            := 
endif

ifeq ("","")
ifeq (target,target)
tools-flexcat-bin_CXXFLAGS            := $(CXXFLAGS)
endif
ifeq (target,host)
tools-flexcat-bin_CXXFLAGS            := $(HOST_CXXFLAGS)
endif
ifeq (target,kernel)
tools-flexcat-bin_CXXFLAGS            := $(strip $(KERNEL_ISA_CXXFLAGS) $(KERNEL_CXXFLAGS))
endif
else
tools-flexcat-bin_CXXFLAGS          := 
endif

ifeq ("","")
ifeq (target,target)
tools-flexcat-bin_LDFLAGS            := $(LDFLAGS)
endif
ifeq (target,host)
tools-flexcat-bin_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (target,kernel)
tools-flexcat-bin_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
tools-flexcat-bin_LDFLAGS          := 
endif

tools-flexcat-bin_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
tools-flexcat-bin_COVERAGE := yes
tools-flexcat-bin_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
tools-flexcat-bin_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
tools-flexcat-bin_CFLAGS    := $(strip $(tools-flexcat-bin_COVERAGEFLAGS) $(tools-flexcat-bin_CFLAGS))
tools-flexcat-bin_CXXFLAGS := $(strip $(tools-flexcat-bin_COVERAGEFLAGS) $(tools-flexcat-bin_CXXFLAGS))
tools-flexcat-bin_LIBS += $(tools-flexcat-bin_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
tools-flexcat-bin_FUNCINSTR := yes
tools-flexcat-bin_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
tools-flexcat-bin_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
tools-flexcat-bin_CFLAGS    := $(strip $(tools-flexcat-bin_INSTRFUNCFLAGS) $(tools-flexcat-bin_CFLAGS))
tools-flexcat-bin_CXXFLAGS := $(strip $(tools-flexcat-bin_INSTRFUNCFLAGS) $(tools-flexcat-bin_CXXFLAGS))
tools-flexcat-bin_LIBS += $(tools-flexcat-bin_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
tools-flexcat-bin_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(tools-flexcat-bin_CFLAGS))
tools-flexcat-bin_CXXFLAGS := $(strip $(LTO_BINARY_CFLAGS) $(tools-flexcat-bin_CXXFLAGS))
endif
endif
tools-flexcat-bin_AFLAGS    := $(AFLAGS)
ifneq (,)
    tools-flexcat-bin_DFLAGS     := 
else
    tools-flexcat-bin_DFLAGS     := $(tools-flexcat-bin_CFLAGS)
endif
ifneq (,)
    tools-flexcat-bin_DXXFLAGS     := 
else
    tools-flexcat-bin_DXXFLAGS     := $(tools-flexcat-bin_CXXFLAGS)
endif
ifeq (target,target)
tools-flexcat-bin_LDFLAGS           := $(tools-flexcat-bin_LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
tools-flexcat-bin_LDFLAGS           := $(tools-flexcat-bin_LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
tools-flexcat-bin_LDFLAGS           := $(tools-flexcat-bin_LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
tools-flexcat-bin_LDFLAGS   += -L
endif

#MM
tools-flexcat-bin-quick : tools-flexcat-bin

#MM tools-flexcat-bin : includes-generate-deps core-linklibs
tools-flexcat-bin : $(tools-flexcat-bin_TARGETDIR)/$(tools-flexcat-bin_PROGNAME)

ifneq ($(filter $(TARGET),tools-flexcat-bin tools-flexcat-bin-quick tools-flexcat-bin-gz-quick),)

tools-flexcat-bin_CXXABSBASENAMES := $(foreach tools-flexcat-bin_CXXBASE,$(tools-flexcat-bin_CXX_NARCHFILES),$(if $(filter /%,$(tools-flexcat-bin_CXXBASE)),$(tools-flexcat-bin_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(tools-flexcat-bin_CXXBASE))))

ifneq ($(tools-flexcat-bin_CXXABSBASENAMES),)

tools-flexcat-bin_CXXBASENAMES := $(basename $(tools-flexcat-bin_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
tools-flexcat-bin_MCXX_FILES  := $(strip $(foreach tools-flexcat-bin_CXXBASE,$(tools-flexcat-bin_CXXABSBASENAMES), $(firstword $(wildcard $(foreach tools-flexcat-bin_EXT, $(AROS_CXXEXTS),$(addsuffix .$(tools-flexcat-bin_EXT),$(tools-flexcat-bin_CXXBASE)))))))

ifeq (,)
tools-flexcat-bin_MCXX_SRCWILDCARD := %
else
tools-flexcat-bin_MCXX_SRCWILDCARD := /%
endif

ifeq ($(tools-flexcat-bin_OBJDIR),)
  tools-flexcat-bin_CXXTARGETS := $(notdir $(tools-flexcat-bin_CXXBASENAMES:=.o))
  tools-flexcat-bin_CXXDTARGETS := $(notdir $(tools-flexcat-bin_CXXBASENAMES:=.d))
  tools-flexcat-bin_MCXX_WILDCARD := %
else
  tools-flexcat-bin_CXXTARGETS := $(addprefix $(tools-flexcat-bin_OBJDIR)/,$(notdir $(tools-flexcat-bin_CXXBASENAMES:=.o)))
  tools-flexcat-bin_CXXDTARGETS := $(addprefix $(tools-flexcat-bin_OBJDIR)/,$(notdir $(tools-flexcat-bin_CXXBASENAMES:=.d)))
  tools-flexcat-bin_MCXX_WILDCARD := $(tools-flexcat-bin_OBJDIR)/%

  # Be sure that all source files are generated
  $(tools-flexcat-bin_CXXTARGETS) $(tools-flexcat-bin_CXXDTARGETS) : | $(tools-flexcat-bin_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
tools-flexcat-bin_MCXX_CPPFLAGS := $(tools-flexcat-bin_CPPFLAGS)
tools-flexcat-bin_CXXFLAGS := $(tools-flexcat-bin_CXXFLAGS)
ifeq ($(tools-flexcat-bin_DXXFLAGS),)
  tools-flexcat-bin_DXXFLAGS := $(tools-flexcat-bin_CXXFLAGS)
else
  tools-flexcat-bin_DXXFLAGS := $(tools-flexcat-bin_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  tools-flexcat-bin_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  tools-flexcat-bin_STRIP ?= $(HOST_STRIP)
  tools-flexcat-bin_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  tools-flexcat-bin_CXXCMD:=$(HOST_CXX)
  tools-flexcat-bin_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(tools-flexcat-bin_MCXX_CPPFLAGS) $(tools-flexcat-bin_MCXX_EXTRA_CPPFLAGS))
  tools-flexcat-bin_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(tools-flexcat-bin_CXXFLAGS))
  tools-flexcat-bin_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(tools-flexcat-bin_DXXFLAGS))
  tools-flexcat-bin_CXXIQUOTE:=$(HOST_IQUOTE)
  tools-flexcat-bin_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  tools-flexcat-bin_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  tools-flexcat-bin_STRIP ?= $(TARGET_STRIP)
  tools-flexcat-bin_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  tools-flexcat-bin_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  tools-flexcat-bin_MCXX_CPPFLAGS := $(strip $(tools-flexcat-bin_MCXX_CPPFLAGS) $(tools-flexcat-bin_MCXX_EXTRA_CPPFLAGS))
  tools-flexcat-bin_CXXFLAGS := $(strip $(tools-flexcat-bin_CXXFLAGS) $(SAFETY_CFLAGS))
  tools-flexcat-bin_DXXFLAGS := $(tools-flexcat-bin_DXXFLAGS)
  tools-flexcat-bin_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  tools-flexcat-bin_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  tools-flexcat-bin_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  tools-flexcat-bin_STRIP ?= $(ECHO) >/dev/null
  tools-flexcat-bin_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  tools-flexcat-bin_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  tools-flexcat-bin_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(tools-flexcat-bin_MCXX_CPPFLAGS) $(tools-flexcat-bin_MCXX_EXTRA_CPPFLAGS))
  tools-flexcat-bin_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(tools-flexcat-bin_CXXFLAGS))
  tools-flexcat-bin_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(tools-flexcat-bin_DXXFLAGS))
  tools-flexcat-bin_CXXIQUOTE:=$(KERNEL_IQUOTE)
  tools-flexcat-bin_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(tools-flexcat-bin_CXXCMD) $(tools-flexcat-bin_CXXIQUOTE) $(dir $(2)) $(tools-flexcat-bin_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-flexcat-bin_CXXIQUOTE) . $(tools-flexcat-bin_CXXIQUOTE_END) $(strip $(tools-flexcat-bin_CXXFLAGS) $(tools-flexcat-bin_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(tools-flexcat-bin_CXXCMD) $(tools-flexcat-bin_CXXIQUOTE) $(dir $(2)) $(tools-flexcat-bin_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-flexcat-bin_CXXIQUOTE) . $(tools-flexcat-bin_CXXIQUOTE_END) $(strip $(tools-flexcat-bin_CXXFLAGS) $(tools-flexcat-bin_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(tools-flexcat-bin_CXXCMD) $(tools-flexcat-bin_CXXIQUOTE) $(dir $(2)) $(tools-flexcat-bin_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(tools-flexcat-bin_CXXIQUOTE) . $(tools-flexcat-bin_CXXIQUOTE_END) $(strip $(tools-flexcat-bin_CXXFLAGS) $(tools-flexcat-bin_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(tools-flexcat-bin_CXXCMD)" $(MKDEPEND) $(strip $(tools-flexcat-bin_DXXFLAGS) $(tools-flexcat-bin_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(tools-flexcat-bin_OBJDIR),)
  $(foreach tools-flexcat-bin_CXXFILE,$(tools-flexcat-bin_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(tools-flexcat-bin_CXXFILE))),$(tools-flexcat-bin_CXXFILE))))
else
  $(foreach tools-flexcat-bin_CXXFILE,$(tools-flexcat-bin_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(tools-flexcat-bin_OBJDIR)/,$(notdir $(basename $(tools-flexcat-bin_CXXFILE)))),$(tools-flexcat-bin_CXXFILE))))
endif

endif


ifneq ($(tools-flexcat-bin_OBJC_NARCHFILES),)

ifeq (,)
tools-flexcat-bin_MOBJC_SRCWILDCARD := %
else
tools-flexcat-bin_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(tools-flexcat-bin_OBJDIR),)
  tools-flexcat-bin_MOBJC_TARGETS := $(addsuffix .o,$(tools-flexcat-bin_OBJC_NARCHFILES))
  tools-flexcat-bin_MOBJC_DTARGETS := $(addsuffix .d,$(tools-flexcat-bin_OBJC_NARCHFILES))
  tools-flexcat-bin_MOBJC_WILDCARD := %
else
  tools-flexcat-bin_MOBJC_TARGETS := $(addsuffix .o,$(addprefix $(tools-flexcat-bin_OBJDIR)/,$(tools-flexcat-bin_OBJC_NARCHFILES)))
  tools-flexcat-bin_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(tools-flexcat-bin_OBJDIR)/,$(tools-flexcat-bin_OBJC_NARCHFILES)))
  tools-flexcat-bin_MOBJC_WILDCARD := $(tools-flexcat-bin_OBJDIR)/%

  # Be sure that all .m files are generated
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : | $(addsuffix .m,$(tools-flexcat-bin_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  tools-flexcat-bin_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  tools-flexcat-bin_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(tools-flexcat-bin_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  tools-flexcat-bin_MOBJC_DIRS := $(foreach dir, $(tools-flexcat-bin_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(tools-flexcat-bin_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(tools-flexcat-bin_MOBJC_DIRS),)
    tools-flexcat-bin_MOBJC_DIRS := $(shell echo $(tools-flexcat-bin_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(tools-flexcat-bin_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  tools-flexcat-bin_CC := $(TARGET_CC)
else
  tools-flexcat-bin_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
tools-flexcat-bin_MOBJC_CPPFLAGS := $(tools-flexcat-bin_CPPFLAGS)
tools-flexcat-bin_OBJCFLAGS := $(tools-flexcat-bin_CFLAGS)
tools-flexcat-bin_OBJCFLAGS := $(tools-flexcat-bin_OBJCFLAGS) -isystem $(AROS_DEVELOPER)/include
tools-flexcat-bin_OBJCFLAGS := $(subst -Wno-pointer-sign,, $(subst -Werror-implicit-function-declaration,, $(tools-flexcat-bin_OBJCFLAGS)))
ifeq ($(tools-flexcat-bin_DFLAGS),)
  tools-flexcat-bin_OBJCDFLAGS := $(tools-flexcat-bin_CFLAGS)
else
  tools-flexcat-bin_OBJCDFLAGS := $(tools-flexcat-bin_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  tools-flexcat-bin_LINK ?= $(strip $(tools-flexcat-bin_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  tools-flexcat-bin_STRIP ?= $(TARGET_STRIP)
  tools-flexcat-bin_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : CMD:=$(strip $(tools-flexcat-bin_CC) $(TARGET_SYSROOT))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_MOBJC_CPPFLAGS:=$(strip $(tools-flexcat-bin_MOBJC_CPPFLAGS) $(tools-flexcat-bin_MOBJC_EXTRA_CPPFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_OBJCFLAGS:=$(strip $(tools-flexcat-bin_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_OBJCDFLAGS:=$(tools-flexcat-bin_OBJCDFLAGS)
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_IQUOTE:=$(CFLAGS_IQUOTE)
  $(tools-flexcat-bin_MOBJC_TARGETS) $(tools-flexcat-bin_MOBJC_DTARGETS) : tools-flexcat-bin_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
