include $(SRCDIR)/config/aros.cfg

LN ?= ln

ICU_VERSION := 4.2.1
ICU_PKGNAME := icu4c
ICU_PKGVERSION=$(subst .,_,$(ICU_VERSION))

ICU_EXTRA_OPTS = \
        --bindir=$(CROSSTOOLSDIR) \
        --sbindir=$(CROSSTOOLSDIR) \
        --enable-static \
        --disable-strict \
        --disable-dyload \
        --disable-shared \
        --disable-tests \
        --disable-samples \
        --disable-extras \
        --with-data-packaging=static

ICU_REPOSITORY := http://download.icu-project.org/files/$(ICU_PKGNAME)/$(ICU_VERSION)

icu-installflag := $(CROSSTOOLSDIR)/.installflag-icu-$(ICU_VERSION)

#MM
tools-crosstools-icu :
	@$(IF) ! $(TEST) -d $(CROSSTOOLSDIR) \
	    || ! $(TEST) -f $(icu-installflag) ; then \
	       $(RM) $(CROSSTOOLSDIR)/$(ICU_PKGNAME)/.files-touched \
	    && $(MAKE) -f ./mmakefile crosstools-icu--fetch \
	    && $(MAKE) -f ./mmakefile crosstools-icu--build_and_install-quick \
	    && $(TOUCH) $(icu-installflag) ; \
	fi

HOST_CXXFLAGS := $(subst -Wno-pointer-sign,, $(subst -Werror-implicit-function-declaration,, $(HOST_CXXFLAGS)))

# specify the gendir for icu to be in HOSTDIR so it ends up under CROSSTOOLSDIR, and can be reused

#MM- crosstools-icu-quick : crosstools-icu--quick
#MM- crosstools-icu--quick : crosstools-icu--fetch
#MM- crosstools-icu-fetch : crosstools-icu--fetch
#MM- crosstools-icu-create-patch : crosstools-icu--create-patch
#MM- crosstools-icu-create-patch-quick : crosstools-icu--create-patch
 
crosstools-icu-archbase                        := $(ICU_PKGNAME)-$(ICU_PKGVERSION)-src

ifeq (host,host)
    crosstools-icu-portdir                     := $(HOSTDIR)/Ports/host/$(ICU_PKGNAME)
else
    crosstools-icu-portdir                     := $(PORTSDIR)/$(ICU_PKGNAME)
endif

ifeq ($(CROSSTOOLSDIR),)
    crosstools-icu-prefix                      := $(CONTRIB_DIR)/$(ICU_PKGNAME)
else
    crosstools-icu-prefix                      := $(CROSSTOOLSDIR)
endif

ifneq (,)
    crosstools-icu--archbase      := $(ICU_PKGNAME)--$(ICU_PKGVERSION)-src
else
    crosstools-icu--archbase      := $(ICU_PKGNAME)-$(ICU_PKGVERSION)-src
endif

ifneq (icu,)
    crosstools-icu--srcdir        := icu
else
    crosstools-icu--srcdir        := $(crosstools-icu-archbase)
endif

ifneq (source,)
    crosstools-icu--builddir      := $(crosstools-icu--srcdir)/source
else
    crosstools-icu--builddir      := $(crosstools-icu--srcdir)
endif

ifeq (yes,yes)
    crosstools-icu--patches_specs := $(crosstools-icu--archbase)-aros.diff:$(crosstools-icu--srcdir):-f,-p1
else
    crosstools-icu--patches_specs := ::
endif


.PHONY: crosstools-icu--fetch

ifneq ($(TOOLDIR),)
    crosstools-icu--fetch-tooldir := "$(TOOLDIR)/"
else
    crosstools-icu--fetch-tooldir := "$(TOOLDIR)/"
endif

ifneq ($(PORTSSOURCEDIR),)
    crosstools-icu--fetch-location := $(PORTSSOURCEDIR)
else
    crosstools-icu--fetch-location := $(crosstools-icu-portdir)
endif

crosstools-icu--fetch-fetchedflag := $(crosstools-icu--fetch-location)/.$(crosstools-icu--archbase)-fetched

#MM
crosstools-icu--fetch :
	$(Q)$(ECHO) "Fetching   $(crosstools-icu--archbase) ..."
	$(Q)TOOLDIR="$(crosstools-icu--fetch-tooldir)" $(FETCH) -ao ". $(ICU_REPOSITORY)" -a $(crosstools-icu--archbase) -s "tgz" -l $(crosstools-icu--fetch-location) \
	-d $(crosstools-icu-portdir) -po "$(SRCDIR)/$(CURDIR)" -p "$(crosstools-icu--patches_specs)"
	$(Q)$(IF) ! $(TEST) -f $(crosstools-icu--fetch-fetchedflag) ; then \
		 $(TOUCH) $(crosstools-icu--fetch-fetchedflag) ; \
	fi

#	$(Q)$(IF) ! $(TEST) -f $(crosstools-icu--fetch-fetchedflag) ; then \
#		$(ECHO) "Fetching   $(crosstools-icu--archbase) ..." \
#		&& $(FETCH) -ao ". $(ICU_REPOSITORY)" -a $(crosstools-icu--archbase) -s "tgz" -l $(crosstools-icu--fetch-location) \
#		-d $(crosstools-icu-portdir) -po "$(SRCDIR)/$(CURDIR)" -p "$(crosstools-icu--patches_specs)" \
#		&& $(TOUCH) $(crosstools-icu--fetch-fetchedflag) ; \
#	fi


.PHONY: crosstools-icu--create-patch

ifneq (,)
    crosstools-icu--create-patch-exclude := -X ./exclude.patterns
endif

ifneq ($(crosstools-icu--srcdir),)
    crosstools-icu--create-patch-srcdir   := $(crosstools-icu--srcdir)
else
    crosstools-icu--create-patch-srcdir   := $(crosstools-icu--archbase)
endif

#MM- crosstools-icu--create-patch :  crosstools-icu--create-patch-diff 
#MM- crosstools-icu--create-patch-quick :  crosstools-icu--create-patch-diff 

#MM
crosstools-icu--create-patch-diff:
	$(Q)$(FETCH) -a $(crosstools-icu--archbase) -s "tgz" -l $(PORTSSOURCEDIR) -d $(crosstools-icu-portdir)/tmp ; \
	$(MV) $(crosstools-icu-portdir)/$(crosstools-icu--create-patch-srcdir) $(crosstools-icu-portdir)/tmp/$(crosstools-icu--create-patch-srcdir).aros ; \
	cd $(crosstools-icu-portdir)/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(crosstools-icu--archbase)-aros-new.diff'" ; \
	diff -ruN $(crosstools-icu--create-patch-exclude) \
	    $(crosstools-icu--create-patch-srcdir) \
	    $(crosstools-icu--create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(crosstools-icu--archbase)-aros-new.diff ; \
	$(MV) $(crosstools-icu-portdir)/tmp/$(crosstools-icu--create-patch-srcdir).aros $(crosstools-icu-portdir)/$(crosstools-icu--create-patch-srcdir) ; \
	$(RM) $(crosstools-icu-portdir)/tmp

