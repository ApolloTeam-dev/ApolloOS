crosstools-icu--touchfileflag ?= $(crosstools-icu--pkgdir)/.files-touched

ifneq ("$(wildcard $(crosstools-icu-portdir)/$(crosstools-icu--builddir)/Makefile)","")
# in an ideal world, we would depend on the files in the source directory,
# so we could copy them when they change. unfortunately filenames with
# spaces cause problems with this
$(crosstools-icu--pkgdir)/.local-copy:
	$(Q)$(FOR) dir in $(crosstools-icu--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Copying Local-Build Sources to  \`$(patsubst $(TOP)/%,%,$(abspath $(crosstools-icu--pkgdir)))'"
	$(Q)$(CP) -Rf "$(crosstools-icu-portdir)/$(crosstools-icu--builddir)/." $(crosstools-icu--pkgdir)/ && $(TOUCH) $@

$(crosstools-icu--touchfileflag) : $(crosstools-icu--pkgdir)/.local-copy

    crosstools-icu--cfg-srcdir=$(crosstools-icu--pkgdir)
else
    crosstools-icu--cfg-srcdir=$(crosstools-icu-portdir)/$(crosstools-icu--builddir)
endif
crosstools-icu--make-env := -C $(crosstools-icu--pkgdir)

.PHONY : crosstools-icu- crosstools-icu--clean crosstools-icu--build_and_install-quick

# When building for the host, we don't need to build the
# linklibs - this is especially true when building the
# crosstool toolchain on 'foreign' architectures (such as
# building PPC on x86)

#MM- crosstools-icu--host : setup includes crosstools-icu--quick
#MM- crosstools-icu--target : setup includes core-linklibs crosstools-icu--quick
#MM- crosstools-icu-: crosstools-icu--host

# Using -j1 in install_command may result in a warning but finally
# it does its job. make install for gcc does not work reliably for -jN
# where N > 1.
ifneq (install,)
    crosstools-icu--install_command = \
        $(ECHO) "Installing from build in         $(subst $(TOP)/,,$(crosstools-icu--pkgdir))" && \
        $(MAKE) PROGDIR="$(crosstools-icu--PROGDIR)/" $(crosstools-icu--install_opts) \
        $(crosstools-icu--make-env) install -j1

    crosstools-icu--uninstall_command = \
    $(RM) $(crosstools-icu--installflag) && \
    $(MAKE) PROGDIR="$(crosstools-icu--PROGDIR)/" \
    $(crosstools-icu--install_opts) $(crosstools-icu--make-env) uninstall
else
    crosstools-icu--install_command   := true
    crosstools-icu--uninstall_command := true
endif

#MM- crosstools-icu--quick :  crosstools-icu--configure  crosstools-icu--build_and_install-quick crosstools-icu--make-package

#MM
crosstools-icu--build_and_install-quick :  $(crosstools-icu--installflag)

#
# N.B.: the make test for the targets being up to date generates a benign Error 1.
#
$(crosstools-icu--installflag) : $(crosstools-icu--configflag)
	$(Q)$(IF) ! $(BUILD_ENV) $(MAKE) PROGDIR="$(call crosstools-icu--volfunc, PROGDIR)" -q $(crosstools-icu--make-env); then \
	    $(RM) $(crosstools-icu--installflag) && \
	    $(ECHO) "Performing build in         $(subst $(TOP)/,,$(crosstools-icu--pkgdir))" && \
	    $(BUILD_ENV) $(MAKE) PROGDIR="$(call crosstools-icu--volfunc, PROGDIR)" $(crosstools-icu--make-env) && \
	    $(crosstools-icu--install_command) && \
	    $(TOUCH) $@ -r $^; \
	fi

ifneq ($(crosstools-icu--touchfileflag),)
$(crosstools-icu--touchfileflag):
	$(Q)$(FOR) dir in $(crosstools-icu--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)find $(crosstools-icu-portdir)/$(crosstools-icu--builddir) -exec $(TOUCH) -c -r $(crosstools-icu--cfg-srcdir)/configure '{}' \; && \
	$(TOUCH) $@
endif

#MM
crosstools-icu--uninstall :
	$(crosstools-icu--uninstall_command)

#MM
crosstools-icu--configure : $(crosstools-icu--configflag)

$(crosstools-icu--configflag) : TMP_SRCDIR := $(shell echo $(crosstools-icu--cfg-srcdir) | sed 's/^\(.\):\//\/\1\//')
$(crosstools-icu--configflag) : $(crosstools-icu--touchfileflag) $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	$(Q)$(FOR) dir in $(crosstools-icu--pkgdir) ; do \
		$(IF) $(TEST) ! -d $$dir ; then $(MKDIR) $$dir ; else $(NOP) ; fi ; \
	done
	$(Q)$(ECHO) "Configuring build in         $(subst $(TOP)/,,$(crosstools-icu--pkgdir))"
	$(Q)cd $(crosstools-icu--pkgdir) && \
	find . -name config.cache -exec $(RM) '{}' \; && \
	$(crosstools-icu--cfg-env) $(TMP_SRCDIR)/configure $(crosstools-icu--config_opts) $(ICU_EXTRA_OPTS) && \
	$(TOUCH) $@

#MM
crosstools-icu--clean : crosstools-icu--uninstall
	$(Q)$(RM) $(crosstools-icu--pkgdir)

.PHONY : crosstools-icu--make-package crosstools-icu--create-patch
#MM crosstools-icu--make-package : crosstools-icu--quick

#MM
crosstools-icu--make-package : $(crosstools-icu--package)
 
#There seems to be a bug, either with my clock or with make, 'cause it may happen
#that $^ and $@ have exactly the same mtime, and in that case make tries
#to rebuild $@ again, which would fail because the directory where
#the package got installed would not exist anymore. 
#We work this around by using an if statement to manually check the mtimes.
$(crosstools-icu--package-basename).tar.bz2 :
	$(Q)$(IF) $(TEST) $(crosstools-icu-installflag) -nt $@ || ! $(TEST) -s $@; then \
	    $(RM) $@ ; \
	    $(ECHO) "Building   \`$(crosstools-icu--package-basename).tar.bz2'" ; \
	    $(MKDIR) -p "$(DISTDIR)/Packages" ; \
	    $(MKDIR) -p "$(crosstools-icu-prefix)" ; \
	    cd $(crosstools-icu--package-dir) ; \
	    tar -cvf $(crosstools-icu--package-basename).tar * ; \
	    bzip2 -9 -f $(crosstools-icu--package-basename).tar ; \
	fi

# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

