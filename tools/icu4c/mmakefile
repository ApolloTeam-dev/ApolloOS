    # the "plain" host compiler.
    crosstools-icu--cfg-env :=  \
        CPP="$(HOST_CPP)" \
        CXXCPP="$(HOST_CPP)" \
        CC="$(strip $(HOST_DEF_CC) $(crosstools-icu--HOST_CFLAGS) -I$(CROSSTOOLSDIR)/include)" \
        CXX="$(strip $(HOST_CXX) $(crosstools-icu--HOST_CXXFLAGS) -I$(CROSSTOOLSDIR)/include)" \
