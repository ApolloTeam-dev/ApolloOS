compiler-stdc-genmakefile_DEPS := $(GENMODULE)
ifneq (,)
    ifeq ($(dir ),./)
        compiler-stdc-genmakefile_OPTS += -c $(SRCDIR)/$(CURDIR)/
        compiler-stdc-genmakefile_DEPS += $(SRCDIR)/$(CURDIR)/
    else
        compiler-stdc-genmakefile_OPTS += -c 
        compiler-stdc-genmakefile_DEPS += 
    endif 
else
    compiler-stdc-genmakefile_OPTS += -c $(SRCDIR)/$(CURDIR)/stdc.conf
    compiler-stdc-genmakefile_DEPS += $(SRCDIR)/$(CURDIR)/stdc.conf
endif
ifneq (,)
    ifeq ($(dir ),./)
        compiler-stdc-genmakefile_OPTS += -o $(SRCDIR)/$(CURDIR)/
        compiler-stdc-genmakefile_DEPS += $(SRCDIR)/$(CURDIR)/
    else
        compiler-stdc-genmakefile_OPTS += -o 
        compiler-stdc-genmakefile_DEPS += 
    endif 
endif
ifneq (,)
    compiler-stdc-genmakefile_OPTS += -s 
endif
ifneq ($(compiler-stdc_OBJDIR),)
    compiler-stdc-genmakefile_OPTS += -d $(compiler-stdc_OBJDIR)
    compiler-stdc-genmakefile_TARGET := $(compiler-stdc_OBJDIR)/$(compiler-stdc-genmakefile_TARGET)
endif

$(compiler-stdc-genmakefile_TARGET) : OPTS := $(compiler-stdc-genmakefile_OPTS)
$(compiler-stdc-genmakefile_TARGET) : MODNAME := stdc
$(compiler-stdc-genmakefile_TARGET) : MODTYPE := library
$(compiler-stdc-genmakefile_TARGET) : $(compiler-stdc-genmakefile_DEPS)
	$(Q)$(GENMODULE) $(OPTS) writemakefile $(MODNAME) $(MODTYPE)


ifneq ($(compiler-stdc-makefile),)
