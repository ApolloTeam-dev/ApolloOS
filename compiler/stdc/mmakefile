define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(compiler-stdcio_CXXCMD) $(compiler-stdcio_CXXIQUOTE) $(dir $(2)) $(compiler-stdcio_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(compiler-stdcio_CXXIQUOTE) . $(compiler-stdcio_CXXIQUOTE_END) $(strip $(compiler-stdcio_CXXFLAGS) $(compiler-stdcio_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(compiler-stdcio_CXXCMD) $(compiler-stdcio_CXXIQUOTE) $(dir $(2)) $(compiler-stdcio_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(compiler-stdcio_CXXIQUOTE) . $(compiler-stdcio_CXXIQUOTE_END) $(strip $(compiler-stdcio_CXXFLAGS) $(compiler-stdcio_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(compiler-stdcio_CXXCMD) $(compiler-stdcio_CXXIQUOTE) $(dir $(2)) $(compiler-stdcio_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(compiler-stdcio_CXXIQUOTE) . $(compiler-stdcio_CXXIQUOTE_END) $(strip $(compiler-stdcio_CXXFLAGS) $(compiler-stdcio_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(compiler-stdcio_CXXCMD)" $(MKDEPEND) $(strip $(compiler-stdcio_DXXFLAGS) $(compiler-stdcio_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(compiler-stdcio_OBJDIR),)
  $(foreach compiler-stdcio_CXXFILE,$(compiler-stdcio_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(compiler-stdcio_CXXFILE))),$(compiler-stdcio_CXXFILE))))
else
  $(foreach compiler-stdcio_CXXFILE,$(compiler-stdcio_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(compiler-stdcio_OBJDIR)/,$(notdir $(basename $(compiler-stdcio_CXXFILE)))),$(compiler-stdcio_CXXFILE))))
