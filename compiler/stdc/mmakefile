# We will employ a terrifying, but unavoidable, hack here.
# genmf has no concept of conditionals (ie %ifeq), and MetaMake
# ignores GNU Make ifeq() statements, but will process any #MM
# headed lines in the file.
# 
# So, to make the following #MM lines conditional on whether we want
# to build the ABI, Library, or both, we define build_abi= and 
# build_library as 'M' to enable, or '' to disable, which allows genmf
# to do the following conversions:
# 
#  #MM includes-foo: foo-include
#    becomes, when build_abi=M
#  #MM includes-foo: foo-include   <= Processed by MetaMake
#    but, when build_abi= ...
#  #M includes-foo: foo-includes   <= ignored by MetaMake! Yes!
# 
# Taking full blame for this: Jason S. McMullan <jason.mcmullan@gmail.com>

# Define metamake targets and their dependencies
#MM compiler-stdc
#MM compiler-stdc-quick
#MM compiler-stdc-makefile
#MM compiler-stdc-clean

# ABI targets:
#MM- includes-all : compiler-stdc-includes
#MM- linklibs-stdc: compiler-stdc-linklib
#MM- linklibs-stdc_rel : compiler-stdc-linklib
#MM- includes-stdc: compiler-stdc-includes
#MM- includes-stdc_rel : compiler-stdc-includes
#MM- compiler-stdc : compiler-stdc-includes core-linklibs linklibs-
#MM compiler-stdc-linklib : compiler-stdc-includes includes-
#MM- compiler-stdc-quick : compiler-stdc-includes-quick
#MM compiler-stdc-includes : compiler-stdc-makefile compiler-stdc-includes-dirs \
#MM     includes-generate-deps compiler-stdc-fd
#MM compiler-stdc-includes-quick
#MM compiler-stdc-includes-dirs
#MM compiler-stdc-fd

# Library targets
#MM compiler-stdc-kobj : core-linklibs linklibs-
#MM compiler-stdc-kobj-quick : 

# Library with ABI targets:
#MM compiler-stdc-kobj : compiler-stdc-includes core-linklibs linklibs-
#MM compiler-stdc-kobj-quick : compiler-stdc-includes-quick

# All MetaMake targets defined by this macro
compiler-stdc_ALLTARGETS       := compiler-stdc compiler-stdc-quick compiler-stdc-clean

ifeq (M,M)
compiler-stdc_ALLTARGETS       += compiler-stdc-kobj compiler-stdc-kobj-quick
endif

ifeq (M,M)
compiler-stdc_ALLTARGETS += compiler-stdc-includes \
                 compiler-stdc-includes-quick compiler-stdc-includes-dirs  \
                 compiler-stdc-linklib compiler-stdc-fd
endif

