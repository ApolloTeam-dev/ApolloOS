#MM- includes-posixc_rel : compiler-posixc-includes
#MM- compiler-posixc : compiler-posixc-includes core-linklibs linklibs-stdc_rel linklibs-stdcio_rel
#MM compiler-posixc-linklib : compiler-posixc-includes includes-stdc_rel includes-stdcio_rel
#MM- compiler-posixc-quick : compiler-posixc-includes-quick
#MM compiler-posixc-includes : compiler-posixc-makefile compiler-posixc-includes-dirs \
