	    UtilityBase ExpansionBase KeymapBase KernelBase

kernel-cgxbootpic_SYMBOLS := $(kernel-cgxbootpic_KBASE)

kernel-cgxbootpic_KLIB             := hiddstubs amiga arossupport autoinit libinit
kernel-cgxbootpic_KOBJ_LIBS        := $(filter-out $(kernel-cgxbootpic_KLIB),$(kernel-cgxbootpic_LIBS)) $(kernel-cgxbootpic_KAUTOLIB)
$(kernel-cgxbootpic_KOBJ) : LINKLIBS:=$(kernel-cgxbootpic_KOBJ_LIBS) $($(kernel-cgxbootpic_DEFNAME)_LIBS)
$(kernel-cgxbootpic_KOBJ) : FILTBASES:=$(addprefix -L ,$(kernel-cgxbootpic_SYMBOLS))
$(kernel-cgxbootpic_KOBJ) : USER_LDFLAGS:=$(USER_LDFLAGS)
$(kernel-cgxbootpic_KOBJ) : $(kernel-cgxbootpic_OBJS) $(USER_OBJS) $(kernel-cgxbootpic_ENDOBJS)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$@)"
	$(Q)$(AROS_LD) -Ur -o $@ $^ $(USER_LDFLAGS) -L$(AROS_LIB) $(addprefix -l,$(LINKLIBS))
	$(Q)$(OBJCOPY) $@ $(FILTBASES) `$(NM_PLAIN) $@ | $(AWK) '($$3 ~ /^__.*_(LIST|END)__\r?$$/) || ($$3 ~ /^__aros_lib.*\r?$$/) {print "-L " $$3;}'`
endif

