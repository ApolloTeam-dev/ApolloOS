ifeq (M,M)
# Link kernel object file
kernel-ahci_KAUTOLIB         := dos intuition layers graphics oop utility expansion keymap

# Make these symbols local
kernel-ahci_KBASE            := DOSBase IntuitionBase LayersBase GfxBase OOPBase \
	    UtilityBase ExpansionBase KeymapBase KernelBase

kernel-ahci_SYMBOLS := $(kernel-ahci_KBASE)

kernel-ahci_KLIB             := hiddstubs amiga arossupport autoinit libinit
kernel-ahci_KOBJ_LIBS        := $(filter-out $(kernel-ahci_KLIB),$(kernel-ahci_LIBS)) $(kernel-ahci_KAUTOLIB)
$(kernel-ahci_KOBJ) : LINKLIBS:=$(kernel-ahci_KOBJ_LIBS) $($(kernel-ahci_DEFNAME)_LIBS)
$(kernel-ahci_KOBJ) : FILTBASES:=$(addprefix -L ,$(kernel-ahci_SYMBOLS))
$(kernel-ahci_KOBJ) : USER_LDFLAGS:=$(USER_LDFLAGS)
$(kernel-ahci_KOBJ) : $(kernel-ahci_OBJS) $(USER_OBJS) $(kernel-ahci_ENDOBJS)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$@)"
	$(Q)$(AROS_LD) -Ur -o $@ $^ $(USER_LDFLAGS) -L$(AROS_LIB) $(addprefix -l,$(LINKLIBS))
	$(Q)$(OBJCOPY) $@ $(FILTBASES) `$(NM_PLAIN) $@ | $(AWK) '($$3 ~ /^__.*_(LIST|END)__\r?$$/) || ($$3 ~ /^__aros_lib.*\r?$$/) {print "-L " $$3;}'`
endif

## Dependency fine-tuning
##
kernel-ahci_DEPS             := $(addprefix $(kernel-ahci_OBJDIR)/,$(notdir $(kernel-ahci_CCFILES:=.d) $(kernel-ahci_TARGETCCFILES:=.d) $(kernel-ahci_CXXFILES:=.d))) $(addprefix $(kernel-ahci_OBJDIR)/linklib/,$(notdir $(kernel-ahci_LINKLIBCCFILES:=.d)))

ifneq ($(kernel-ahci_DEPS),)
  ifneq (kernel-ahci kernel-ahci-quick kernel-ahci-kobj kernel-ahci-kobj-quick,)
    ifneq ($(findstring $(TARGET),kernel-ahci kernel-ahci-quick kernel-ahci-kobj kernel-ahci-kobj-quick),)
      -include $(kernel-ahci_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-ahci_DEPS)
    endif
  endif
endif

$(kernel-ahci_OBJS) $(kernel-ahci_DEPS) : | $(kernel-ahci_OBJDIR)/linklib

ifneq ($(kernel-ahci_OBJS) $(kernel-ahci_DEPS) $(kernel-ahci_MODULE) $(kernel-ahci_KOBJ),)
$(kernel-ahci_OBJS) $(kernel-ahci_DEPS) $(kernel-ahci_MODULE) $(kernel-ahci_KOBJ) : | $(kernel-ahci_OBJDIR) $(AROSDIR)/$(kernel-ahci_MODDIR) $(KOBJSDIR)
else
$(kernel-ahci_OBJS) $(kernel-ahci_DEPS) $(kernel-ahci_MODULE) $(kernel-ahci_KOBJ) :: $(kernel-ahci_OBJDIR) $(AROSDIR)/$(kernel-ahci_MODDIR) $(KOBJSDIR)
endif

GLOB_MKDIRS += $(kernel-ahci_OBJDIR) $(AROSDIR)/$(kernel-ahci_MODDIR) $(KOBJSDIR)


# Some include files need to be generated before the .c can be parsed.
ifneq ($(filter $(TARGET),kernel-ahci kernel-ahci-includes kernel-ahci-quick kernel-ahci-kobj kernel-ahci-kobj-quick),) # Only for this target these deps are wanted

kernel-ahci_DFILE_DEPS := $(kernel-ahci_LIBDEFSINC) $(kernel-ahci_DEFLIBDEFSINC) \
    $(addprefix $(kernel-ahci_INCDIR)/,$($(kernel-ahci_DEFNAME)_INCLUDES))
$(kernel-ahci_DEPS) : $(kernel-ahci_DFILE_DEPS)
endif

kernel-ahci_TOCLEAN := $(kernel-ahci_OBJS) $(kernel-ahci_DEPS) \
    $(kernel-ahci_MODULE) $(kernel-ahci_LINKLIB) $(kernel-ahci_KOBJ) \
    $(kernel-ahci_OBJDIR)/Makefile.ahcidevice \
    $(addprefix $(kernel-ahci_OBJDIR)/include/,$($(kernel-ahci_DEFNAME)_INCLUDES)) \
    $(addprefix $(GENINCDIR)/,$($(kernel-ahci_DEFNAME)_INCLUDES)) \
    $(addprefix $(kernel-ahci_INCDIR)/,$($(kernel-ahci_DEFNAME)_INCLUDES)) \
    $(kernel-ahci_OBJDIR)/ahci_geninc $(kernel-ahci_OBJDIR)/ahci_incs \
    $(addsuffix .c,$(kernel-ahci_LINKLIBFILES)) $(kernel-ahci_LINKLIBOBJS) $(kernel-ahci_LIBDEFSINC) \
    $(kernel-ahci_DEFLIBDEFSINC) $(addsuffix .c,$(kernel-ahci_STARTFILES) $(kernel-ahci_ENDFILES)) \
    $(kernel-ahci_ENDOBJS)
kernel-ahci-clean : FILES              := $(kernel-ahci_TOCLEAN)
kernel-ahci-clean ::
	$(Q)$(ECHO) "Cleaning up for module ahci"
	$(Q)$(RM) $(FILES)

endif # $(TARGET) in $(kernel-ahci_ALLTARGETS)


