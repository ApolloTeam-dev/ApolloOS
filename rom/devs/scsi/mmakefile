#MM- includes-scsi_rel : kernel-scsi-includes
#MM- kernel-scsi : kernel-scsi-includes core-linklibs linklibs-
#MM kernel-scsi-linklib : kernel-scsi-includes includes-
#MM- kernel-scsi-quick : kernel-scsi-includes-quick
#MM kernel-scsi-includes : kernel-scsi-makefile kernel-scsi-includes-dirs \
