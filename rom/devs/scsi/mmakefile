# Link kernel object file
kernel-scsi_KAUTOLIB         := dos intuition layers graphics oop utility expansion keymap

# Make these symbols local
kernel-scsi_KBASE            := DOSBase IntuitionBase LayersBase GfxBase OOPBase \
	    UtilityBase ExpansionBase KeymapBase KernelBase

kernel-scsi_SYMBOLS := $(kernel-scsi_KBASE)

kernel-scsi_KLIB             := hiddstubs amiga arossupport autoinit libinit
kernel-scsi_KOBJ_LIBS        := $(filter-out $(kernel-scsi_KLIB),$(kernel-scsi_LIBS)) $(kernel-scsi_KAUTOLIB)
$(kernel-scsi_KOBJ) : LINKLIBS:=$(kernel-scsi_KOBJ_LIBS) $($(kernel-scsi_DEFNAME)_LIBS)
$(kernel-scsi_KOBJ) : FILTBASES:=$(addprefix -L ,$(kernel-scsi_SYMBOLS))
$(kernel-scsi_KOBJ) : USER_LDFLAGS:=$(USER_LDFLAGS)
$(kernel-scsi_KOBJ) : $(kernel-scsi_OBJS) $(USER_OBJS) $(kernel-scsi_ENDOBJS)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$@)"
	$(Q)$(AROS_LD) -Ur -o $@ $^ $(USER_LDFLAGS) -L$(AROS_LIB) $(addprefix -l,$(LINKLIBS))
	$(Q)$(OBJCOPY) $@ $(FILTBASES) `$(NM_PLAIN) $@ | $(AWK) '($$3 ~ /^__.*_(LIST|END)__\r?$$/) || ($$3 ~ /^__aros_lib.*\r?$$/) {print "-L " $$3;}'`
endif

## Dependency fine-tuning
##
kernel-scsi_DEPS             := $(addprefix $(kernel-scsi_OBJDIR)/,$(notdir $(kernel-scsi_CCFILES:=.d) $(kernel-scsi_TARGETCCFILES:=.d) $(kernel-scsi_CXXFILES:=.d))) $(addprefix $(kernel-scsi_OBJDIR)/linklib/,$(notdir $(kernel-scsi_LINKLIBCCFILES:=.d)))

ifneq ($(kernel-scsi_DEPS),)
  ifneq (kernel-scsi kernel-scsi-quick kernel-scsi-kobj kernel-scsi-kobj-quick,)
    ifneq ($(findstring $(TARGET),kernel-scsi kernel-scsi-quick kernel-scsi-kobj kernel-scsi-kobj-quick),)
      -include $(kernel-scsi_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-scsi_DEPS)
    endif
  endif
endif

$(kernel-scsi_OBJS) $(kernel-scsi_DEPS) : | $(kernel-scsi_OBJDIR)/linklib

ifneq ($(kernel-scsi_OBJS) $(kernel-scsi_DEPS) $(kernel-scsi_MODULE) $(kernel-scsi_KOBJ),)
$(kernel-scsi_OBJS) $(kernel-scsi_DEPS) $(kernel-scsi_MODULE) $(kernel-scsi_KOBJ) : | $(kernel-scsi_OBJDIR) $(AROSDIR)/$(kernel-scsi_MODDIR) $(KOBJSDIR)
else
$(kernel-scsi_OBJS) $(kernel-scsi_DEPS) $(kernel-scsi_MODULE) $(kernel-scsi_KOBJ) :: $(kernel-scsi_OBJDIR) $(AROSDIR)/$(kernel-scsi_MODDIR) $(KOBJSDIR)
