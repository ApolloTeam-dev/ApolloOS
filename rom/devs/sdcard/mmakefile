#MM- linklibs-sdcard: kernel-sdcard-linklib
#MM- linklibs-sdcard_rel : kernel-sdcard-linklib
#MM- includes-sdcard: kernel-sdcard-includes
#MM- includes-sdcard_rel : kernel-sdcard-includes
#MM- kernel-sdcard : kernel-sdcard-includes core-linklibs linklibs-
#MM kernel-sdcard-linklib : kernel-sdcard-includes includes-
#MM- kernel-sdcard-quick : kernel-sdcard-includes-quick
#MM kernel-sdcard-includes : kernel-sdcard-makefile kernel-sdcard-includes-dirs \
#MM     includes-generate-deps kernel-sdcard-fd
#MM kernel-sdcard-includes-quick
#MM kernel-sdcard-includes-dirs
#MM kernel-sdcard-fd

# Library targets
#MM kernel-sdcard-kobj : core-linklibs linklibs-
#MM kernel-sdcard-kobj-quick : 

# Library with ABI targets:
#MM kernel-sdcard-kobj : kernel-sdcard-includes core-linklibs linklibs-
#MM kernel-sdcard-kobj-quick : kernel-sdcard-includes-quick

