	$(Q)$(IF) $(kernel-task_CXXCMD) $(kernel-task_CXXIQUOTE) $(dir $(2)) $(kernel-task_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-task_CXXIQUOTE) . $(kernel-task_CXXIQUOTE_END) $(strip $(kernel-task_CXXFLAGS) $(kernel-task_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
