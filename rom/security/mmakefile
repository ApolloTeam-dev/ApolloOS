## Dependency fine-tuning
##
kernel-security_DEPS             := $(addprefix $(kernel-security_OBJDIR)/,$(notdir $(kernel-security_CCFILES:=.d) $(kernel-security_TARGETCCFILES:=.d) $(kernel-security_CXXFILES:=.d))) $(addprefix $(kernel-security_OBJDIR)/linklib/,$(notdir $(kernel-security_LINKLIBCCFILES:=.d)))

ifneq ($(kernel-security_DEPS),)
  ifneq (kernel-security kernel-security-quick kernel-security-kobj kernel-security-kobj-quick,)
    ifneq ($(findstring $(TARGET),kernel-security kernel-security-quick kernel-security-kobj kernel-security-kobj-quick),)
      -include $(kernel-security_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-security_DEPS)
    endif
  endif
endif

$(kernel-security_OBJS) $(kernel-security_DEPS) : | $(kernel-security_OBJDIR)/linklib

ifneq ($(kernel-security_OBJS) $(kernel-security_DEPS) $(kernel-security_MODULE) $(kernel-security_KOBJ),)
$(kernel-security_OBJS) $(kernel-security_DEPS) $(kernel-security_MODULE) $(kernel-security_KOBJ) : | $(kernel-security_OBJDIR) $(AROSDIR)/$(kernel-security_MODDIR) $(KOBJSDIR)
else
$(kernel-security_OBJS) $(kernel-security_DEPS) $(kernel-security_MODULE) $(kernel-security_KOBJ) :: $(kernel-security_OBJDIR) $(AROSDIR)/$(kernel-security_MODDIR) $(KOBJSDIR)
endif

GLOB_MKDIRS += $(kernel-security_OBJDIR) $(AROSDIR)/$(kernel-security_MODDIR) $(KOBJSDIR)


# Some include files need to be generated before the .c can be parsed.
ifneq ($(filter $(TARGET),kernel-security kernel-security-includes kernel-security-quick kernel-security-kobj kernel-security-kobj-quick),) # Only for this target these deps are wanted

kernel-security_DFILE_DEPS := $(kernel-security_LIBDEFSINC) $(kernel-security_DEFLIBDEFSINC) \
    $(addprefix $(kernel-security_INCDIR)/,$($(kernel-security_DEFNAME)_INCLUDES))
$(kernel-security_DEPS) : $(kernel-security_DFILE_DEPS)
endif

kernel-security_TOCLEAN := $(kernel-security_OBJS) $(kernel-security_DEPS) \
    $(kernel-security_MODULE) $(kernel-security_LINKLIB) $(kernel-security_KOBJ) \
    $(kernel-security_OBJDIR)/Makefile.securitylibrary \
    $(addprefix $(kernel-security_OBJDIR)/include/,$($(kernel-security_DEFNAME)_INCLUDES)) \
    $(addprefix $(GENINCDIR)/,$($(kernel-security_DEFNAME)_INCLUDES)) \
    $(addprefix $(kernel-security_INCDIR)/,$($(kernel-security_DEFNAME)_INCLUDES)) \
    $(kernel-security_OBJDIR)/security_geninc $(kernel-security_OBJDIR)/security_incs \
    $(addsuffix .c,$(kernel-security_LINKLIBFILES)) $(kernel-security_LINKLIBOBJS) $(kernel-security_LIBDEFSINC) \
    $(kernel-security_DEFLIBDEFSINC) $(addsuffix .c,$(kernel-security_STARTFILES) $(kernel-security_ENDFILES)) \
    $(kernel-security_ENDOBJS)
kernel-security-clean : FILES              := $(kernel-security_TOCLEAN)
kernel-security-clean ::
	$(Q)$(ECHO) "Cleaning up for module security"
	$(Q)$(RM) $(FILES)

endif # $(TARGET) in $(kernel-security_ALLTARGETS)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
