  # Be sure that all .m files are found
  workbench-devs-sfs-c-sfscheck_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  workbench-devs-sfs-c-sfscheck_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-devs-sfs-c-sfscheck_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
