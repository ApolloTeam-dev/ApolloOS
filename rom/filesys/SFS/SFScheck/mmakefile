  workbench-devs-sfs-c-sfscheck_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(workbench-devs-sfs-c-sfscheck_OBJDIR)/,$(workbench-devs-sfs-c-sfscheck_OBJC_NARCHFILES)))
