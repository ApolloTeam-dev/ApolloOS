#MM- includes-scsi_wd33c93: kernel-hidd-scsiwd33c93-includes
#MM- includes-scsi_wd33c93_rel : kernel-hidd-scsiwd33c93-includes
#MM- kernel-hidd-scsiwd33c93 : kernel-hidd-scsiwd33c93-includes core-linklibs linklibs-
#MM kernel-hidd-scsiwd33c93-linklib : kernel-hidd-scsiwd33c93-includes includes-
