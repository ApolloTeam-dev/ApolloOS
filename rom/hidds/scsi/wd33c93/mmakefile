TMP_DIRS := $(subst -L ,-L,$(strip $(TMP_LDFLAGS)))
# Filter out only the libdirs and remove -L
TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(kernel-hidd-scsiwd33c93_LIBS) $($(kernel-hidd-scsiwd33c93_DEFNAME)_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(kernel-hidd-scsiwd33c93_MODULE) : LIB_NAMES := $(kernel-hidd-scsiwd33c93_LIBS) $($(kernel-hidd-scsiwd33c93_DEFNAME)_LIBS)
$(kernel-hidd-scsiwd33c93_MODULE) : OBJS := $(kernel-hidd-scsiwd33c93_STARTOBJS) $(kernel-hidd-scsiwd33c93_OBJS) $(USER_OBJS)
$(kernel-hidd-scsiwd33c93_MODULE) : ENDTAG := $(kernel-hidd-scsiwd33c93_ENDOBJS)
$(kernel-hidd-scsiwd33c93_MODULE) : ERR := $(kernel-hidd-scsiwd33c93_ERR)
$(kernel-hidd-scsiwd33c93_MODULE) : OBJDIR := $(kernel-hidd-scsiwd33c93_OBJDIR)
$(kernel-hidd-scsiwd33c93_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(kernel-hidd-scsiwd33c93_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(kernel-hidd-scsiwd33c93_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(kernel-hidd-scsiwd33c93_MODULE) : $(kernel-hidd-scsiwd33c93_STARTOBJS) $(kernel-hidd-scsiwd33c93_OBJS) $(USER_OBJS) $(kernel-hidd-scsiwd33c93_ENDOBJS) $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(kernel-hidd-scsiwd33c93_LINK) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(kernel-hidd-scsiwd33c93_LINK) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi

endif

