#MM- includes-bus_rel : kernel-hidd-bus-includes
#MM- kernel-hidd-bus : kernel-hidd-bus-includes core-linklibs linklibs-
#MM kernel-hidd-bus-linklib : kernel-hidd-bus-includes includes-
#MM- kernel-hidd-bus-quick : kernel-hidd-bus-includes-quick
#MM kernel-hidd-bus-includes : kernel-hidd-bus-makefile kernel-hidd-bus-includes-dirs \
#MM     includes-generate-deps kernel-hidd-bus-fd
#MM kernel-hidd-bus-includes-quick
