define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(kernel-hidd-storage_CXXCMD) $(kernel-hidd-storage_CXXIQUOTE) $(dir $(2)) $(kernel-hidd-storage_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-hidd-storage_CXXIQUOTE) . $(kernel-hidd-storage_CXXIQUOTE_END) $(strip $(kernel-hidd-storage_CXXFLAGS) $(kernel-hidd-storage_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(kernel-hidd-storage_CXXCMD) $(kernel-hidd-storage_CXXIQUOTE) $(dir $(2)) $(kernel-hidd-storage_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-hidd-storage_CXXIQUOTE) . $(kernel-hidd-storage_CXXIQUOTE_END) $(strip $(kernel-hidd-storage_CXXFLAGS) $(kernel-hidd-storage_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(kernel-hidd-storage_CXXCMD) $(kernel-hidd-storage_CXXIQUOTE) $(dir $(2)) $(kernel-hidd-storage_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-hidd-storage_CXXIQUOTE) . $(kernel-hidd-storage_CXXIQUOTE_END) $(strip $(kernel-hidd-storage_CXXFLAGS) $(kernel-hidd-storage_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(kernel-hidd-storage_CXXCMD)" $(MKDEPEND) $(strip $(kernel-hidd-storage_DXXFLAGS) $(kernel-hidd-storage_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
