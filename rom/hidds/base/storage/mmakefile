# The module is linked from all the compiled .o files

TMP_LDFLAGS  := $(LDFLAGS) $($(kernel-hidd-storage_DEFNAME)_LDFLAGS) $(kernel-hidd-storage_ISA_LDFLAGS)
# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
TMP_DIRS := $(subst -L ,-L,$(strip $(TMP_LDFLAGS)))
# Filter out only the libdirs and remove -L
TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(kernel-hidd-storage_LIBS) $($(kernel-hidd-storage_DEFNAME)_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(kernel-hidd-storage_MODULE) : LIB_NAMES := $(kernel-hidd-storage_LIBS) $($(kernel-hidd-storage_DEFNAME)_LIBS)
$(kernel-hidd-storage_MODULE) : OBJS := $(kernel-hidd-storage_STARTOBJS) $(kernel-hidd-storage_OBJS) $(USER_OBJS)
$(kernel-hidd-storage_MODULE) : ENDTAG := $(kernel-hidd-storage_ENDOBJS)
$(kernel-hidd-storage_MODULE) : ERR := $(kernel-hidd-storage_ERR)
$(kernel-hidd-storage_MODULE) : OBJDIR := $(kernel-hidd-storage_OBJDIR)
$(kernel-hidd-storage_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(kernel-hidd-storage_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(kernel-hidd-storage_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(kernel-hidd-storage_MODULE) : $(kernel-hidd-storage_STARTOBJS) $(kernel-hidd-storage_OBJS) $(USER_OBJS) $(kernel-hidd-storage_ENDOBJS) $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(kernel-hidd-storage_LINK) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(kernel-hidd-storage_LINK) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi

endif

