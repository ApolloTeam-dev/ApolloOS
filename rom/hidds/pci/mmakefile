kernel-hidd-pci_OBJS := $(addsuffix .o,$(kernel-hidd-pci_STARTFILES)) $(kernel-hidd-pci_ARCHOBJS) \
           $(addprefix $(kernel-hidd-pci_OBJDIR)/,$(notdir $(kernel-hidd-pci_C_NARCHFILES:=.o) $(kernel-hidd-pci_CXXFILES:=.o)))

ifeq (yes,yes)
# Handlers always have entry point
ifneq (hidd,handler)
kernel-hidd-pci_STARTOBJS        := $(addsuffix .o,$(addprefix $(GENDIR)/,$(RESIDENT_BEGIN)))
endif
endif

# Under Windows con* is a reserved name, it refers to console. Files with such names can't be created.
# This breaks con-handler build. Here we work around this
ifeq (pci,con)
    kernel-hidd-pci_ERR          := $(notdir $(kernel-hidd-pci_MODULE)).err
else
    kernel-hidd-pci_ERR          := pci.err
endif

ifeq (M,M)
# The module is linked from all the compiled .o files

TMP_LDFLAGS  := $(LDFLAGS) $($(kernel-hidd-pci_DEFNAME)_LDFLAGS) $(kernel-hidd-pci_ISA_LDFLAGS)
# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
TMP_DIRS := $(subst -L ,-L,$(strip $(TMP_LDFLAGS)))
# Filter out only the libdirs and remove -L
TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(kernel-hidd-pci_LIBS) $($(kernel-hidd-pci_DEFNAME)_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(kernel-hidd-pci_MODULE) : LIB_NAMES := $(kernel-hidd-pci_LIBS) $($(kernel-hidd-pci_DEFNAME)_LIBS)
$(kernel-hidd-pci_MODULE) : OBJS := $(kernel-hidd-pci_STARTOBJS) $(kernel-hidd-pci_OBJS) $(USER_OBJS)
$(kernel-hidd-pci_MODULE) : ENDTAG := $(kernel-hidd-pci_ENDOBJS)
$(kernel-hidd-pci_MODULE) : ERR := $(kernel-hidd-pci_ERR)
$(kernel-hidd-pci_MODULE) : OBJDIR := $(kernel-hidd-pci_OBJDIR)
$(kernel-hidd-pci_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(kernel-hidd-pci_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(kernel-hidd-pci_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(kernel-hidd-pci_MODULE) : $(kernel-hidd-pci_STARTOBJS) $(kernel-hidd-pci_OBJS) $(USER_OBJS) $(kernel-hidd-pci_ENDOBJS) $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(kernel-hidd-pci_LINK) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(kernel-hidd-pci_LINK) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi

endif

