ifeq (M,M)
# Link kernel object file
kernel-hidd-pci_KAUTOLIB         := dos intuition layers graphics oop utility expansion keymap

# Make these symbols local
kernel-hidd-pci_KBASE            := DOSBase IntuitionBase LayersBase GfxBase OOPBase \
	    UtilityBase ExpansionBase KeymapBase KernelBase

kernel-hidd-pci_SYMBOLS := $(kernel-hidd-pci_KBASE)

kernel-hidd-pci_KLIB             := hiddstubs amiga arossupport autoinit libinit
kernel-hidd-pci_KOBJ_LIBS        := $(filter-out $(kernel-hidd-pci_KLIB),$(kernel-hidd-pci_LIBS)) $(kernel-hidd-pci_KAUTOLIB)
$(kernel-hidd-pci_KOBJ) : LINKLIBS:=$(kernel-hidd-pci_KOBJ_LIBS) $($(kernel-hidd-pci_DEFNAME)_LIBS)
$(kernel-hidd-pci_KOBJ) : FILTBASES:=$(addprefix -L ,$(kernel-hidd-pci_SYMBOLS))
$(kernel-hidd-pci_KOBJ) : USER_LDFLAGS:=$(USER_LDFLAGS)
$(kernel-hidd-pci_KOBJ) : $(kernel-hidd-pci_OBJS) $(USER_OBJS) $(kernel-hidd-pci_ENDOBJS)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$@)"
	$(Q)$(AROS_LD) -Ur -o $@ $^ $(USER_LDFLAGS) -L$(AROS_LIB) $(addprefix -l,$(LINKLIBS))
	$(Q)$(OBJCOPY) $@ $(FILTBASES) `$(NM_PLAIN) $@ | $(AWK) '($$3 ~ /^__.*_(LIST|END)__\r?$$/) || ($$3 ~ /^__aros_lib.*\r?$$/) {print "-L " $$3;}'`
endif

## Dependency fine-tuning
##
kernel-hidd-pci_DEPS             := $(addprefix $(kernel-hidd-pci_OBJDIR)/,$(notdir $(kernel-hidd-pci_CCFILES:=.d) $(kernel-hidd-pci_TARGETCCFILES:=.d) $(kernel-hidd-pci_CXXFILES:=.d))) $(addprefix $(kernel-hidd-pci_OBJDIR)/linklib/,$(notdir $(kernel-hidd-pci_LINKLIBCCFILES:=.d)))

ifneq ($(kernel-hidd-pci_DEPS),)
  ifneq (kernel-hidd-pci kernel-hidd-pci-quick kernel-hidd-pci-kobj kernel-hidd-pci-kobj-quick,)
    ifneq ($(findstring $(TARGET),kernel-hidd-pci kernel-hidd-pci-quick kernel-hidd-pci-kobj kernel-hidd-pci-kobj-quick),)
      -include $(kernel-hidd-pci_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-hidd-pci_DEPS)
    endif
  endif
endif

$(kernel-hidd-pci_OBJS) $(kernel-hidd-pci_DEPS) : | $(kernel-hidd-pci_OBJDIR)/linklib

ifneq ($(kernel-hidd-pci_OBJS) $(kernel-hidd-pci_DEPS) $(kernel-hidd-pci_MODULE) $(kernel-hidd-pci_KOBJ),)
$(kernel-hidd-pci_OBJS) $(kernel-hidd-pci_DEPS) $(kernel-hidd-pci_MODULE) $(kernel-hidd-pci_KOBJ) : | $(kernel-hidd-pci_OBJDIR) $(AROSDIR)/$(kernel-hidd-pci_MODDIR) $(KOBJSDIR)
else
$(kernel-hidd-pci_OBJS) $(kernel-hidd-pci_DEPS) $(kernel-hidd-pci_MODULE) $(kernel-hidd-pci_KOBJ) :: $(kernel-hidd-pci_OBJDIR) $(AROSDIR)/$(kernel-hidd-pci_MODDIR) $(KOBJSDIR)
endif

GLOB_MKDIRS += $(kernel-hidd-pci_OBJDIR) $(AROSDIR)/$(kernel-hidd-pci_MODDIR) $(KOBJSDIR)


# Some include files need to be generated before the .c can be parsed.
ifneq ($(filter $(TARGET),kernel-hidd-pci kernel-hidd-pci-includes kernel-hidd-pci-quick kernel-hidd-pci-kobj kernel-hidd-pci-kobj-quick),) # Only for this target these deps are wanted

kernel-hidd-pci_DFILE_DEPS := $(kernel-hidd-pci_LIBDEFSINC) $(kernel-hidd-pci_DEFLIBDEFSINC) \
    $(addprefix $(kernel-hidd-pci_INCDIR)/,$($(kernel-hidd-pci_DEFNAME)_INCLUDES))
$(kernel-hidd-pci_DEPS) : $(kernel-hidd-pci_DFILE_DEPS)
endif

kernel-hidd-pci_TOCLEAN := $(kernel-hidd-pci_OBJS) $(kernel-hidd-pci_DEPS) \
    $(kernel-hidd-pci_MODULE) $(kernel-hidd-pci_LINKLIB) $(kernel-hidd-pci_KOBJ) \
    $(kernel-hidd-pci_OBJDIR)/Makefile.pcihidd \
    $(addprefix $(kernel-hidd-pci_OBJDIR)/include/,$($(kernel-hidd-pci_DEFNAME)_INCLUDES)) \
    $(addprefix $(GENINCDIR)/,$($(kernel-hidd-pci_DEFNAME)_INCLUDES)) \
    $(addprefix $(kernel-hidd-pci_INCDIR)/,$($(kernel-hidd-pci_DEFNAME)_INCLUDES)) \
    $(kernel-hidd-pci_OBJDIR)/pci_geninc $(kernel-hidd-pci_OBJDIR)/pci_incs \
    $(addsuffix .c,$(kernel-hidd-pci_LINKLIBFILES)) $(kernel-hidd-pci_LINKLIBOBJS) $(kernel-hidd-pci_LIBDEFSINC) \
    $(kernel-hidd-pci_DEFLIBDEFSINC) $(addsuffix .c,$(kernel-hidd-pci_STARTFILES) $(kernel-hidd-pci_ENDFILES)) \
    $(kernel-hidd-pci_ENDOBJS)
kernel-hidd-pci-clean : FILES              := $(kernel-hidd-pci_TOCLEAN)
kernel-hidd-pci-clean ::
	$(Q)$(ECHO) "Cleaning up for module pci"
	$(Q)$(RM) $(FILES)

endif # $(TARGET) in $(kernel-hidd-pci_ALLTARGETS)


