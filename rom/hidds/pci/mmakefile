kernel-hidd-pci-kobj       : $(kernel-hidd-pci_KOBJ) $(kernel-hidd-pci_LINKLIB) $(kernel-hidd-pci_RELLINKLIB)
kernel-hidd-pci-kobj-quick : $(kernel-hidd-pci_KOBJ) $(kernel-hidd-pci_LINKLIB) $(kernel-hidd-pci_RELLINKLIB)
endif
ifeq (M,M)
kernel-hidd-pci-linklib    : $(kernel-hidd-pci_LINKLIB) $(kernel-hidd-pci_RELLINKLIB)
