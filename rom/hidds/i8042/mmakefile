#MM- linklibs-i8042: kernel-hidd-i8042-linklib
#MM- linklibs-i8042_rel : kernel-hidd-i8042-linklib
#MM- includes-i8042: kernel-hidd-i8042-includes
#MM- includes-i8042_rel : kernel-hidd-i8042-includes
#MM- kernel-hidd-i8042 : kernel-hidd-i8042-includes core-linklibs linklibs-hiddstubs
#MM kernel-hidd-i8042-linklib : kernel-hidd-i8042-includes includes-hiddstubs
#MM- kernel-hidd-i8042-quick : kernel-hidd-i8042-includes-quick
#MM kernel-hidd-i8042-includes : kernel-hidd-i8042-makefile kernel-hidd-i8042-includes-dirs \
#MM     includes-generate-deps kernel-hidd-i8042-fd
#MM kernel-hidd-i8042-includes-quick
#MM kernel-hidd-i8042-includes-dirs
#MM kernel-hidd-i8042-fd

# Library targets
#MM kernel-hidd-i8042-kobj : core-linklibs linklibs-hiddstubs
#MM kernel-hidd-i8042-kobj-quick : 

