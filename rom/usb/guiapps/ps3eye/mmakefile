ifneq ($(ps3eye_CXXABSBASENAMES),)

ps3eye_CXXBASENAMES := $(basename $(ps3eye_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
ps3eye_MCXX_FILES  := $(strip $(foreach ps3eye_CXXBASE,$(ps3eye_CXXABSBASENAMES), $(firstword $(wildcard $(foreach ps3eye_EXT, $(AROS_CXXEXTS),$(addsuffix .$(ps3eye_EXT),$(ps3eye_CXXBASE)))))))

ifeq (,)
ps3eye_MCXX_SRCWILDCARD := %
else
ps3eye_MCXX_SRCWILDCARD := /%
endif

ifeq ($(ps3eye_OBJDIR),)
  ps3eye_CXXTARGETS := $(notdir $(ps3eye_CXXBASENAMES:=.o))
  ps3eye_CXXDTARGETS := $(notdir $(ps3eye_CXXBASENAMES:=.d))
  ps3eye_MCXX_WILDCARD := %
else
  ps3eye_CXXTARGETS := $(addprefix $(ps3eye_OBJDIR)/,$(notdir $(ps3eye_CXXBASENAMES:=.o)))
  ps3eye_CXXDTARGETS := $(addprefix $(ps3eye_OBJDIR)/,$(notdir $(ps3eye_CXXBASENAMES:=.d)))
  ps3eye_MCXX_WILDCARD := $(ps3eye_OBJDIR)/%

