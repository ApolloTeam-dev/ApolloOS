ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  ps3eye_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  ps3eye_STRIP ?= $(ECHO) >/dev/null
