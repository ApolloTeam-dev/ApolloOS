ps3eye-MA_DIRS := $(foreach dir, $(ps3eye-MA_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(ps3eye-MA_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(ps3eye-MA_DIRS),)
