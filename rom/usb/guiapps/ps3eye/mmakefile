  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(ps3eye_MOBJC_CPPFLAGS) $(ps3eye_MOBJC_EXTRA_CPPFLAGS))
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(ps3eye_OBJCFLAGS))
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(ps3eye_OBJCDFLAGS))
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_IQUOTE:=$(KERNEL_IQUOTE)
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_IQUOTE_END:=$(KERNEL_IQUOTE_END)
