  ps3eye_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  ps3eye_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(ps3eye_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  ps3eye_MOBJC_DIRS := $(foreach dir, $(ps3eye_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(ps3eye_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(ps3eye_MOBJC_DIRS),)
    ps3eye_MOBJC_DIRS := $(shell echo $(ps3eye_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
