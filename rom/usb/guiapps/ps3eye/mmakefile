endif
ifeq (target,kernel)
ps3eye_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
ps3eye_CFLAGS            := 
endif

ifeq ("","")
ifeq (target,target)
ps3eye_CXXFLAGS            := $(CXXFLAGS)
endif
