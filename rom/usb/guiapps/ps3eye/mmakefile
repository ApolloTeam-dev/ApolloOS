ps3eye_AFLAGS    := $(AFLAGS)
ifneq (,)
    ps3eye_DFLAGS     := 
else
    ps3eye_DFLAGS     := $(ps3eye_CFLAGS)
endif
ifneq (,)
    ps3eye_DXXFLAGS     := 
else
    ps3eye_DXXFLAGS     := $(ps3eye_CXXFLAGS)
endif
ifeq (target,target)
