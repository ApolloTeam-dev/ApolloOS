  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_OBJCFLAGS:=$(strip $(ps3eye_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_OBJCDFLAGS:=$(ps3eye_OBJCDFLAGS)
