  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(ps3eye_OBJCFLAGS))
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(ps3eye_OBJCDFLAGS))
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_IQUOTE:=$(HOST_IQUOTE)
  $(ps3eye_MOBJC_TARGETS) $(ps3eye_MOBJC_DTARGETS) : ps3eye_IQUOTE_END:=$(HOST_IQUOTE_END)
