ps3eye-link_EXTRA_LDFLAGS := 
ps3eye-link_EXTRA_LIBS :=
ifeq (no,yes)
    ps3eye-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    ps3eye-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    ps3eye-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files this program depends on.
# In LDFLAGS remove white space between -L and directory
ps3eye-link_DIRS := $(subst -L ,-L,$(strip $(ps3eye_LDFLAGS)))
# Filter out only the libdirs and remove -L
ps3eye-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(ps3eye-link_DIRS)))
# Add trailing /
ps3eye-link_DIRS := $(subst //,/,$(addsuffix /,$(ps3eye-link_DIRS)))
# Add normal linklib path
ps3eye-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
ps3eye-link_LIBS := $(addprefix lib,$(addsuffix .a,$(ps3eye_LIBS) $(ps3eye-link_EXTRA_LIBS)))
ifeq (yes,yes)
    ps3eye-link_LIBS += startup.o
endif
ifeq (no,yes)
    ps3eye-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
ps3eye-link_DEPLIBS := $(foreach lib,$(ps3eye-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(ps3eye-link_DIRS)))) \
)

$(ps3eye_TARGETDIR)/$(ps3eye_PROGNAME) : OBJDIR := $(ps3eye_OBJDIR)
$(ps3eye_TARGETDIR)/$(ps3eye_PROGNAME) : OBJS := $(ps3eye_OBJS) $(ps3eye_ARCHOBJS) $(USER_OBJS)
$(ps3eye_TARGETDIR)/$(ps3eye_PROGNAME) : LDFLAGS := $(strip $(ps3eye_LDFLAGS) $(ps3eye-link_EXTRA_LDFLAGS))
$(ps3eye_TARGETDIR)/$(ps3eye_PROGNAME) : LIBS := $(addprefix -l,$(ps3eye_LIBS) $(ps3eye-link_EXTRA_LIBS) )
$(ps3eye_TARGETDIR)/$(ps3eye_PROGNAME) : $(ps3eye_OBJS) $(ps3eye_ARCHOBJS) $(USER_OBJS) $(ps3eye-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(ps3eye_LINK) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(ps3eye_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(ps3eye_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(ps3eye_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(ps3eye_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(ps3eye_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(ps3eye_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

