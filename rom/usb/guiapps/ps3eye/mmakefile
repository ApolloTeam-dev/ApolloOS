endif
ifeq (target,host)
  ps3eye_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  ps3eye_STRIP ?= $(HOST_STRIP)
  ps3eye_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  ps3eye_CXXCMD:=$(HOST_CXX)
  ps3eye_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(ps3eye_MCXX_CPPFLAGS) $(ps3eye_MCXX_EXTRA_CPPFLAGS))
  ps3eye_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(ps3eye_CXXFLAGS))
  ps3eye_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(ps3eye_DXXFLAGS))
  ps3eye_CXXIQUOTE:=$(HOST_IQUOTE)
  ps3eye_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  ps3eye_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  ps3eye_STRIP ?= $(TARGET_STRIP)
  ps3eye_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  ps3eye_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  ps3eye_MCXX_CPPFLAGS := $(strip $(ps3eye_MCXX_CPPFLAGS) $(ps3eye_MCXX_EXTRA_CPPFLAGS))
  ps3eye_CXXFLAGS := $(strip $(ps3eye_CXXFLAGS) $(SAFETY_CFLAGS))
  ps3eye_DXXFLAGS := $(ps3eye_DXXFLAGS)
  ps3eye_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  ps3eye_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
