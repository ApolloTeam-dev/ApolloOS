ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  ps3eye_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  ps3eye_STRIP ?= $(ECHO) >/dev/null
  ps3eye_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  ps3eye_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  ps3eye_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(ps3eye_MCXX_CPPFLAGS) $(ps3eye_MCXX_EXTRA_CPPFLAGS))
  ps3eye_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ps3eye_CXXFLAGS))
  ps3eye_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(ps3eye_DXXFLAGS))
  ps3eye_CXXIQUOTE:=$(KERNEL_IQUOTE)
  ps3eye_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(ps3eye_CXXCMD) $(ps3eye_CXXIQUOTE) $(dir $(2)) $(ps3eye_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ps3eye_CXXIQUOTE) . $(ps3eye_CXXIQUOTE_END) $(strip $(ps3eye_CXXFLAGS) $(ps3eye_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(ps3eye_CXXCMD) $(ps3eye_CXXIQUOTE) $(dir $(2)) $(ps3eye_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ps3eye_CXXIQUOTE) . $(ps3eye_CXXIQUOTE_END) $(strip $(ps3eye_CXXFLAGS) $(ps3eye_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(ps3eye_CXXCMD) $(ps3eye_CXXIQUOTE) $(dir $(2)) $(ps3eye_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(ps3eye_CXXIQUOTE) . $(ps3eye_CXXIQUOTE_END) $(strip $(ps3eye_CXXFLAGS) $(ps3eye_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(ps3eye_CXXCMD)" $(MKDEPEND) $(strip $(ps3eye_DXXFLAGS) $(ps3eye_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(ps3eye_OBJDIR),)
  $(foreach ps3eye_CXXFILE,$(ps3eye_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(ps3eye_CXXFILE))),$(ps3eye_CXXFILE))))
else
  $(foreach ps3eye_CXXFILE,$(ps3eye_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(ps3eye_OBJDIR)/,$(notdir $(basename $(ps3eye_CXXFILE)))),$(ps3eye_CXXFILE))))
endif

endif


ifneq ($(ps3eye_OBJC_NARCHFILES),)

ifeq (,)
