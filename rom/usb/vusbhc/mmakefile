		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(kernel-usb-vusbhci_CXXCMD) $(kernel-usb-vusbhci_CXXIQUOTE) $(dir $(2)) $(kernel-usb-vusbhci_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-usb-vusbhci_CXXIQUOTE) . $(kernel-usb-vusbhci_CXXIQUOTE_END) $(strip $(kernel-usb-vusbhci_CXXFLAGS) $(kernel-usb-vusbhci_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
