kernel-usb-vusbhci_STRIP ?= $(ECHO) >/dev/null
kernel-usb-vusbhci_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(kernel-usb-vusbhci_MC_TARGETS) $(kernel-usb-vusbhci_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(kernel-usb-vusbhci_MC_TARGETS) $(kernel-usb-vusbhci_MC_DTARGETS) : kernel-usb-vusbhci_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(kernel-usb-vusbhci_MC_CPPFLAGS) $(kernel-usb-vusbhci_MC_EXTRA_CPPFLAGS))
$(kernel-usb-vusbhci_MC_TARGETS) $(kernel-usb-vusbhci_MC_DTARGETS) : kernel-usb-vusbhci_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(kernel-usb-vusbhci_CFLAGS))
$(kernel-usb-vusbhci_MC_TARGETS) $(kernel-usb-vusbhci_MC_DTARGETS) : kernel-usb-vusbhci_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(kernel-usb-vusbhci_DFLAGS))
$(kernel-usb-vusbhci_MC_TARGETS) $(kernel-usb-vusbhci_MC_DTARGETS) : kernel-usb-vusbhci_IQUOTE:=$(KERNEL_IQUOTE)
$(kernel-usb-vusbhci_MC_TARGETS) $(kernel-usb-vusbhci_MC_DTARGETS) : kernel-usb-vusbhci_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(kernel-usb-vusbhci_MC_TARGETS) : CPPFLAGS := $(kernel-usb-vusbhci_MC_CPPFLAGS)
$(kernel-usb-vusbhci_MC_TARGETS) : CFLAGS := $(kernel-usb-vusbhci_CFLAGS)
$(kernel-usb-vusbhci_MC_TARGETS) : $(kernel-usb-vusbhci_MC_TGTWILDCARD).o : $(kernel-usb-vusbhci_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(kernel-usb-vusbhci_IQUOTE) $(dir $<) $(kernel-usb-vusbhci_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-usb-vusbhci_IQUOTE) . $(kernel-usb-vusbhci_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(kernel-usb-vusbhci_IQUOTE) $(dir $<) $(kernel-usb-vusbhci_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-usb-vusbhci_IQUOTE) . $(kernel-usb-vusbhci_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(kernel-usb-vusbhci_IQUOTE) $(dir $<) $(kernel-usb-vusbhci_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-usb-vusbhci_IQUOTE) . $(kernel-usb-vusbhci_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(kernel-usb-vusbhci_MC_DTARGETS) : $(kernel-usb-vusbhci_MC_TGTWILDCARD).d : $(kernel-usb-vusbhci_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(kernel-usb-vusbhci_DFLAGS) $(kernel-usb-vusbhci_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@

ifneq ($(kernel-usb-vusbhci_LINKLIBAFILES),)

ifeq ($(kernel-usb-vusbhci_OBJDIR)/linklib,)
kernel-usb-vusbhci-MA_TARGETS := $(addsuffix .o,$(kernel-usb-vusbhci_LINKLIBAFILES) $(kernel-usb-vusbhci_RELLINKLIBAFILES))
kernel-usb-vusbhci-MA_WILDCARD := %
else
kernel-usb-vusbhci-MA_TARGETS := $(addsuffix .o,$(addprefix $(kernel-usb-vusbhci_OBJDIR)/linklib/,$(notdir $(kernel-usb-vusbhci_LINKLIBAFILES) $(kernel-usb-vusbhci_RELLINKLIBAFILES))))
kernel-usb-vusbhci-MA_WILDCARD := $(kernel-usb-vusbhci_OBJDIR)/linklib/%

# Be sure that all .s files are generated
$(kernel-usb-vusbhci-MA_TARGETS) : | $(addsuffix .S,$(kernel-usb-vusbhci_LINKLIBAFILES) $(kernel-usb-vusbhci_RELLINKLIBAFILES))

# Be sure that all .c files are found
kernel-usb-vusbhci-MA_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
kernel-usb-vusbhci-MA_BASEDIRS := $(shell echo $(sort $(dir $(kernel-usb-vusbhci_LINKLIBAFILES) $(kernel-usb-vusbhci_RELLINKLIBAFILES))) | sed 's/\(.\):\//\/\1\//g')
kernel-usb-vusbhci-MA_DIRS := $(foreach dir, $(kernel-usb-vusbhci-MA_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(kernel-usb-vusbhci-MA_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(kernel-usb-vusbhci-MA_DIRS),)
    kernel-usb-vusbhci-MA_DIRS := $(shell echo $(kernel-usb-vusbhci-MA_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.S $(kernel-usb-vusbhci-MA_DIRS)
endif

endif

kernel-usb-vusbhci-MA_ASSEMBLER ?= $(kernel-usb-vusbhci_ASSEMBLER)

$(kernel-usb-vusbhci-MA_TARGETS) : kernel-usb-vusbhci-MA_CMD:= $(kernel-usb-vusbhci-MA_ASSEMBLER)

$(kernel-usb-vusbhci-MA_TARGETS) : CPPFLAGS := $(CPPFLAGS)
$(kernel-usb-vusbhci-MA_TARGETS) : AFLAGS := $(AFLAGS)
$(kernel-usb-vusbhci-MA_TARGETS) : $(kernel-usb-vusbhci-MA_WILDCARD).o : %.S
	$(Q)$(ECHO) "Assembling $(notdir $<)..."
	$(Q)$(IF) $(kernel-usb-vusbhci-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(notdir $<): $(kernel-usb-vusbhci-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@" >> $(GENDIR)/errors ; \
			$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Assemble failed: $(kernel-usb-vusbhci-MA_CMD) $(strip $(AFLAGS) $(CPPFLAGS)) $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
endif

