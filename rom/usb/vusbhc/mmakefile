# We will employ a terrifying, but unavoidable, hack here.
# genmf has no concept of conditionals (ie %ifeq), and MetaMake
# ignores GNU Make ifeq() statements, but will process any #MM
# headed lines in the file.
# 
# So, to make the following #MM lines conditional on whether we want
# to build the ABI, Library, or both, we define build_abi= and 
# build_library as 'M' to enable, or '' to disable, which allows genmf
# to do the following conversions:
# 
#  #MM includes-foo: foo-include
#    becomes, when build_abi=M
#  #MM includes-foo: foo-include   <= Processed by MetaMake
#    but, when build_abi= ...
#  #M includes-foo: foo-includes   <= ignored by MetaMake! Yes!
# 
# Taking full blame for this: Jason S. McMullan <jason.mcmullan@gmail.com>

# Define metamake targets and their dependencies
#MM kernel-usb-vusbhci
#MM kernel-usb-vusbhci-quick
#MM kernel-usb-vusbhci-makefile
#MM kernel-usb-vusbhci-clean

# ABI targets:
#MM- includes-all : kernel-usb-vusbhci-includes
#MM- linklibs-vusbhci: kernel-usb-vusbhci-linklib
#MM- linklibs-vusbhci_rel : kernel-usb-vusbhci-linklib
#MM- includes-vusbhci: kernel-usb-vusbhci-includes
#MM- includes-vusbhci_rel : kernel-usb-vusbhci-includes
#MM- kernel-usb-vusbhci : kernel-usb-vusbhci-includes core-linklibs linklibs-stdc.static
#MM kernel-usb-vusbhci-linklib : kernel-usb-vusbhci-includes includes-stdc.static
#MM- kernel-usb-vusbhci-quick : kernel-usb-vusbhci-includes-quick
#MM kernel-usb-vusbhci-includes : kernel-usb-vusbhci-makefile kernel-usb-vusbhci-includes-dirs \
#MM     includes-generate-deps kernel-usb-vusbhci-fd
#MM kernel-usb-vusbhci-includes-quick
#MM kernel-usb-vusbhci-includes-dirs
#MM kernel-usb-vusbhci-fd

# Library targets
#MM kernel-usb-vusbhci-kobj : core-linklibs linklibs-stdc.static
#MM kernel-usb-vusbhci-kobj-quick : 

# Library with ABI targets:
#MM kernel-usb-vusbhci-kobj : kernel-usb-vusbhci-includes core-linklibs linklibs-stdc.static
#MM kernel-usb-vusbhci-kobj-quick : kernel-usb-vusbhci-includes-quick

