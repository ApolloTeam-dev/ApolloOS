$(test-library-arosx_TARGETDIR)/$(test-library-arosx_PROGNAME) : LDFLAGS := $(strip $(test-library-arosx_LDFLAGS) $(test-library-arosx-link_EXTRA_LDFLAGS))
$(test-library-arosx_TARGETDIR)/$(test-library-arosx_PROGNAME) : LIBS := $(addprefix -l,$(test-library-arosx_LIBS) $(test-library-arosx-link_EXTRA_LIBS) )
$(test-library-arosx_TARGETDIR)/$(test-library-arosx_PROGNAME) : $(test-library-arosx_OBJS) $(test-library-arosx_ARCHOBJS) $(USER_OBJS) $(test-library-arosx-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(test-library-arosx_LINK) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(test-library-arosx_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(test-library-arosx_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-library-arosx_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(test-library-arosx_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(test-library-arosx_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(test-library-arosx_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(test-library-arosx_DEPS),)
  ifneq (test-library-arosx test-library-arosx-quick,)
    ifneq ($(findstring $(TARGET),test-library-arosx test-library-arosx-quick),)
      -include $(test-library-arosx_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(test-library-arosx_DEPS)
    endif
  endif
endif


ifneq ($(test-library-arosx_OBJS) $(test-library-arosx_DEPS) $(test-library-arosx_TARGETDIR)/$(test-library-arosx_PROGNAME),)
$(test-library-arosx_OBJS) $(test-library-arosx_DEPS) $(test-library-arosx_TARGETDIR)/$(test-library-arosx_PROGNAME) : | $(test-library-arosx_OBJDIR) $(test-library-arosx_TARGETDIR)
else
$(test-library-arosx_OBJS) $(test-library-arosx_DEPS) $(test-library-arosx_TARGETDIR)/$(test-library-arosx_PROGNAME) :: $(test-library-arosx_OBJDIR) $(test-library-arosx_TARGETDIR)
endif

GLOB_MKDIRS += $(test-library-arosx_OBJDIR) $(test-library-arosx_TARGETDIR)


test-library-arosx-clean : FILES := $(test-library-arosx_OBJS) $(test-library-arosx_TARGETDIR)/$(test-library-arosx_PROGNAME) $(test-library-arosx_DEPS)
#MM
test-library-arosx-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget test-library-arosx"
	$(Q)$(RM) $(FILES)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
