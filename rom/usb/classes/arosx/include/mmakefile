#MM- includes-arosx: kernel-usb-classes-arosx-library-includes
#MM- includes-arosx_rel : kernel-usb-classes-arosx-library-includes
#MM- kernel-usb-classes-arosx-library : kernel-usb-classes-arosx-library-includes core-linklibs linklibs-
#MM kernel-usb-classes-arosx-library-linklib : kernel-usb-classes-arosx-library-includes includes-
