TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(kernel-usb-classes-arosx-library_LIBS) $($(kernel-usb-classes-arosx-library_DEFNAME)_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(kernel-usb-classes-arosx-library_MODULE) : LIB_NAMES := $(kernel-usb-classes-arosx-library_LIBS) $($(kernel-usb-classes-arosx-library_DEFNAME)_LIBS)
$(kernel-usb-classes-arosx-library_MODULE) : OBJS := $(kernel-usb-classes-arosx-library_STARTOBJS) $(kernel-usb-classes-arosx-library_OBJS) $(USER_OBJS)
$(kernel-usb-classes-arosx-library_MODULE) : ENDTAG := $(kernel-usb-classes-arosx-library_ENDOBJS)
$(kernel-usb-classes-arosx-library_MODULE) : ERR := $(kernel-usb-classes-arosx-library_ERR)
$(kernel-usb-classes-arosx-library_MODULE) : OBJDIR := $(kernel-usb-classes-arosx-library_OBJDIR)
$(kernel-usb-classes-arosx-library_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(kernel-usb-classes-arosx-library_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(kernel-usb-classes-arosx-library_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(kernel-usb-classes-arosx-library_MODULE) : $(kernel-usb-classes-arosx-library_STARTOBJS) $(kernel-usb-classes-arosx-library_OBJS) $(USER_OBJS) $(kernel-usb-classes-arosx-library_ENDOBJS) $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(kernel-usb-classes-arosx-library_LINK) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(kernel-usb-classes-arosx-library_LINK) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi

endif

