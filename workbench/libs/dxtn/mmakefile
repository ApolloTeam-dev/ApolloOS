#MM- includes-dxtn: workbench-libs-dxtn-includes
#MM- includes-dxtn_rel : workbench-libs-dxtn-includes
#MM- workbench-libs-dxtn : workbench-libs-dxtn-includes core-linklibs linklibs-
#MM workbench-libs-dxtn-linklib : workbench-libs-dxtn-includes includes-
#MM- workbench-libs-dxtn-quick : workbench-libs-dxtn-includes-quick
#MM workbench-libs-dxtn-includes : workbench-libs-dxtn-makefile workbench-libs-dxtn-includes-dirs \
#MM     includes-generate-deps workbench-libs-dxtn-fd
#MM workbench-libs-dxtn-includes-quick
