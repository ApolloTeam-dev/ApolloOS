  workbench-libs-codesets_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-libs-codesets_STRIP ?= $(ECHO) >/dev/null
