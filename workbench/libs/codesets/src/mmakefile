workbench-libs-codesets_CXXABSBASENAMES := $(foreach workbench-libs-codesets_CXXBASE,$(workbench-libs-codesets_CXX_NARCHFILES),$(if $(filter /%,$(workbench-libs-codesets_CXXBASE)),$(workbench-libs-codesets_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(workbench-libs-codesets_CXXBASE))))

ifneq ($(workbench-libs-codesets_CXXABSBASENAMES),)

workbench-libs-codesets_CXXBASENAMES := $(basename $(workbench-libs-codesets_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
workbench-libs-codesets_MCXX_FILES  := $(strip $(foreach workbench-libs-codesets_CXXBASE,$(workbench-libs-codesets_CXXABSBASENAMES), $(firstword $(wildcard $(foreach workbench-libs-codesets_EXT, $(AROS_CXXEXTS),$(addsuffix .$(workbench-libs-codesets_EXT),$(workbench-libs-codesets_CXXBASE)))))))

