  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(workbench-libs-codesets_MOBJC_CPPFLAGS) $(workbench-libs-codesets_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-libs-codesets_OBJCFLAGS))
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-libs-codesets_OBJCDFLAGS))
