  workbench-libs-codesets_STRIP ?= $(TARGET_STRIP)
  workbench-libs-codesets_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  workbench-libs-codesets_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  workbench-libs-codesets_MCXX_CPPFLAGS := $(strip $(workbench-libs-codesets_MCXX_CPPFLAGS) $(workbench-libs-codesets_MCXX_EXTRA_CPPFLAGS))
  workbench-libs-codesets_CXXFLAGS := $(strip $(workbench-libs-codesets_CXXFLAGS) $(SAFETY_CFLAGS))
  workbench-libs-codesets_DXXFLAGS := $(workbench-libs-codesets_DXXFLAGS)
  workbench-libs-codesets_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  workbench-libs-codesets_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
