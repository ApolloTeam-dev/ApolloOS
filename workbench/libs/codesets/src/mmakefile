  workbench-libs-codesets_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-libs-codesets_DXXFLAGS))
  workbench-libs-codesets_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-libs-codesets_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-libs-codesets_CXXCMD) $(workbench-libs-codesets_CXXIQUOTE) $(dir $(2)) $(workbench-libs-codesets_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-libs-codesets_CXXIQUOTE) . $(workbench-libs-codesets_CXXIQUOTE_END) $(strip $(workbench-libs-codesets_CXXFLAGS) $(workbench-libs-codesets_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-libs-codesets_CXXCMD) $(workbench-libs-codesets_CXXIQUOTE) $(dir $(2)) $(workbench-libs-codesets_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-libs-codesets_CXXIQUOTE) . $(workbench-libs-codesets_CXXIQUOTE_END) $(strip $(workbench-libs-codesets_CXXFLAGS) $(workbench-libs-codesets_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-libs-codesets_CXXCMD) $(workbench-libs-codesets_CXXIQUOTE) $(dir $(2)) $(workbench-libs-codesets_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-libs-codesets_CXXIQUOTE) . $(workbench-libs-codesets_CXXIQUOTE_END) $(strip $(workbench-libs-codesets_CXXFLAGS) $(workbench-libs-codesets_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-libs-codesets_CXXCMD)" $(MKDEPEND) $(strip $(workbench-libs-codesets_DXXFLAGS) $(workbench-libs-codesets_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(OBJDIR),)
  $(foreach workbench-libs-codesets_CXXFILE,$(workbench-libs-codesets_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-libs-codesets_CXXFILE))),$(workbench-libs-codesets_CXXFILE))))
else
  $(foreach workbench-libs-codesets_CXXFILE,$(workbench-libs-codesets_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(OBJDIR)/,$(notdir $(basename $(workbench-libs-codesets_CXXFILE)))),$(workbench-libs-codesets_CXXFILE))))
endif

endif


ifneq ($(workbench-libs-codesets_OBJC_NARCHFILES),)

ifeq (,)
