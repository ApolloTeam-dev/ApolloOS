  workbench-libs-codesets_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(workbench-libs-codesets_MCXX_CPPFLAGS) $(workbench-libs-codesets_MCXX_EXTRA_CPPFLAGS))
