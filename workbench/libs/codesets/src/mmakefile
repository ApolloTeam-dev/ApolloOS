  workbench-libs-codesets_STRIP ?= $(HOST_STRIP)
  workbench-libs-codesets_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-libs-codesets_MOBJC_CPPFLAGS) $(workbench-libs-codesets_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-libs-codesets_OBJCFLAGS))
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-libs-codesets_OBJCDFLAGS))
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_IQUOTE_END:=$(HOST_IQUOTE_END)
