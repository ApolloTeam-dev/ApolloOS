  $(workbench-libs-codesets_MOBJC_TARGETS) $(workbench-libs-codesets_MOBJC_DTARGETS) : workbench-libs-codesets_OBJCFLAGS:=$(strip $(workbench-libs-codesets_OBJCFLAGS) $(SAFETY_CFLAGS))
