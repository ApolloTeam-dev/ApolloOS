  # Be sure that all .m files are found
  workbench-libs-codesets_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  workbench-libs-codesets_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-libs-codesets_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  workbench-libs-codesets_MOBJC_DIRS := $(foreach dir, $(workbench-libs-codesets_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-libs-codesets_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(workbench-libs-codesets_MOBJC_DIRS),)
    workbench-libs-codesets_MOBJC_DIRS := $(shell echo $(workbench-libs-codesets_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(workbench-libs-codesets_MOBJC_DIRS)
