include $(SRCDIR)/config/aros.cfg

CATALOGS:=


ifeq (,)
workbench-libs-muimaster-catalogs_DESC := $(basename $(wildcard $(SRCDIR)/$(CURDIR)/*.cd))
else
workbench-libs-muimaster-catalogs_DESC := 
endif

workbench-libs-muimaster-catalogs_SRC := $(shell echo $(TOOLDIR)/C_h_aros | sed 's/^\(.\):\//\/\1\//')

ifeq ($(CATALOGS),)
workbench-libs-muimaster-catalogs_LNGS := $(basename $(notdir $(call WILDCARD, $(SRCDIR)/$(CURDIR)/*.ct)))
else
workbench-libs-muimaster-catalogs_LNGS := $(CATALOGS)
endif

workbench-libs-muimaster-catalogs_OBJS := $(addsuffix /System/Libs/muimaster.catalog, $(addprefix $(AROS_CATALOGS)/, $(workbench-libs-muimaster-catalogs_LNGS)))
workbench-libs-muimaster-catalogs_DIRS := $(addsuffix /System/Libs, $(addprefix $(AROS_CATALOGS)/, $(workbench-libs-muimaster-catalogs_LNGS))) $(dir ../muimaster_strings.h)

#MM- workbench-libs-muimaster-catalogs-quick : workbench-libs-muimaster-catalogs

#MM
workbench-libs-muimaster-catalogs : $(workbench-libs-muimaster-catalogs_OBJS) ../muimaster_strings.h


ifneq ($(workbench-libs-muimaster-catalogs_OBJS),)
$(workbench-libs-muimaster-catalogs_OBJS) : | $(workbench-libs-muimaster-catalogs_DIRS)
else
$(workbench-libs-muimaster-catalogs_OBJS) :: $(workbench-libs-muimaster-catalogs_DIRS)
endif

GLOB_MKDIRS += $(workbench-libs-muimaster-catalogs_DIRS)


$(AROS_CATALOGS)/%/System/Libs/muimaster.catalog : $(SRCDIR)/$(CURDIR)/%.ct $(workbench-libs-muimaster-catalogs_DESC).cd
	$(Q)$(ECHO) "Creating   muimaster catalog for language $*."
	$(Q)$(IF) $(TEST) "$*" = "polish"; then \
	    $(FLEXCAT) iso88592toamigapl $(workbench-libs-muimaster-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Libs/muimaster.catalog" || [ $$? -lt 10 ] ; \
	elif $(TEST) "$*" = "russian"; then \
	    $(FLEXCAT) win1251toamiga1251 $(workbench-libs-muimaster-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Libs/muimaster.catalog" || [ $$? -lt 10 ] ; \
	else \
	    $(FLEXCAT) $(workbench-libs-muimaster-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Libs/muimaster.catalog" || [ $$? -lt 10 ] ; \
	fi

ifneq (../muimaster_strings.h,)
../muimaster_strings.h : workbench-libs-muimaster-catalogs_DESC := $(workbench-libs-muimaster-catalogs_DESC)
../muimaster_strings.h : workbench-libs-muimaster-catalogs_SRC := $(workbench-libs-muimaster-catalogs_SRC)
../muimaster_strings.h : $(workbench-libs-muimaster-catalogs_DESC).cd $(workbench-libs-muimaster-catalogs_SRC).sd | $(dir ../muimaster_strings.h)
	$(Q)$(ECHO) "Creating   muimaster catalog source file $@"
	$(Q)$(FLEXCAT) $(workbench-libs-muimaster-catalogs_DESC).cd $@=$(workbench-libs-muimaster-catalogs_SRC).sd
endif

workbench-libs-muimaster-catalogs-clean : FILES := $(workbench-libs-muimaster-catalogs_OBJS) ../muimaster_strings.h
#MM
workbench-libs-muimaster-catalogs-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget workbench-libs-muimaster-catalogs"
	$(Q)$(RM) $(FILES)

.PHONY: workbench-libs-muimaster-catalogs workbench-libs-muimaster-catalogs-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
