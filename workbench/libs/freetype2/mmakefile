#		&& $(TOUCH) $(freetype2-fetch-fetchedflag) ; \
#	fi


.PHONY: freetype2-create-patch

ifneq (,)
    freetype2-create-patch-exclude := -X ./exclude.patterns
endif

ifneq (,)
    freetype2-create-patch-srcdir   := 
else
    freetype2-create-patch-srcdir   := $(ARCHBASE)
endif

#MM- freetype2-create-patch :  freetype2-create-patch-diff 
#MM- freetype2-create-patch-quick :  freetype2-create-patch-diff 

#MM
freetype2-create-patch-diff:
	$(Q)$(FETCH) -a $(ARCHBASE) -s "tar.gz" -l $(PORTSSOURCEDIR) -d $(PORTSDIR)/$(FT2NAME)2/tmp ; \
	$(MV) $(PORTSDIR)/$(FT2NAME)2/$(freetype2-create-patch-srcdir) $(PORTSDIR)/$(FT2NAME)2/tmp/$(freetype2-create-patch-srcdir).aros ; \
	cd $(PORTSDIR)/$(FT2NAME)2/tmp ; \
	$(FOR) f in  ; do \
	    $(ECHO) $$f >> ./exclude.patterns ; \
	done ; \
	$(ECHO) "Creating   \`$(ARCHBASE)-aros-new.diff'" ; \
	diff -ruN $(freetype2-create-patch-exclude) \
	    $(freetype2-create-patch-srcdir) \
	    $(freetype2-create-patch-srcdir).aros \
	    >$(SRCDIR)/$(CURDIR)/$(ARCHBASE)-aros-new.diff ; \
	$(MV) $(PORTSDIR)/$(FT2NAME)2/tmp/$(freetype2-create-patch-srcdir).aros $(PORTSDIR)/$(FT2NAME)2/$(freetype2-create-patch-srcdir) ; \
	$(RM) $(PORTSDIR)/$(FT2NAME)2/tmp

