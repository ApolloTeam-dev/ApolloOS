.PHONY: freetype2-fetch

ifneq ($(TOOLDIR),)
    freetype2-fetch-tooldir := "$(TOOLDIR)/"
else
    freetype2-fetch-tooldir := "$(TOOLDIR)/"
endif

ifneq ($(PORTSSOURCEDIR),)
    freetype2-fetch-location := $(PORTSSOURCEDIR)
else
    freetype2-fetch-location := $(PORTSDIR)/$(FT2NAME)2
endif

freetype2-fetch-fetchedflag := $(freetype2-fetch-location)/.$(ARCHBASE)-fetched

#MM
freetype2-fetch :
	$(Q)$(ECHO) "Fetching   $(ARCHBASE) ..."
	$(Q)TOOLDIR="$(freetype2-fetch-tooldir)" $(FETCH) -ao "$(REPOSITORIES)" -a $(ARCHBASE) -s "tar.gz" -l $(freetype2-fetch-location) \
	-d $(PORTSDIR)/$(FT2NAME)2 -po "$(SRCDIR)/$(CURDIR)" -p "$(PATCHSPEC)"
	$(Q)$(IF) ! $(TEST) -f $(freetype2-fetch-fetchedflag) ; then \
		 $(TOUCH) $(freetype2-fetch-fetchedflag) ; \
	fi

#	$(Q)$(IF) ! $(TEST) -f $(freetype2-fetch-fetchedflag) ; then \
