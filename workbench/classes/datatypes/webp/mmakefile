  $(foreach workbench-datatypes-webp_CXXFILE,$(workbench-datatypes-webp_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-datatypes-webp_OBJDIR)/,$(notdir $(basename $(workbench-datatypes-webp_CXXFILE)))),$(workbench-datatypes-webp_CXXFILE))))
