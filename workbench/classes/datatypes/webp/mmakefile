define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(datatypes-webp-linklibs-webpdsp_CXXCMD) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) $(dir $(2)) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) . $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE_END) $(strip $(datatypes-webp-linklibs-webpdsp_CXXFLAGS) $(datatypes-webp-linklibs-webpdsp_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(datatypes-webp-linklibs-webpdsp_CXXCMD) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) $(dir $(2)) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) . $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE_END) $(strip $(datatypes-webp-linklibs-webpdsp_CXXFLAGS) $(datatypes-webp-linklibs-webpdsp_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(datatypes-webp-linklibs-webpdsp_CXXCMD) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) $(dir $(2)) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE) . $(datatypes-webp-linklibs-webpdsp_CXXIQUOTE_END) $(strip $(datatypes-webp-linklibs-webpdsp_CXXFLAGS) $(datatypes-webp-linklibs-webpdsp_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(datatypes-webp-linklibs-webpdsp_CXXCMD)" $(MKDEPEND) $(strip $(datatypes-webp-linklibs-webpdsp_DXXFLAGS) $(datatypes-webp-linklibs-webpdsp_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
