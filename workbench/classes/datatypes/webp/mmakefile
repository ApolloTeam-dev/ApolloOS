  $(foreach workbench-datatypes-webp_CXXFILE,$(workbench-datatypes-webp_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-datatypes-webp_CXXFILE))),$(workbench-datatypes-webp_CXXFILE))))
