# Filter out only the libdirs and remove -L
TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(workbench-classes-zune-calltips_LIBS) $($(workbench-classes-zune-calltips_DEFNAME)_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(workbench-classes-zune-calltips_MODULE) : LIB_NAMES := $(workbench-classes-zune-calltips_LIBS) $($(workbench-classes-zune-calltips_DEFNAME)_LIBS)
$(workbench-classes-zune-calltips_MODULE) : OBJS := $(workbench-classes-zune-calltips_STARTOBJS) $(workbench-classes-zune-calltips_OBJS) $(USER_OBJS)
$(workbench-classes-zune-calltips_MODULE) : ENDTAG := $(workbench-classes-zune-calltips_ENDOBJS)
$(workbench-classes-zune-calltips_MODULE) : ERR := $(workbench-classes-zune-calltips_ERR)
$(workbench-classes-zune-calltips_MODULE) : OBJDIR := $(workbench-classes-zune-calltips_OBJDIR)
$(workbench-classes-zune-calltips_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(workbench-classes-zune-calltips_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(workbench-classes-zune-calltips_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(workbench-classes-zune-calltips_MODULE) : $(workbench-classes-zune-calltips_STARTOBJS) $(workbench-classes-zune-calltips_OBJS) $(USER_OBJS) $(workbench-classes-zune-calltips_ENDOBJS) $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(workbench-classes-zune-calltips_LINK) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(workbench-classes-zune-calltips_LINK) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi

endif

