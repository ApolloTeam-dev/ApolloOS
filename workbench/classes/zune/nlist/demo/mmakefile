classes-zune-nbitmap-demo-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
classes-zune-nbitmap-demo-link_LIBS := $(addprefix lib,$(addsuffix .a,$(classes-zune-nbitmap-demo_LIBS) $(classes-zune-nbitmap-demo-link_EXTRA_LIBS)))
ifeq (yes,yes)
    classes-zune-nbitmap-demo-link_LIBS += startup.o
endif
ifeq (no,yes)
    classes-zune-nbitmap-demo-link_LIBS += detach.o
endif
# search for the linklibs in the given path, ignore ones not found
classes-zune-nbitmap-demo-link_DEPLIBS := $(foreach lib,$(classes-zune-nbitmap-demo-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(classes-zune-nbitmap-demo-link_DIRS)))) \
)

$(classes-zune-nbitmap-demo_TARGETDIR)/$(classes-zune-nbitmap-demo_PROGNAME) : OBJDIR := $(classes-zune-nbitmap-demo_OBJDIR)
$(classes-zune-nbitmap-demo_TARGETDIR)/$(classes-zune-nbitmap-demo_PROGNAME) : OBJS := $(classes-zune-nbitmap-demo_OBJS) $(classes-zune-nbitmap-demo_ARCHOBJS) $(USER_OBJS)
$(classes-zune-nbitmap-demo_TARGETDIR)/$(classes-zune-nbitmap-demo_PROGNAME) : LDFLAGS := $(strip $(classes-zune-nbitmap-demo_LDFLAGS) $(classes-zune-nbitmap-demo-link_EXTRA_LDFLAGS))
$(classes-zune-nbitmap-demo_TARGETDIR)/$(classes-zune-nbitmap-demo_PROGNAME) : LIBS := $(addprefix -l,$(classes-zune-nbitmap-demo_LIBS) $(classes-zune-nbitmap-demo-link_EXTRA_LIBS) )
$(classes-zune-nbitmap-demo_TARGETDIR)/$(classes-zune-nbitmap-demo_PROGNAME) : $(classes-zune-nbitmap-demo_OBJS) $(classes-zune-nbitmap-demo_ARCHOBJS) $(USER_OBJS) $(classes-zune-nbitmap-demo-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(classes-zune-nbitmap-demo_LINK) $(OBJS) -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(classes-zune-nbitmap-demo_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(classes-zune-nbitmap-demo_LINK) $(OBJS) -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(classes-zune-nbitmap-demo_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(classes-zune-nbitmap-demo_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(classes-zune-nbitmap-demo_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(classes-zune-nbitmap-demo_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $(OBJS))))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

