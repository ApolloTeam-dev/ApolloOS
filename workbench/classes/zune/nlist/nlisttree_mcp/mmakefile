else
  $(foreach classes-zune-nlisttree-mcp_CXXFILE,$(classes-zune-nlisttree-mcp_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(OBJDIR)/,$(notdir $(basename $(classes-zune-nlisttree-mcp_CXXFILE)))),$(classes-zune-nlisttree-mcp_CXXFILE))))
