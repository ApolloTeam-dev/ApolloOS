else
  $(foreach classes-zune-nlistview-class_CXXFILE,$(classes-zune-nlistview-class_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(OBJDIR)/,$(notdir $(basename $(classes-zune-nlistview-class_CXXFILE)))),$(classes-zune-nlistview-class_CXXFILE))))
