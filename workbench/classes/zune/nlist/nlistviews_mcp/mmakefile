else
  $(foreach classes-zune-nlistviews-mcp_CXXFILE,$(classes-zune-nlistviews-mcp_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(OBJDIR)/,$(notdir $(basename $(classes-zune-nlistviews-mcp_CXXFILE)))),$(classes-zune-nlistviews-mcp_CXXFILE))))
