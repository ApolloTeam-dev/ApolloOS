.PHONY : workbench-system-find

workbench-system-find_PROGNAME  := Find
workbench-system-find_OBJDIR    := $(GENDIR)/$(CURDIR)
workbench-system-find_TARGETDIR := $(EXEDIR)
workbench-system-find_LINKER    := 
workbench-system-find_LIBS := 
# If not supplied, linker is equal to compiler
ifeq ($(workbench-system-find_LINKER),)
    workbench-system-find_LINKER := target
endif

ifneq ("$(strip $(FILES)   )","")
    workbench-system-find_FILES     := $(FILES)
    workbench-system-find_OBJCFILES := 
    workbench-system-find_ASMFILES  := 
    workbench-system-find_CXXFILES := 
else
    workbench-system-find_FILES     := $(workbench-system-find_PROGNAME)
    workbench-system-find_OBJCFILES :=
    workbench-system-find_ASMFILES  :=
    workbench-system-find_CXXFILES :=
endif

workbench-system-find_ARCHOBJS   := $(wildcard $(workbench-system-find_OBJDIR)/arch/*.o)
workbench-system-find_ARCHFILES  := $(basename $(notdir $(workbench-system-find_ARCHOBJS)))
