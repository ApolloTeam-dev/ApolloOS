workbench-system-find_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (target,target)
workbench-system-find_CFLAGS            := $(CFLAGS)
endif
ifeq (target,host)
workbench-system-find_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
workbench-system-find_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
workbench-system-find_CFLAGS            := 
endif

ifeq ("","")
ifeq (target,target)
workbench-system-find_CXXFLAGS            := $(CXXFLAGS)
endif
ifeq (target,host)
workbench-system-find_CXXFLAGS            := $(HOST_CXXFLAGS)
endif
ifeq (target,kernel)
workbench-system-find_CXXFLAGS            := $(strip $(KERNEL_ISA_CXXFLAGS) $(KERNEL_CXXFLAGS))
endif
else
workbench-system-find_CXXFLAGS          := 
endif

ifeq ("","")
ifeq (target,target)
workbench-system-find_LDFLAGS            := $(LDFLAGS)
endif
ifeq (target,host)
workbench-system-find_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (target,kernel)
workbench-system-find_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
workbench-system-find_LDFLAGS          := 
endif

workbench-system-find_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
workbench-system-find_COVERAGE := yes
workbench-system-find_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
workbench-system-find_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
workbench-system-find_CFLAGS    := $(strip $(workbench-system-find_COVERAGEFLAGS) $(workbench-system-find_CFLAGS))
workbench-system-find_CXXFLAGS := $(strip $(workbench-system-find_COVERAGEFLAGS) $(workbench-system-find_CXXFLAGS))
workbench-system-find_LIBS += $(workbench-system-find_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
workbench-system-find_FUNCINSTR := yes
workbench-system-find_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
workbench-system-find_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
workbench-system-find_CFLAGS    := $(strip $(workbench-system-find_INSTRFUNCFLAGS) $(workbench-system-find_CFLAGS))
workbench-system-find_CXXFLAGS := $(strip $(workbench-system-find_INSTRFUNCFLAGS) $(workbench-system-find_CXXFLAGS))
workbench-system-find_LIBS += $(workbench-system-find_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
workbench-system-find_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(workbench-system-find_CFLAGS))
workbench-system-find_CXXFLAGS := $(strip $(LTO_BINARY_CFLAGS) $(workbench-system-find_CXXFLAGS))
endif
endif
workbench-system-find_AFLAGS    := $(AFLAGS)
ifneq (,)
    workbench-system-find_DFLAGS     := 
else
    workbench-system-find_DFLAGS     := $(workbench-system-find_CFLAGS)
endif
ifneq (,)
    workbench-system-find_DXXFLAGS     := 
else
    workbench-system-find_DXXFLAGS     := $(workbench-system-find_CXXFLAGS)
endif
ifeq (target,target)
