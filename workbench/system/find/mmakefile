  workbench-system-find_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(workbench-system-find_OBJDIR)/,$(workbench-system-find_OBJC_NARCHFILES)))
  workbench-system-find_MOBJC_WILDCARD := $(workbench-system-find_OBJDIR)/%

  # Be sure that all .m files are generated
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : | $(addsuffix .m,$(workbench-system-find_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  workbench-system-find_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  workbench-system-find_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-system-find_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  workbench-system-find_MOBJC_DIRS := $(foreach dir, $(workbench-system-find_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-system-find_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(workbench-system-find_MOBJC_DIRS),)
    workbench-system-find_MOBJC_DIRS := $(shell echo $(workbench-system-find_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(workbench-system-find_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  workbench-system-find_CC := $(TARGET_CC)
else
  workbench-system-find_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
workbench-system-find_MOBJC_CPPFLAGS := $(workbench-system-find_CPPFLAGS)
workbench-system-find_OBJCFLAGS := $(workbench-system-find_CFLAGS)
workbench-system-find_OBJCFLAGS := $(workbench-system-find_OBJCFLAGS) -isystem $(AROS_DEVELOPER)/include
workbench-system-find_OBJCFLAGS := $(subst -Wno-pointer-sign,, $(subst -Werror-implicit-function-declaration,, $(workbench-system-find_OBJCFLAGS)))
ifeq ($(workbench-system-find_DFLAGS),)
  workbench-system-find_OBJCDFLAGS := $(workbench-system-find_CFLAGS)
else
  workbench-system-find_OBJCDFLAGS := $(workbench-system-find_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  workbench-system-find_LINK ?= $(strip $(workbench-system-find_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-system-find_STRIP ?= $(TARGET_STRIP)
  workbench-system-find_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : CMD:=$(strip $(workbench-system-find_CC) $(TARGET_SYSROOT))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_MOBJC_CPPFLAGS:=$(strip $(workbench-system-find_MOBJC_CPPFLAGS) $(workbench-system-find_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_OBJCFLAGS:=$(strip $(workbench-system-find_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_OBJCDFLAGS:=$(workbench-system-find_OBJCDFLAGS)
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  workbench-system-find_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  workbench-system-find_STRIP ?= $(HOST_STRIP)
  workbench-system-find_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-system-find_MOBJC_CPPFLAGS) $(workbench-system-find_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-system-find_OBJCFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-system-find_OBJCDFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  workbench-system-find_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-system-find_STRIP ?= $(ECHO) >/dev/null
  workbench-system-find_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(workbench-system-find_MOBJC_CPPFLAGS) $(workbench-system-find_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-system-find_OBJCFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-system-find_OBJCDFLAGS))
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_IQUOTE:=$(KERNEL_IQUOTE)
  $(workbench-system-find_MOBJC_TARGETS) $(workbench-system-find_MOBJC_DTARGETS) : workbench-system-find_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(workbench-system-find_MOBJC_TARGETS) : CPPFLAGS := $(workbench-system-find_MOBJC_CPPFLAGS)
$(workbench-system-find_MOBJC_TARGETS) : CFLAGS := $(workbench-system-find_OBJCFLAGS)
$(workbench-system-find_MOBJC_TARGETS) : $(workbench-system-find_MOBJC_WILDCARD).o : $(workbench-system-find_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(workbench-system-find_IQUOTE) $(dir $<) $(workbench-system-find_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-system-find_IQUOTE) . $(workbench-system-find_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(workbench-system-find_IQUOTE) $(dir $<) $(workbench-system-find_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-system-find_IQUOTE) . $(workbench-system-find_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(workbench-system-find_IQUOTE) $(dir $<) $(workbench-system-find_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-system-find_IQUOTE) . $(workbench-system-find_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

