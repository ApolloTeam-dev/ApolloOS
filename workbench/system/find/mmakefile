workbench-system-find_CXX_NARCHFILES := $(filter-out $(workbench-system-find_ARCHFILES),$(workbench-system-find_CXXFILES))
workbench-system-find_OBJC_NARCHFILES := $(filter-out $(workbench-system-find_ARCHFILES),$(workbench-system-find_OBJCFILES))

TMP_FILES := $(workbench-system-find_C_NARCHFILES) $(workbench-system-find_CXX_NARCHFILES) $(workbench-system-find_ASMFILES) $(workbench-system-find_OBJC_NARCHFILES)
workbench-system-find_OBJS := $(addsuffix .o,$(addprefix $(workbench-system-find_OBJDIR)/,$(notdir $(TMP_FILES))))
workbench-system-find_DEPS := $(addsuffix .d,$(addprefix $(workbench-system-find_OBJDIR)/,$(notdir $(TMP_FILES))))

workbench-system-find_CPPFLAGS :=  $(CPPFLAGS)
