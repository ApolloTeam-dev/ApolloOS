endif
ifeq (target,host)
workbench-system-find_LDFLAGS           := $(workbench-system-find_LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
workbench-system-find_LDFLAGS           := $(workbench-system-find_LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
workbench-system-find_LDFLAGS   += -L
endif

#MM
workbench-system-find-quick : workbench-system-find

#MM workbench-system-find : includes-generate-deps core-linklibs
workbench-system-find : $(workbench-system-find_TARGETDIR)/$(workbench-system-find_PROGNAME)

ifneq ($(filter $(TARGET),workbench-system-find workbench-system-find-quick workbench-system-find-gz-quick),)

workbench-system-find_CXXABSBASENAMES := $(foreach workbench-system-find_CXXBASE,$(workbench-system-find_CXX_NARCHFILES),$(if $(filter /%,$(workbench-system-find_CXXBASE)),$(workbench-system-find_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(workbench-system-find_CXXBASE))))

ifneq ($(workbench-system-find_CXXABSBASENAMES),)

workbench-system-find_CXXBASENAMES := $(basename $(workbench-system-find_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
workbench-system-find_MCXX_FILES  := $(strip $(foreach workbench-system-find_CXXBASE,$(workbench-system-find_CXXABSBASENAMES), $(firstword $(wildcard $(foreach workbench-system-find_EXT, $(AROS_CXXEXTS),$(addsuffix .$(workbench-system-find_EXT),$(workbench-system-find_CXXBASE)))))))

ifeq (,)
workbench-system-find_MCXX_SRCWILDCARD := %
else
workbench-system-find_MCXX_SRCWILDCARD := /%
endif

ifeq ($(workbench-system-find_OBJDIR),)
  workbench-system-find_CXXTARGETS := $(notdir $(workbench-system-find_CXXBASENAMES:=.o))
  workbench-system-find_CXXDTARGETS := $(notdir $(workbench-system-find_CXXBASENAMES:=.d))
  workbench-system-find_MCXX_WILDCARD := %
else
  workbench-system-find_CXXTARGETS := $(addprefix $(workbench-system-find_OBJDIR)/,$(notdir $(workbench-system-find_CXXBASENAMES:=.o)))
  workbench-system-find_CXXDTARGETS := $(addprefix $(workbench-system-find_OBJDIR)/,$(notdir $(workbench-system-find_CXXBASENAMES:=.d)))
  workbench-system-find_MCXX_WILDCARD := $(workbench-system-find_OBJDIR)/%

  # Be sure that all source files are generated
  $(workbench-system-find_CXXTARGETS) $(workbench-system-find_CXXDTARGETS) : | $(workbench-system-find_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
workbench-system-find_MCXX_CPPFLAGS := $(workbench-system-find_CPPFLAGS)
workbench-system-find_CXXFLAGS := $(workbench-system-find_CXXFLAGS)
ifeq ($(workbench-system-find_DXXFLAGS),)
  workbench-system-find_DXXFLAGS := $(workbench-system-find_CXXFLAGS)
else
  workbench-system-find_DXXFLAGS := $(workbench-system-find_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  workbench-system-find_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  workbench-system-find_STRIP ?= $(HOST_STRIP)
  workbench-system-find_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  workbench-system-find_CXXCMD:=$(HOST_CXX)
  workbench-system-find_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(workbench-system-find_MCXX_CPPFLAGS) $(workbench-system-find_MCXX_EXTRA_CPPFLAGS))
  workbench-system-find_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-system-find_CXXFLAGS))
  workbench-system-find_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-system-find_DXXFLAGS))
  workbench-system-find_CXXIQUOTE:=$(HOST_IQUOTE)
  workbench-system-find_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  workbench-system-find_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-system-find_STRIP ?= $(TARGET_STRIP)
  workbench-system-find_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  workbench-system-find_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  workbench-system-find_MCXX_CPPFLAGS := $(strip $(workbench-system-find_MCXX_CPPFLAGS) $(workbench-system-find_MCXX_EXTRA_CPPFLAGS))
  workbench-system-find_CXXFLAGS := $(strip $(workbench-system-find_CXXFLAGS) $(SAFETY_CFLAGS))
  workbench-system-find_DXXFLAGS := $(workbench-system-find_DXXFLAGS)
  workbench-system-find_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  workbench-system-find_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  workbench-system-find_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-system-find_STRIP ?= $(ECHO) >/dev/null
  workbench-system-find_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  workbench-system-find_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  workbench-system-find_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(workbench-system-find_MCXX_CPPFLAGS) $(workbench-system-find_MCXX_EXTRA_CPPFLAGS))
  workbench-system-find_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-system-find_CXXFLAGS))
  workbench-system-find_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-system-find_DXXFLAGS))
  workbench-system-find_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-system-find_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-system-find_CXXCMD) $(workbench-system-find_CXXIQUOTE) $(dir $(2)) $(workbench-system-find_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-system-find_CXXIQUOTE) . $(workbench-system-find_CXXIQUOTE_END) $(strip $(workbench-system-find_CXXFLAGS) $(workbench-system-find_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-system-find_CXXCMD) $(workbench-system-find_CXXIQUOTE) $(dir $(2)) $(workbench-system-find_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-system-find_CXXIQUOTE) . $(workbench-system-find_CXXIQUOTE_END) $(strip $(workbench-system-find_CXXFLAGS) $(workbench-system-find_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-system-find_CXXCMD) $(workbench-system-find_CXXIQUOTE) $(dir $(2)) $(workbench-system-find_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-system-find_CXXIQUOTE) . $(workbench-system-find_CXXIQUOTE_END) $(strip $(workbench-system-find_CXXFLAGS) $(workbench-system-find_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-system-find_CXXCMD)" $(MKDEPEND) $(strip $(workbench-system-find_DXXFLAGS) $(workbench-system-find_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-system-find_OBJDIR),)
  $(foreach workbench-system-find_CXXFILE,$(workbench-system-find_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-system-find_CXXFILE))),$(workbench-system-find_CXXFILE))))
else
  $(foreach workbench-system-find_CXXFILE,$(workbench-system-find_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-system-find_OBJDIR)/,$(notdir $(basename $(workbench-system-find_CXXFILE)))),$(workbench-system-find_CXXFILE))))
endif

endif


ifneq ($(workbench-system-find_OBJC_NARCHFILES),)

ifeq (,)
workbench-system-find_MOBJC_SRCWILDCARD := %
else
workbench-system-find_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(workbench-system-find_OBJDIR),)
  workbench-system-find_MOBJC_TARGETS := $(addsuffix .o,$(workbench-system-find_OBJC_NARCHFILES))
  workbench-system-find_MOBJC_DTARGETS := $(addsuffix .d,$(workbench-system-find_OBJC_NARCHFILES))
