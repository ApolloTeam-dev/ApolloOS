include $(SRCDIR)/config/aros.cfg

#MM- workbench-fs-complete : workbench-fs-ntfs

#MM workbench-fs-ntfs : workbench-libs-uuid-includes

USER_LDFLAGS := -static

FILES := startup main disk cache packet ntfs ops lock direntry charset names timer notify support

DISABLEDFILES :=   file   


.PHONY : workbench-fs-ntfs

workbench-fs-ntfs_PROGNAME  := ntfs-handler
workbench-fs-ntfs_OBJDIR    := $(GENDIR)/$(CURDIR)
workbench-fs-ntfs_TARGETDIR := $(AROSDIR)/Storage
workbench-fs-ntfs_LINKER    := 
workbench-fs-ntfs_LIBS := 
# If not supplied, linker is equal to compiler
ifeq ($(workbench-fs-ntfs_LINKER),)
    workbench-fs-ntfs_LINKER := target
endif

ifneq ("$(strip $(FILES)   )","")
    workbench-fs-ntfs_FILES     := $(FILES)
    workbench-fs-ntfs_OBJCFILES := 
    workbench-fs-ntfs_ASMFILES  := 
    workbench-fs-ntfs_CXXFILES := 
else
    workbench-fs-ntfs_FILES     := $(workbench-fs-ntfs_PROGNAME)
    workbench-fs-ntfs_OBJCFILES :=
    workbench-fs-ntfs_ASMFILES  :=
    workbench-fs-ntfs_CXXFILES :=
endif

workbench-fs-ntfs_ARCHOBJS   := $(wildcard $(workbench-fs-ntfs_OBJDIR)/arch/*.o)
workbench-fs-ntfs_ARCHFILES  := $(basename $(notdir $(workbench-fs-ntfs_ARCHOBJS)))
workbench-fs-ntfs_C_NARCHFILES := $(filter-out $(workbench-fs-ntfs_ARCHFILES),$(workbench-fs-ntfs_FILES))
workbench-fs-ntfs_CXX_NARCHFILES := $(filter-out $(workbench-fs-ntfs_ARCHFILES),$(workbench-fs-ntfs_CXXFILES))
workbench-fs-ntfs_OBJC_NARCHFILES := $(filter-out $(workbench-fs-ntfs_ARCHFILES),$(workbench-fs-ntfs_OBJCFILES))

TMP_FILES := $(workbench-fs-ntfs_C_NARCHFILES) $(workbench-fs-ntfs_CXX_NARCHFILES) $(workbench-fs-ntfs_ASMFILES) $(workbench-fs-ntfs_OBJC_NARCHFILES)
workbench-fs-ntfs_OBJS := $(addsuffix .o,$(addprefix $(workbench-fs-ntfs_OBJDIR)/,$(notdir $(TMP_FILES))))
workbench-fs-ntfs_DEPS := $(addsuffix .d,$(addprefix $(workbench-fs-ntfs_OBJDIR)/,$(notdir $(TMP_FILES))))

workbench-fs-ntfs_CPPFLAGS :=  $(CPPFLAGS)
ifneq (,)
workbench-fs-ntfs_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (target,target)
workbench-fs-ntfs_CFLAGS            := $(CFLAGS)
endif
ifeq (target,host)
workbench-fs-ntfs_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
workbench-fs-ntfs_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
workbench-fs-ntfs_CFLAGS            := 
endif

ifeq ("","")
ifeq (target,target)
workbench-fs-ntfs_CXXFLAGS            := $(CXXFLAGS)
endif
ifeq (target,host)
workbench-fs-ntfs_CXXFLAGS            := $(HOST_CXXFLAGS)
endif
ifeq (target,kernel)
workbench-fs-ntfs_CXXFLAGS            := $(strip $(KERNEL_ISA_CXXFLAGS) $(KERNEL_CXXFLAGS))
endif
else
workbench-fs-ntfs_CXXFLAGS          := 
endif

ifeq ("","")
ifeq (target,target)
workbench-fs-ntfs_LDFLAGS            := $(LDFLAGS)
endif
ifeq (target,host)
workbench-fs-ntfs_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (target,kernel)
workbench-fs-ntfs_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
workbench-fs-ntfs_LDFLAGS          := 
endif

workbench-fs-ntfs_COVERAGE := no
ifeq (target,target)
ifeq (no,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
workbench-fs-ntfs_COVERAGE := yes
workbench-fs-ntfs_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
workbench-fs-ntfs_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
workbench-fs-ntfs_CFLAGS    := $(strip $(workbench-fs-ntfs_COVERAGEFLAGS) $(workbench-fs-ntfs_CFLAGS))
workbench-fs-ntfs_CXXFLAGS := $(strip $(workbench-fs-ntfs_COVERAGEFLAGS) $(workbench-fs-ntfs_CXXFLAGS))
workbench-fs-ntfs_LIBS += $(workbench-fs-ntfs_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
workbench-fs-ntfs_FUNCINSTR := yes
workbench-fs-ntfs_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
workbench-fs-ntfs_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
workbench-fs-ntfs_CFLAGS    := $(strip $(workbench-fs-ntfs_INSTRFUNCFLAGS) $(workbench-fs-ntfs_CFLAGS))
workbench-fs-ntfs_CXXFLAGS := $(strip $(workbench-fs-ntfs_INSTRFUNCFLAGS) $(workbench-fs-ntfs_CXXFLAGS))
workbench-fs-ntfs_LIBS += $(workbench-fs-ntfs_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
workbench-fs-ntfs_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(workbench-fs-ntfs_CFLAGS))
workbench-fs-ntfs_CXXFLAGS := $(strip $(LTO_BINARY_CFLAGS) $(workbench-fs-ntfs_CXXFLAGS))
endif
endif
workbench-fs-ntfs_AFLAGS    := $(AFLAGS)
ifneq (,)
    workbench-fs-ntfs_DFLAGS     := 
else
    workbench-fs-ntfs_DFLAGS     := $(workbench-fs-ntfs_CFLAGS)
endif
ifneq (,)
    workbench-fs-ntfs_DXXFLAGS     := 
else
    workbench-fs-ntfs_DXXFLAGS     := $(workbench-fs-ntfs_CXXFLAGS)
endif
ifeq (target,target)
workbench-fs-ntfs_LDFLAGS           := $(workbench-fs-ntfs_LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
workbench-fs-ntfs_LDFLAGS           := $(workbench-fs-ntfs_LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
workbench-fs-ntfs_LDFLAGS           := $(workbench-fs-ntfs_LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
workbench-fs-ntfs_LDFLAGS   += -L
endif

#MM
workbench-fs-ntfs-quick : workbench-fs-ntfs

#MM workbench-fs-ntfs : includes-generate-deps core-linklibs
workbench-fs-ntfs : $(workbench-fs-ntfs_TARGETDIR)/$(workbench-fs-ntfs_PROGNAME)

ifneq ($(filter $(TARGET),workbench-fs-ntfs workbench-fs-ntfs-quick workbench-fs-ntfs-gz-quick),)

workbench-fs-ntfs_CXXABSBASENAMES := $(foreach workbench-fs-ntfs_CXXBASE,$(workbench-fs-ntfs_CXX_NARCHFILES),$(if $(filter /%,$(workbench-fs-ntfs_CXXBASE)),$(workbench-fs-ntfs_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(workbench-fs-ntfs_CXXBASE))))

ifneq ($(workbench-fs-ntfs_CXXABSBASENAMES),)

workbench-fs-ntfs_CXXBASENAMES := $(basename $(workbench-fs-ntfs_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
workbench-fs-ntfs_MCXX_FILES  := $(strip $(foreach workbench-fs-ntfs_CXXBASE,$(workbench-fs-ntfs_CXXABSBASENAMES), $(firstword $(wildcard $(foreach workbench-fs-ntfs_EXT, $(AROS_CXXEXTS),$(addsuffix .$(workbench-fs-ntfs_EXT),$(workbench-fs-ntfs_CXXBASE)))))))

ifeq (,)
workbench-fs-ntfs_MCXX_SRCWILDCARD := %
else
workbench-fs-ntfs_MCXX_SRCWILDCARD := /%
endif

ifeq ($(workbench-fs-ntfs_OBJDIR),)
  workbench-fs-ntfs_CXXTARGETS := $(notdir $(workbench-fs-ntfs_CXXBASENAMES:=.o))
  workbench-fs-ntfs_CXXDTARGETS := $(notdir $(workbench-fs-ntfs_CXXBASENAMES:=.d))
  workbench-fs-ntfs_MCXX_WILDCARD := %
else
  workbench-fs-ntfs_CXXTARGETS := $(addprefix $(workbench-fs-ntfs_OBJDIR)/,$(notdir $(workbench-fs-ntfs_CXXBASENAMES:=.o)))
  workbench-fs-ntfs_CXXDTARGETS := $(addprefix $(workbench-fs-ntfs_OBJDIR)/,$(notdir $(workbench-fs-ntfs_CXXBASENAMES:=.d)))
  workbench-fs-ntfs_MCXX_WILDCARD := $(workbench-fs-ntfs_OBJDIR)/%

  # Be sure that all source files are generated
  $(workbench-fs-ntfs_CXXTARGETS) $(workbench-fs-ntfs_CXXDTARGETS) : | $(workbench-fs-ntfs_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
workbench-fs-ntfs_MCXX_CPPFLAGS := $(workbench-fs-ntfs_CPPFLAGS)
workbench-fs-ntfs_CXXFLAGS := $(workbench-fs-ntfs_CXXFLAGS)
ifeq ($(workbench-fs-ntfs_DXXFLAGS),)
  workbench-fs-ntfs_DXXFLAGS := $(workbench-fs-ntfs_CXXFLAGS)
else
  workbench-fs-ntfs_DXXFLAGS := $(workbench-fs-ntfs_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  workbench-fs-ntfs_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  workbench-fs-ntfs_STRIP ?= $(HOST_STRIP)
  workbench-fs-ntfs_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  workbench-fs-ntfs_CXXCMD:=$(HOST_CXX)
  workbench-fs-ntfs_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(workbench-fs-ntfs_MCXX_CPPFLAGS) $(workbench-fs-ntfs_MCXX_EXTRA_CPPFLAGS))
  workbench-fs-ntfs_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-fs-ntfs_CXXFLAGS))
  workbench-fs-ntfs_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-fs-ntfs_DXXFLAGS))
  workbench-fs-ntfs_CXXIQUOTE:=$(HOST_IQUOTE)
  workbench-fs-ntfs_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  workbench-fs-ntfs_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-fs-ntfs_STRIP ?= $(TARGET_STRIP)
  workbench-fs-ntfs_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  workbench-fs-ntfs_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  workbench-fs-ntfs_MCXX_CPPFLAGS := $(strip $(workbench-fs-ntfs_MCXX_CPPFLAGS) $(workbench-fs-ntfs_MCXX_EXTRA_CPPFLAGS))
  workbench-fs-ntfs_CXXFLAGS := $(strip $(workbench-fs-ntfs_CXXFLAGS) $(SAFETY_CFLAGS))
  workbench-fs-ntfs_DXXFLAGS := $(workbench-fs-ntfs_DXXFLAGS)
  workbench-fs-ntfs_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  workbench-fs-ntfs_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  workbench-fs-ntfs_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-fs-ntfs_STRIP ?= $(ECHO) >/dev/null
  workbench-fs-ntfs_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  workbench-fs-ntfs_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  workbench-fs-ntfs_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(workbench-fs-ntfs_MCXX_CPPFLAGS) $(workbench-fs-ntfs_MCXX_EXTRA_CPPFLAGS))
  workbench-fs-ntfs_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-fs-ntfs_CXXFLAGS))
  workbench-fs-ntfs_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-fs-ntfs_DXXFLAGS))
  workbench-fs-ntfs_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-fs-ntfs_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-fs-ntfs_CXXCMD) $(workbench-fs-ntfs_CXXIQUOTE) $(dir $(2)) $(workbench-fs-ntfs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-fs-ntfs_CXXIQUOTE) . $(workbench-fs-ntfs_CXXIQUOTE_END) $(strip $(workbench-fs-ntfs_CXXFLAGS) $(workbench-fs-ntfs_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-fs-ntfs_CXXCMD) $(workbench-fs-ntfs_CXXIQUOTE) $(dir $(2)) $(workbench-fs-ntfs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-fs-ntfs_CXXIQUOTE) . $(workbench-fs-ntfs_CXXIQUOTE_END) $(strip $(workbench-fs-ntfs_CXXFLAGS) $(workbench-fs-ntfs_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-fs-ntfs_CXXCMD) $(workbench-fs-ntfs_CXXIQUOTE) $(dir $(2)) $(workbench-fs-ntfs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-fs-ntfs_CXXIQUOTE) . $(workbench-fs-ntfs_CXXIQUOTE_END) $(strip $(workbench-fs-ntfs_CXXFLAGS) $(workbench-fs-ntfs_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-fs-ntfs_CXXCMD)" $(MKDEPEND) $(strip $(workbench-fs-ntfs_DXXFLAGS) $(workbench-fs-ntfs_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-fs-ntfs_OBJDIR),)
  $(foreach workbench-fs-ntfs_CXXFILE,$(workbench-fs-ntfs_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-fs-ntfs_CXXFILE))),$(workbench-fs-ntfs_CXXFILE))))
else
  $(foreach workbench-fs-ntfs_CXXFILE,$(workbench-fs-ntfs_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-fs-ntfs_OBJDIR)/,$(notdir $(basename $(workbench-fs-ntfs_CXXFILE)))),$(workbench-fs-ntfs_CXXFILE))))
endif

endif


ifneq ($(workbench-fs-ntfs_OBJC_NARCHFILES),)

ifeq (,)
