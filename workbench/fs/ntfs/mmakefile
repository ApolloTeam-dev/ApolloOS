  workbench-fs-ntfs_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(workbench-fs-ntfs_OBJDIR)/,$(workbench-fs-ntfs_OBJC_NARCHFILES)))
  workbench-fs-ntfs_MOBJC_WILDCARD := $(workbench-fs-ntfs_OBJDIR)/%

  # Be sure that all .m files are generated
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : | $(addsuffix .m,$(workbench-fs-ntfs_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  workbench-fs-ntfs_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  workbench-fs-ntfs_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-fs-ntfs_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  workbench-fs-ntfs_MOBJC_DIRS := $(foreach dir, $(workbench-fs-ntfs_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-fs-ntfs_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(workbench-fs-ntfs_MOBJC_DIRS),)
    workbench-fs-ntfs_MOBJC_DIRS := $(shell echo $(workbench-fs-ntfs_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(workbench-fs-ntfs_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  workbench-fs-ntfs_CC := $(TARGET_CC)
else
  workbench-fs-ntfs_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
workbench-fs-ntfs_MOBJC_CPPFLAGS := $(workbench-fs-ntfs_CPPFLAGS)
workbench-fs-ntfs_OBJCFLAGS := $(workbench-fs-ntfs_CFLAGS)
workbench-fs-ntfs_OBJCFLAGS := $(workbench-fs-ntfs_OBJCFLAGS) -isystem $(AROS_DEVELOPER)/include
workbench-fs-ntfs_OBJCFLAGS := $(subst -Wno-pointer-sign,, $(subst -Werror-implicit-function-declaration,, $(workbench-fs-ntfs_OBJCFLAGS)))
ifeq ($(workbench-fs-ntfs_DFLAGS),)
  workbench-fs-ntfs_OBJCDFLAGS := $(workbench-fs-ntfs_CFLAGS)
else
  workbench-fs-ntfs_OBJCDFLAGS := $(workbench-fs-ntfs_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  workbench-fs-ntfs_LINK ?= $(strip $(workbench-fs-ntfs_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-fs-ntfs_STRIP ?= $(TARGET_STRIP)
  workbench-fs-ntfs_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : CMD:=$(strip $(workbench-fs-ntfs_CC) $(TARGET_SYSROOT))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_MOBJC_CPPFLAGS:=$(strip $(workbench-fs-ntfs_MOBJC_CPPFLAGS) $(workbench-fs-ntfs_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_OBJCFLAGS:=$(strip $(workbench-fs-ntfs_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_OBJCDFLAGS:=$(workbench-fs-ntfs_OBJCDFLAGS)
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  workbench-fs-ntfs_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  workbench-fs-ntfs_STRIP ?= $(HOST_STRIP)
  workbench-fs-ntfs_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-fs-ntfs_MOBJC_CPPFLAGS) $(workbench-fs-ntfs_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-fs-ntfs_OBJCFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-fs-ntfs_OBJCDFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  workbench-fs-ntfs_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-fs-ntfs_STRIP ?= $(ECHO) >/dev/null
  workbench-fs-ntfs_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(workbench-fs-ntfs_MOBJC_CPPFLAGS) $(workbench-fs-ntfs_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-fs-ntfs_OBJCFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-fs-ntfs_OBJCDFLAGS))
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_IQUOTE:=$(KERNEL_IQUOTE)
  $(workbench-fs-ntfs_MOBJC_TARGETS) $(workbench-fs-ntfs_MOBJC_DTARGETS) : workbench-fs-ntfs_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(workbench-fs-ntfs_MOBJC_TARGETS) : CPPFLAGS := $(workbench-fs-ntfs_MOBJC_CPPFLAGS)
$(workbench-fs-ntfs_MOBJC_TARGETS) : CFLAGS := $(workbench-fs-ntfs_OBJCFLAGS)
$(workbench-fs-ntfs_MOBJC_TARGETS) : $(workbench-fs-ntfs_MOBJC_WILDCARD).o : $(workbench-fs-ntfs_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(workbench-fs-ntfs_IQUOTE) $(dir $<) $(workbench-fs-ntfs_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-fs-ntfs_IQUOTE) . $(workbench-fs-ntfs_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
