else
  $(foreach hidd-i2c_CXXFILE,$(hidd-i2c_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(hidd-i2c_OBJDIR)/,$(notdir $(basename $(hidd-i2c_CXXFILE)))),$(hidd-i2c_CXXFILE))))
