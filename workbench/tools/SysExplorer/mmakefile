	$(Q)AROS_CC="$(workbench-tools-sysexplorer-module-ata_CXXCMD)" $(MKDEPEND) $(strip $(workbench-tools-sysexplorer-module-ata_DXXFLAGS) $(workbench-tools-sysexplorer-module-ata_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
