include $(SRCDIR)/config/aros.cfg

CATALOGS:=


ifeq (,)
workbench-tools-installaros-catalogs_DESC := $(basename $(wildcard $(SRCDIR)/$(CURDIR)/*.cd))
else
workbench-tools-installaros-catalogs_DESC := 
endif

workbench-tools-installaros-catalogs_SRC := $(shell echo $(TOOLDIR)/C_h_aros | sed 's/^\(.\):\//\/\1\//')

ifeq ($(CATALOGS),)
workbench-tools-installaros-catalogs_LNGS := $(basename $(notdir $(call WILDCARD, $(SRCDIR)/$(CURDIR)/*.ct)))
else
workbench-tools-installaros-catalogs_LNGS := $(CATALOGS)
endif

workbench-tools-installaros-catalogs_OBJS := $(addsuffix /System/Tools//installaros.catalog, $(addprefix $(AROS_CATALOGS)/, $(workbench-tools-installaros-catalogs_LNGS)))
workbench-tools-installaros-catalogs_DIRS := $(addsuffix /System/Tools/, $(addprefix $(AROS_CATALOGS)/, $(workbench-tools-installaros-catalogs_LNGS))) $(dir ../strings.h)

#MM- workbench-tools-installaros-catalogs-quick : workbench-tools-installaros-catalogs

#MM
workbench-tools-installaros-catalogs : $(workbench-tools-installaros-catalogs_OBJS) ../strings.h


ifneq ($(workbench-tools-installaros-catalogs_OBJS),)
$(workbench-tools-installaros-catalogs_OBJS) : | $(workbench-tools-installaros-catalogs_DIRS)
else
$(workbench-tools-installaros-catalogs_OBJS) :: $(workbench-tools-installaros-catalogs_DIRS)
endif

GLOB_MKDIRS += $(workbench-tools-installaros-catalogs_DIRS)


$(AROS_CATALOGS)/%/System/Tools//installaros.catalog : $(SRCDIR)/$(CURDIR)/%.ct $(workbench-tools-installaros-catalogs_DESC).cd
	$(Q)$(ECHO) "Creating   installaros catalog for language $*."
	$(Q)$(IF) $(TEST) "$*" = "polish"; then \
	    $(FLEXCAT) iso88592toamigapl $(workbench-tools-installaros-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Tools//installaros.catalog" || [ $$? -lt 10 ] ; \
	elif $(TEST) "$*" = "russian"; then \
	    $(FLEXCAT) win1251toamiga1251 $(workbench-tools-installaros-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Tools//installaros.catalog" || [ $$? -lt 10 ] ; \
	else \
	    $(FLEXCAT) $(workbench-tools-installaros-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Tools//installaros.catalog" || [ $$? -lt 10 ] ; \
	fi

ifneq (../strings.h,)
../strings.h : workbench-tools-installaros-catalogs_DESC := $(workbench-tools-installaros-catalogs_DESC)
../strings.h : workbench-tools-installaros-catalogs_SRC := $(workbench-tools-installaros-catalogs_SRC)
../strings.h : $(workbench-tools-installaros-catalogs_DESC).cd $(workbench-tools-installaros-catalogs_SRC).sd | $(dir ../strings.h)
	$(Q)$(ECHO) "Creating   installaros catalog source file $@"
	$(Q)$(FLEXCAT) $(workbench-tools-installaros-catalogs_DESC).cd $@=$(workbench-tools-installaros-catalogs_SRC).sd
endif

workbench-tools-installaros-catalogs-clean : FILES := $(workbench-tools-installaros-catalogs_OBJS) ../strings.h
#MM
workbench-tools-installaros-catalogs-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget workbench-tools-installaros-catalogs"
	$(Q)$(RM) $(FILES)

.PHONY: workbench-tools-installaros-catalogs workbench-tools-installaros-catalogs-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
