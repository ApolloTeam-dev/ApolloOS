  workbench-tools-wimp_CXXDTARGETS := $(addprefix $(workbench-tools-wimp_OBJDIR)/,$(notdir $(workbench-tools-wimp_CXXBASENAMES:=.d)))
  workbench-tools-wimp_MCXX_WILDCARD := $(workbench-tools-wimp_OBJDIR)/%

