    workbench-tools-wimp_MOBJC_DIRS := $(shell echo $(workbench-tools-wimp_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(workbench-tools-wimp_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  workbench-tools-wimp_CC := $(TARGET_CC)
else
  workbench-tools-wimp_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
workbench-tools-wimp_MOBJC_CPPFLAGS := $(workbench-tools-wimp_CPPFLAGS)
workbench-tools-wimp_OBJCFLAGS := $(workbench-tools-wimp_CFLAGS)
workbench-tools-wimp_OBJCFLAGS := $(workbench-tools-wimp_OBJCFLAGS) -isystem $(AROS_DEVELOPER)/include
