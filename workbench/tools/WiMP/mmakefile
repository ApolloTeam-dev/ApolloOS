  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : | $(addsuffix .m,$(workbench-tools-wimp_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  workbench-tools-wimp_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  workbench-tools-wimp_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-tools-wimp_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  workbench-tools-wimp_MOBJC_DIRS := $(foreach dir, $(workbench-tools-wimp_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-tools-wimp_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
