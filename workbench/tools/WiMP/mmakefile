  workbench-tools-wimp_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  workbench-tools-wimp_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-tools-wimp_STRIP ?= $(TARGET_STRIP)
  workbench-tools-wimp_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  workbench-tools-wimp_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  workbench-tools-wimp_MCXX_CPPFLAGS := $(strip $(workbench-tools-wimp_MCXX_CPPFLAGS) $(workbench-tools-wimp_MCXX_EXTRA_CPPFLAGS))
