  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_OBJCFLAGS:=$(strip $(workbench-tools-wimp_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_OBJCDFLAGS:=$(workbench-tools-wimp_OBJCDFLAGS)
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  workbench-tools-wimp_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  workbench-tools-wimp_STRIP ?= $(HOST_STRIP)
  workbench-tools-wimp_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-tools-wimp_MOBJC_CPPFLAGS) $(workbench-tools-wimp_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-tools-wimp_OBJCFLAGS))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-tools-wimp_OBJCDFLAGS))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  workbench-tools-wimp_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-tools-wimp_STRIP ?= $(ECHO) >/dev/null
  workbench-tools-wimp_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(workbench-tools-wimp_MOBJC_CPPFLAGS) $(workbench-tools-wimp_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-tools-wimp_OBJCFLAGS))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-tools-wimp_OBJCDFLAGS))
  $(workbench-tools-wimp_MOBJC_TARGETS) $(workbench-tools-wimp_MOBJC_DTARGETS) : workbench-tools-wimp_IQUOTE:=$(KERNEL_IQUOTE)
