# Adjust compiler flags to suit C++
workbench-tools-wimp_MCXX_CPPFLAGS := $(workbench-tools-wimp_CPPFLAGS)
workbench-tools-wimp_CXXFLAGS := $(workbench-tools-wimp_CXXFLAGS)
ifeq ($(workbench-tools-wimp_DXXFLAGS),)
