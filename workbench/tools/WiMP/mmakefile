  workbench-tools-wimp_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-tools-wimp_STRIP ?= $(ECHO) >/dev/null
  workbench-tools-wimp_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  workbench-tools-wimp_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  workbench-tools-wimp_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(workbench-tools-wimp_MCXX_CPPFLAGS) $(workbench-tools-wimp_MCXX_EXTRA_CPPFLAGS))
  workbench-tools-wimp_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-tools-wimp_CXXFLAGS))
  workbench-tools-wimp_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-tools-wimp_DXXFLAGS))
  workbench-tools-wimp_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-tools-wimp_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-tools-wimp_CXXCMD) $(workbench-tools-wimp_CXXIQUOTE) $(dir $(2)) $(workbench-tools-wimp_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-tools-wimp_CXXIQUOTE) . $(workbench-tools-wimp_CXXIQUOTE_END) $(strip $(workbench-tools-wimp_CXXFLAGS) $(workbench-tools-wimp_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-tools-wimp_CXXCMD) $(workbench-tools-wimp_CXXIQUOTE) $(dir $(2)) $(workbench-tools-wimp_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-tools-wimp_CXXIQUOTE) . $(workbench-tools-wimp_CXXIQUOTE_END) $(strip $(workbench-tools-wimp_CXXFLAGS) $(workbench-tools-wimp_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-tools-wimp_CXXCMD) $(workbench-tools-wimp_CXXIQUOTE) $(dir $(2)) $(workbench-tools-wimp_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-tools-wimp_CXXIQUOTE) . $(workbench-tools-wimp_CXXIQUOTE_END) $(strip $(workbench-tools-wimp_CXXFLAGS) $(workbench-tools-wimp_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-tools-wimp_CXXCMD)" $(MKDEPEND) $(strip $(workbench-tools-wimp_DXXFLAGS) $(workbench-tools-wimp_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-tools-wimp_OBJDIR),)
  $(foreach workbench-tools-wimp_CXXFILE,$(workbench-tools-wimp_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-tools-wimp_CXXFILE))),$(workbench-tools-wimp_CXXFILE))))
else
  $(foreach workbench-tools-wimp_CXXFILE,$(workbench-tools-wimp_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-tools-wimp_OBJDIR)/,$(notdir $(basename $(workbench-tools-wimp_CXXFILE)))),$(workbench-tools-wimp_CXXFILE))))
endif

endif


ifneq ($(workbench-tools-wimp_OBJC_NARCHFILES),)

