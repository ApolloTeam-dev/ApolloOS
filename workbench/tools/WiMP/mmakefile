$(workbench-tools-wimp_MOBJC_TARGETS) : CPPFLAGS := $(workbench-tools-wimp_MOBJC_CPPFLAGS)
$(workbench-tools-wimp_MOBJC_TARGETS) : CFLAGS := $(workbench-tools-wimp_OBJCFLAGS)
$(workbench-tools-wimp_MOBJC_TARGETS) : $(workbench-tools-wimp_MOBJC_WILDCARD).o : $(workbench-tools-wimp_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(workbench-tools-wimp_IQUOTE) $(dir $<) $(workbench-tools-wimp_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-tools-wimp_IQUOTE) . $(workbench-tools-wimp_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
