ifneq ($(workbench-tools-wimp_CXXABSBASENAMES),)

workbench-tools-wimp_CXXBASENAMES := $(basename $(workbench-tools-wimp_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
workbench-tools-wimp_MCXX_FILES  := $(strip $(foreach workbench-tools-wimp_CXXBASE,$(workbench-tools-wimp_CXXABSBASENAMES), $(firstword $(wildcard $(foreach workbench-tools-wimp_EXT, $(AROS_CXXEXTS),$(addsuffix .$(workbench-tools-wimp_EXT),$(workbench-tools-wimp_CXXBASE)))))))

ifeq (,)
workbench-tools-wimp_MCXX_SRCWILDCARD := %
else
workbench-tools-wimp_MCXX_SRCWILDCARD := /%
endif

ifeq ($(workbench-tools-wimp_OBJDIR),)
  workbench-tools-wimp_CXXTARGETS := $(notdir $(workbench-tools-wimp_CXXBASENAMES:=.o))
  workbench-tools-wimp_CXXDTARGETS := $(notdir $(workbench-tools-wimp_CXXBASENAMES:=.d))
  workbench-tools-wimp_MCXX_WILDCARD := %
else
