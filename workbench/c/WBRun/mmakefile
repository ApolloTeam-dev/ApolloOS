  workbench-c-wbrun_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-c-wbrun_DXXFLAGS))
  workbench-c-wbrun_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-c-wbrun_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-c-wbrun_CXXCMD) $(workbench-c-wbrun_CXXIQUOTE) $(dir $(2)) $(workbench-c-wbrun_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-wbrun_CXXIQUOTE) . $(workbench-c-wbrun_CXXIQUOTE_END) $(strip $(workbench-c-wbrun_CXXFLAGS) $(workbench-c-wbrun_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-c-wbrun_CXXCMD) $(workbench-c-wbrun_CXXIQUOTE) $(dir $(2)) $(workbench-c-wbrun_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-wbrun_CXXIQUOTE) . $(workbench-c-wbrun_CXXIQUOTE_END) $(strip $(workbench-c-wbrun_CXXFLAGS) $(workbench-c-wbrun_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-c-wbrun_CXXCMD) $(workbench-c-wbrun_CXXIQUOTE) $(dir $(2)) $(workbench-c-wbrun_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-wbrun_CXXIQUOTE) . $(workbench-c-wbrun_CXXIQUOTE_END) $(strip $(workbench-c-wbrun_CXXFLAGS) $(workbench-c-wbrun_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-c-wbrun_CXXCMD)" $(MKDEPEND) $(strip $(workbench-c-wbrun_DXXFLAGS) $(workbench-c-wbrun_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-c-wbrun_OBJDIR),)
  $(foreach workbench-c-wbrun_CXXFILE,$(workbench-c-wbrun_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-c-wbrun_CXXFILE))),$(workbench-c-wbrun_CXXFILE))))
else
  $(foreach workbench-c-wbrun_CXXFILE,$(workbench-c-wbrun_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-c-wbrun_OBJDIR)/,$(notdir $(basename $(workbench-c-wbrun_CXXFILE)))),$(workbench-c-wbrun_CXXFILE))))
endif

endif


