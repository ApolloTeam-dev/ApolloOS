  workbench-c-wbrun_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-c-wbrun_STRIP ?= $(ECHO) >/dev/null
