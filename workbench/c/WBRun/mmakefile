  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-c-wbrun_OBJCFLAGS))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-c-wbrun_OBJCDFLAGS))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_IQUOTE:=$(KERNEL_IQUOTE)
