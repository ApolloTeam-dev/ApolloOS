  workbench-c-wbrun_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-c-wbrun_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  workbench-c-wbrun_MOBJC_DIRS := $(foreach dir, $(workbench-c-wbrun_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-c-wbrun_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
