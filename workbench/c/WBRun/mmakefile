  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_MOBJC_CPPFLAGS:=$(strip $(workbench-c-wbrun_MOBJC_CPPFLAGS) $(workbench-c-wbrun_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_OBJCFLAGS:=$(strip $(workbench-c-wbrun_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_OBJCDFLAGS:=$(workbench-c-wbrun_OBJCDFLAGS)
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  workbench-c-wbrun_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  workbench-c-wbrun_STRIP ?= $(HOST_STRIP)
  workbench-c-wbrun_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-c-wbrun_MOBJC_CPPFLAGS) $(workbench-c-wbrun_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-c-wbrun_OBJCFLAGS))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-c-wbrun_OBJCDFLAGS))
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-c-wbrun_MOBJC_TARGETS) $(workbench-c-wbrun_MOBJC_DTARGETS) : workbench-c-wbrun_IQUOTE_END:=$(HOST_IQUOTE_END)
