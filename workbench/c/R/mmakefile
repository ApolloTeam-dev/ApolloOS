workbench-c-r_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (target,kernel)
workbench-c-r_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
workbench-c-r_LDFLAGS          := 
endif

workbench-c-r_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
