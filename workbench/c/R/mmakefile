TMP_FILES := $(workbench-c-r_C_NARCHFILES) $(workbench-c-r_CXX_NARCHFILES) $(workbench-c-r_ASMFILES) $(workbench-c-r_OBJC_NARCHFILES)
workbench-c-r_OBJS := $(addsuffix .o,$(addprefix $(workbench-c-r_OBJDIR)/,$(notdir $(TMP_FILES))))
