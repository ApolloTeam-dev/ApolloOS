endif

#MM
workbench-c-r-quick : workbench-c-r

#MM workbench-c-r : includes-generate-deps core-linklibs
workbench-c-r : $(workbench-c-r_TARGETDIR)/$(workbench-c-r_PROGNAME)

ifneq ($(filter $(TARGET),workbench-c-r workbench-c-r-quick workbench-c-r-gz-quick),)

workbench-c-r_CXXABSBASENAMES := $(foreach workbench-c-r_CXXBASE,$(workbench-c-r_CXX_NARCHFILES),$(if $(filter /%,$(workbench-c-r_CXXBASE)),$(workbench-c-r_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(workbench-c-r_CXXBASE))))

ifneq ($(workbench-c-r_CXXABSBASENAMES),)

workbench-c-r_CXXBASENAMES := $(basename $(workbench-c-r_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
workbench-c-r_MCXX_FILES  := $(strip $(foreach workbench-c-r_CXXBASE,$(workbench-c-r_CXXABSBASENAMES), $(firstword $(wildcard $(foreach workbench-c-r_EXT, $(AROS_CXXEXTS),$(addsuffix .$(workbench-c-r_EXT),$(workbench-c-r_CXXBASE)))))))

ifeq (,)
workbench-c-r_MCXX_SRCWILDCARD := %
else
workbench-c-r_MCXX_SRCWILDCARD := /%
endif

ifeq ($(workbench-c-r_OBJDIR),)
  workbench-c-r_CXXTARGETS := $(notdir $(workbench-c-r_CXXBASENAMES:=.o))
  workbench-c-r_CXXDTARGETS := $(notdir $(workbench-c-r_CXXBASENAMES:=.d))
  workbench-c-r_MCXX_WILDCARD := %
else
  workbench-c-r_CXXTARGETS := $(addprefix $(workbench-c-r_OBJDIR)/,$(notdir $(workbench-c-r_CXXBASENAMES:=.o)))
  workbench-c-r_CXXDTARGETS := $(addprefix $(workbench-c-r_OBJDIR)/,$(notdir $(workbench-c-r_CXXBASENAMES:=.d)))
  workbench-c-r_MCXX_WILDCARD := $(workbench-c-r_OBJDIR)/%

  # Be sure that all source files are generated
  $(workbench-c-r_CXXTARGETS) $(workbench-c-r_CXXDTARGETS) : | $(workbench-c-r_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
workbench-c-r_MCXX_CPPFLAGS := $(workbench-c-r_CPPFLAGS)
workbench-c-r_CXXFLAGS := $(workbench-c-r_CXXFLAGS)
ifeq ($(workbench-c-r_DXXFLAGS),)
  workbench-c-r_DXXFLAGS := $(workbench-c-r_CXXFLAGS)
else
  workbench-c-r_DXXFLAGS := $(workbench-c-r_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  workbench-c-r_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  workbench-c-r_STRIP ?= $(HOST_STRIP)
  workbench-c-r_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  workbench-c-r_CXXCMD:=$(HOST_CXX)
  workbench-c-r_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(workbench-c-r_MCXX_CPPFLAGS) $(workbench-c-r_MCXX_EXTRA_CPPFLAGS))
  workbench-c-r_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-c-r_CXXFLAGS))
  workbench-c-r_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-c-r_DXXFLAGS))
  workbench-c-r_CXXIQUOTE:=$(HOST_IQUOTE)
  workbench-c-r_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  workbench-c-r_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-c-r_STRIP ?= $(TARGET_STRIP)
  workbench-c-r_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  workbench-c-r_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  workbench-c-r_MCXX_CPPFLAGS := $(strip $(workbench-c-r_MCXX_CPPFLAGS) $(workbench-c-r_MCXX_EXTRA_CPPFLAGS))
  workbench-c-r_CXXFLAGS := $(strip $(workbench-c-r_CXXFLAGS) $(SAFETY_CFLAGS))
  workbench-c-r_DXXFLAGS := $(workbench-c-r_DXXFLAGS)
  workbench-c-r_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  workbench-c-r_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  workbench-c-r_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-c-r_STRIP ?= $(ECHO) >/dev/null
  workbench-c-r_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  workbench-c-r_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  workbench-c-r_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(workbench-c-r_MCXX_CPPFLAGS) $(workbench-c-r_MCXX_EXTRA_CPPFLAGS))
  workbench-c-r_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-c-r_CXXFLAGS))
  workbench-c-r_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-c-r_DXXFLAGS))
  workbench-c-r_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-c-r_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-c-r_CXXCMD) $(workbench-c-r_CXXIQUOTE) $(dir $(2)) $(workbench-c-r_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-r_CXXIQUOTE) . $(workbench-c-r_CXXIQUOTE_END) $(strip $(workbench-c-r_CXXFLAGS) $(workbench-c-r_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-c-r_CXXCMD) $(workbench-c-r_CXXIQUOTE) $(dir $(2)) $(workbench-c-r_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-r_CXXIQUOTE) . $(workbench-c-r_CXXIQUOTE_END) $(strip $(workbench-c-r_CXXFLAGS) $(workbench-c-r_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-c-r_CXXCMD) $(workbench-c-r_CXXIQUOTE) $(dir $(2)) $(workbench-c-r_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-r_CXXIQUOTE) . $(workbench-c-r_CXXIQUOTE_END) $(strip $(workbench-c-r_CXXFLAGS) $(workbench-c-r_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-c-r_CXXCMD)" $(MKDEPEND) $(strip $(workbench-c-r_DXXFLAGS) $(workbench-c-r_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-c-r_OBJDIR),)
  $(foreach workbench-c-r_CXXFILE,$(workbench-c-r_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-c-r_CXXFILE))),$(workbench-c-r_CXXFILE))))
else
  $(foreach workbench-c-r_CXXFILE,$(workbench-c-r_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-c-r_OBJDIR)/,$(notdir $(basename $(workbench-c-r_CXXFILE)))),$(workbench-c-r_CXXFILE))))
endif

endif


ifneq ($(workbench-c-r_OBJC_NARCHFILES),)

ifeq (,)
workbench-c-r_MOBJC_SRCWILDCARD := %
else
workbench-c-r_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(workbench-c-r_OBJDIR),)
  workbench-c-r_MOBJC_TARGETS := $(addsuffix .o,$(workbench-c-r_OBJC_NARCHFILES))
  workbench-c-r_MOBJC_DTARGETS := $(addsuffix .d,$(workbench-c-r_OBJC_NARCHFILES))
