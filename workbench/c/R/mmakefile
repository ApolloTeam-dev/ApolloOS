endif
ifeq (target,host)
workbench-c-r_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
workbench-c-r_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
workbench-c-r_CFLAGS            := 
endif

ifeq ("","")
ifeq (target,target)
workbench-c-r_CXXFLAGS            := $(CXXFLAGS)
endif
ifeq (target,host)
workbench-c-r_CXXFLAGS            := $(HOST_CXXFLAGS)
endif
ifeq (target,kernel)
workbench-c-r_CXXFLAGS            := $(strip $(KERNEL_ISA_CXXFLAGS) $(KERNEL_CXXFLAGS))
endif
else
workbench-c-r_CXXFLAGS          := 
endif

ifeq ("","")
ifeq (target,target)
workbench-c-r_LDFLAGS            := $(LDFLAGS)
endif
