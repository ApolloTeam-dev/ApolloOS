  workbench-c-r_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(workbench-c-r_OBJDIR)/,$(workbench-c-r_OBJC_NARCHFILES)))
  workbench-c-r_MOBJC_WILDCARD := $(workbench-c-r_OBJDIR)/%

  # Be sure that all .m files are generated
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : | $(addsuffix .m,$(workbench-c-r_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  workbench-c-r_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  workbench-c-r_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-c-r_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  workbench-c-r_MOBJC_DIRS := $(foreach dir, $(workbench-c-r_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-c-r_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(workbench-c-r_MOBJC_DIRS),)
    workbench-c-r_MOBJC_DIRS := $(shell echo $(workbench-c-r_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(workbench-c-r_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  workbench-c-r_CC := $(TARGET_CC)
else
  workbench-c-r_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
workbench-c-r_MOBJC_CPPFLAGS := $(workbench-c-r_CPPFLAGS)
workbench-c-r_OBJCFLAGS := $(workbench-c-r_CFLAGS)
workbench-c-r_OBJCFLAGS := $(workbench-c-r_OBJCFLAGS) -isystem $(AROS_DEVELOPER)/include
workbench-c-r_OBJCFLAGS := $(subst -Wno-pointer-sign,, $(subst -Werror-implicit-function-declaration,, $(workbench-c-r_OBJCFLAGS)))
ifeq ($(workbench-c-r_DFLAGS),)
  workbench-c-r_OBJCDFLAGS := $(workbench-c-r_CFLAGS)
else
  workbench-c-r_OBJCDFLAGS := $(workbench-c-r_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  workbench-c-r_LINK ?= $(strip $(workbench-c-r_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-c-r_STRIP ?= $(TARGET_STRIP)
  workbench-c-r_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : CMD:=$(strip $(workbench-c-r_CC) $(TARGET_SYSROOT))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_MOBJC_CPPFLAGS:=$(strip $(workbench-c-r_MOBJC_CPPFLAGS) $(workbench-c-r_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_OBJCFLAGS:=$(strip $(workbench-c-r_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_OBJCDFLAGS:=$(workbench-c-r_OBJCDFLAGS)
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  workbench-c-r_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  workbench-c-r_STRIP ?= $(HOST_STRIP)
  workbench-c-r_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-c-r_MOBJC_CPPFLAGS) $(workbench-c-r_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-c-r_OBJCFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-c-r_OBJCDFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  workbench-c-r_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-c-r_STRIP ?= $(ECHO) >/dev/null
  workbench-c-r_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(workbench-c-r_MOBJC_CPPFLAGS) $(workbench-c-r_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-c-r_OBJCFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-c-r_OBJCDFLAGS))
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_IQUOTE:=$(KERNEL_IQUOTE)
  $(workbench-c-r_MOBJC_TARGETS) $(workbench-c-r_MOBJC_DTARGETS) : workbench-c-r_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(workbench-c-r_MOBJC_TARGETS) : CPPFLAGS := $(workbench-c-r_MOBJC_CPPFLAGS)
$(workbench-c-r_MOBJC_TARGETS) : CFLAGS := $(workbench-c-r_OBJCFLAGS)
$(workbench-c-r_MOBJC_TARGETS) : $(workbench-c-r_MOBJC_WILDCARD).o : $(workbench-c-r_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(workbench-c-r_IQUOTE) $(dir $<) $(workbench-c-r_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-r_IQUOTE) . $(workbench-c-r_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(workbench-c-r_IQUOTE) $(dir $<) $(workbench-c-r_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-r_IQUOTE) . $(workbench-c-r_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(workbench-c-r_IQUOTE) $(dir $<) $(workbench-c-r_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-r_IQUOTE) . $(workbench-c-r_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

