.PHONY : workbench-c-r

workbench-c-r_PROGNAME  := R
workbench-c-r_OBJDIR    := $(GENDIR)/$(CURDIR)
workbench-c-r_TARGETDIR := $(EXEDIR)
workbench-c-r_LINKER    := 
workbench-c-r_LIBS := 
