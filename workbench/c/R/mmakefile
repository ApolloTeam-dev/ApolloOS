workbench-c-r_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
workbench-c-r_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
workbench-c-r_CFLAGS    := $(strip $(workbench-c-r_COVERAGEFLAGS) $(workbench-c-r_CFLAGS))
workbench-c-r_CXXFLAGS := $(strip $(workbench-c-r_COVERAGEFLAGS) $(workbench-c-r_CXXFLAGS))
workbench-c-r_LIBS += $(workbench-c-r_COVERAGELIBS)
