  AHI-linklibs-alsa-bridge_STRIP ?= $(HOST_STRIP)
  AHI-linklibs-alsa-bridge_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(AHI-linklibs-alsa-bridge_MOBJC_TARGETS) $(AHI-linklibs-alsa-bridge_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(AHI-linklibs-alsa-bridge_MOBJC_TARGETS) $(AHI-linklibs-alsa-bridge_MOBJC_DTARGETS) : AHI-linklibs-alsa-bridge_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(AHI-linklibs-alsa-bridge_MOBJC_CPPFLAGS) $(AHI-linklibs-alsa-bridge_MOBJC_EXTRA_CPPFLAGS))
  $(AHI-linklibs-alsa-bridge_MOBJC_TARGETS) $(AHI-linklibs-alsa-bridge_MOBJC_DTARGETS) : AHI-linklibs-alsa-bridge_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(AHI-linklibs-alsa-bridge_OBJCFLAGS))
