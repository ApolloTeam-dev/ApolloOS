  $(AHI-linklibs-alsa-bridge_MOBJC_TARGETS) $(AHI-linklibs-alsa-bridge_MOBJC_DTARGETS) : AHI-linklibs-alsa-bridge_IQUOTE:=$(CFLAGS_IQUOTE)
  $(AHI-linklibs-alsa-bridge_MOBJC_TARGETS) $(AHI-linklibs-alsa-bridge_MOBJC_DTARGETS) : AHI-linklibs-alsa-bridge_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
