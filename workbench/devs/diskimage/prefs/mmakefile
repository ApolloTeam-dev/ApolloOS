define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-devs-diskimage-prefs_CXXCMD) $(workbench-devs-diskimage-prefs_CXXIQUOTE) $(dir $(2)) $(workbench-devs-diskimage-prefs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-devs-diskimage-prefs_CXXIQUOTE) . $(workbench-devs-diskimage-prefs_CXXIQUOTE_END) $(strip $(workbench-devs-diskimage-prefs_CXXFLAGS) $(workbench-devs-diskimage-prefs_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-devs-diskimage-prefs_CXXCMD) $(workbench-devs-diskimage-prefs_CXXIQUOTE) $(dir $(2)) $(workbench-devs-diskimage-prefs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-devs-diskimage-prefs_CXXIQUOTE) . $(workbench-devs-diskimage-prefs_CXXIQUOTE_END) $(strip $(workbench-devs-diskimage-prefs_CXXFLAGS) $(workbench-devs-diskimage-prefs_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-devs-diskimage-prefs_CXXCMD) $(workbench-devs-diskimage-prefs_CXXIQUOTE) $(dir $(2)) $(workbench-devs-diskimage-prefs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-devs-diskimage-prefs_CXXIQUOTE) . $(workbench-devs-diskimage-prefs_CXXIQUOTE_END) $(strip $(workbench-devs-diskimage-prefs_CXXFLAGS) $(workbench-devs-diskimage-prefs_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-devs-diskimage-prefs_CXXCMD)" $(MKDEPEND) $(strip $(workbench-devs-diskimage-prefs_DXXFLAGS) $(workbench-devs-diskimage-prefs_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
