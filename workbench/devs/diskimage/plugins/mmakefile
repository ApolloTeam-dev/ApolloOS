else
  $(foreach workbench-devs-diskimage-ccd_CXXFILE,$(workbench-devs-diskimage-ccd_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-devs-diskimage-ccd_OBJDIR)/,$(notdir $(basename $(workbench-devs-diskimage-ccd_CXXFILE)))),$(workbench-devs-diskimage-ccd_CXXFILE))))
