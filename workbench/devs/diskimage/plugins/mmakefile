		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-devs-diskimage-nrg_CXXCMD) $(workbench-devs-diskimage-nrg_CXXIQUOTE) $(dir $(2)) $(workbench-devs-diskimage-nrg_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-devs-diskimage-nrg_CXXIQUOTE) . $(workbench-devs-diskimage-nrg_CXXIQUOTE_END) $(strip $(workbench-devs-diskimage-nrg_CXXFLAGS) $(workbench-devs-diskimage-nrg_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-devs-diskimage-nrg_CXXCMD) $(workbench-devs-diskimage-nrg_CXXIQUOTE) $(dir $(2)) $(workbench-devs-diskimage-nrg_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-devs-diskimage-nrg_CXXIQUOTE) . $(workbench-devs-diskimage-nrg_CXXIQUOTE_END) $(strip $(workbench-devs-diskimage-nrg_CXXFLAGS) $(workbench-devs-diskimage-nrg_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
