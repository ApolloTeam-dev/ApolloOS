  arostcp-c-netstat_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(arostcp-c-netstat_CXXFLAGS))
  arostcp-c-netstat_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(arostcp-c-netstat_DXXFLAGS))
