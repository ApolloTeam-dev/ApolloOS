# Identify the "real" c++ files from the passed in basenames
arostcp-c-netstat_MCXX_FILES  := $(strip $(foreach arostcp-c-netstat_CXXBASE,$(arostcp-c-netstat_CXXABSBASENAMES), $(firstword $(wildcard $(foreach arostcp-c-netstat_EXT, $(AROS_CXXEXTS),$(addsuffix .$(arostcp-c-netstat_EXT),$(arostcp-c-netstat_CXXBASE)))))))

