  arostcp-c-netstat_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  arostcp-c-netstat_STRIP ?= $(ECHO) >/dev/null
  arostcp-c-netstat_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  arostcp-c-netstat_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  arostcp-c-netstat_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(arostcp-c-netstat_MCXX_CPPFLAGS) $(arostcp-c-netstat_MCXX_EXTRA_CPPFLAGS))
  arostcp-c-netstat_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(arostcp-c-netstat_CXXFLAGS))
  arostcp-c-netstat_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(arostcp-c-netstat_DXXFLAGS))
  arostcp-c-netstat_CXXIQUOTE:=$(KERNEL_IQUOTE)
  arostcp-c-netstat_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(arostcp-c-netstat_CXXCMD) $(arostcp-c-netstat_CXXIQUOTE) $(dir $(2)) $(arostcp-c-netstat_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(arostcp-c-netstat_CXXIQUOTE) . $(arostcp-c-netstat_CXXIQUOTE_END) $(strip $(arostcp-c-netstat_CXXFLAGS) $(arostcp-c-netstat_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(arostcp-c-netstat_CXXCMD) $(arostcp-c-netstat_CXXIQUOTE) $(dir $(2)) $(arostcp-c-netstat_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(arostcp-c-netstat_CXXIQUOTE) . $(arostcp-c-netstat_CXXIQUOTE_END) $(strip $(arostcp-c-netstat_CXXFLAGS) $(arostcp-c-netstat_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(arostcp-c-netstat_CXXCMD) $(arostcp-c-netstat_CXXIQUOTE) $(dir $(2)) $(arostcp-c-netstat_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(arostcp-c-netstat_CXXIQUOTE) . $(arostcp-c-netstat_CXXIQUOTE_END) $(strip $(arostcp-c-netstat_CXXFLAGS) $(arostcp-c-netstat_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(arostcp-c-netstat_CXXCMD)" $(MKDEPEND) $(strip $(arostcp-c-netstat_DXXFLAGS) $(arostcp-c-netstat_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(arostcp-c-netstat_OBJDIR),)
  $(foreach arostcp-c-netstat_CXXFILE,$(arostcp-c-netstat_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(arostcp-c-netstat_CXXFILE))),$(arostcp-c-netstat_CXXFILE))))
else
  $(foreach arostcp-c-netstat_CXXFILE,$(arostcp-c-netstat_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(arostcp-c-netstat_OBJDIR)/,$(notdir $(basename $(arostcp-c-netstat_CXXFILE)))),$(arostcp-c-netstat_CXXFILE))))
endif

endif


