  arostcp-c-netstat_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(arostcp-c-netstat_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  arostcp-c-netstat_MOBJC_DIRS := $(foreach dir, $(arostcp-c-netstat_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(arostcp-c-netstat_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
