ifeq (target,target)
  arostcp-c-netstat_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  arostcp-c-netstat_STRIP ?= $(TARGET_STRIP)
  arostcp-c-netstat_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  arostcp-c-netstat_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  arostcp-c-netstat_MCXX_CPPFLAGS := $(strip $(arostcp-c-netstat_MCXX_CPPFLAGS) $(arostcp-c-netstat_MCXX_EXTRA_CPPFLAGS))
  arostcp-c-netstat_CXXFLAGS := $(strip $(arostcp-c-netstat_CXXFLAGS) $(SAFETY_CFLAGS))
  arostcp-c-netstat_DXXFLAGS := $(arostcp-c-netstat_DXXFLAGS)
