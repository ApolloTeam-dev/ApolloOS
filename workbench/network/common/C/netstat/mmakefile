  arostcp-c-netstat_CXXDTARGETS := $(notdir $(arostcp-c-netstat_CXXBASENAMES:=.d))
  arostcp-c-netstat_MCXX_WILDCARD := %
else
  arostcp-c-netstat_CXXTARGETS := $(addprefix $(arostcp-c-netstat_OBJDIR)/,$(notdir $(arostcp-c-netstat_CXXBASENAMES:=.o)))
  arostcp-c-netstat_CXXDTARGETS := $(addprefix $(arostcp-c-netstat_OBJDIR)/,$(notdir $(arostcp-c-netstat_CXXBASENAMES:=.d)))
