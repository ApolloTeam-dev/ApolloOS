  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_MOBJC_CPPFLAGS:=$(strip $(arostcp-c-netstat_MOBJC_CPPFLAGS) $(arostcp-c-netstat_MOBJC_EXTRA_CPPFLAGS))
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_OBJCFLAGS:=$(strip $(arostcp-c-netstat_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_OBJCDFLAGS:=$(arostcp-c-netstat_OBJCDFLAGS)
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_IQUOTE:=$(CFLAGS_IQUOTE)
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  arostcp-c-netstat_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  arostcp-c-netstat_STRIP ?= $(HOST_STRIP)
  arostcp-c-netstat_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(arostcp-c-netstat_MOBJC_CPPFLAGS) $(arostcp-c-netstat_MOBJC_EXTRA_CPPFLAGS))
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(arostcp-c-netstat_OBJCFLAGS))
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(arostcp-c-netstat_OBJCDFLAGS))
  $(arostcp-c-netstat_MOBJC_TARGETS) $(arostcp-c-netstat_MOBJC_DTARGETS) : arostcp-c-netstat_IQUOTE:=$(HOST_IQUOTE)
