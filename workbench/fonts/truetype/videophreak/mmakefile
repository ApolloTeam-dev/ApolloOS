include $(SRCDIR)/config/aros.cfg

#MM- fonts-truetype : fonts-truetype-videophreak
#MM- fonts-truetype-quick : fonts-truetype-videophreak
#MM- fonts-truetype-videophreak : fonts-truetype-videophreak-ttf fonts-truetype-videophreak-amifonts


fonts-truetype-videophreak-ttf_SRC := $(shell echo . | sed 's/^\(.\):\//\/\1\//')


ifneq (setup,)
setup : | $(AROSDIR)/Fonts/TrueType
else
setup :: $(AROSDIR)/Fonts/TrueType
endif

GLOB_MKDIRS += $(AROSDIR)/Fonts/TrueType


.PHONY : fonts-truetype-videophreak-ttf

#MM
fonts-truetype-videophreak-ttf : | $(AROSDIR)/Fonts/TrueType 
	$(foreach file, $(call WILDCARD, *.ttf), $(shell $(CP) $(addprefix $(if $(filter /%,$(fonts-truetype-videophreak-ttf_SRC)),$(fonts-truetype-videophreak-ttf_SRC),$(SRCDIR)/$(CURDIR)/$(fonts-truetype-videophreak-ttf_SRC))/, $(file)) $(addprefix $(AROSDIR)/Fonts/TrueType/, $(file))))


#MM
fonts-truetype-videophreak-amifonts :
	@cd $(SRCDIR)/$(CURDIR); for file in *.font *.otag; do \
            if [ ! -e "$(AROSDIR)/Fonts/$$file" ]; then \
                $(ECHO) Copying "$$file"...; \
                $(CP) "$$file" $(AROSDIR)/Fonts; \
            fi; \
        done

# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
