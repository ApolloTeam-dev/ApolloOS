workbench-prefs-boot_LDFLAGS            := $(LDFLAGS)
endif
ifeq (target,host)
workbench-prefs-boot_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (target,kernel)
workbench-prefs-boot_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
workbench-prefs-boot_LDFLAGS          := 
endif

workbench-prefs-boot_COVERAGE := no
