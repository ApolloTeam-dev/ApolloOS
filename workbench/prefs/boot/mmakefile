  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : CMD:=$(strip $(workbench-prefs-boot_CC) $(TARGET_SYSROOT))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_MOBJC_CPPFLAGS:=$(strip $(workbench-prefs-boot_MOBJC_CPPFLAGS) $(workbench-prefs-boot_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_OBJCFLAGS:=$(strip $(workbench-prefs-boot_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_OBJCDFLAGS:=$(workbench-prefs-boot_OBJCDFLAGS)
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  workbench-prefs-boot_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  workbench-prefs-boot_STRIP ?= $(HOST_STRIP)
  workbench-prefs-boot_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-prefs-boot_MOBJC_CPPFLAGS) $(workbench-prefs-boot_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-prefs-boot_OBJCFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-prefs-boot_OBJCDFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  workbench-prefs-boot_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-prefs-boot_STRIP ?= $(ECHO) >/dev/null
  workbench-prefs-boot_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(workbench-prefs-boot_MOBJC_CPPFLAGS) $(workbench-prefs-boot_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-prefs-boot_OBJCFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-prefs-boot_OBJCDFLAGS))
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_IQUOTE:=$(KERNEL_IQUOTE)
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : workbench-prefs-boot_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(workbench-prefs-boot_MOBJC_TARGETS) : CPPFLAGS := $(workbench-prefs-boot_MOBJC_CPPFLAGS)
$(workbench-prefs-boot_MOBJC_TARGETS) : CFLAGS := $(workbench-prefs-boot_OBJCFLAGS)
$(workbench-prefs-boot_MOBJC_TARGETS) : $(workbench-prefs-boot_MOBJC_WILDCARD).o : $(workbench-prefs-boot_MOBJC_SRCWILDCARD).m
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
