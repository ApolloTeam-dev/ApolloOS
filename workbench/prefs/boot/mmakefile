workbench-prefs-boot_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (target,target)
workbench-prefs-boot_CFLAGS            := $(CFLAGS)
endif
ifeq (target,host)
workbench-prefs-boot_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
workbench-prefs-boot_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
