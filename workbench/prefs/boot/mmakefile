  workbench-prefs-boot_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  workbench-prefs-boot_CXXCMD:=$(HOST_CXX)
  workbench-prefs-boot_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(workbench-prefs-boot_MCXX_CPPFLAGS) $(workbench-prefs-boot_MCXX_EXTRA_CPPFLAGS))
  workbench-prefs-boot_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-prefs-boot_CXXFLAGS))
  workbench-prefs-boot_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-prefs-boot_DXXFLAGS))
  workbench-prefs-boot_CXXIQUOTE:=$(HOST_IQUOTE)
  workbench-prefs-boot_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  workbench-prefs-boot_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-prefs-boot_STRIP ?= $(TARGET_STRIP)
  workbench-prefs-boot_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  workbench-prefs-boot_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  workbench-prefs-boot_MCXX_CPPFLAGS := $(strip $(workbench-prefs-boot_MCXX_CPPFLAGS) $(workbench-prefs-boot_MCXX_EXTRA_CPPFLAGS))
  workbench-prefs-boot_CXXFLAGS := $(strip $(workbench-prefs-boot_CXXFLAGS) $(SAFETY_CFLAGS))
  workbench-prefs-boot_DXXFLAGS := $(workbench-prefs-boot_DXXFLAGS)
  workbench-prefs-boot_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  workbench-prefs-boot_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  workbench-prefs-boot_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-prefs-boot_STRIP ?= $(ECHO) >/dev/null
  workbench-prefs-boot_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  workbench-prefs-boot_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  workbench-prefs-boot_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(workbench-prefs-boot_MCXX_CPPFLAGS) $(workbench-prefs-boot_MCXX_EXTRA_CPPFLAGS))
  workbench-prefs-boot_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-prefs-boot_CXXFLAGS))
  workbench-prefs-boot_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-prefs-boot_DXXFLAGS))
  workbench-prefs-boot_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-prefs-boot_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-prefs-boot_CXXCMD) $(workbench-prefs-boot_CXXIQUOTE) $(dir $(2)) $(workbench-prefs-boot_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-prefs-boot_CXXIQUOTE) . $(workbench-prefs-boot_CXXIQUOTE_END) $(strip $(workbench-prefs-boot_CXXFLAGS) $(workbench-prefs-boot_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-prefs-boot_CXXCMD) $(workbench-prefs-boot_CXXIQUOTE) $(dir $(2)) $(workbench-prefs-boot_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-prefs-boot_CXXIQUOTE) . $(workbench-prefs-boot_CXXIQUOTE_END) $(strip $(workbench-prefs-boot_CXXFLAGS) $(workbench-prefs-boot_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-prefs-boot_CXXCMD) $(workbench-prefs-boot_CXXIQUOTE) $(dir $(2)) $(workbench-prefs-boot_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-prefs-boot_CXXIQUOTE) . $(workbench-prefs-boot_CXXIQUOTE_END) $(strip $(workbench-prefs-boot_CXXFLAGS) $(workbench-prefs-boot_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-prefs-boot_CXXCMD)" $(MKDEPEND) $(strip $(workbench-prefs-boot_DXXFLAGS) $(workbench-prefs-boot_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-prefs-boot_OBJDIR),)
  $(foreach workbench-prefs-boot_CXXFILE,$(workbench-prefs-boot_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-prefs-boot_CXXFILE))),$(workbench-prefs-boot_CXXFILE))))
else
  $(foreach workbench-prefs-boot_CXXFILE,$(workbench-prefs-boot_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-prefs-boot_OBJDIR)/,$(notdir $(basename $(workbench-prefs-boot_CXXFILE)))),$(workbench-prefs-boot_CXXFILE))))
endif

endif


ifneq ($(workbench-prefs-boot_OBJC_NARCHFILES),)

ifeq (,)
