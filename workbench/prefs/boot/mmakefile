workbench-prefs-boot_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
workbench-prefs-boot_CFLAGS    := $(strip $(workbench-prefs-boot_INSTRFUNCFLAGS) $(workbench-prefs-boot_CFLAGS))
