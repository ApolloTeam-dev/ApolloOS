workbench-prefs-boot-quick : workbench-prefs-boot

#MM workbench-prefs-boot : includes-generate-deps core-linklibs
workbench-prefs-boot : $(workbench-prefs-boot_TARGETDIR)/$(workbench-prefs-boot_PROGNAME)

ifneq ($(filter $(TARGET),workbench-prefs-boot workbench-prefs-boot-quick workbench-prefs-boot-gz-quick),)

workbench-prefs-boot_CXXABSBASENAMES := $(foreach workbench-prefs-boot_CXXBASE,$(workbench-prefs-boot_CXX_NARCHFILES),$(if $(filter /%,$(workbench-prefs-boot_CXXBASE)),$(workbench-prefs-boot_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(workbench-prefs-boot_CXXBASE))))

ifneq ($(workbench-prefs-boot_CXXABSBASENAMES),)

workbench-prefs-boot_CXXBASENAMES := $(basename $(workbench-prefs-boot_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
workbench-prefs-boot_MCXX_FILES  := $(strip $(foreach workbench-prefs-boot_CXXBASE,$(workbench-prefs-boot_CXXABSBASENAMES), $(firstword $(wildcard $(foreach workbench-prefs-boot_EXT, $(AROS_CXXEXTS),$(addsuffix .$(workbench-prefs-boot_EXT),$(workbench-prefs-boot_CXXBASE)))))))

ifeq (,)
workbench-prefs-boot_MCXX_SRCWILDCARD := %
else
workbench-prefs-boot_MCXX_SRCWILDCARD := /%
endif

ifeq ($(workbench-prefs-boot_OBJDIR),)
  workbench-prefs-boot_CXXTARGETS := $(notdir $(workbench-prefs-boot_CXXBASENAMES:=.o))
  workbench-prefs-boot_CXXDTARGETS := $(notdir $(workbench-prefs-boot_CXXBASENAMES:=.d))
  workbench-prefs-boot_MCXX_WILDCARD := %
else
  workbench-prefs-boot_CXXTARGETS := $(addprefix $(workbench-prefs-boot_OBJDIR)/,$(notdir $(workbench-prefs-boot_CXXBASENAMES:=.o)))
  workbench-prefs-boot_CXXDTARGETS := $(addprefix $(workbench-prefs-boot_OBJDIR)/,$(notdir $(workbench-prefs-boot_CXXBASENAMES:=.d)))
  workbench-prefs-boot_MCXX_WILDCARD := $(workbench-prefs-boot_OBJDIR)/%

  # Be sure that all source files are generated
  $(workbench-prefs-boot_CXXTARGETS) $(workbench-prefs-boot_CXXDTARGETS) : | $(workbench-prefs-boot_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
workbench-prefs-boot_MCXX_CPPFLAGS := $(workbench-prefs-boot_CPPFLAGS)
workbench-prefs-boot_CXXFLAGS := $(workbench-prefs-boot_CXXFLAGS)
ifeq ($(workbench-prefs-boot_DXXFLAGS),)
  workbench-prefs-boot_DXXFLAGS := $(workbench-prefs-boot_CXXFLAGS)
else
  workbench-prefs-boot_DXXFLAGS := $(workbench-prefs-boot_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  workbench-prefs-boot_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
