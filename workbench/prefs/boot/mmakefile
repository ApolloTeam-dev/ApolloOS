  workbench-prefs-boot_MOBJC_WILDCARD := $(workbench-prefs-boot_OBJDIR)/%

  # Be sure that all .m files are generated
  $(workbench-prefs-boot_MOBJC_TARGETS) $(workbench-prefs-boot_MOBJC_DTARGETS) : | $(addsuffix .m,$(workbench-prefs-boot_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  workbench-prefs-boot_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  workbench-prefs-boot_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-prefs-boot_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  workbench-prefs-boot_MOBJC_DIRS := $(foreach dir, $(workbench-prefs-boot_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-prefs-boot_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(workbench-prefs-boot_MOBJC_DIRS),)
    workbench-prefs-boot_MOBJC_DIRS := $(shell echo $(workbench-prefs-boot_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(workbench-prefs-boot_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  workbench-prefs-boot_CC := $(TARGET_CC)
else
  workbench-prefs-boot_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
workbench-prefs-boot_MOBJC_CPPFLAGS := $(workbench-prefs-boot_CPPFLAGS)
workbench-prefs-boot_OBJCFLAGS := $(workbench-prefs-boot_CFLAGS)
