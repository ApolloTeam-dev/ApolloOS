.PHONY : workbench-prefs-boot

workbench-prefs-boot_PROGNAME  := Boot
workbench-prefs-boot_OBJDIR    := $(GENDIR)/$(CURDIR)
workbench-prefs-boot_TARGETDIR := $(EXEDIR)
workbench-prefs-boot_LINKER    := 
workbench-prefs-boot_LIBS := 
