  workbench-prefs-printer_STRIP ?= $(HOST_STRIP)
  workbench-prefs-printer_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : workbench-prefs-printer_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-prefs-printer_MOBJC_CPPFLAGS) $(workbench-prefs-printer_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : workbench-prefs-printer_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-prefs-printer_OBJCFLAGS))
  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : workbench-prefs-printer_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-prefs-printer_OBJCDFLAGS))
