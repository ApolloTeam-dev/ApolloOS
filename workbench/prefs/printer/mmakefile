ifeq (target,target)
  workbench-prefs-printer_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  workbench-prefs-printer_STRIP ?= $(TARGET_STRIP)
  workbench-prefs-printer_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  workbench-prefs-printer_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  workbench-prefs-printer_MCXX_CPPFLAGS := $(strip $(workbench-prefs-printer_MCXX_CPPFLAGS) $(workbench-prefs-printer_MCXX_EXTRA_CPPFLAGS))
  workbench-prefs-printer_CXXFLAGS := $(strip $(workbench-prefs-printer_CXXFLAGS) $(SAFETY_CFLAGS))
  workbench-prefs-printer_DXXFLAGS := $(workbench-prefs-printer_DXXFLAGS)
