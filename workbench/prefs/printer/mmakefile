# Identify the "real" c++ files from the passed in basenames
workbench-prefs-printer_MCXX_FILES  := $(strip $(foreach workbench-prefs-printer_CXXBASE,$(workbench-prefs-printer_CXXABSBASENAMES), $(firstword $(wildcard $(foreach workbench-prefs-printer_EXT, $(AROS_CXXEXTS),$(addsuffix .$(workbench-prefs-printer_EXT),$(workbench-prefs-printer_CXXBASE)))))))

ifeq (,)
workbench-prefs-printer_MCXX_SRCWILDCARD := %
else
workbench-prefs-printer_MCXX_SRCWILDCARD := /%
endif

ifeq ($(workbench-prefs-printer_OBJDIR),)
  workbench-prefs-printer_CXXTARGETS := $(notdir $(workbench-prefs-printer_CXXBASENAMES:=.o))
  workbench-prefs-printer_CXXDTARGETS := $(notdir $(workbench-prefs-printer_CXXBASENAMES:=.d))
  workbench-prefs-printer_MCXX_WILDCARD := %
else
  workbench-prefs-printer_CXXTARGETS := $(addprefix $(workbench-prefs-printer_OBJDIR)/,$(notdir $(workbench-prefs-printer_CXXBASENAMES:=.o)))
  workbench-prefs-printer_CXXDTARGETS := $(addprefix $(workbench-prefs-printer_OBJDIR)/,$(notdir $(workbench-prefs-printer_CXXBASENAMES:=.d)))
