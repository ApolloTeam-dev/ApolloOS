  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : workbench-prefs-printer_OBJCFLAGS:=$(strip $(workbench-prefs-printer_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : workbench-prefs-printer_OBJCDFLAGS:=$(workbench-prefs-printer_OBJCDFLAGS)
  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : workbench-prefs-printer_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-prefs-printer_MOBJC_TARGETS) $(workbench-prefs-printer_MOBJC_DTARGETS) : workbench-prefs-printer_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
