  KERNEL_CXX ?= $(KERNEL_CC)
  workbench-prefs-printer_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-prefs-printer_STRIP ?= $(ECHO) >/dev/null
  workbench-prefs-printer_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  workbench-prefs-printer_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  workbench-prefs-printer_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(workbench-prefs-printer_MCXX_CPPFLAGS) $(workbench-prefs-printer_MCXX_EXTRA_CPPFLAGS))
  workbench-prefs-printer_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-prefs-printer_CXXFLAGS))
  workbench-prefs-printer_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(workbench-prefs-printer_DXXFLAGS))
  workbench-prefs-printer_CXXIQUOTE:=$(KERNEL_IQUOTE)
  workbench-prefs-printer_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-prefs-printer_CXXCMD) $(workbench-prefs-printer_CXXIQUOTE) $(dir $(2)) $(workbench-prefs-printer_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-prefs-printer_CXXIQUOTE) . $(workbench-prefs-printer_CXXIQUOTE_END) $(strip $(workbench-prefs-printer_CXXFLAGS) $(workbench-prefs-printer_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-prefs-printer_CXXCMD) $(workbench-prefs-printer_CXXIQUOTE) $(dir $(2)) $(workbench-prefs-printer_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-prefs-printer_CXXIQUOTE) . $(workbench-prefs-printer_CXXIQUOTE_END) $(strip $(workbench-prefs-printer_CXXFLAGS) $(workbench-prefs-printer_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-prefs-printer_CXXCMD) $(workbench-prefs-printer_CXXIQUOTE) $(dir $(2)) $(workbench-prefs-printer_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-prefs-printer_CXXIQUOTE) . $(workbench-prefs-printer_CXXIQUOTE_END) $(strip $(workbench-prefs-printer_CXXFLAGS) $(workbench-prefs-printer_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-prefs-printer_CXXCMD)" $(MKDEPEND) $(strip $(workbench-prefs-printer_DXXFLAGS) $(workbench-prefs-printer_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-prefs-printer_OBJDIR),)
  $(foreach workbench-prefs-printer_CXXFILE,$(workbench-prefs-printer_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-prefs-printer_CXXFILE))),$(workbench-prefs-printer_CXXFILE))))
else
  $(foreach workbench-prefs-printer_CXXFILE,$(workbench-prefs-printer_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-prefs-printer_OBJDIR)/,$(notdir $(basename $(workbench-prefs-printer_CXXFILE)))),$(workbench-prefs-printer_CXXFILE))))
endif

endif


