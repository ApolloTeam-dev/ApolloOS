  workbench-prefs-printer_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-prefs-printer_CXXFLAGS))
  workbench-prefs-printer_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(workbench-prefs-printer_DXXFLAGS))
