include $(SRCDIR)/config/aros.cfg

CATALOGS:=czech french polish norwegian

# The need to update french catalog 


ifeq (,)
workbench-prefs-printer-catalogs_DESC := $(basename $(wildcard $(SRCDIR)/$(CURDIR)/*.cd))
else
workbench-prefs-printer-catalogs_DESC := 
endif

workbench-prefs-printer-catalogs_SRC := $(shell echo $(TOOLDIR)/C_h_aros | sed 's/^\(.\):\//\/\1\//')

ifeq ($(CATALOGS),)
workbench-prefs-printer-catalogs_LNGS := $(basename $(notdir $(call WILDCARD, $(SRCDIR)/$(CURDIR)/*.ct)))
else
workbench-prefs-printer-catalogs_LNGS := $(CATALOGS)
endif

workbench-prefs-printer-catalogs_OBJS := $(addsuffix /System/Prefs/Printer.catalog, $(addprefix $(AROS_CATALOGS)/, $(workbench-prefs-printer-catalogs_LNGS)))
workbench-prefs-printer-catalogs_DIRS := $(addsuffix /System/Prefs, $(addprefix $(AROS_CATALOGS)/, $(workbench-prefs-printer-catalogs_LNGS))) $(dir ../strings.h)

#MM- workbench-prefs-printer-catalogs-quick : workbench-prefs-printer-catalogs

#MM
workbench-prefs-printer-catalogs : $(workbench-prefs-printer-catalogs_OBJS) ../strings.h


ifneq ($(workbench-prefs-printer-catalogs_OBJS),)
$(workbench-prefs-printer-catalogs_OBJS) : | $(workbench-prefs-printer-catalogs_DIRS)
else
$(workbench-prefs-printer-catalogs_OBJS) :: $(workbench-prefs-printer-catalogs_DIRS)
endif

GLOB_MKDIRS += $(workbench-prefs-printer-catalogs_DIRS)


$(AROS_CATALOGS)/%/System/Prefs/Printer.catalog : $(SRCDIR)/$(CURDIR)/%.ct $(workbench-prefs-printer-catalogs_DESC).cd
	$(Q)$(ECHO) "Creating   Printer catalog for language $*."
	$(Q)$(IF) $(TEST) "$*" = "polish"; then \
	    $(FLEXCAT) iso88592toamigapl $(workbench-prefs-printer-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Prefs/Printer.catalog" || [ $$? -lt 10 ] ; \
	elif $(TEST) "$*" = "russian"; then \
	    $(FLEXCAT) win1251toamiga1251 $(workbench-prefs-printer-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Prefs/Printer.catalog" || [ $$? -lt 10 ] ; \
	else \
	    $(FLEXCAT) $(workbench-prefs-printer-catalogs_DESC).cd $< CATALOG="$(AROS_CATALOGS)/$*/System/Prefs/Printer.catalog" || [ $$? -lt 10 ] ; \
	fi

ifneq (../strings.h,)
../strings.h : workbench-prefs-printer-catalogs_DESC := $(workbench-prefs-printer-catalogs_DESC)
../strings.h : workbench-prefs-printer-catalogs_SRC := $(workbench-prefs-printer-catalogs_SRC)
../strings.h : $(workbench-prefs-printer-catalogs_DESC).cd $(workbench-prefs-printer-catalogs_SRC).sd | $(dir ../strings.h)
	$(Q)$(ECHO) "Creating   Printer catalog source file $@"
	$(Q)$(FLEXCAT) $(workbench-prefs-printer-catalogs_DESC).cd $@=$(workbench-prefs-printer-catalogs_SRC).sd
endif

workbench-prefs-printer-catalogs-clean : FILES := $(workbench-prefs-printer-catalogs_OBJS) ../strings.h
#MM
workbench-prefs-printer-catalogs-clean ::
	$(Q)$(ECHO) "Cleaning up for metatarget workbench-prefs-printer-catalogs"
	$(Q)$(RM) $(FILES)

.PHONY: workbench-prefs-printer-catalogs workbench-prefs-printer-catalogs-clean


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
