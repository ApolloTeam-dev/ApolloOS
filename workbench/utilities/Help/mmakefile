ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  workbench-utilities-help_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  workbench-utilities-help_STRIP ?= $(ECHO) >/dev/null
