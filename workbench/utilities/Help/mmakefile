define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(workbench-utilities-help_CXXCMD) $(workbench-utilities-help_CXXIQUOTE) $(dir $(2)) $(workbench-utilities-help_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-utilities-help_CXXIQUOTE) . $(workbench-utilities-help_CXXIQUOTE_END) $(strip $(workbench-utilities-help_CXXFLAGS) $(workbench-utilities-help_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-utilities-help_CXXCMD) $(workbench-utilities-help_CXXIQUOTE) $(dir $(2)) $(workbench-utilities-help_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-utilities-help_CXXIQUOTE) . $(workbench-utilities-help_CXXIQUOTE_END) $(strip $(workbench-utilities-help_CXXFLAGS) $(workbench-utilities-help_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-utilities-help_CXXCMD) $(workbench-utilities-help_CXXIQUOTE) $(dir $(2)) $(workbench-utilities-help_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-utilities-help_CXXIQUOTE) . $(workbench-utilities-help_CXXIQUOTE_END) $(strip $(workbench-utilities-help_CXXFLAGS) $(workbench-utilities-help_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(workbench-utilities-help_CXXCMD)" $(MKDEPEND) $(strip $(workbench-utilities-help_DXXFLAGS) $(workbench-utilities-help_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(workbench-utilities-help_OBJDIR),)
  $(foreach workbench-utilities-help_CXXFILE,$(workbench-utilities-help_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(workbench-utilities-help_CXXFILE))),$(workbench-utilities-help_CXXFILE))))
else
  $(foreach workbench-utilities-help_CXXFILE,$(workbench-utilities-help_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(workbench-utilities-help_OBJDIR)/,$(notdir $(basename $(workbench-utilities-help_CXXFILE)))),$(workbench-utilities-help_CXXFILE))))
endif

endif


