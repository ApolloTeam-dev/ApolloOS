  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_OBJCDFLAGS:=$(workbench-utilities-help_OBJCDFLAGS)
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_IQUOTE:=$(CFLAGS_IQUOTE)
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
