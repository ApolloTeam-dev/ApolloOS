  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(workbench-utilities-help_MOBJC_CPPFLAGS) $(workbench-utilities-help_MOBJC_EXTRA_CPPFLAGS))
