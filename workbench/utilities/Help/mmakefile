ifeq (target,host)
  workbench-utilities-help_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  workbench-utilities-help_STRIP ?= $(HOST_STRIP)
  workbench-utilities-help_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(workbench-utilities-help_MOBJC_CPPFLAGS) $(workbench-utilities-help_MOBJC_EXTRA_CPPFLAGS))
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-utilities-help_OBJCFLAGS))
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-utilities-help_OBJCDFLAGS))
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_IQUOTE:=$(HOST_IQUOTE)
  $(workbench-utilities-help_MOBJC_TARGETS) $(workbench-utilities-help_MOBJC_DTARGETS) : workbench-utilities-help_IQUOTE_END:=$(HOST_IQUOTE_END)
