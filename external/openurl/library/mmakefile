external-openurl-lib_CXXABSBASENAMES := $(foreach external-openurl-lib_CXXBASE,$(external-openurl-lib_CXX_NARCHFILES),$(if $(filter /%,$(external-openurl-lib_CXXBASE)),$(external-openurl-lib_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(external-openurl-lib_CXXBASE))))

ifneq ($(external-openurl-lib_CXXABSBASENAMES),)

external-openurl-lib_CXXBASENAMES := $(basename $(external-openurl-lib_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
external-openurl-lib_MCXX_FILES  := $(strip $(foreach external-openurl-lib_CXXBASE,$(external-openurl-lib_CXXABSBASENAMES), $(firstword $(wildcard $(foreach external-openurl-lib_EXT, $(AROS_CXXEXTS),$(addsuffix .$(external-openurl-lib_EXT),$(external-openurl-lib_CXXBASE)))))))

ifeq (,)
