endif
ifeq (target,target)
  external-openurl-lib_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  external-openurl-lib_STRIP ?= $(TARGET_STRIP)
  external-openurl-lib_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  external-openurl-lib_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  external-openurl-lib_MCXX_CPPFLAGS := $(strip $(external-openurl-lib_MCXX_CPPFLAGS) $(external-openurl-lib_MCXX_EXTRA_CPPFLAGS))
  external-openurl-lib_CXXFLAGS := $(strip $(external-openurl-lib_CXXFLAGS) $(SAFETY_CFLAGS))
  external-openurl-lib_DXXFLAGS := $(external-openurl-lib_DXXFLAGS)
  external-openurl-lib_CXXIQUOTE:=$(CFLAGS_IQUOTE)
