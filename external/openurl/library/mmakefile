else
  external-openurl-lib_CXXTARGETS := $(addprefix $(OBJDIR)/,$(notdir $(external-openurl-lib_CXXBASENAMES:=.o)))
  external-openurl-lib_CXXDTARGETS := $(addprefix $(OBJDIR)/,$(notdir $(external-openurl-lib_CXXBASENAMES:=.d)))
  external-openurl-lib_MCXX_WILDCARD := $(OBJDIR)/%

  # Be sure that all source files are generated
  $(external-openurl-lib_CXXTARGETS) $(external-openurl-lib_CXXDTARGETS) : | $(external-openurl-lib_MCXX_FILES)
