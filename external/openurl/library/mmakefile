endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  external-openurl-lib_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  external-openurl-lib_STRIP ?= $(ECHO) >/dev/null
  external-openurl-lib_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  external-openurl-lib_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  external-openurl-lib_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(external-openurl-lib_MCXX_CPPFLAGS) $(external-openurl-lib_MCXX_EXTRA_CPPFLAGS))
  external-openurl-lib_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(external-openurl-lib_CXXFLAGS))
  external-openurl-lib_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(external-openurl-lib_DXXFLAGS))
  external-openurl-lib_CXXIQUOTE:=$(KERNEL_IQUOTE)
  external-openurl-lib_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(external-openurl-lib_CXXCMD) $(external-openurl-lib_CXXIQUOTE) $(dir $(2)) $(external-openurl-lib_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-openurl-lib_CXXIQUOTE) . $(external-openurl-lib_CXXIQUOTE_END) $(strip $(external-openurl-lib_CXXFLAGS) $(external-openurl-lib_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(external-openurl-lib_CXXCMD) $(external-openurl-lib_CXXIQUOTE) $(dir $(2)) $(external-openurl-lib_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-openurl-lib_CXXIQUOTE) . $(external-openurl-lib_CXXIQUOTE_END) $(strip $(external-openurl-lib_CXXFLAGS) $(external-openurl-lib_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(external-openurl-lib_CXXCMD) $(external-openurl-lib_CXXIQUOTE) $(dir $(2)) $(external-openurl-lib_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-openurl-lib_CXXIQUOTE) . $(external-openurl-lib_CXXIQUOTE_END) $(strip $(external-openurl-lib_CXXFLAGS) $(external-openurl-lib_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(external-openurl-lib_CXXCMD)" $(MKDEPEND) $(strip $(external-openurl-lib_DXXFLAGS) $(external-openurl-lib_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(OBJDIR),)
  $(foreach external-openurl-lib_CXXFILE,$(external-openurl-lib_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(external-openurl-lib_CXXFILE))),$(external-openurl-lib_CXXFILE))))
else
  $(foreach external-openurl-lib_CXXFILE,$(external-openurl-lib_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(OBJDIR)/,$(notdir $(basename $(external-openurl-lib_CXXFILE)))),$(external-openurl-lib_CXXFILE))))
endif

endif


