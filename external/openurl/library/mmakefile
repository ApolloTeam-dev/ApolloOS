# Adjust compiler flags to suit C++
external-openurl-lib_MCXX_CPPFLAGS := $(CPPFLAGS)
external-openurl-lib_CXXFLAGS := $(external-openurl-lib_CXXFLAGS)
ifeq ($(external-openurl-lib_DXXFLAGS),)
  external-openurl-lib_DXXFLAGS := $(external-openurl-lib_CXXFLAGS)
else
  external-openurl-lib_DXXFLAGS := $(external-openurl-lib_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
