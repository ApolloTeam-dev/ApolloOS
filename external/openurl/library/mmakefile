  $(external-openurl-lib_MOBJC_TARGETS) $(external-openurl-lib_MOBJC_DTARGETS) : external-openurl-lib_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(external-openurl-lib_OBJCDFLAGS))
