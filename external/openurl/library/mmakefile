ifeq (target,host)
  external-openurl-lib_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  external-openurl-lib_STRIP ?= $(HOST_STRIP)
  external-openurl-lib_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  external-openurl-lib_CXXCMD:=$(HOST_CXX)
  external-openurl-lib_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(external-openurl-lib_MCXX_CPPFLAGS) $(external-openurl-lib_MCXX_EXTRA_CPPFLAGS))
  external-openurl-lib_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(external-openurl-lib_CXXFLAGS))
  external-openurl-lib_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(external-openurl-lib_DXXFLAGS))
