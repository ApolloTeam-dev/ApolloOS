#MM
external-openurl-prefs-setup : locale.h 

EXE := OpenURL
EXEDIR := $(AROS_PREFS)

# We need to use -idirafter, so that we
# *don't* pick up the project's local MUI headers.
USER_INCLUDES := -idirafter $(SRCDIR)/$(CURDIR)/../include

FILES := \
        OpenURL \
        locale \
        utils \
        popport \
        popph \
        ftpeditwin \
        mailereditwin \
        browsereditwin \
        applist \
        win \
        about \
        app \
        vastubs \
        debug


.PHONY : external-openurl-prefs

external-openurl-prefs_PROGNAME  := $(EXE)
external-openurl-prefs_OBJDIR    := $(GENDIR)/$(CURDIR)
external-openurl-prefs_TARGETDIR := $(EXEDIR)
external-openurl-prefs_LINKER    := 
external-openurl-prefs_LIBS := 
# If not supplied, linker is equal to compiler
ifeq ($(external-openurl-prefs_LINKER),)
    external-openurl-prefs_LINKER := target
endif

ifneq ("$(strip $(FILES)   )","")
    external-openurl-prefs_FILES     := $(FILES)
    external-openurl-prefs_OBJCFILES := 
    external-openurl-prefs_ASMFILES  := 
    external-openurl-prefs_CXXFILES := 
else
    external-openurl-prefs_FILES     := $(external-openurl-prefs_PROGNAME)
    external-openurl-prefs_OBJCFILES :=
    external-openurl-prefs_ASMFILES  :=
    external-openurl-prefs_CXXFILES :=
endif

external-openurl-prefs_ARCHOBJS   := $(wildcard $(external-openurl-prefs_OBJDIR)/arch/*.o)
external-openurl-prefs_ARCHFILES  := $(basename $(notdir $(external-openurl-prefs_ARCHOBJS)))
external-openurl-prefs_C_NARCHFILES := $(filter-out $(external-openurl-prefs_ARCHFILES),$(external-openurl-prefs_FILES))
external-openurl-prefs_CXX_NARCHFILES := $(filter-out $(external-openurl-prefs_ARCHFILES),$(external-openurl-prefs_CXXFILES))
external-openurl-prefs_OBJC_NARCHFILES := $(filter-out $(external-openurl-prefs_ARCHFILES),$(external-openurl-prefs_OBJCFILES))

TMP_FILES := $(external-openurl-prefs_C_NARCHFILES) $(external-openurl-prefs_CXX_NARCHFILES) $(external-openurl-prefs_ASMFILES) $(external-openurl-prefs_OBJC_NARCHFILES)
external-openurl-prefs_OBJS := $(addsuffix .o,$(addprefix $(external-openurl-prefs_OBJDIR)/,$(notdir $(TMP_FILES))))
external-openurl-prefs_DEPS := $(addsuffix .d,$(addprefix $(external-openurl-prefs_OBJDIR)/,$(notdir $(TMP_FILES))))

external-openurl-prefs_CPPFLAGS :=  $(CPPFLAGS)
ifneq (,)
external-openurl-prefs_CPPFLAGS    += -I
endif

ifeq ("","")
ifeq (target,target)
external-openurl-prefs_CFLAGS            := $(CFLAGS)
endif
ifeq (target,host)
external-openurl-prefs_CFLAGS            := $(HOST_CFLAGS)
endif
ifeq (target,kernel)
external-openurl-prefs_CFLAGS            := $(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS))
endif
else
external-openurl-prefs_CFLAGS            := 
endif

ifeq ("","")
ifeq (target,target)
external-openurl-prefs_CXXFLAGS            := $(CXXFLAGS)
endif
ifeq (target,host)
external-openurl-prefs_CXXFLAGS            := $(HOST_CXXFLAGS)
endif
ifeq (target,kernel)
external-openurl-prefs_CXXFLAGS            := $(strip $(KERNEL_ISA_CXXFLAGS) $(KERNEL_CXXFLAGS))
endif
else
external-openurl-prefs_CXXFLAGS          := 
endif

ifeq ("","")
ifeq (target,target)
external-openurl-prefs_LDFLAGS            := $(LDFLAGS)
endif
ifeq (target,host)
external-openurl-prefs_LDFLAGS            := $(HOST_LDFLAGS)
endif
ifeq (target,kernel)
external-openurl-prefs_LDFLAGS            := $(strip $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
endif
else
external-openurl-prefs_LDFLAGS          := 
endif

external-openurl-prefs_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq ($(TARGET_COVERAGEINSTR),yes)
external-openurl-prefs_COVERAGE := yes
external-openurl-prefs_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
external-openurl-prefs_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
external-openurl-prefs_CFLAGS    := $(strip $(external-openurl-prefs_COVERAGEFLAGS) $(external-openurl-prefs_CFLAGS))
external-openurl-prefs_CXXFLAGS := $(strip $(external-openurl-prefs_COVERAGEFLAGS) $(external-openurl-prefs_CXXFLAGS))
external-openurl-prefs_LIBS += $(external-openurl-prefs_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
external-openurl-prefs_FUNCINSTR := yes
external-openurl-prefs_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
external-openurl-prefs_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
external-openurl-prefs_CFLAGS    := $(strip $(external-openurl-prefs_INSTRFUNCFLAGS) $(external-openurl-prefs_CFLAGS))
external-openurl-prefs_CXXFLAGS := $(strip $(external-openurl-prefs_INSTRFUNCFLAGS) $(external-openurl-prefs_CXXFLAGS))
external-openurl-prefs_LIBS += $(external-openurl-prefs_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
external-openurl-prefs_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(external-openurl-prefs_CFLAGS))
external-openurl-prefs_CXXFLAGS := $(strip $(LTO_BINARY_CFLAGS) $(external-openurl-prefs_CXXFLAGS))
endif
endif
external-openurl-prefs_AFLAGS    := $(AFLAGS)
ifneq (,)
    external-openurl-prefs_DFLAGS     := 
else
    external-openurl-prefs_DFLAGS     := $(external-openurl-prefs_CFLAGS)
endif
ifneq (,)
    external-openurl-prefs_DXXFLAGS     := 
else
    external-openurl-prefs_DXXFLAGS     := $(external-openurl-prefs_CXXFLAGS)
endif
ifeq (target,target)
external-openurl-prefs_LDFLAGS           := $(external-openurl-prefs_LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
external-openurl-prefs_LDFLAGS           := $(external-openurl-prefs_LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
external-openurl-prefs_LDFLAGS           := $(external-openurl-prefs_LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
external-openurl-prefs_LDFLAGS   += -L
endif

#MM
external-openurl-prefs-quick : external-openurl-prefs

#MM external-openurl-prefs : includes-generate-deps core-linklibs
external-openurl-prefs : $(external-openurl-prefs_TARGETDIR)/$(external-openurl-prefs_PROGNAME)

ifneq ($(filter $(TARGET),external-openurl-prefs external-openurl-prefs-quick external-openurl-prefs-gz-quick),)

external-openurl-prefs_CXXABSBASENAMES := $(foreach external-openurl-prefs_CXXBASE,$(external-openurl-prefs_CXX_NARCHFILES),$(if $(filter /%,$(external-openurl-prefs_CXXBASE)),$(external-openurl-prefs_CXXBASE),$(abspath $(SRCDIR)/$(CURDIR)/$(external-openurl-prefs_CXXBASE))))

ifneq ($(external-openurl-prefs_CXXABSBASENAMES),)

external-openurl-prefs_CXXBASENAMES := $(basename $(external-openurl-prefs_CXXABSBASENAMES))

# Identify the "real" c++ files from the passed in basenames
external-openurl-prefs_MCXX_FILES  := $(strip $(foreach external-openurl-prefs_CXXBASE,$(external-openurl-prefs_CXXABSBASENAMES), $(firstword $(wildcard $(foreach external-openurl-prefs_EXT, $(AROS_CXXEXTS),$(addsuffix .$(external-openurl-prefs_EXT),$(external-openurl-prefs_CXXBASE)))))))

ifeq (,)
external-openurl-prefs_MCXX_SRCWILDCARD := %
else
external-openurl-prefs_MCXX_SRCWILDCARD := /%
endif

ifeq ($(external-openurl-prefs_OBJDIR),)
  external-openurl-prefs_CXXTARGETS := $(notdir $(external-openurl-prefs_CXXBASENAMES:=.o))
  external-openurl-prefs_CXXDTARGETS := $(notdir $(external-openurl-prefs_CXXBASENAMES:=.d))
  external-openurl-prefs_MCXX_WILDCARD := %
else
  external-openurl-prefs_CXXTARGETS := $(addprefix $(external-openurl-prefs_OBJDIR)/,$(notdir $(external-openurl-prefs_CXXBASENAMES:=.o)))
  external-openurl-prefs_CXXDTARGETS := $(addprefix $(external-openurl-prefs_OBJDIR)/,$(notdir $(external-openurl-prefs_CXXBASENAMES:=.d)))
  external-openurl-prefs_MCXX_WILDCARD := $(external-openurl-prefs_OBJDIR)/%

  # Be sure that all source files are generated
  $(external-openurl-prefs_CXXTARGETS) $(external-openurl-prefs_CXXDTARGETS) : | $(external-openurl-prefs_MCXX_FILES)
endif

# Adjust compiler flags to suit C++
external-openurl-prefs_MCXX_CPPFLAGS := $(external-openurl-prefs_CPPFLAGS)
external-openurl-prefs_CXXFLAGS := $(external-openurl-prefs_CXXFLAGS)
ifeq ($(external-openurl-prefs_DXXFLAGS),)
  external-openurl-prefs_DXXFLAGS := $(external-openurl-prefs_CXXFLAGS)
else
  external-openurl-prefs_DXXFLAGS := $(external-openurl-prefs_DXXFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,host)
  external-openurl-prefs_LINK ?= $(strip $(HOST_CXX) $(HOST_LDFLAGS))
  external-openurl-prefs_STRIP ?= $(HOST_STRIP)
  external-openurl-prefs_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  external-openurl-prefs_CXXCMD:=$(HOST_CXX)
  external-openurl-prefs_MCXX_CPPFLAGS := $(strip $(HOST_MCXX_CPPFLAGS) $(external-openurl-prefs_MCXX_CPPFLAGS) $(external-openurl-prefs_MCXX_EXTRA_CPPFLAGS))
  external-openurl-prefs_CXXFLAGS := $(strip $(HOST_CXXFLAGS) $(external-openurl-prefs_CXXFLAGS))
  external-openurl-prefs_DXXFLAGS := $(strip $(HOST_CXXFLAGS) $(external-openurl-prefs_DXXFLAGS))
  external-openurl-prefs_CXXIQUOTE:=$(HOST_IQUOTE)
  external-openurl-prefs_CXXIQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,target)
  external-openurl-prefs_LINK ?= $(strip $(AROS_CXX) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  external-openurl-prefs_STRIP ?= $(TARGET_STRIP)
  external-openurl-prefs_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  external-openurl-prefs_CXXCMD:=$(strip $(AROS_CXX) $(TARGET_SYSROOT))
  external-openurl-prefs_MCXX_CPPFLAGS := $(strip $(external-openurl-prefs_MCXX_CPPFLAGS) $(external-openurl-prefs_MCXX_EXTRA_CPPFLAGS))
  external-openurl-prefs_CXXFLAGS := $(strip $(external-openurl-prefs_CXXFLAGS) $(SAFETY_CFLAGS))
  external-openurl-prefs_DXXFLAGS := $(external-openurl-prefs_DXXFLAGS)
  external-openurl-prefs_CXXIQUOTE:=$(CFLAGS_IQUOTE)
  external-openurl-prefs_CXXIQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_CXX ?= $(KERNEL_CC)
  external-openurl-prefs_LINK ?= $(strip $(KERNEL_CXX) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  external-openurl-prefs_STRIP ?= $(ECHO) >/dev/null
  external-openurl-prefs_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  external-openurl-prefs_CXXCMD:=$(strip $(KERNEL_CXX) $(KERNEL_SYSROOT))
  external-openurl-prefs_CXXFLAGS := $(strip $(KERNEL_MCXX_CPPFLAGS) $(external-openurl-prefs_MCXX_CPPFLAGS) $(external-openurl-prefs_MCXX_EXTRA_CPPFLAGS))
  external-openurl-prefs_CXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(external-openurl-prefs_CXXFLAGS))
  external-openurl-prefs_DXXFLAGS := $(strip $(KERNEL_CXXFLAGS) $(external-openurl-prefs_DXXFLAGS))
  external-openurl-prefs_CXXIQUOTE:=$(KERNEL_IQUOTE)
  external-openurl-prefs_CXXIQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(external-openurl-prefs_CXXCMD) $(external-openurl-prefs_CXXIQUOTE) $(dir $(2)) $(external-openurl-prefs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-openurl-prefs_CXXIQUOTE) . $(external-openurl-prefs_CXXIQUOTE_END) $(strip $(external-openurl-prefs_CXXFLAGS) $(external-openurl-prefs_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(external-openurl-prefs_CXXCMD) $(external-openurl-prefs_CXXIQUOTE) $(dir $(2)) $(external-openurl-prefs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-openurl-prefs_CXXIQUOTE) . $(external-openurl-prefs_CXXIQUOTE_END) $(strip $(external-openurl-prefs_CXXFLAGS) $(external-openurl-prefs_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(external-openurl-prefs_CXXCMD) $(external-openurl-prefs_CXXIQUOTE) $(dir $(2)) $(external-openurl-prefs_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-openurl-prefs_CXXIQUOTE) . $(external-openurl-prefs_CXXIQUOTE_END) $(strip $(external-openurl-prefs_CXXFLAGS) $(external-openurl-prefs_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(external-openurl-prefs_CXXCMD)" $(MKDEPEND) $(strip $(external-openurl-prefs_DXXFLAGS) $(external-openurl-prefs_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(external-openurl-prefs_OBJDIR),)
  $(foreach external-openurl-prefs_CXXFILE,$(external-openurl-prefs_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(external-openurl-prefs_CXXFILE))),$(external-openurl-prefs_CXXFILE))))
else
  $(foreach external-openurl-prefs_CXXFILE,$(external-openurl-prefs_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(external-openurl-prefs_OBJDIR)/,$(notdir $(basename $(external-openurl-prefs_CXXFILE)))),$(external-openurl-prefs_CXXFILE))))
endif

endif


ifneq ($(external-openurl-prefs_OBJC_NARCHFILES),)

ifeq (,)
external-openurl-prefs_MOBJC_SRCWILDCARD := %
else
external-openurl-prefs_MOBJC_SRCWILDCARD := /%
endif

ifeq ($(external-openurl-prefs_OBJDIR),)
  external-openurl-prefs_MOBJC_TARGETS := $(addsuffix .o,$(external-openurl-prefs_OBJC_NARCHFILES))
  external-openurl-prefs_MOBJC_DTARGETS := $(addsuffix .d,$(external-openurl-prefs_OBJC_NARCHFILES))
  external-openurl-prefs_MOBJC_WILDCARD := %
else
  external-openurl-prefs_MOBJC_TARGETS := $(addsuffix .o,$(addprefix $(external-openurl-prefs_OBJDIR)/,$(external-openurl-prefs_OBJC_NARCHFILES)))
  external-openurl-prefs_MOBJC_DTARGETS := $(addsuffix .d,$(addprefix $(external-openurl-prefs_OBJDIR)/,$(external-openurl-prefs_OBJC_NARCHFILES)))
  external-openurl-prefs_MOBJC_WILDCARD := $(external-openurl-prefs_OBJDIR)/%

  # Be sure that all .m files are generated
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : | $(addsuffix .m,$(external-openurl-prefs_OBJC_NARCHFILES))

  # Be sure that all .m files are found
  external-openurl-prefs_MOBJC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
  external-openurl-prefs_MOBJC_BASEDIRS := $(shell echo $(sort $(dir $(external-openurl-prefs_OBJC_NARCHFILES))) | sed 's/\(.\):\//\/\1\//g')
  external-openurl-prefs_MOBJC_DIRS := $(foreach dir, $(external-openurl-prefs_MOBJC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(external-openurl-prefs_MOBJC_SRCDIR)/$(CURDIR)/$(dir)))
  ifneq ($(external-openurl-prefs_MOBJC_DIRS),)
    external-openurl-prefs_MOBJC_DIRS := $(shell echo $(external-openurl-prefs_MOBJC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.m $(external-openurl-prefs_MOBJC_DIRS)
  endif
endif

# Define the use of cross compiler
ifeq ($(TARGET_OBJC),)
  external-openurl-prefs_CC := $(TARGET_CC)
else
  external-openurl-prefs_CC := $(TARGET_OBJC)
endif

# Adjust compiler flags to suit ObjC
external-openurl-prefs_MOBJC_CPPFLAGS := $(external-openurl-prefs_CPPFLAGS)
external-openurl-prefs_OBJCFLAGS := $(external-openurl-prefs_CFLAGS)
external-openurl-prefs_OBJCFLAGS := $(external-openurl-prefs_OBJCFLAGS) -isystem $(AROS_DEVELOPER)/include
external-openurl-prefs_OBJCFLAGS := $(subst -Wno-pointer-sign,, $(subst -Werror-implicit-function-declaration,, $(external-openurl-prefs_OBJCFLAGS)))
ifeq ($(external-openurl-prefs_DFLAGS),)
  external-openurl-prefs_OBJCDFLAGS := $(external-openurl-prefs_CFLAGS)
else
  external-openurl-prefs_OBJCDFLAGS := $(external-openurl-prefs_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
  external-openurl-prefs_LINK ?= $(strip $(external-openurl-prefs_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
  external-openurl-prefs_STRIP ?= $(TARGET_STRIP)
  external-openurl-prefs_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : CMD:=$(strip $(external-openurl-prefs_CC) $(TARGET_SYSROOT))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_MOBJC_CPPFLAGS:=$(strip $(external-openurl-prefs_MOBJC_CPPFLAGS) $(external-openurl-prefs_MOBJC_EXTRA_CPPFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_OBJCFLAGS:=$(strip $(external-openurl-prefs_OBJCFLAGS) $(SAFETY_CFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_OBJCDFLAGS:=$(external-openurl-prefs_OBJCDFLAGS)
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_IQUOTE:=$(CFLAGS_IQUOTE)
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
  external-openurl-prefs_LINK ?= $(strip $(HOST_OBJC) $(HOST_LDFLAGS))
  external-openurl-prefs_STRIP ?= $(HOST_STRIP)
  external-openurl-prefs_ASSEMBLER ?= $(strip $(HOST_CC) $(HOST_SYSROOT))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : CMD:=$(HOST_OBJC)
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_MOBJC_CPPFLAGS:=$(strip $(HOST_MOBJC_CPPFLAGS) $(external-openurl-prefs_MOBJC_CPPFLAGS) $(external-openurl-prefs_MOBJC_EXTRA_CPPFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_OBJCFLAGS:=$(strip $(HOST_CFLAGS) $(external-openurl-prefs_OBJCFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_OBJCDFLAGS:=$(strip $(HOST_CFLAGS) $(external-openurl-prefs_OBJCDFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_IQUOTE:=$(HOST_IQUOTE)
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
  KERNEL_OBJC ?= $(KERNEL_CC)
  external-openurl-prefs_LINK ?= $(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
  external-openurl-prefs_STRIP ?= $(ECHO) >/dev/null
  external-openurl-prefs_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : CMD:=$(strip $(KERNEL_OBJC) $(KERNEL_SYSROOT))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_MOBJC_CPPFLAGS:=$(strip $(KERNEL_MOBJC_CPPFLAGS) $(external-openurl-prefs_MOBJC_CPPFLAGS) $(external-openurl-prefs_MOBJC_EXTRA_CPPFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_OBJCFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(external-openurl-prefs_OBJCFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_OBJCDFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(external-openurl-prefs_OBJCDFLAGS))
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_IQUOTE:=$(KERNEL_IQUOTE)
  $(external-openurl-prefs_MOBJC_TARGETS) $(external-openurl-prefs_MOBJC_DTARGETS) : external-openurl-prefs_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(external-openurl-prefs_MOBJC_TARGETS) : CPPFLAGS := $(external-openurl-prefs_MOBJC_CPPFLAGS)
$(external-openurl-prefs_MOBJC_TARGETS) : CFLAGS := $(external-openurl-prefs_OBJCFLAGS)
