define cxx_multi_recipe_template
 $(1).o : $(2)
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))"
	$(Q)$(IF) $(external-bz2-lib_CXXCMD) $(external-bz2-lib_CXXIQUOTE) $(dir $(2)) $(external-bz2-lib_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-bz2-lib_CXXIQUOTE) . $(external-bz2-lib_CXXIQUOTE_END) $(strip $(external-bz2-lib_CXXFLAGS) $(external-bz2-lib_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(external-bz2-lib_CXXCMD) $(external-bz2-lib_CXXIQUOTE) $(dir $(2)) $(external-bz2-lib_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-bz2-lib_CXXIQUOTE) . $(external-bz2-lib_CXXIQUOTE_END) $(strip $(external-bz2-lib_CXXFLAGS) $(external-bz2-lib_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(external-bz2-lib_CXXCMD) $(external-bz2-lib_CXXIQUOTE) $(dir $(2)) $(external-bz2-lib_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(external-bz2-lib_CXXIQUOTE) . $(external-bz2-lib_CXXIQUOTE_END) $(strip $(external-bz2-lib_CXXFLAGS) $(external-bz2-lib_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

 $(1).d : $(2)
	$(Q)$(IF) $(TEST) ! -d $(dir $(1).d) ; then $(MKDIR) $(dir $(1).d) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$(2)),$(if $(filter $(SRCDIR)/%,$(abspath $(2))),$(patsubst $(SRCDIR)/%,%,$(abspath $(2))),$(patsubst $(TOP)/%,%,$(abspath $(2)))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$(2))))..."
	$(Q)AROS_CC="$(external-bz2-lib_CXXCMD)" $(MKDEPEND) $(strip $(external-bz2-lib_DXXFLAGS) $(external-bz2-lib_MCXX_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $(2) -o $(1).d
endef
ifeq ($(external-bz2-lib_OBJDIR),)
  $(foreach external-bz2-lib_CXXFILE,$(external-bz2-lib_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(notdir $(basename $(external-bz2-lib_CXXFILE))),$(external-bz2-lib_CXXFILE))))
else
  $(foreach external-bz2-lib_CXXFILE,$(external-bz2-lib_MCXX_FILES),$(eval $(call cxx_multi_recipe_template,$(addprefix $(external-bz2-lib_OBJDIR)/,$(notdir $(basename $(external-bz2-lib_CXXFILE)))),$(external-bz2-lib_CXXFILE))))
