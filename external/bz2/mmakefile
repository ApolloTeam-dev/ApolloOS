	$(Q)$(IF) $(CMD) $(external-bz2-bzip2-bin_IQUOTE) $(dir $<) $(external-bz2-bzip2-bin_IQUOTE) $(SRCDIR)/$(CURDIR) $(external-bz2-bzip2-bin_IQUOTE) . $(external-bz2-bzip2-bin_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
