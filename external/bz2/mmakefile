# We will employ a terrifying, but unavoidable, hack here.
# genmf has no concept of conditionals (ie %ifeq), and MetaMake
# ignores GNU Make ifeq() statements, but will process any #MM
# headed lines in the file.
# 
# So, to make the following #MM lines conditional on whether we want
# to build the ABI, Library, or both, we define build_abi= and 
# build_library as 'M' to enable, or '' to disable, which allows genmf
# to do the following conversions:
# 
#  #MM includes-foo: foo-include
#    becomes, when build_abi=M
#  #MM includes-foo: foo-include   <= Processed by MetaMake
#    but, when build_abi= ...
#  #M includes-foo: foo-includes   <= ignored by MetaMake! Yes!
# 
# Taking full blame for this: Jason S. McMullan <jason.mcmullan@gmail.com>

# Define metamake targets and their dependencies
#MM external-bz2-lib
#MM external-bz2-lib-quick
#MM external-bz2-lib-makefile
#MM external-bz2-lib-clean

# ABI targets:
#MM- includes-all : external-bz2-lib-includes
#MM- linklibs-bz2: external-bz2-lib-linklib
#MM- linklibs-bz2_rel : external-bz2-lib-linklib
#MM- includes-bz2: external-bz2-lib-includes
#MM- includes-bz2_rel : external-bz2-lib-includes
#MM- external-bz2-lib : external-bz2-lib-includes core-linklibs linklibs-
#MM external-bz2-lib-linklib : external-bz2-lib-includes includes-
#MM- external-bz2-lib-quick : external-bz2-lib-includes-quick
#MM external-bz2-lib-includes : external-bz2-lib-makefile external-bz2-lib-includes-dirs \
#MM     includes-generate-deps external-bz2-lib-fd
#MM external-bz2-lib-includes-quick
#MM external-bz2-lib-includes-dirs
#MM external-bz2-lib-fd

# Library targets
#MM external-bz2-lib-kobj : core-linklibs linklibs-
#MM external-bz2-lib-kobj-quick : 

# Library with ABI targets:
#MM external-bz2-lib-kobj : external-bz2-lib-includes core-linklibs linklibs-
#MM external-bz2-lib-kobj-quick : external-bz2-lib-includes-quick

# All MetaMake targets defined by this macro
external-bz2-lib_ALLTARGETS       := external-bz2-lib external-bz2-lib-quick external-bz2-lib-clean

