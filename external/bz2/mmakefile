external-bz2-bzip2-bin-link_EXTRA_LDFLAGS := 
external-bz2-bzip2-bin-link_EXTRA_LIBS :=
ifeq (yes,yes)
    external-bz2-bzip2-bin-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    external-bz2-bzip2-bin-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (no,yes)
    external-bz2-bzip2-bin-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
external-bz2-bzip2-bin-link_DIRS := $(subst -L ,-L,$(strip $(external-bz2-bzip2-bin_LDFLAGS)))
# Filter out only the libdirs and remove -L
external-bz2-bzip2-bin-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(external-bz2-bzip2-bin-link_DIRS)))
# Add trailing /
external-bz2-bzip2-bin-link_DIRS := $(subst //,/,$(addsuffix /,$(external-bz2-bzip2-bin-link_DIRS)))
# Add normal linklib path
external-bz2-bzip2-bin-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
external-bz2-bzip2-bin-link_LIBS := $(addprefix lib,$(addsuffix .a,$(external-bz2-bzip2-bin_LIBS) $(external-bz2-bzip2-bin-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
external-bz2-bzip2-bin-link_DEPLIBS := $(foreach lib,$(external-bz2-bzip2-bin-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(external-bz2-bzip2-bin-link_DIRS)))) \
)
external-bz2-bzip2-bin-link_PROGS := $(addprefix $(external-bz2-bzip2-bin_TARGETDIR)/,$(external-bz2-bzip2-bin_FILES))

$(external-bz2-bzip2-bin-link_PROGS) : OBJDIR := $(external-bz2-bzip2-bin_OBJDIR)
$(external-bz2-bzip2-bin-link_PROGS) : LDFLAGS := $(strip $(external-bz2-bzip2-bin_LDFLAGS) $(external-bz2-bzip2-bin-link_EXTRA_LDFLAGS))
$(external-bz2-bzip2-bin-link_PROGS) : LIBS := $(addprefix -l,$(external-bz2-bzip2-bin_LIBS) $(external-bz2-bzip2-bin-link_EXTRA_LIBS) )
$(external-bz2-bzip2-bin-link_PROGS) : $(external-bz2-bzip2-bin_TARGETDIR)/% : $(external-bz2-bzip2-bin_OBJDIR)/%.o $(external-bz2-bzip2-bin-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(external-bz2-bzip2-bin_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(external-bz2-bzip2-bin_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(external-bz2-bzip2-bin_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(external-bz2-bzip2-bin_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(external-bz2-bzip2-bin_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(external-bz2-bzip2-bin_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(external-bz2-bzip2-bin_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

