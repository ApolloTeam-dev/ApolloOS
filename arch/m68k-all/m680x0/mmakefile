#MM kernel-m680x0-linklib : kernel-m680x0-includes includes-
#MM- kernel-m680x0-quick : kernel-m680x0-includes-quick
#MM kernel-m680x0-includes : kernel-m680x0-makefile kernel-m680x0-includes-dirs \
#MM     includes-generate-deps kernel-m680x0-fd
#MM kernel-m680x0-includes-quick
