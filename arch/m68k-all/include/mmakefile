include $(SRCDIR)/config/aros.cfg

INCLUDE_FILES := $(call WILDCARD, aros/*.h)

ifeq ($(findstring target,host kernel target),)
$(error %copy_includes: compiler argument (target) has to be host, kernel or target)
endif

ifneq (aros,)
TMP_DIR                := aros
$(eval TMP_DIRREMAIN   := $$$(TMP_DIR))
TMP_DIRFIRST           := $(subst $(TMP_DIRREMAIN),,$(TMP_DIR))
BD_INCL_FILES          := $(subst aros,$(GENINCDIR)/aros/m68k,$(dir $(INCLUDE_FILES)))
BD_INCL_FILES          := $(addprefix $(GENINCDIR)/aros/m68k/,$(notdir $(INCLUDE_FILES)))
ifeq ($(TMP_DIRFIRST),/)
BD_INC_PATH            := aros/
else
BD_INC_PATH            := $(SRCDIR)/$(CURDIR)/aros/
endif
else
BD_INCL_FILES          := $(addprefix $(GENINCDIR)/aros/m68k/,$(INCLUDE_FILES))
BD_INC_PATH            := $(SRCDIR)/$(CURDIR)/
endif

$(BD_INCL_FILES) : $(GENINCDIR)/aros/m68k/% : $(BD_INC_PATH)%
	$(Q)$(CP) $< $@

ifeq (target,target)

ifneq (aros,)
BD_INCL_FILES2         := $(subst aros,$(AROS_INCLUDES)/aros/m68k,$(dir $(INCLUDE_FILES)))
BD_INCL_FILES2         := $(addprefix $(AROS_INCLUDES)/aros/m68k/,$(notdir $(INCLUDE_FILES)))
else
BD_INCL_FILES2         := $(addprefix $(AROS_INCLUDES)/aros/m68k/,$(INCLUDE_FILES))
endif

BD_INCL_FILES          += $(BD_INCL_FILES2)

$(BD_INCL_FILES2) : $(AROS_INCLUDES)/aros/m68k/% : $(BD_INC_PATH)%
