BD_OBJDIR$(BDID)  := $(BD_OBJROOT$(BDID))/arch
BD_LIBOBJDIR$(BDID)  := $(BD_OBJROOT$(BDID))/linklib/arch
BD_FILEOBJS$(BDID)   := $(addsuffix .o,$(addprefix $(BD_OBJDIR$(BDID))/,$(notdir $(CFILES)))) $(addsuffix .o,$(addprefix $(BD_OBJDIR$(BDID))/,$(notdir )))
