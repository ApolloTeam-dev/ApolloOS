$(kernel-amiga-m68k-wbtag_MODULE) : $(kernel-amiga-m68k-wbtag_OBJS)  $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(strip $(AROS_CC) $(TARGET_SYSROOT)) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(strip $(AROS_CC) $(TARGET_SYSROOT)) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi


