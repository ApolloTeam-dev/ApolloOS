	$(Q)$(IF) $(kernel-potgo_CXXCMD) $(kernel-potgo_CXXIQUOTE) $(dir $(2)) $(kernel-potgo_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-potgo_CXXIQUOTE) . $(kernel-potgo_CXXIQUOTE_END) $(strip $(kernel-potgo_CXXFLAGS) $(kernel-potgo_MCXX_CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))"\" -c $(2) -o $(1).o > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
