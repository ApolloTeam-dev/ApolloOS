kernel-cia_LINK ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
kernel-cia_STRIP ?= $(ECHO) >/dev/null
kernel-cia_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(kernel-cia_MC_TARGETS) $(kernel-cia_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(kernel-cia_MC_TARGETS) $(kernel-cia_MC_DTARGETS) : kernel-cia_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(kernel-cia_MC_CPPFLAGS) $(kernel-cia_MC_EXTRA_CPPFLAGS))
$(kernel-cia_MC_TARGETS) $(kernel-cia_MC_DTARGETS) : kernel-cia_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(kernel-cia_CFLAGS))
$(kernel-cia_MC_TARGETS) $(kernel-cia_MC_DTARGETS) : kernel-cia_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(kernel-cia_DFLAGS))
$(kernel-cia_MC_TARGETS) $(kernel-cia_MC_DTARGETS) : kernel-cia_IQUOTE:=$(KERNEL_IQUOTE)
$(kernel-cia_MC_TARGETS) $(kernel-cia_MC_DTARGETS) : kernel-cia_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(kernel-cia_MC_TARGETS) : CPPFLAGS := $(kernel-cia_MC_CPPFLAGS)
$(kernel-cia_MC_TARGETS) : CFLAGS := $(kernel-cia_CFLAGS)
$(kernel-cia_MC_TARGETS) : $(kernel-cia_MC_TGTWILDCARD).o : $(kernel-cia_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(kernel-cia_IQUOTE) $(dir $<) $(kernel-cia_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-cia_IQUOTE) . $(kernel-cia_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(kernel-cia_IQUOTE) $(dir $<) $(kernel-cia_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-cia_IQUOTE) . $(kernel-cia_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(kernel-cia_IQUOTE) $(dir $<) $(kernel-cia_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-cia_IQUOTE) . $(kernel-cia_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(kernel-cia_MC_DTARGETS) : $(kernel-cia_MC_TGTWILDCARD).d : $(kernel-cia_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(kernel-cia_DFLAGS) $(kernel-cia_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@

# Handlers use dash instead of dot in their names
ifeq (resource,handler)
kernel-cia_MODULE := $(kernel-cia_MODDIR)/cia-resource
else
ifeq (resource,printer)
kernel-cia_MODULE := $(kernel-cia_MODDIR)/cia
else
kernel-cia_MODULE := $(kernel-cia_MODDIR)/cia.resource
endif
endif
kernel-cia_KOBJ   := $(KOBJSDIR)/cia_resource.o

kernel-cia-quick : kernel-cia
kernel-cia-kobj-quick : $(kernel-cia_KOBJ)
kernel-cia       : $(kernel-cia_MODULE)
kernel-cia-kobj  : $(kernel-cia_KOBJ)

# The module is linked from all the compiled .o files
kernel-cia_OBJS       := $(kernel-cia_ARCHOBJS) $(addprefix $(OBJDIR)/, $(addsuffix .o,$(notdir $(kernel-cia_C_NARCHFILES))))

# Under Windows con* is a reserved name, it refers to console. Files with such names can't be created.
# This breaks con-handler build. Here we work around this
ifeq (cia,con)
    kernel-cia_ERR := $(notdir $(kernel-cia_MODULE)).err
else
    kernel-cia_ERR := cia.err
endif


TMP_LDFLAGS  := $(strip $(LDFLAGS) $(cia_LDFLAGS))
# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
TMP_DIRS := $(subst -L ,-L,$(strip $(TMP_LDFLAGS)))
# Filter out only the libdirs and remove -L
TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(cia_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(kernel-cia_MODULE) : LIB_NAMES := $(cia_LIBS)
$(kernel-cia_MODULE) : OBJS := $(kernel-cia_OBJS)
$(kernel-cia_MODULE) : ENDTAG := 
$(kernel-cia_MODULE) : ERR := $(kernel-cia_ERR)
$(kernel-cia_MODULE) : OBJDIR := $(OBJDIR)
$(kernel-cia_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(kernel-cia_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(kernel-cia_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(kernel-cia_MODULE) : $(kernel-cia_OBJS)  $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(strip $(AROS_CC) $(TARGET_SYSROOT)) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(strip $(AROS_CC) $(TARGET_SYSROOT)) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi


# Link kernel object file
kernel-cia_KAUTOLIB := dos intuition layers graphics oop utility expansion keymap

# Make these symbols local
kernel-cia_KBASE := DOSBase IntuitionBase LayersBase GfxBase OOPBase \
    UtilityBase ExpansionBase KeymapBase KernelBase

kernel-cia_SYMBOLS := $(kernel-cia_KBASE)

kernel-cia_KLIB := hiddstubs amiga arossupport autoinit libinit
kernel-cia_KOBJ_LIBS := $(filter-out $(kernel-cia_KLIB),) $(kernel-cia_KAUTOLIB)
$(kernel-cia_KOBJ) : LINKLIBS:=$(kernel-cia_KOBJ_LIBS)
$(kernel-cia_KOBJ) : FILTBASES:=$(addprefix -L ,$(kernel-cia_SYMBOLS))
$(kernel-cia_KOBJ) : USER_LDFLAGS := $(USER_LDFLAGS)
$(kernel-cia_KOBJ) : $(kernel-cia_OBJS) $(kernel-cia_ENDOBJS)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$@)"
	$(Q)$(AROS_LD) -Ur -o $@ $^ $(USER_LDFLAGS) -L$(AROS_LIB) $(addprefix -l,$(LINKLIBS))
	$(Q)$(OBJCOPY) $@ $(FILTBASES) `$(NM_PLAIN) $@ | $(AWK) '($$3 ~ /^__.*_(LIST|END)__\r?$$/) || ($$3 ~ /^__aros_lib.*\r?$$/) {print "-L " $$3;}'`


## Dependency fine-tuning
##
kernel-cia_DEPS       := $(addprefix $(OBJDIR)/, $(addsuffix .d,cia_init cia_interrupt $(FUNCTIONS) resident_end))
ifneq ($(kernel-cia_DEPS),)
  ifneq (kernel-cia kernel-cia-quick kernel-cia-kobj,)
    ifneq ($(findstring $(TARGET),kernel-cia kernel-cia-quick kernel-cia-kobj),)
      -include $(kernel-cia_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-cia_DEPS)
    endif
  endif
endif


ifneq ($(kernel-cia_OBJS) $(kernel-cia_DEPS) $(kernel-cia_MODULE) $(kernel-cia_KOBJ),)
$(kernel-cia_OBJS) $(kernel-cia_DEPS) $(kernel-cia_MODULE) $(kernel-cia_KOBJ) : | $(OBJDIR) $(kernel-cia_MODDIR) $(KOBJSDIR)
else
$(kernel-cia_OBJS) $(kernel-cia_DEPS) $(kernel-cia_MODULE) $(kernel-cia_KOBJ) :: $(OBJDIR) $(kernel-cia_MODDIR) $(KOBJSDIR)
endif

GLOB_MKDIRS += $(OBJDIR) $(kernel-cia_MODDIR) $(KOBJSDIR)


kernel-cia-clean : FILES := $(kernel-cia_OBJS) $(kernel-cia_MODULE) $(kernel-cia_KOBJ) $(kernel-cia_DEPS)
kernel-cia-clean ::
	$(Q)$(ECHO) "Cleaning up for module cia"
	$(Q)$(RM) $(FILES)

