			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-c-m68k-setpatcharos_CXXCMD) $(workbench-c-m68k-setpatcharos_CXXIQUOTE) $(dir $(2)) $(workbench-c-m68k-setpatcharos_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-m68k-setpatcharos_CXXIQUOTE) . $(workbench-c-m68k-setpatcharos_CXXIQUOTE_END) $(strip $(workbench-c-m68k-setpatcharos_CXXFLAGS) $(workbench-c-m68k-setpatcharos_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
