USER_LDFLAGS := -static

FILES := gdbstub


.PHONY : workbench-c-m68k-gdbstub

workbench-c-m68k-gdbstub_OBJDIR    := $(GENDIR)/$(CURDIR)
workbench-c-m68k-gdbstub_TARGETDIR := $(AROS_C)
workbench-c-m68k-gdbstub_LIBS := romhack

workbench-c-m68k-gdbstub_FILES     := $(FILES)
workbench-c-m68k-gdbstub_OBJS      := $(addsuffix .o,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(workbench-c-m68k-gdbstub_FILES)))
workbench-c-m68k-gdbstub_DEPS      := $(addsuffix .d,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(workbench-c-m68k-gdbstub_FILES)))
workbench-c-m68k-gdbstub_EXES      := $(addprefix $(workbench-c-m68k-gdbstub_TARGETDIR)/,$(workbench-c-m68k-gdbstub_FILES))

workbench-c-m68k-gdbstub_CPPFLAGS := $(CPPFLAGS)
ifneq (,)
    workbench-c-m68k-gdbstub_CPPFLAGS += -I
endif
workbench-c-m68k-gdbstub_CFLAGS    := $(CFLAGS)
workbench-c-m68k-gdbstub_COVERAGE := no
ifeq (target,target)
ifeq (yes,yes)
ifeq (no,yes)
workbench-c-m68k-gdbstub_COVERAGE := yes
workbench-c-m68k-gdbstub_COVERAGEFLAGS   ?= $(COVERAGEINSTR_FLAGS)
workbench-c-m68k-gdbstub_COVERAGELIBS    ?= $(COVERAGEINSTR_LIBS)
workbench-c-m68k-gdbstub_CFLAGS    := $(strip $(workbench-c-m68k-gdbstub_COVERAGEFLAGS) $(workbench-c-m68k-gdbstub_CFLAGS))
workbench-c-m68k-gdbstub_LIBS += $(workbench-c-m68k-gdbstub_COVERAGELIBS)
endif
ifeq ($(TARGET_FUNCINSTR),yes)
workbench-c-m68k-gdbstub_FUNCINSTR := yes
workbench-c-m68k-gdbstub_INSTRFUNCFLAGS   ?= $(FUNCINSTR_FLAGS)
workbench-c-m68k-gdbstub_INSTRFUNCLIBS    ?= $(FUNCINSTR_LIBS)
workbench-c-m68k-gdbstub_CFLAGS    := $(strip $(workbench-c-m68k-gdbstub_INSTRFUNCFLAGS) $(workbench-c-m68k-gdbstub_CFLAGS))
workbench-c-m68k-gdbstub_LIBS += $(workbench-c-m68k-gdbstub_INSTRFUNCLIBS)
endif
endif
ifeq ($(TARGET_LTO),yes)
workbench-c-m68k-gdbstub_CFLAGS    := $(strip $(LTO_BINARY_CFLAGS) $(workbench-c-m68k-gdbstub_CFLAGS))
endif
endif
ifneq (,)
    workbench-c-m68k-gdbstub_DFLAGS := 
else
    workbench-c-m68k-gdbstub_DFLAGS := $(workbench-c-m68k-gdbstub_CFLAGS)
endif
ifeq (target,target)
workbench-c-m68k-gdbstub_LDFLAGS           := $(LDFLAGS) $(TARGET_ISA_OBJCFLAGS)
endif
ifeq (target,host)
workbench-c-m68k-gdbstub_LDFLAGS           := $(LDFLAGS) $(HOST_ISA_OBJCFLAGS)
endif
ifeq (target,kernel)
workbench-c-m68k-gdbstub_LDFLAGS           := $(LDFLAGS) $(KERNEL_ISA_OBJCFLAGS)
endif
ifneq (,)
    workbench-c-m68k-gdbstub_LDFLAGS += -L
endif

#MM
workbench-c-m68k-gdbstub-quick : workbench-c-m68k-gdbstub

#MM workbench-c-m68k-gdbstub : includes-generate-deps core-linklibs
workbench-c-m68k-gdbstub : $(workbench-c-m68k-gdbstub_EXES)

ifneq ($(filter $(TARGET),workbench-c-m68k-gdbstub workbench-c-m68k-gdbstub-quick),)

ifeq (,)
workbench-c-m68k-gdbstub_MC_SRCWILDCARD := %
else
workbench-c-m68k-gdbstub_MC_SRCWILDCARD := /%
endif

ifeq ($(workbench-c-m68k-gdbstub_OBJDIR),)
workbench-c-m68k-gdbstub_MC_TARGETS := $(addsuffix .o,$(workbench-c-m68k-gdbstub_FILES))
workbench-c-m68k-gdbstub_MC_DTARGETS := $(addsuffix .d,$(workbench-c-m68k-gdbstub_FILES))
workbench-c-m68k-gdbstub_MC_TGTWILDCARD := %
else
ifeq (no,no)
    workbench-c-m68k-gdbstub_MC_TARGETS := $(addsuffix .o,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(notdir $(workbench-c-m68k-gdbstub_FILES))))
    workbench-c-m68k-gdbstub_MC_DTARGETS := $(addsuffix .d,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(notdir $(workbench-c-m68k-gdbstub_FILES))))
else
ifeq (,)
    workbench-c-m68k-gdbstub_MC_TARGETS := $(addsuffix .o,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(workbench-c-m68k-gdbstub_FILES)))
    workbench-c-m68k-gdbstub_MC_DTARGETS := $(addsuffix .d,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(workbench-c-m68k-gdbstub_FILES)))
else
    workbench-c-m68k-gdbstub_MC_TARGETS := $(addsuffix .o,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(patsubst /%,%,$(workbench-c-m68k-gdbstub_FILES))))
    workbench-c-m68k-gdbstub_MC_DTARGETS := $(addsuffix .d,$(addprefix $(workbench-c-m68k-gdbstub_OBJDIR)/,$(patsubst /%,%,$(workbench-c-m68k-gdbstub_FILES))))
endif
endif
workbench-c-m68k-gdbstub_MC_TGTWILDCARD := $(workbench-c-m68k-gdbstub_OBJDIR)/%

# Be sure that all .c files are generated
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : | $(addsuffix .c,$(workbench-c-m68k-gdbstub_FILES))

# Be sure that all .c files are found
workbench-c-m68k-gdbstub_MC_SRCDIR := $(shell echo $(SRCDIR) | sed 's/^\(.\):\//\/\1\//')
workbench-c-m68k-gdbstub_MC_BASEDIRS := $(shell echo $(sort $(dir $(workbench-c-m68k-gdbstub_FILES))) | sed 's/\(.\):\//\/\1\//g')
workbench-c-m68k-gdbstub_MC_DIRS := $(foreach dir, $(workbench-c-m68k-gdbstub_MC_BASEDIRS), $(if $(filter /%,$(dir)),$(dir),$(workbench-c-m68k-gdbstub_MC_SRCDIR)/$(CURDIR)/$(dir)))
ifneq ($(workbench-c-m68k-gdbstub_MC_DIRS),)
    workbench-c-m68k-gdbstub_MC_DIRS := $(shell echo $(workbench-c-m68k-gdbstub_MC_DIRS) | sed 's/\(.\):\//\/\1\//g')
    vpath %.c $(workbench-c-m68k-gdbstub_MC_DIRS)
endif

endif

workbench-c-m68k-gdbstub_MC_CPPFLAGS := $(workbench-c-m68k-gdbstub_CPPFLAGS)
workbench-c-m68k-gdbstub_CFLAGS := $(workbench-c-m68k-gdbstub_CFLAGS)
ifeq ($(workbench-c-m68k-gdbstub_DFLAGS),)
  workbench-c-m68k-gdbstub_DFLAGS := $(workbench-c-m68k-gdbstub_CFLAGS)
else
  workbench-c-m68k-gdbstub_DFLAGS := $(workbench-c-m68k-gdbstub_DFLAGS)
endif

ifeq ($(findstring target,host kernel target),)
  $(error unknown compiler target)
endif
ifeq (target,target)
workbench-c-m68k-gdbstub_LINK ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT) $(TARGET_LDFLAGS))
workbench-c-m68k-gdbstub_STRIP ?= $(TARGET_STRIP)
workbench-c-m68k-gdbstub_ASSEMBLER ?= $(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : CMD:=$(strip $(TARGET_CC) $(TARGET_SYSROOT))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_MC_CPPFLAGS:=$(strip $(workbench-c-m68k-gdbstub_MC_CPPFLAGS) $(workbench-c-m68k-gdbstub_MC_EXTRA_CPPFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_CFLAGS:=$(strip $(workbench-c-m68k-gdbstub_CFLAGS) $(SAFETY_CFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_DFLAGS:=$(workbench-c-m68k-gdbstub_DFLAGS)
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_IQUOTE:=$(CFLAGS_IQUOTE)
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_IQUOTE_END:=$(CFLAGS_IQUOTE_END)
endif
ifeq (target,host)
workbench-c-m68k-gdbstub_LINK ?= $(strip $(HOST_CC) $(HOST_LDFLAGS))
workbench-c-m68k-gdbstub_STRIP ?= $(HOST_STRIP)
workbench-c-m68k-gdbstub_ASSEMBLER ?= $(strip $HOST_CC) $(HOST_SYSROOT))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : CMD:=$(HOST_CC)
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_MC_CPPFLAGS:=$(strip $(HOST_MC_CPPFLAGS) $(workbench-c-m68k-gdbstub_MC_CPPFLAGS) $(workbench-c-m68k-gdbstub_MC_EXTRA_CPPFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_CFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-c-m68k-gdbstub_CFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_DFLAGS:=$(strip $(HOST_CFLAGS) $(workbench-c-m68k-gdbstub_DFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_IQUOTE:=$(HOST_IQUOTE)
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_IQUOTE_END:=$(HOST_IQUOTE_END)
endif
ifeq (target,kernel)
workbench-c-m68k-gdbstub_LINK ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT) $(USER_LDFLAGS) $(KERNEL_LDFLAGS))
workbench-c-m68k-gdbstub_STRIP ?= $(ECHO) >/dev/null
workbench-c-m68k-gdbstub_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(workbench-c-m68k-gdbstub_MC_CPPFLAGS) $(workbench-c-m68k-gdbstub_MC_EXTRA_CPPFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-c-m68k-gdbstub_CFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(workbench-c-m68k-gdbstub_DFLAGS))
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_IQUOTE:=$(KERNEL_IQUOTE)
$(workbench-c-m68k-gdbstub_MC_TARGETS) $(workbench-c-m68k-gdbstub_MC_DTARGETS) : workbench-c-m68k-gdbstub_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(workbench-c-m68k-gdbstub_MC_TARGETS) : CPPFLAGS := $(workbench-c-m68k-gdbstub_MC_CPPFLAGS)
$(workbench-c-m68k-gdbstub_MC_TARGETS) : CFLAGS := $(workbench-c-m68k-gdbstub_CFLAGS)
$(workbench-c-m68k-gdbstub_MC_TARGETS) : $(workbench-c-m68k-gdbstub_MC_TGTWILDCARD).o : $(workbench-c-m68k-gdbstub_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(workbench-c-m68k-gdbstub_IQUOTE) $(dir $<) $(workbench-c-m68k-gdbstub_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-m68k-gdbstub_IQUOTE) . $(workbench-c-m68k-gdbstub_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(workbench-c-m68k-gdbstub_IQUOTE) $(dir $<) $(workbench-c-m68k-gdbstub_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-m68k-gdbstub_IQUOTE) . $(workbench-c-m68k-gdbstub_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(workbench-c-m68k-gdbstub_IQUOTE) $(dir $<) $(workbench-c-m68k-gdbstub_IQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-m68k-gdbstub_IQUOTE) . $(workbench-c-m68k-gdbstub_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(workbench-c-m68k-gdbstub_MC_DTARGETS) : $(workbench-c-m68k-gdbstub_MC_TGTWILDCARD).d : $(workbench-c-m68k-gdbstub_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(workbench-c-m68k-gdbstub_DFLAGS) $(workbench-c-m68k-gdbstub_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@


workbench-c-m68k-gdbstub-link_EXTRA_LDFLAGS := 
workbench-c-m68k-gdbstub-link_EXTRA_LIBS :=
ifeq (no,yes)
    workbench-c-m68k-gdbstub-link_EXTRA_LDFLAGS += $(NIX_LDFLAGS)
endif
ifeq (yes,no)
    workbench-c-m68k-gdbstub-link_EXTRA_LDFLAGS += $(NOSTARTUP_LDFLAGS)
endif
ifeq (yes,yes)
    workbench-c-m68k-gdbstub-link_EXTRA_LDFLAGS += $(DETACH_LDFLAGS)
endif

# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
workbench-c-m68k-gdbstub-link_DIRS := $(subst -L ,-L,$(strip $(workbench-c-m68k-gdbstub_LDFLAGS)))
# Filter out only the libdirs and remove -L
workbench-c-m68k-gdbstub-link_DIRS := $(patsubst -L%,%,$(filter -L%,$(workbench-c-m68k-gdbstub-link_DIRS)))
# Add trailing /
workbench-c-m68k-gdbstub-link_DIRS := $(subst //,/,$(addsuffix /,$(workbench-c-m68k-gdbstub-link_DIRS)))
# Add normal linklib path
workbench-c-m68k-gdbstub-link_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
workbench-c-m68k-gdbstub-link_LIBS := $(addprefix lib,$(addsuffix .a,$(workbench-c-m68k-gdbstub_LIBS) $(workbench-c-m68k-gdbstub-link_EXTRA_LIBS)))
# search for the linklibs in the given path, ignore ones not found
workbench-c-m68k-gdbstub-link_DEPLIBS := $(foreach lib,$(workbench-c-m68k-gdbstub-link_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(workbench-c-m68k-gdbstub-link_DIRS)))) \
)
workbench-c-m68k-gdbstub-link_PROGS := $(addprefix $(workbench-c-m68k-gdbstub_TARGETDIR)/,$(workbench-c-m68k-gdbstub_FILES))

$(workbench-c-m68k-gdbstub-link_PROGS) : OBJDIR := $(workbench-c-m68k-gdbstub_OBJDIR)
$(workbench-c-m68k-gdbstub-link_PROGS) : LDFLAGS := $(strip $(workbench-c-m68k-gdbstub_LDFLAGS) $(workbench-c-m68k-gdbstub-link_EXTRA_LDFLAGS))
$(workbench-c-m68k-gdbstub-link_PROGS) : LIBS := $(addprefix -l,$(workbench-c-m68k-gdbstub_LIBS) $(workbench-c-m68k-gdbstub-link_EXTRA_LIBS) )
$(workbench-c-m68k-gdbstub-link_PROGS) : $(workbench-c-m68k-gdbstub_TARGETDIR)/% : $(workbench-c-m68k-gdbstub_OBJDIR)/%.o $(workbench-c-m68k-gdbstub-link_DEPLIBS)
	$(Q)$(eval LINKTARGET=$@)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$(LINKTARGET))..."
	$(Q)$(eval LINKTMPFILE=$(OBJDIR)/$(notdir $(LINKTARGET)))
	$(Q)$(IF) $(workbench-c-m68k-gdbstub_LINK) $< -o $(LINKTMPFILE) $(LDFLAGS) $(LIBS) 2>&1 > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
				$(ECHO) "$(LINKTARGET): $(workbench-c-m68k-gdbstub_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" >> $(GENDIR)/errors ; \
				$(CAT) $(GENDIR)/cerrors >> $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
		$(CP) $(LINKTMPFILE) $(LINKTARGET) ; \
	else \
		$(ECHO) "Link failed: $(workbench-c-m68k-gdbstub_LINK) $< -o $(LINKTARGET) $(LDFLAGS) $(LIBS)" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi
	$(Q)$(IF) $(TEST) "$(workbench-c-m68k-gdbstub_STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(workbench-c-m68k-gdbstub_STRIP) $(LINKTARGET) --only-keep-debug -o $(LINKTARGET).dbg ; \
		fi ; \
		$(workbench-c-m68k-gdbstub_STRIP) $(LINKTARGET) ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $(LINKTARGET).dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$(LINKTARGET).dbg $(LINKTARGET) ; \
			fi ; \
		fi ; \
	fi
	$(Q)$(IF) $(TEST) "$(workbench-c-m68k-gdbstub_COVERAGE)" = "yes"; then \
		LINKBASEFILES="$(strip $(notdir $(basename $<)))" ; \
		$(FOR) covext in $(TARGET_COVERAGEINSTR_EXTS) ; do \
			$(FOR) file in $$LINKBASEFILES ; do \
				COVERAGEFILE=`echo $$file$$covext` ; \
				$(IF) $(TEST) -s $(OBJDIR)/$$COVERAGEFILE ; then \
					$(CP) $(OBJDIR)/$$COVERAGEFILE $(dir $(LINKTARGET))$$COVERAGEFILE ; \
				fi ; \
			done ; \
		done ; \
	fi

endif

ifneq ($(workbench-c-m68k-gdbstub_DEPS),)
  ifneq (workbench-c-m68k-gdbstub workbench-c-m68k-gdbstub-quick,)
    ifneq ($(findstring $(TARGET),workbench-c-m68k-gdbstub workbench-c-m68k-gdbstub-quick),)
      -include $(workbench-c-m68k-gdbstub_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(workbench-c-m68k-gdbstub_DEPS)
    endif
  endif
