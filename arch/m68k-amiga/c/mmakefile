		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$(2): $(workbench-c-m68k-setpatch_CXXCMD) $(workbench-c-m68k-setpatch_CXXIQUOTE) $(dir $(2)) $(workbench-c-m68k-setpatch_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-m68k-setpatch_CXXIQUOTE) . $(workbench-c-m68k-setpatch_CXXIQUOTE_END) $(strip $(workbench-c-m68k-setpatch_CXXFLAGS) $(workbench-c-m68k-setpatch_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(workbench-c-m68k-setpatch_CXXCMD) $(workbench-c-m68k-setpatch_CXXIQUOTE) $(dir $(2)) $(workbench-c-m68k-setpatch_CXXIQUOTE) $(SRCDIR)/$(CURDIR) $(workbench-c-m68k-setpatch_CXXIQUOTE) . $(workbench-c-m68k-setpatch_CXXIQUOTE_END) $(strip $(workbench-c-m68k-setpatch_CXXFLAGS) $(workbench-c-m68k-setpatch_MCXX_CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $(2))))\" -c $(2) -o $(1).o" 1>&2 ; \
