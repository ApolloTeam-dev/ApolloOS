kernel-diag_STRIP ?= $(ECHO) >/dev/null
kernel-diag_ASSEMBLER ?= $(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(kernel-diag_MC_TARGETS) $(kernel-diag_MC_DTARGETS) : CMD:=$(strip $(KERNEL_CC) $(KERNEL_SYSROOT))
$(kernel-diag_MC_TARGETS) $(kernel-diag_MC_DTARGETS) : kernel-diag_MC_CPPFLAGS:=$(strip $(KERNEL_MC_CPPFLAGS) $(kernel-diag_MC_CPPFLAGS) $(kernel-diag_MC_EXTRA_CPPFLAGS))
$(kernel-diag_MC_TARGETS) $(kernel-diag_MC_DTARGETS) : kernel-diag_CFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(kernel-diag_CFLAGS))
$(kernel-diag_MC_TARGETS) $(kernel-diag_MC_DTARGETS) : kernel-diag_DFLAGS:=$(strip $(KERNEL_ISA_CFLAGS) $(KERNEL_CFLAGS) $(kernel-diag_DFLAGS))
$(kernel-diag_MC_TARGETS) $(kernel-diag_MC_DTARGETS) : kernel-diag_IQUOTE:=$(KERNEL_IQUOTE)
$(kernel-diag_MC_TARGETS) $(kernel-diag_MC_DTARGETS) : kernel-diag_IQUOTE_END:=$(KERNEL_IQUOTE_END)
endif

$(kernel-diag_MC_TARGETS) : CPPFLAGS := $(kernel-diag_MC_CPPFLAGS)
$(kernel-diag_MC_TARGETS) : CFLAGS := $(kernel-diag_CFLAGS)
$(kernel-diag_MC_TARGETS) : $(kernel-diag_MC_TGTWILDCARD).o : $(kernel-diag_MC_SRCWILDCARD).c
	$(Q)$(ECHO) "Compiling  $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))"
	$(Q)$(IF) $(CMD) $(kernel-diag_IQUOTE) $(dir $<) $(kernel-diag_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-diag_IQUOTE) . $(kernel-diag_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__="\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))"\" -c $< -o $@ > $(GENDIR)/cerrors 2>&1 ; then \
		$(IF) $(TEST) -s $(GENDIR)/cerrors ; then \
			$(ECHO) "$<: $(CMD) $(kernel-diag_IQUOTE) $(dir $<) $(kernel-diag_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-diag_IQUOTE) . $(kernel-diag_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" >> $(GENDIR)/errors ; \
			tee < $(GENDIR)/cerrors -a $(GENDIR)/errors ; \
		else \
			$(NOP) ; \
		fi ; \
	else \
		$(ECHO) "Compile failed: $(CMD) $(kernel-diag_IQUOTE) $(dir $<) $(kernel-diag_IQUOTE) $(SRCDIR)/$(CURDIR) $(kernel-diag_IQUOTE) . $(kernel-diag_IQUOTE_END) $(strip $(CFLAGS) $(CPPFLAGS)) -D__SRCFILENAME__=\"$(subst $(TOP)/,,$(subst $(SRCDIR)/,,$(abspath $<)))\" -c $< -o $@" 1>&2 ; \
		tee < $(GENDIR)/cerrors -a $(GENDIR)/errors 1>&2 ; \
		exit 1 ; \
	fi

$(kernel-diag_MC_DTARGETS) : $(kernel-diag_MC_TGTWILDCARD).d : $(kernel-diag_MC_SRCWILDCARD).c
	$(Q)$(IF) $(TEST) ! -d $(dir $@) ; then $(MKDIR) $(dir $@) ; else $(NOP) ; fi
	$(Q)$(ECHO) "Makedepend $(if $(filter /%,$<),$(if $(filter $(SRCDIR)/%,$(abspath $<)),$(patsubst $(SRCDIR)/%,%,$(abspath $<)),$(patsubst $(TOP)/%,%,$(abspath $<))),$(patsubst $(SRCDIR)/%,%,$(abspath $(SRCDIR)/$(CURDIR)/$<)))..."
	$(Q)AROS_CC="$(CMD)" $(MKDEPEND) $(strip $(kernel-diag_DFLAGS) $(kernel-diag_MC_CPPFLAGS)) -I$(TOP)/$(CURDIR) -I$(SRCDIR)/$(CURDIR) $< -o $@

# Handlers use dash instead of dot in their names
ifeq (hook,handler)
kernel-diag_MODULE := $(kernel-diag_MODDIR)/diag-hook
else
ifeq (hook,printer)
kernel-diag_MODULE := $(kernel-diag_MODDIR)/diag
else
kernel-diag_MODULE := $(kernel-diag_MODDIR)/diag.hook
endif
endif
kernel-diag_KOBJ   := $(KOBJSDIR)/diag_hook.o

kernel-diag-quick : kernel-diag
kernel-diag-kobj-quick : $(kernel-diag_KOBJ)
kernel-diag       : $(kernel-diag_MODULE)
kernel-diag-kobj  : $(kernel-diag_KOBJ)

# The module is linked from all the compiled .o files
kernel-diag_OBJS       := $(kernel-diag_ARCHOBJS) $(addprefix $(OBJDIR)/, $(addsuffix .o,$(notdir $(kernel-diag_C_NARCHFILES))))

# Under Windows con* is a reserved name, it refers to console. Files with such names can't be created.
# This breaks con-handler build. Here we work around this
ifeq (diag,con)
    kernel-diag_ERR := $(notdir $(kernel-diag_MODULE)).err
else
    kernel-diag_ERR := diag.err
endif


TMP_LDFLAGS  := $(strip $(LDFLAGS) $(diag_LDFLAGS))
# Make a list of the lib files the programs depend on.
# In LDFLAGS remove white space between -L and directory
TMP_DIRS := $(subst -L ,-L,$(strip $(TMP_LDFLAGS)))
# Filter out only the libdirs and remove -L
TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(diag_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(kernel-diag_MODULE) : LIB_NAMES := $(diag_LIBS)
$(kernel-diag_MODULE) : OBJS := $(kernel-diag_OBJS)
$(kernel-diag_MODULE) : ENDTAG := 
$(kernel-diag_MODULE) : ERR := $(kernel-diag_ERR)
$(kernel-diag_MODULE) : OBJDIR := $(OBJDIR)
$(kernel-diag_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(kernel-diag_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(kernel-diag_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(kernel-diag_MODULE) : $(kernel-diag_OBJS)  $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(strip $(AROS_CC) $(TARGET_SYSROOT)) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(strip $(AROS_CC) $(TARGET_SYSROOT)) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi


# Link kernel object file
kernel-diag_KAUTOLIB := dos intuition layers graphics oop utility expansion keymap

# Make these symbols local
kernel-diag_KBASE := DOSBase IntuitionBase LayersBase GfxBase OOPBase \
    UtilityBase ExpansionBase KeymapBase KernelBase

kernel-diag_SYMBOLS := $(kernel-diag_KBASE)

kernel-diag_KLIB := hiddstubs amiga arossupport autoinit libinit
kernel-diag_KOBJ_LIBS := $(filter-out $(kernel-diag_KLIB),) $(kernel-diag_KAUTOLIB)
$(kernel-diag_KOBJ) : LINKLIBS:=$(kernel-diag_KOBJ_LIBS)
$(kernel-diag_KOBJ) : FILTBASES:=$(addprefix -L ,$(kernel-diag_SYMBOLS))
$(kernel-diag_KOBJ) : USER_LDFLAGS := $(USER_LDFLAGS)
$(kernel-diag_KOBJ) : $(kernel-diag_OBJS) $(kernel-diag_ENDOBJS)
	$(Q)$(ECHO) "Linking    $(subst $(TARGETDIR)/,,$@)"
	$(Q)$(AROS_LD) -Ur -o $@ $^ $(USER_LDFLAGS) -L$(AROS_LIB) $(addprefix -l,$(LINKLIBS))
	$(Q)$(OBJCOPY) $@ $(FILTBASES) `$(NM_PLAIN) $@ | $(AWK) '($$3 ~ /^__.*_(LIST|END)__\r?$$/) || ($$3 ~ /^__aros_lib.*\r?$$/) {print "-L " $$3;}'`


## Dependency fine-tuning
##
kernel-diag_DEPS       := $(addprefix $(OBJDIR)/, $(addsuffix .d,diag resident_end))
ifneq ($(kernel-diag_DEPS),)
  ifneq (kernel-diag kernel-diag-quick kernel-diag-kobj,)
    ifneq ($(findstring $(TARGET),kernel-diag kernel-diag-quick kernel-diag-kobj),)
      -include $(kernel-diag_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-diag_DEPS)
    endif
  endif
endif


ifneq ($(kernel-diag_OBJS) $(kernel-diag_DEPS) $(kernel-diag_MODULE) $(kernel-diag_KOBJ),)
$(kernel-diag_OBJS) $(kernel-diag_DEPS) $(kernel-diag_MODULE) $(kernel-diag_KOBJ) : | $(OBJDIR) $(kernel-diag_MODDIR) $(KOBJSDIR)
else
$(kernel-diag_OBJS) $(kernel-diag_DEPS) $(kernel-diag_MODULE) $(kernel-diag_KOBJ) :: $(OBJDIR) $(kernel-diag_MODDIR) $(KOBJSDIR)
endif

GLOB_MKDIRS += $(OBJDIR) $(kernel-diag_MODDIR) $(KOBJSDIR)


kernel-diag-clean : FILES := $(kernel-diag_OBJS) $(kernel-diag_MODULE) $(kernel-diag_KOBJ) $(kernel-diag_DEPS)
kernel-diag-clean ::
	$(Q)$(ECHO) "Cleaning up for module diag"
	$(Q)$(RM) $(FILES)

# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
