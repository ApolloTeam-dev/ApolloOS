kernel-amiga-m68k-amigavideo_DEPS             := $(addprefix $(kernel-amiga-m68k-amigavideo_OBJDIR)/,$(notdir $(kernel-amiga-m68k-amigavideo_CCFILES:=.d) $(kernel-amiga-m68k-amigavideo_TARGETCCFILES:=.d) $(kernel-amiga-m68k-amigavideo_CXXFILES:=.d))) $(addprefix $(kernel-amiga-m68k-amigavideo_OBJDIR)/linklib/,$(notdir $(kernel-amiga-m68k-amigavideo_LINKLIBCCFILES:=.d)))

ifneq ($(kernel-amiga-m68k-amigavideo_DEPS),)
  ifneq (kernel-amiga-m68k-amigavideo kernel-amiga-m68k-amigavideo-quick kernel-amiga-m68k-amigavideo-kobj kernel-amiga-m68k-amigavideo-kobj-quick,)
    ifneq ($(findstring $(TARGET),kernel-amiga-m68k-amigavideo kernel-amiga-m68k-amigavideo-quick kernel-amiga-m68k-amigavideo-kobj kernel-amiga-m68k-amigavideo-kobj-quick),)
      -include $(kernel-amiga-m68k-amigavideo_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-amiga-m68k-amigavideo_DEPS)
    endif
  endif
endif

$(kernel-amiga-m68k-amigavideo_OBJS) $(kernel-amiga-m68k-amigavideo_DEPS) : | $(kernel-amiga-m68k-amigavideo_OBJDIR)/linklib

ifneq ($(kernel-amiga-m68k-amigavideo_OBJS) $(kernel-amiga-m68k-amigavideo_DEPS) $(kernel-amiga-m68k-amigavideo_MODULE) $(kernel-amiga-m68k-amigavideo_KOBJ),)
$(kernel-amiga-m68k-amigavideo_OBJS) $(kernel-amiga-m68k-amigavideo_DEPS) $(kernel-amiga-m68k-amigavideo_MODULE) $(kernel-amiga-m68k-amigavideo_KOBJ) : | $(kernel-amiga-m68k-amigavideo_OBJDIR) $(AROSDIR)/$(kernel-amiga-m68k-amigavideo_MODDIR) $(KOBJSDIR)
else
$(kernel-amiga-m68k-amigavideo_OBJS) $(kernel-amiga-m68k-amigavideo_DEPS) $(kernel-amiga-m68k-amigavideo_MODULE) $(kernel-amiga-m68k-amigavideo_KOBJ) :: $(kernel-amiga-m68k-amigavideo_OBJDIR) $(AROSDIR)/$(kernel-amiga-m68k-amigavideo_MODDIR) $(KOBJSDIR)
endif

GLOB_MKDIRS += $(kernel-amiga-m68k-amigavideo_OBJDIR) $(AROSDIR)/$(kernel-amiga-m68k-amigavideo_MODDIR) $(KOBJSDIR)


# Some include files need to be generated before the .c can be parsed.
ifneq ($(filter $(TARGET),kernel-amiga-m68k-amigavideo kernel-amiga-m68k-amigavideo-includes kernel-amiga-m68k-amigavideo-quick kernel-amiga-m68k-amigavideo-kobj kernel-amiga-m68k-amigavideo-kobj-quick),) # Only for this target these deps are wanted

kernel-amiga-m68k-amigavideo_DFILE_DEPS := $(kernel-amiga-m68k-amigavideo_LIBDEFSINC) $(kernel-amiga-m68k-amigavideo_DEFLIBDEFSINC) \
    $(addprefix $(kernel-amiga-m68k-amigavideo_INCDIR)/,$($(kernel-amiga-m68k-amigavideo_DEFNAME)_INCLUDES))
$(kernel-amiga-m68k-amigavideo_DEPS) : $(kernel-amiga-m68k-amigavideo_DFILE_DEPS)
endif

kernel-amiga-m68k-amigavideo_TOCLEAN := $(kernel-amiga-m68k-amigavideo_OBJS) $(kernel-amiga-m68k-amigavideo_DEPS) \
    $(kernel-amiga-m68k-amigavideo_MODULE) $(kernel-amiga-m68k-amigavideo_LINKLIB) $(kernel-amiga-m68k-amigavideo_KOBJ) \
    $(kernel-amiga-m68k-amigavideo_OBJDIR)/Makefile.amigavideohidd \
    $(addprefix $(kernel-amiga-m68k-amigavideo_OBJDIR)/include/,$($(kernel-amiga-m68k-amigavideo_DEFNAME)_INCLUDES)) \
    $(addprefix $(GENINCDIR)/,$($(kernel-amiga-m68k-amigavideo_DEFNAME)_INCLUDES)) \
    $(addprefix $(kernel-amiga-m68k-amigavideo_INCDIR)/,$($(kernel-amiga-m68k-amigavideo_DEFNAME)_INCLUDES)) \
    $(kernel-amiga-m68k-amigavideo_OBJDIR)/amigavideo_geninc $(kernel-amiga-m68k-amigavideo_OBJDIR)/amigavideo_incs \
    $(addsuffix .c,$(kernel-amiga-m68k-amigavideo_LINKLIBFILES)) $(kernel-amiga-m68k-amigavideo_LINKLIBOBJS) $(kernel-amiga-m68k-amigavideo_LIBDEFSINC) \
    $(kernel-amiga-m68k-amigavideo_DEFLIBDEFSINC) $(addsuffix .c,$(kernel-amiga-m68k-amigavideo_STARTFILES) $(kernel-amiga-m68k-amigavideo_ENDFILES)) \
    $(kernel-amiga-m68k-amigavideo_ENDOBJS)
kernel-amiga-m68k-amigavideo-clean : FILES              := $(kernel-amiga-m68k-amigavideo_TOCLEAN)
kernel-amiga-m68k-amigavideo-clean ::
	$(Q)$(ECHO) "Cleaning up for module amigavideo"
	$(Q)$(RM) $(FILES)

endif # $(TARGET) in $(kernel-amiga-m68k-amigavideo_ALLTARGETS)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
