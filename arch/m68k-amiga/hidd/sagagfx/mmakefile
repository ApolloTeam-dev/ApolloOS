# Filter out only the libdirs and remove -L
TMP_DIRS := $(patsubst -L%,%,$(filter -L%,$(TMP_DIRS)))
# Add trailing /
TMP_DIRS := $(subst //,/,$(addsuffix /,$(TMP_DIRS)))
# Add normal linklib path
TMP_DIRS += $(AROS_LIB)/
# add lib and .a to static linklib names
TMP_LIBS := $(addprefix lib,$(addsuffix .a,$(hidd-m68k-sagagfx_LIBS) $($(hidd-m68k-sagagfx_DEFNAME)_LIBS)))
# search for the linklibs in the given path, ignore ones not found
TMP_DEPLIBS := $(foreach lib,$(TMP_LIBS), \
    $(firstword $(wildcard $(addsuffix $(lib),$(TMP_DIRS)))) \
)

$(hidd-m68k-sagagfx_MODULE) : LIB_NAMES := $(hidd-m68k-sagagfx_LIBS) $($(hidd-m68k-sagagfx_DEFNAME)_LIBS)
$(hidd-m68k-sagagfx_MODULE) : OBJS := $(hidd-m68k-sagagfx_STARTOBJS) $(hidd-m68k-sagagfx_OBJS) $(USER_OBJS)
$(hidd-m68k-sagagfx_MODULE) : ENDTAG := $(hidd-m68k-sagagfx_ENDOBJS)
$(hidd-m68k-sagagfx_MODULE) : ERR := $(hidd-m68k-sagagfx_ERR)
$(hidd-m68k-sagagfx_MODULE) : OBJDIR := $(hidd-m68k-sagagfx_OBJDIR)
$(hidd-m68k-sagagfx_MODULE) : LDFLAGS := $(TMP_LDFLAGS)
ifeq (,)
$(hidd-m68k-sagagfx_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES))
else
# Warning: the -L/usr/lib here can result in modules
# linking against host libs instead of AROS libs (e.g stdc++) !!
$(hidd-m68k-sagagfx_MODULE) : LIBS := $(addprefix -l,$(LIB_NAMES)) \
                    -L/usr/lib $(addprefix -l,)
endif 
$(hidd-m68k-sagagfx_MODULE) : $(hidd-m68k-sagagfx_STARTOBJS) $(hidd-m68k-sagagfx_OBJS) $(USER_OBJS) $(hidd-m68k-sagagfx_ENDOBJS) $(TMP_DEPLIBS) $(USER_DEPLIBS)
	$(Q)$(ECHO) "Building   $(subst $(TARGETDIR)/,,$@) ..."
	$(Q)$(IF) $(hidd-m68k-sagagfx_LINK) $(NOSTARTUP_LDFLAGS) \
		$(GENMAP) $(OBJDIR)/$(MODULE).map \
		$(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) \
		-o $@ 2>&1 > $(OBJDIR)/$(ERR) 2>&1 ; \
	then \
		cat $(OBJDIR)/$(ERR); \
	else \
		echo "$(hidd-m68k-sagagfx_LINK) $(NOSTARTUP_LDFLAGS) $(GENMAP) $(OBJDIR)/$(MODULE).map $(OBJS) $(LIBS) $(LDFLAGS) $(ENDTAG) -o $@"; \
		cat $(OBJDIR)/$(ERR); \
		exit 1; \
	fi
	$(Q)$(IF) $(TEST) ! -s $(OBJDIR)/$(ERR) ; then $(RM) $(OBJDIR)/$(ERR) ; fi
	$(Q)$(IF) $(TEST) "$(STRIP)" != ""; then \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(STRIP) $@ --only-keep-debug -o $@.dbg ; \
		fi ; \
		$(STRIP) $@ ; \
		$(IF) $(TEST) "$(DEBUG)" = "yes"; then \
			$(IF) $(TEST) -s $@.dbg ; then \
				$(OBJCOPY) --add-gnu-debuglink=$@.dbg $@ ; \
			fi ; \
		fi ; \
	fi

endif

