kernel-amiga-m68k-p96gfx_DEPS             := $(addprefix $(kernel-amiga-m68k-p96gfx_OBJDIR)/,$(notdir $(kernel-amiga-m68k-p96gfx_CCFILES:=.d) $(kernel-amiga-m68k-p96gfx_TARGETCCFILES:=.d) $(kernel-amiga-m68k-p96gfx_CXXFILES:=.d))) $(addprefix $(kernel-amiga-m68k-p96gfx_OBJDIR)/linklib/,$(notdir $(kernel-amiga-m68k-p96gfx_LINKLIBCCFILES:=.d)))

ifneq ($(kernel-amiga-m68k-p96gfx_DEPS),)
  ifneq (kernel-amiga-m68k-p96gfx kernel-amiga-m68k-p96gfx-quick kernel-amiga-m68k-p96gfx-kobj kernel-amiga-m68k-p96gfx-kobj-quick,)
    ifneq ($(findstring $(TARGET),kernel-amiga-m68k-p96gfx kernel-amiga-m68k-p96gfx-quick kernel-amiga-m68k-p96gfx-kobj kernel-amiga-m68k-p96gfx-kobj-quick),)
      -include $(kernel-amiga-m68k-p96gfx_DEPS)
    endif
  else
    ifeq (,$(filter clean% %clean %clean% setup% includes% %setup,$(TARGET)))
      -include $(kernel-amiga-m68k-p96gfx_DEPS)
    endif
  endif
endif

$(kernel-amiga-m68k-p96gfx_OBJS) $(kernel-amiga-m68k-p96gfx_DEPS) : | $(kernel-amiga-m68k-p96gfx_OBJDIR)/linklib

ifneq ($(kernel-amiga-m68k-p96gfx_OBJS) $(kernel-amiga-m68k-p96gfx_DEPS) $(kernel-amiga-m68k-p96gfx_MODULE) $(kernel-amiga-m68k-p96gfx_KOBJ),)
$(kernel-amiga-m68k-p96gfx_OBJS) $(kernel-amiga-m68k-p96gfx_DEPS) $(kernel-amiga-m68k-p96gfx_MODULE) $(kernel-amiga-m68k-p96gfx_KOBJ) : | $(kernel-amiga-m68k-p96gfx_OBJDIR) $(AROSDIR)/$(kernel-amiga-m68k-p96gfx_MODDIR) $(KOBJSDIR)
else
$(kernel-amiga-m68k-p96gfx_OBJS) $(kernel-amiga-m68k-p96gfx_DEPS) $(kernel-amiga-m68k-p96gfx_MODULE) $(kernel-amiga-m68k-p96gfx_KOBJ) :: $(kernel-amiga-m68k-p96gfx_OBJDIR) $(AROSDIR)/$(kernel-amiga-m68k-p96gfx_MODDIR) $(KOBJSDIR)
endif

GLOB_MKDIRS += $(kernel-amiga-m68k-p96gfx_OBJDIR) $(AROSDIR)/$(kernel-amiga-m68k-p96gfx_MODDIR) $(KOBJSDIR)


# Some include files need to be generated before the .c can be parsed.
ifneq ($(filter $(TARGET),kernel-amiga-m68k-p96gfx kernel-amiga-m68k-p96gfx-includes kernel-amiga-m68k-p96gfx-quick kernel-amiga-m68k-p96gfx-kobj kernel-amiga-m68k-p96gfx-kobj-quick),) # Only for this target these deps are wanted

kernel-amiga-m68k-p96gfx_DFILE_DEPS := $(kernel-amiga-m68k-p96gfx_LIBDEFSINC) $(kernel-amiga-m68k-p96gfx_DEFLIBDEFSINC) \
    $(addprefix $(kernel-amiga-m68k-p96gfx_INCDIR)/,$($(kernel-amiga-m68k-p96gfx_DEFNAME)_INCLUDES))
$(kernel-amiga-m68k-p96gfx_DEPS) : $(kernel-amiga-m68k-p96gfx_DFILE_DEPS)
endif

kernel-amiga-m68k-p96gfx_TOCLEAN := $(kernel-amiga-m68k-p96gfx_OBJS) $(kernel-amiga-m68k-p96gfx_DEPS) \
    $(kernel-amiga-m68k-p96gfx_MODULE) $(kernel-amiga-m68k-p96gfx_LINKLIB) $(kernel-amiga-m68k-p96gfx_KOBJ) \
    $(kernel-amiga-m68k-p96gfx_OBJDIR)/Makefile.p96gfxhidd \
    $(addprefix $(kernel-amiga-m68k-p96gfx_OBJDIR)/include/,$($(kernel-amiga-m68k-p96gfx_DEFNAME)_INCLUDES)) \
    $(addprefix $(GENINCDIR)/,$($(kernel-amiga-m68k-p96gfx_DEFNAME)_INCLUDES)) \
    $(addprefix $(kernel-amiga-m68k-p96gfx_INCDIR)/,$($(kernel-amiga-m68k-p96gfx_DEFNAME)_INCLUDES)) \
    $(kernel-amiga-m68k-p96gfx_OBJDIR)/p96gfx_geninc $(kernel-amiga-m68k-p96gfx_OBJDIR)/p96gfx_incs \
    $(addsuffix .c,$(kernel-amiga-m68k-p96gfx_LINKLIBFILES)) $(kernel-amiga-m68k-p96gfx_LINKLIBOBJS) $(kernel-amiga-m68k-p96gfx_LIBDEFSINC) \
    $(kernel-amiga-m68k-p96gfx_DEFLIBDEFSINC) $(addsuffix .c,$(kernel-amiga-m68k-p96gfx_STARTFILES) $(kernel-amiga-m68k-p96gfx_ENDFILES)) \
    $(kernel-amiga-m68k-p96gfx_ENDOBJS)
kernel-amiga-m68k-p96gfx-clean : FILES              := $(kernel-amiga-m68k-p96gfx_TOCLEAN)
kernel-amiga-m68k-p96gfx-clean ::
	$(Q)$(ECHO) "Cleaning up for module p96gfx"
	$(Q)$(RM) $(FILES)

endif # $(TARGET) in $(kernel-amiga-m68k-p96gfx_ALLTARGETS)


# Delete generated makefiles
#MM
clean ::
	$(Q)$(RM) $(TOP)/$(CURDIR)/mmakefile $(TOP)/$(CURDIR)/mmakefile.bak

include $(SRCDIR)/config/make.tail

BDID := $(BDTARGETID)
