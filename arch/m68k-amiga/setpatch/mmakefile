#MM- linklibs-setpatch: kernel-setpatch-linklib
#MM- linklibs-setpatch_rel : kernel-setpatch-linklib
#MM- includes-setpatch: kernel-setpatch-includes
#MM- includes-setpatch_rel : kernel-setpatch-includes
#MM- kernel-setpatch : kernel-setpatch-includes core-linklibs linklibs-
#MM kernel-setpatch-linklib : kernel-setpatch-includes includes-
#MM- kernel-setpatch-quick : kernel-setpatch-includes-quick
#MM kernel-setpatch-includes : kernel-setpatch-makefile kernel-setpatch-includes-dirs \
#MM     includes-generate-deps kernel-setpatch-fd
#MM kernel-setpatch-includes-quick
#MM kernel-setpatch-includes-dirs
#MM kernel-setpatch-fd

# Library targets
#MM kernel-setpatch-kobj : core-linklibs linklibs-
#MM kernel-setpatch-kobj-quick : 

# Library with ABI targets:
#MM kernel-setpatch-kobj : kernel-setpatch-includes core-linklibs linklibs-
